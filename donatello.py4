#+--|-------------------------------------------->>>
#+--|

def parse_pinned_wp(tokens):
    """
    Extract team WP percentages from ESPN's live Win Probability panel.
    Renders (flattened) as one of:
        "Probabilities Win Probability Cover Probability ATL 88.7% ..."
        "Probabilities", "Win Probability", "Cover Probability", "ATL", "88.7%", ...
        "Probabilities", "ATL 88.7%", ...
    Returns {"ABBR": pct, ...} or {} if not found.
    """
    if not tokens:
        return {}

    # find the anchor — match the actual panel title on ESPN
    anchor = None
    for i, t in enumerate(tokens):
        tl = (t or "").lower()
        if tl.startswith("probabilities") or tl == "matchup predictor":
            anchor = i
            break
    if anchor is None:
        return {}

    out = {}
    n = len(tokens)
    # walk forward, look for "<ABBR> <float>%" on one token OR split
    i = anchor
    while i < n and i < anchor + 40:
        t = tokens[i] or ""

        # stop if we've clearly left the panel
        if i > anchor + 1 and ("Game Odds" in t or "Odds by" in t):
            break

        # case 1: "ATL 88.7%" — abbr + space + pct + % glued into one token
        m = re.search(r'\b([A-Z]{2,4})\s+(\d{1,3}(?:\.\d+)?)\s*%', t)
        if m:
            out.setdefault(m.group(1), float(m.group(2)))
            i += 1
            continue

        # case 2: two tokens — "ATL" then "88.7%"
        if re.fullmatch(r'[A-Z]{2,4}', t):
            for j in range(i + 1, min(i + 3, n)):
                m2 = re.fullmatch(r'(\d{1,3}(?:\.\d+)?)\s*%', tokens[j] or "")
                if m2:
                    out.setdefault(t, float(m2.group(1)))
                    break
            i += 1
            continue

        i += 1

    return out


