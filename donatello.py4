        f"state.down_distance: {state.get('down_distance')}\n"
        f"state.ball_on: {state.get('ball_on')}\n"
        f"state.clock: {state.get('clock')}\n"
        f"state.quarter: {state.get('quarter')}\n"
        f"state.last_play: {state.get('last_play')}\n"
        f"wp: {wp}\n",
        encoding="utf-8"
    )

    # 1f. PARSE GAME QUARTER SCORE (from pinned game page, not scoreboard)
    quarters = {}
    for pin in PINNED_GAMES:
        key = f"{pin['away']}@{pin['home']}"
        if key in pinned_scores and "q_breakdown" in pinned_scores[key]:
            quarters[key] = pinned_scores[key]["q_breakdown"]
    print(f"  {RED}game quarter scores parsed: {len(quarters)}{R}")


    # 2. PARSE — read the token stream already proven to parse (boxscores work)

    games = parse_games(sb_tokens)          # not from disk, from memory

    scoreboard = parse_games(sb_tokens)
    games      = scoreboard

    # ── NEW: Yahoo WP Grip ──
    yahoo_wp_data = {}
    if WP:
        yahoo_html = fetch(WP)
        yahoo_wp_data = parse_yahoo_wp(yahoo_html)
        if yahoo_wp_data.get("away_pct") is not None:
            # Map Yahoo's away percentage to your game dict
            # We assume the Yahoo link is for the pinned game
            if PINNED_GAMES:
                pin = PINNED_GAMES[0]
                key = f"{pin['away']}@{pin['home']}"
                away_pct = yahoo_wp_data["away_pct"]
                home_pct = 100.0 - away_pct
                yahoo_wp_data[key] = {"away": away_pct, "home": home_pct}
                print(f"  {CHK}✓ YAHOO WP GRIPPED: {key} → {away_pct}% / {home_pct}%{R}")




    # 2b. INJECT PINNED GAMES — today's game(s) come from the pinned list
    existing_keys = {f"{g['away']}@{g['home']}" for g in games}
    for pin in PINNED_GAMES:
        key = f"{pin['away']}@{pin['home']}"
        if key in existing_keys:
            continue
        games.append({
            "away": pin["away"], "home": pin["home"],
            "away_score": "0", "home_score": "0",
            "status": "Scheduled",
            "line": None, "total": None,
            "away_odds": None, "home_odds": None,
            "away_qb": "TBD", "home_qb": "TBD",
        })

    # 3a. FORMULA
    compute_edges(games)
    print(f"  {RED}◆ formulas computed{R}")

    # 3a.5 GAME STATUS STAMP
    stamp_game_status(games)


    # 3b + 3c. ATTACH WP AND ODDS to matching games
    for g in games:
        key = f"{g['away']}@{g['home']}"

        # ── NEW: live score from pinned game page wins over scoreboard ──
        if key in pinned_scores:
            ps = pinned_scores[key]
            g["away_score"] = str(ps["away_score"])
            g["home_score"] = str(ps["home_score"])
            g["status"]     = ps["status"]
            if "q_breakdown" in ps:
                g["q_breakdown"] = ps["q_breakdown"]      # ← this already covers it

        if key in pinned_wps:
            w = pinned_wps[key]
            if w.get("away") is not None and w.get("home") is not None:
                g["wp_away"] = round(w["away"], 1)
                g["wp_home"] = round(w["home"], 1)
                g["wp_source"] = "espn"

        # ── NEW: Attach Yahoo WP if available (OVERRIDES ESPN) ──
        if key in yahoo_wp_data:
            g["wp_away"] = yahoo_wp_data[key]["away"]
            g["wp_home"] = yahoo_wp_data[key]["home"]
            g["wp_source"] = "yahoo"

#+--|-------------------------------------------->>>
