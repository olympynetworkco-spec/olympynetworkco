def write_state():
    # reformat last_fetch into your preferred style: 6:15pm, Oct 8 2026
    lf = STATE.get("last_fetch")
    if lf:
        try:
            dt = datetime.fromisoformat(lf)
            h = dt.hour % 12 or 12
            ampm = "am" if dt.hour < 12 else "pm"
            lf_pretty = f"{h}:{dt.strftime('%M')}{ampm}, {dt.strftime('%b')} {dt.day} {dt.year}"
        except Exception:
            lf_pretty = lf
    else:
        lf_pretty = "—"

    lines = []
    lines.append(f"track: {STATE['track']}")
    lines.append(f"last_fetch: {lf_pretty}")
    lines.append(f"last_count: {STATE['last_count']}")
    lines.append("previous_scores:")
    lines.append("─" * 50)
    for k, v in previous_scores.items():
        lines.append(f"  {k} = {v}")
        lines.append("─" * 50)
    FINALS_FILE.write_text("\n".join(lines) + "\n", encoding="utf-8")

