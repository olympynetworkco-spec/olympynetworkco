# ─── WRITE MIROFISH SCORES ─── ✓
def write_scores(games):
    payload = {
        "fetched_at": datetime.now().isoformat(),
        "total": len(games),
        "games": [
            {
                "away": g["away"],
                "home": g["home"],
                "away_score": g.get("away_score", "0"),
                "home_score": g.get("home_score", "0"),
                "status": g.get("status", ""),
                "edge": g.get("edge", 0),
                "animal": g.get("animal", ""),
                "wp_away": g.get("wp_away"),
                "wp_home": g.get("wp_home"),
                "game_id": g.get("game_id"),
                "is_live": g.get("is_live", False),
            }
            for g in games
        ],
    }
    SCORES_FILE.write_text(json.dumps(payload, indent=2), encoding="utf-8")
    print(f"  {CHK}✓ wrote {len(games)} games → nfl-scores.json{R}")
    print(f"{RED}{'═' * 70}{R}")
