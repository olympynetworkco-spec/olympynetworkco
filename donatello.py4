def write_odds(games):
    # only write if games actually have odds fields populated
    enriched = [g for g in games
                if g.get("away_spread") is not None or g.get("total") is not None]
    if not enriched:
        return
    payload = {
        "source":     "https://www.espn.com/nfl/odds",
        "total":      len(enriched),
        "games":      enriched,
        "fetched_at": datetime.now().strftime("%Y-%m-%d %I:%M %p"),
    }
    ODDS_FILE.write_text(json.dumps(payload, indent=2), encoding="utf-8")
    print(f"  {RED}ᛉ ODDS → nfl-odds.json{R}")

