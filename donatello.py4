}

_XF_RX = {
    name: (_re.compile(d, _re.I), _re.compile(t, _re.I))
    for name, (d, t) in _XF.items()
}

def detect_xfactors(play):
    if not play:
        return []
    ty   = play.get("type", "") or ""
    desc = play.get("desc", "") or ""
    hits = []
    for name, (rx_desc, rx_type) in _XF_RX.items():
        try:
            if rx_desc.search(desc) and rx_type.search(ty + " " + desc):
                hits.append(name)
        except Exception:
            continue
    return hits






