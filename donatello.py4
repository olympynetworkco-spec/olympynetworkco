# ─── MAC NOTIFICATION (hardened + glue) ───
def notify(title, message, subtitle=""):
    """Fire macOS notification. Print confirmation. Bell fallback on failure."""
    try:
        script = (f'display notification "{message}" '
                  f'with title "{title}" subtitle "{subtitle}" sound name "Ping"')
        r = subprocess.run(['osascript', '-e', script],
                           capture_output=True, text=True, timeout=5)
        if r.returncode != 0:
            log(f"[NOTIFY-FAIL] osascript rc={r.returncode} err={r.stderr.strip()}")
            print(f"  {RED}🦄 NOTIFY FAILED (rc={r.returncode}){R}")
            print("\a", end="", flush=True)
        else:
            print(f"  {CHK}🦄 NOTIFY: {title} — {message}{R}")
            CYCLE_STATS["notify"] += 1
            log(f"[NOTIFY] {title} :: {message} :: {subtitle}")
    except Exception as e:
        log(f"[NOTIFY-EXC] {e}")
        print(f"  {RED}🦄 NOTIFY EXC: {e}{R}")
        print("\a", end="", flush=True)
