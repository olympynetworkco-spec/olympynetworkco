# ─── WRITE TIMELINE (per-cycle WP + score sample) ───
TIMELINE_FILE = DATA_DIR / "nfl-timeline.json"
def write_timeline(games):
    with open(TIMELINE_FILE, "a", encoding="utf-8") as f:
        ts = datetime.now().strftime("%H:%M:%S")
        for g in games:
            wp_a = g.get("wp_away")
            wp_h = g.get("wp_home")

            # fallback: derive from live_wp (set in compute_edges)
            if wp_a is None or wp_h is None:
                live = g.get("live_wp")
                if live is None:
                    # last resort — from score diff
                    try:
                        a = int(g["away_score"]); h = int(g["home_score"])
                        live = min(95.0, max(5.0, 50 + (h - a) * 2.0))
                    except (ValueError, KeyError, TypeError):
                        live = 50.0
                wp_h = round(live, 1)
                wp_a = round(100 - live, 1)

            f.write(f"{ts} | {g['away']}@{g['home']} | "
                    f"{g.get('away_score','0')}-{g.get('home_score','0')} | "
                    f"wp {wp_a}/{wp_h}\n")
    print(f"  {RED}🦄 TIMELINE → edge-projection.txt{R}")


