# ─── DIFF + ALERT + FLASH + NODE ───
def diff_and_alert(games):
    global previous_scores

    for g in games:
        key   = f"{g['away']}@{g['home']}"
        score = f"{g['away_score']}-{g['home_score']}"

        if key not in game_spinners:
            game_spinners[key] = Spinner()

        if key in previous_scores and previous_scores[key] != score:
            old_score = previous_scores[key]
            sp = game_spinners[key]
            sp.flash_check()

            change = {"away": g["away"], "home": g["home"],
                      "old": old_score, "new": score, "key": key}

            print(f"  {ORG}🦄 SCORE CHANGE: {g['away']} @ {g['home']} "
                  f"{old_score} → {score}{R}")
            log(f"SCORE CHANGE {key} {old_score} → {score}")
            CYCLE_STATS["changes"] += 1

            notify(
                "⚡ SCORE CHANGE",
                f"{g['away']} {g['away_score']} - {g['home_score']} {g['home']}",
                f"was {old_score}"
            )

            threading.Thread(
                target=speak_score_change,
                args=(g['away'], g['home'], old_score, score),
                daemon=True
            ).start()

            append_node(change, g)

            threading.Timer(4.0, sp.resume).start()

        previous_scores[key] = score
