#+--|
def grip_betting_article(week, quiet=True):
    """
    Grip the ESPN NFL Week N betting article.
    Print from 'Note: Odds by' down to first 'Terms of Use',
    with a divider before each game's card.
    """
    url = ESPN_BETTING_URL.format(week=week)
    try:
        cmd = [CHROME, "--headless=new", "--disable-gpu", "--no-sandbox",
               "--virtual-time-budget=8000",
               "--run-all-compositor-stages-before-draw",
               "--dump-dom", url]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=80)
        html = r.stdout or ""

        tokens = html_to_tokens(html)

        (DATA_DIR / "espn-betting-article.txt").write_text(
            "\n".join(tokens), encoding="utf-8"
        )

        # slice body
        start_idx = 0
        for i, ln in enumerate(tokens):
            if "note: odds by" in (ln or "").lower():
                start_idx = i
                break

        end_idx = len(tokens)
        for i in range(start_idx, len(tokens)):
            if (tokens[i] or "").strip().lower() == "terms of use":
                end_idx = i
                break

        body = tokens[start_idx:end_idx]

        vs_re = re.compile(r'^[+-]\d+(?:\.\d+)?\s+vs\.$')
        vs_only_re = re.compile(r'^vs\.$')
        team_re = re.compile(r'^[A-Z][a-zA-Z0-9 .\'\-]+$')

        for i, ln in enumerate(body):
            is_start = False
            # shape 1: <Away> / <+spread> vs. / <Home>
            if (i + 2 < len(body)
                    and vs_re.match(body[i + 1] or "")
                    and team_re.match(body[i] or "")
                    and team_re.match(body[i + 2] or "")):
                is_start = True
            # shape 2: <Away> / vs. / <Home> / <+spread>
            elif (i + 3 < len(body)
                    and vs_only_re.match(body[i + 1] or "")
                    and team_re.match(body[i] or "")
                    and team_re.match(body[i + 2] or "")
                    and re.match(r'^[+-]\d+(?:\.\d+)?$', body[i + 3] or "")):
                is_start = True

            if is_start:
                print(f"{RED}{'─' * 70}{R}")
            print(ln)

        print(f"{RED}{'═' * 70}{R}")
        return tokens
    except Exception as e:
        print(f"  {RED}ᛉ betting article fail wk{week}: {e}{R}")
        return []
#+--|-------------------------------------------->>>
#+--| paste these two functions: parse_betting_article - 
#+--| parse_betting_article()
#+--|-------------------------------------------->>>
#+--|
def parse_betting_article(tokens, week):
    """
    Placeholder until the real parser lands. Returns empty dict
    so cycle() continues past the odds block and reaches render_games.
    """
    return {}
    """
    Walk the betting-article token stream and pull one odds dict per game.
    Keyed "AwayFull@HomeFull".
    """
    out = {}
    if not tokens:
        return out

    NICK_TO_FULL = {}
    for nick, full in NFL_TEAMS.items():
        NICK_TO_FULL[nick] = full
        NICK_TO_FULL[full.split()[-1]] = full

    def resolve(name):
        name = (name or "").strip()
        if name in NICK_TO_FULL:
            return NICK_TO_FULL[name]
        last = name.split()[-1] if name else ""
        return NICK_TO_FULL.get(last, name)

    i = 0
    n = len(tokens)
    while i < n:
        line = tokens[i]
        m = _BET_HEADER_RE.match(line)
        if not m:
            i += 1
            continue

        if m.group(1):
            away_raw, away_spr, home_raw = m.group(1), float(m.group(2)), m.group(3)
            home_spr = -away_spr
        else:
            away_raw, home_raw, home_spr = m.group(4), m.group(5), float(m.group(6))
            away_spr = -home_spr

        away = resolve(away_raw)
        home = resolve(home_raw)
        key  = f"{away}@{home}"

        a_ml = h_ml = total = None
        j = i + 1
        while j < n and j - i < 14:
            t = tokens[j]
            mm = _ML_RE.search(t)
            if mm:
                ml_a_name, ml_a_val, ml_b_name, ml_b_val = mm.groups()
                if resolve(ml_a_name) == away:
                    a_ml, h_ml = int(ml_a_val), int(ml_b_val)
                else:
                    a_ml, h_ml = int(ml_b_val), int(ml_a_val)
            mt = _TOT_RE.search(t)
            if mt:
                total = float(mt.group(1))
            if a_ml is not None and total is not None:
                break
            j += 1

        out[key] = {
            "away": away, "home": home,
            "away_spread": away_spr, "home_spread": home_spr,
            "total": total,
            "away_ml": a_ml, "home_ml": h_ml,
        }
        i = j
        continue

    return out

