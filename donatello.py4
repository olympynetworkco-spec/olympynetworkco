# ─── APPEND NODE (append-only + dedupe) ───
def append_node(change, game):
    key = f"{change['away']}@{change['home']}"
    sig = f"{change['old']}→{change['new']}"
    if last_node_sig.get(key) == sig:
        return
    last_node_sig[key] = sig
    line = (f"{datetime.now().isoformat()} | {key} | "
            f"{change['old']}→{change['new']} | "
            f"{game.get('status','')} | edge+{game.get('edge',0)} {game.get('animal','')}")
    with open(NODES_FILE, "a", encoding="utf-8") as f:
        f.write(line + "\n")
    print(f"  {ORG}🦄 NODE: {line}{R}")
