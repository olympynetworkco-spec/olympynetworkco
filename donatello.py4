def grip_pbp_game(url, quiet=True):
    """
    Grip a single ESPN play-by-play URL and dump tokens to nfl-playbyplay.json.
    Parallel to grip_pinned_game() but for the /playbyplay/_/gameId/ page.
    """
    if not url:
        return None
    try:
        cmd = [CHROME, "--headless=new", "--disable-gpu", "--no-sandbox",
               "--dump-dom", url]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
        html = r.stdout or ""

        text = re.sub(r'<script[^>]*>.*?</script>', ' ', html, flags=re.DOTALL)
        text = re.sub(r'<style[^>]*>.*?</style>', ' ', text, flags=re.DOTALL)
        text = re.sub(r'<[^>]+>', '\n', text)
        tokens = [t.strip() for t in text.split('\n') if t.strip()]

        payload = {
            "source": "espn-playbyplay",
            "url": url,
            "fetched_at": datetime.now().isoformat(),
            "rendered_bytes": len(html),
            "total_tokens": len(tokens),
            "tokens": tokens,
        }
        with open(PINNED_PBP_FILE, "w", encoding="utf-8") as f:
            json.dump(payload, f, indent=2)
        # also write a per-gameId copy
        m = re.search(r'/gameId/(\d+)', url)
        if m:
            per_game = DATA_DIR / f"nfl-playbyplay-{m.group(1)}.json"
            with open(per_game, "w", encoding="utf-8") as f:
                json.dump(payload, f, indent=2)

        if not quiet:
            print(f"  {RED}🎬 PBP: {len(tokens)} tokens → nfl-playbyplay.json{R}")
        return tokens
    except Exception as e:
        print(f"  {RED}🎬 pbp grip fail: {e}{R}")
        return None
