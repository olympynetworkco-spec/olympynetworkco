def check_bet_signals(games):
    for g in games:
        key  = f"{g['away']}@{g['home']}"
        edge = g.get("edge", 0)
        status = g.get("status", "")

        # Print every game to terminal
        print(f"  {RED}ᛉ POST MORTEM BULLETS MEMORY: {key}  edge +{edge}  "
              f"{g.get('animal','')}  proj {g.get('predicted',0)}  "
              f"{status}{R}")

        # ONLY notify if Edge is high AND game is live (not Scheduled/Final)
        is_live = "Final" not in status and "Scheduled" not in status
        if edge >= 60.0 and is_live:
            if prime_fired.get(key) == edge:
                continue
            prime_fired[key] = edge

            notify(
                "🦄 TOP BULLET",
                f"{g['away']} @ {g['home']}",
                f"edge {edge}% · {g.get('animal','')}"
            )
            CYCLE_STATS["signals"] += 1
            log(f"BET SIGNAL {key} edge {edge} {g.get('animal','')}")
