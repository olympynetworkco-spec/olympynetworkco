#+--| parse odds parse odds parse_odds_game()
#+--|-------------------------------------------->>>
#+--|

def parse_odds_game(tokens, away, home):
    """
    Parse the Game Odds table from an ESPN game page dump.
    Reads the flat-text section after 'Game Odds' and pulls
    the first block of odds tokens it finds.
    """
    out = {
        "away": away, "home": home,
        "away_spread": None, "home_spread": None,
        "total": None, "away_ml": None, "home_ml": None,
        "over_odds": -110, "under_odds": -110,
    }
    if not tokens:
        return out

    html = tokens[0]

    # strip tags, keep text
    text = re.sub(r'<script[^>]*>.*?</script>', ' ', html, flags=re.DOTALL)
    text = re.sub(r'<style[^>]*>.*?</style>', ' ', text, flags=re.DOTALL)
    text = re.sub(r'<[^>]+>', '\n', text)
    lines = [l.strip() for l in text.split('\n') if l.strip()]

    # find "Game Odds" (case-insensitive)
    start = None
    for i, l in enumerate(lines):
        if "game odds" in l.lower():          # was: l.lower() == "game odds"
            start = i
            break

    if start is None:
        print(f"  {DIM}odds · per-game page has no Game Odds block · "
              f"falling through to week article{R}")
        return out

    # scan the next ~40 lines for odds tokens
    tail = lines[start:start+40]

    # walk: after each team name row, gather that row's odds numbers
    # ESPN order per row: openTotal openJuice spread spreadJuice total totalJuice ml
    ODDS = re.compile(r'^[+-]?\d+(\.\d+)?$|^[ou]\d+(\.\d+)?$')
    rows = []
    cur = []
    for l in tail:
        if ODDS.match(l):
            cur.append(l)
        else:
            if cur:
                rows.append(cur)
                cur = []
    if cur:
        rows.append(cur)

    # need at least two rows (away and home)
    if len(rows) < 2:
        print(f"  [odds] only {len(rows)} odds rows found — need 2")
        return out

    a_nums = rows[0]
    h_nums = rows[1]

    def pick(nums):
        spr = None
        tot = None
        ml  = None
        for x in nums:
            if spr is None and re.match(r'^[+-]\d+\.\d+$', x):
                spr = float(x)
                continue
            if tot is None and re.match(r'^[ou]\d+(\.\d+)?$', x):
                tot = float(x[1:])
                continue
            if re.match(r'^[+-]\d{3}$', x):
                ml = int(x)
        return spr, tot, ml

    a_spr, a_tot, a_ml = pick(a_nums)
    h_spr, h_tot, h_ml = pick(h_nums)

    out["away_spread"] = a_spr
    out["home_spread"] = h_spr
    out["total"]       = a_tot or h_tot
    out["away_ml"]     = a_ml
    out["home_ml"]     = h_ml

    print(f"  [odds] {away.split()[-1][:3].upper()} row: {a_nums}")
    print(f"  [odds] {home.split()[-1][:3].upper()} row: {h_nums}")
    print(f"  [odds] → {out['away_spread']} / {out['home_spread']}  "
          f"O/U {out['total']}  ML {out['away_ml']}/{out['home_ml']}")
    return out
