#+--|-------------------------------------------->>>
#+--|
# ─── PARSE ESPN SCOREBOARD ───
# ─── PARSE ESPN SCOREBOARD TOKENS ───
def parse_games(html):
    """
    Walk ESPN scoreboard tokens.

    Finished / live games look like:
        1  2  3  4  T
        AwayNick ( W-L [Away] ) aQ1 aQ2 aQ3 aQ4 aT
        HomeNick ( W-L [Home] ) hQ1 hQ2 hQ3 hQ4 hT

    Scheduled games look like:
        AwayNick ( W-L x-y Away )
        HomeNick ( W-L x-y Home )
    """
    if not html:
        return []

    # accept either raw html or an already-flattened token list
    if isinstance(html, list):
        tokens = html
    else:
        text = re.sub(r'<script[^>]*>.*?</script>', ' ', html, flags=re.DOTALL)
        text = re.sub(r'<style[^>]*>.*?</style>', ' ', text, flags=re.DOTALL)
        text = re.sub(r'<[^>]+>', '\n', text)
        tokens = [t.strip() for t in text.split('\n') if t.strip()]

    NICK_TO_FULL = {nick: full for nick, full in NFL_TEAMS.items()}
    # also allow "Washington" style city-only keys
    for nick, full in NFL_TEAMS.items():
        NICK_TO_FULL[full] = full
        NICK_TO_FULL[full.split()[-1]] = full

    def nick(t):
        return NICK_TO_FULL.get(t)

    def is_int(t):
        return t.isdigit() and len(t) <= 3

    games = []
    seen  = set()

    i = 0
    n = len(tokens)
    while i < n:
        # ── FINISHED / LIVE: anchor on 1 2 3 4 T ──
        if (i + 4 < n and tokens[i] == "1" and tokens[i+1] == "2"
                and tokens[i+2] == "3" and tokens[i+3] == "4"
                and tokens[i+4] == "T"):
            j = i + 5
            # skip any junk until first team nick
            away = home = None
            while j < n and away is None:
                away = nick(tokens[j])
                if away is None:
                    j += 1
            if away is None:
                i += 5
                continue

            # walk through record fields to the 5 away quarter numbers
            away_q = []
            k = j
            while k < n and len(away_q) < 5:
                if is_int(tokens[k]):
                    away_q.append(int(tokens[k]))
                k += 1
                if k - j > 20:
                    break
            if len(away_q) < 5:
                i += 5
                continue

            # next team = home
            while k < n and home is None:
                home = nick(tokens[k])
                if home is None:
                    k += 1
            if home is None:
                i += 5
                continue

            home_q = []
            while k < n and len(home_q) < 5:
                if is_int(tokens[k]):
                    home_q.append(int(tokens[k]))
                k += 1
                if k - j > 40:
                    break
            if len(home_q) < 5:
                i += 5
                continue

            away_score = str(away_q[4])
            home_score = str(home_q[4])

            key = f"{away}@{home}"
            if key not in seen:
                seen.add(key)
                games.append({
                    "away": away, "home": home,
                    "away_score": away_score,
                    "home_score": home_score,
                    "status": "Final",
                    "week": None,
                    "line": None, "total": None,
                    "away_odds": None, "home_odds": None,
                    "away_qb": "TBD", "home_qb": "TBD",
                    "q_breakdown": {
                        "away": away_q,
                        "home": home_q,
                    },
                })
            i = k
            continue



        # ── SCHEDULED: two nicknames, each followed by ( ... Away|Home ) ──
        a = nick(tokens[i])
        if a and i + 1 < n and tokens[i+1] == "(":
            # scan ahead a few tokens for Away or Home tag
            tag = None
            j = i + 1
            while j < n and j - i < 10:
                if tokens[j] in ("Away", "Home"):
                    tag = tokens[j]
                    break
                j += 1
            if tag == "Away":
                # find the matching Home a bit later
                home = None
                h = j
                while h < n and h - i < 30:
                    hh = nick(tokens[h])
                    if hh and tokens[h+1:h+2] == ["("]:
                        # verify Home tag follows within a few tokens
                        for z in range(h+1, min(h+8, n)):
                            if tokens[z] == "Home":
                                home = hh
                                break
                    if home:
                        break
                    h += 1
                if home:
                    key = f"{a}@{home}"
                    if key not in seen:
                        seen.add(key)
                        games.append({
                            "away": a, "home": home,
                            "away_score": "0", "home_score": "0",
                            "status": "Scheduled",
                            "week": None,
                            "line": None, "total": None,
                            "away_odds": None, "home_odds": None,
                            "away_qb": "TBD", "home_qb": "TBD",
                        })
                    i = h
                    continue
        i += 1

    return games


#+--|-------------------------------------------->>>
#+--| add-on function 4 — parse_pinned_score()
#+--| reads the Q1 Q2 Q3 Q4 [OT] T header row
#+--|-------------------------------------------->>>

def parse_pinned_score(tokens, away, home, scoreboard=None, overtime=False):
    """
    Pull the live score + clock + quarter from a pinned ESPN game-page token dump.
    Returns {"away_score": int, "home_score": int, "status": str,
             "q_breakdown": {"away": [...], "home": [...]}} or {} if not found.
    """
    if not tokens:
        return {}

    n = len(tokens)

    # ── find the header row: 1 2 3 4 [OT] T ──
    hdr = None
    i = 0
    while i < n - 4:
        if (tokens[i] == "1" and tokens[i+1] == "2"
                and tokens[i+2] == "3" and tokens[i+3] == "4"):
            k = i + 4
            while k < n and not tokens[k]:
                k += 1
            if k < n and tokens[k] == "OT":
                hdr = {"start": i, "ot": True, "cols": 6}
            elif k < n and tokens[k] == "T":
                hdr = {"start": i, "ot": False, "cols": 5}
            if hdr:
                break
        i += 1

    if hdr is None:
        return {}

    # ── how many ints to collect per team ──
    # ESPN emits per team:  Q1 Q2 Q3 Q4  T          (header "1 2 3 4 T")
    #                       Q1 Q2 Q3 Q4 OT T        (header "1 2 3 4 OT T")
    # so we always grab one cell MORE than the number of quarters — that extra
    # cell is the T column and must NOT be summed.
    per_team = 6 if hdr["ot"] else 5
    total_needed = per_team * 2

    j = hdr["start"] + hdr["cols"]
    nums = []
    while j < n and len(nums) < total_needed:
        t = tokens[j]
        if t.isdigit() and len(t) <= 3:
            nums.append(int(t))
        j += 1
        if j - hdr["start"] > 80:
            break

    if len(nums) < total_needed:
        return {}

    away_cells = nums[0:per_team]         # Q1 Q2 Q3 Q4 [OT] T
    home_cells = nums[per_team:per_team*2]

    # quarters = every cell except the last (the T column)
    away_q = away_cells[:-1]
    home_q = home_cells[:-1]

    # ── always return a 5-slot breakdown so downstream code is stable ──
    away_q = away_q + [0] * (5 - len(away_q))
    home_q = home_q + [0] * (5 - len(home_q))

    away_total = sum(away_q)
    home_total = sum(home_q)

    # ── clock + quarter (live games) ──
    status = ""
    for k, t in enumerate(tokens):
        m = re.match(r'^(\d{1,2}:\d{2})$', t)
        if m:
            for q in range(k + 1, min(k + 5, n)):
                qm = re.match(r'^(1st|2nd|3rd|4th|OT)$', tokens[q])
                if qm:
                    status = f"{qm.group(1)} {m.group(1)}"
                    break
            if status:
                break

    if not status:
        for t in tokens:
            if t == "Final":
                status = "Final"
                break

    return {
        "away_score":  away_total,
        "home_score":  home_total,
        "status":      status or "Live",
        "q_breakdown": {"away": away_q, "home": home_q},
    }
#+--|-------------------------------------------->>>
#+--| add-on function 4 as 
#+--| much functions here in compute_edge()
#+--|-------------------------------------------->>>
#+--|
import math

def compute_edges(games):
    for g in games:
        try:
            a = int(g["away_score"]); h = int(g["home_score"])
        except (ValueError, KeyError, TypeError):
            g.update({"win_loss": 0, "spring": 0.0, "predicted": 22.5,
                      "edge": 0.0, "animal": "DRAGON", "animal_abbr": "DRG",
                      "animal_tier": 4, "prime": False, "key_number": None})
            continue

        # 1. WIN / LOSS
        diff = h - a

        # 2. SPRING (Mx¨(t) + fvx˙(t) + Kx(t) = f(t))
        spring = diff * 0.4 + (h + a) * 0.05

        # 3. PREDICTION (85th % Percentile of L10)
        predicted = round(22.5 + diff * 0.6, 1)

        # 4. PROBABILITY (Z = (Odd Line - Spring) / 4)
        odd_line = g.get("home_spread")
        
        if odd_line is None:
            # If no line, edge is 0.0 (no false signals)
            edge = 0.0
        else:
            # Z-Score
            z = (odd_line - spring) / 4.0
            
            # Φ(Z) - Standard Normal CDF
            phi_z = 0.5 * (1.0 + math.erf(z / math.sqrt(2.0)))
            
            # Edge = Φ(Z) * 100 (Convert to percentage)
            edge = round(phi_z * 100, 1)

        # 5. KEY NUMBERS (from your JSON: [3, 7, 10, 14])
        key_numbers = [3, 7, 10, 14]
        absdiff = abs(diff)
        nearest = min(key_numbers, key=lambda k: abs(absdiff - k))
        distance = abs(absdiff - nearest)

        # 6. ANIMAL (winProb = 0.50 + (margin * 0.20))
        win_prob = 0.50 + (absdiff * 0.20)
        win_prob_pct = min(99.0, win_prob * 100)

        animal = "DRAGON"
        animal_abbr = "DRG"
        animal_tier = 4
        for lo, hi, abbr, name, tier in ANIMAL_BANDS:
            if lo <= win_prob_pct < hi:
                animal      = name
                animal_abbr = abbr
                animal_tier = tier
                break

        g["win_loss"]    = diff
        g["spring"]      = round(spring, 2)
        g["predicted"]   = predicted
        g["edge"]        = edge
        g["key_number"]  = nearest if distance <= 0.5 else None
        g["animal"]      = animal
        g["animal_abbr"] = animal_abbr
        g["animal_tier"] = animal_tier
        g["prime"]       = (edge >= 70.0 and animal in
                            ("SCORPION", "EAGLE", "VULTURE", "CROW", "LYNX"))
#+--|-------------------------------------------->>>
#+--| add-on function 5 as much functions 
