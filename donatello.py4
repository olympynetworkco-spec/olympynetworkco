#+--|
def write_game_odds(games):
    """
    Write edge data to edge-projection.txt AND game_odds.json, and print the txt.
    """
    import json as _json

    rows = []
    for g in games:
        rows.append({
            "away":        g["away"],
            "home":        g["home"],
            "away_score":  g.get("away_score", "0"),
            "home_score":  g.get("home_score", "0"),
            "edge":        g.get("edge", 0),
            "key_number":  g.get("key_number"),
            "animal":      g.get("animal", ""),
            "win_loss":    g.get("win_loss", 0),
            "spring":      g.get("spring", 0.0),
            "predicted":   g.get("predicted", 0.0),
            "prime":       g.get("prime", False),
        })

    # ── txt ──
    lines = [f"# game_odds · {datetime.now().isoformat()}"]
    for r in rows:
        lines.append(
            f"{r['away']} @ {r['home']} | "
            f"{r['away_score']}-{r['home_score']} | "
            f"edge +{r['edge']} | "
            f"kn {r['key_number'] if r['key_number'] is not None else '—'} | "
            f"{r['animal']} | "
            f"diff {r['win_loss']:+d} | "
            f"spring {r['spring']} | "
            f"proj {r['predicted']}"
            + (" | ★ PRIME" if r["prime"] else "")
        )
    GAME_ODDS_FILE.write_text("\n".join(lines) + "\n", encoding="utf-8")

    # ── json ──
    payload = {
        "source":      "donatello-edge",
        "fetched_at":  datetime.now().isoformat(),
        "total_games": len(rows),
        "games":       rows,
    }
    GAME_ODDS_JSON_FILE.write_text(
        _json.dumps(payload, indent=2), encoding="utf-8"
    )

    # ── print it so you can see it ──
    print(f"\n  {RED}══ edge-projection.txt ══{R}")
    for ln in lines:
        print(f"  {DIM}{ln}{R}")
    print()
