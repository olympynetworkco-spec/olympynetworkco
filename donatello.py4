#+--|
def grip_pinned_game(url, quiet=True):
    """
    Grip a single ESPN game URL and dump its DOM tokens to nfl-pinned.json.
    Doesn't parse anything yet — dumps the tokens so we can find the WP
    value in the DOM and build the real extractor.
    """
    if not url:
        return None
    try:
        cmd = [CHROME, "--headless=new", "--disable-gpu", "--no-sandbox",
               "--dump-dom", url]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
        html = r.stdout or ""


        # save raw for debugging
        (DATA_DIR / "espn-odds-raw.html").write_text(html, encoding="utf-8")        
        tokens = [html]

        payload = {
            "source": "espn-pinned",
            "url": url,
            "fetched_at": datetime.now().isoformat(),
            "rendered_bytes": len(html),
            "total_tokens": len(tokens),
            "tokens": tokens,   # full list — we grep this to find WP
        }
        with open(PINNED_FILE, "w", encoding="utf-8") as f:
            json.dump(payload, f, indent=2)

        # also scan for anything that looks like a WP value right now
        wp_hits = []
        for i, t in enumerate(tokens):
            if re.match(r'^\d{1,3}\.\d$', t):        # e.g. "73.1"
                wp_hits.append((i, t, tokens[i-1] if i > 0 else ""))
        if not quiet:
            print(f"  {RED}📌 PINNED: {len(tokens)} tokens → nfl-pinned.json{R}")
            if wp_hits:
                print(f"  {RED}📌 possible WP values (idx, val, prev):{R}")
                for idx, val, prev in wp_hits[:6]:
                    print(f"      [{idx}] {val}  ← prev: {prev!r}")
        return tokens
    except Exception as e:
        print(f"  {RED}📌 pinned fail: {e}{R}")
        return None

