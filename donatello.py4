def stamp_game_status(games):
    """
    Enrich each game with:
      - game_id     : ESPN gameId if known (from PINNED_GAMES / ODDS_GAMES)
      - status_tag  : colorized [LIVE Q3 08:42] / [FINAL] / [SCHEDULED]
      - is_today    : True if game date == today
    Falls back gracefully if we don't have the ESPN id for a game.
    """
    # colorize everything purple for now — RED from the top of the file
    def _tag(text):
        return f"{RED}{text}{R}"

    # build a lookup of espn id by "Away@Home" from pinned + odds configs
    id_lookup = {}
    for src in (PINNED_GAMES, ODDS_GAMES):
        for entry in src:
            url = entry.get("url", "")
            m = re.search(r'/gameId/(\d+)', url)
            if not m:
                continue
            key = f"{entry['away']}@{entry['home']}"
            id_lookup[key] = m.group(1)

    for g in games:
        key = f"{g['away']}@{g['home']}"
        g["game_id"] = id_lookup.get(key)

        status = (g.get("status") or "").strip()

        # classify — all purple for now
        if "Final" in status:
            g["status_tag"] = _tag("[FINAL]")
            g["is_live"]    = False
        elif re.match(r'^(Q[1-4]|OT|Halftime|HALF)', status) or ":" in status:
            g["status_tag"] = _tag(f"[LIVE {status}]")
            g["is_live"]    = True
        elif "Scheduled" in status or not status:
            g["status_tag"] = _tag("[SCHEDULED]")
            g["is_live"]    = False
        else:
            g["status_tag"] = _tag(f"[{status}]")
            g["is_live"]    = False

        # today tag — purple too
        g["is_today"] = g.get("is_live", False) or g.get("status_tag", "").find("SCHEDULED") != -1


