# ─── RENDER GAME ROW WITH SPINNER ───

def render_games(games):
    divider = f"{DIM}{'─' * 78}{R}"
    pinned_keys = {f"{p['away']}@{p['home']}" for p in PINNED_GAMES}
    for g in games:
        key = f"{g['away']}@{g['home']}"
        # ONLY render the pinned game(s). Skip everything else.
        if key not in pinned_keys:
            continue

        print(f"  {divider}")
        status = g.get("status", "")
        is_final  = "Final" in status
        is_live   = not is_final and "Scheduled" not in status and "vs" not in status
        is_pinned = g.get("wp_home") is not None
        try:
            a_int = int(g["away_score"]); h_int = int(g["home_score"])
        except (ValueError, KeyError, TypeError):
            a_int = h_int = 0

        away_name = g["away"]
        home_name = g["home"]
        if is_live:
            if a_int > h_int:
                away_name = f"{RED_BOLD}{g['away']}{R}"
            elif h_int > a_int:
                home_name = f"{RED_BOLD}{g['home']}{R}"

        edge   = g.get("edge", 0)
        animal = g.get("animal", "")
        gid    = g.get("game_id")
        id_tag = f"{DIM}#{gid}{R} " if gid else ""
        stat_tag = g.get("status_tag", "") + " "
        today_tag = f"{RED}ᛉ TODAY {R}" if g.get("is_today") else ""
        edge_tag = f"{stat_tag}{id_tag}{today_tag}{RED_BOLD}[edge+{edge}]{R} "
        prime  = "🦄" if g.get("prime") else "  "
        kn     = g.get("key_number")
        kntag  = f"🦄{kn}" if kn else "   "
        wp_away_tag = wp_home_tag = ""
        if is_pinned:
            if g.get("wp_away") is not None:
                wp_away_tag = f" {RED}[{g['wp_away']}%]{R}"
            if g.get("wp_home") is not None:
                wp_home_tag = f" {RED}[{g['wp_home']}%]{R}"

        if is_pinned and g.get("away_spread") is not None:
            ab = g["away"].split()[-1][:3].upper()
            hb = g["home"].split()[-1][:3].upper()
            print(f"       {RED}ᛉ{R} {DIM}"
                  f"{ab} {g['away_spread']:+.1f}  ·  "
                  f"O/U {g['total']}  ·  "
                  f"ML {g['away_ml']:+d}/{g['home_ml']:+d}  ·  "
                  f"{hb} {g['home_spread']:+.1f}{R}")

        def pad(name):
            visible = re.sub(r'\033\[[0-9;]*m', '', name)
            return name + ' ' * max(0, 22 - len(visible))


        print(f"    {edge_tag} {pad(away_name)} [{g['away_score']}]{wp_away_tag} - "

              f"[{g['home_score']}]{wp_home_tag} {pad(home_name)} "
              f"{prime} {kntag} {animal}")


