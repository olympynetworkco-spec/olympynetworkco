def grip_odds_game(url, quiet=False):
    """
    Grip a single ESPN odds game URL, dump tokens to nfl-odds.json.
    Parallel to grip_pinned_game() but for the /odds/_/gameId/ page.
    """
    if not url:
        return None
    try:
        cmd = [CHROME, "--headless=new", "--disable-gpu", "--no-sandbox",
               "--virtual-time-budget=8000",
               "--run-all-compositor-stages-before-draw",
               "--dump-dom", url]



        r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
        html = r.stdout or ""

        text = re.sub(r'<script[^>]*>.*?</script>', ' ', html, flags=re.DOTALL)
        text = re.sub(r'<style[^>]*>.*?</style>', ' ', text, flags=re.DOTALL)
        text = re.sub(r'<[^>]+>', '\n', text)
        tokens = [t.strip() for t in text.split('\n') if t.strip()]

        # preserve any existing odds payload if the file already has one
        existing = {"source": "espn-odds", "games": []}
        try:
            existing = json.loads(ODDS_NFL_FILE.read_text(encoding="utf-8"))
        except Exception:
            pass

        existing["url"]        = url
        existing["fetched_at"] = datetime.now().isoformat()
        existing["rendered_bytes"] = len(html)
        existing["total_tokens"]   = len(tokens)
        existing["tokens"]         = tokens

        with open(ODDS_NFL_FILE, "w", encoding="utf-8") as f:
            json.dump(existing, f, indent=2)

        if not quiet:
            print(f"  {RED}ᛉ ODDS GRIP: {len(tokens)} tokens → nfl-odds.json{R}")
        return tokens
    except Exception as e:
        print(f"  {RED}ᛉ odds grip fail: {e}{R}")
        return None
