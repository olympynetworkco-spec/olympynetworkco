_ODDS_RECORD_RE = re.compile(r'^\(\d+-\d+.*\)$')
_ODDS_SPREAD_RE = re.compile(r'^([A-Z]{2,4})\s+([+-]?\d+(?:\.\d+)?)$')
#+--|-------------------------------------------->>>

def parse_odds_page(tokens):
    """
    Parse ESPN /nfl/odds page tokens into per-game dicts.

    Real Week-6 shape:
        Seattle Seahawks
        (3-2, 2-1 Away)
        -2.5        open
        -105        open juice
        -3          spread
        -102        spread juice
        o40.5       total (over)
        -118        total juice
        -155        ML
        Denver Broncos
        (3-2, 2-0 Home)
        u43.5       ← under total leaks onto home row
        -110
        +3
        -118
        u40.5
        -102
        +130

    So: anchor on <TeamName> + (W-L ...), grab up to 12 tokens after
    the record until the next <TeamName>+(W-L ...), then classify:
        ^[+-]\\d{3,4}$        → ML      (|v| >= 100)
        ^[ou]\\d+(\\.\\d+)?$   → total
        ^[+-]\\d+(\\.\\d+)?$   → spread  (first signed small num)
        ^-1\\d{2}$            → juice   (ignored)
    """
    if not tokens:
        return []

    NAME_RE   = re.compile(r'^[A-Za-z][A-Za-z0-9 .\'\-]+$')
    RECORD_RE = re.compile(r'^\(\d+-\d+.*\)$')
    SPREAD_RE = re.compile(r'^[+-]\d+(?:\.\d+)?$')
    TOTAL_RE  = re.compile(r'^[ou]\d+(?:\.\d+)?$', re.I)
    ML_RE     = re.compile(r'^[+-]\d{3,4}$')
    JUICE_RE  = re.compile(r'^-1\d{2}$')


    def classify(block):
        spread = total = ml = None
        ml_candidates = []
        for x in block:
            x = x.strip()
            if not x:
                continue
            # total: o40.5 / u43.5
            if TOTAL_RE.match(x) and total is None:
                total = float(x[1:])
                continue
            # spread: signed number with abs < 100 (excludes -155, +130)
            if SPREAD_RE.match(x) and abs(float(x)) < 100 and spread is None:
                spread = float(x)
                continue
            # ML: signed 3-4 digit token — collect all, take last
            if ML_RE.match(x):
                ml_candidates.append(int(x))
        if ml_candidates:
            ml = ml_candidates[-1]
        return spread, total, ml


    def is_team_start(i):
        return (i + 1 < len(tokens)
                and NAME_RE.match(tokens[i] or "")
                and RECORD_RE.match(tokens[i+1] or ""))

    games = []
    i, n = 0, len(tokens)
    while i < n - 1:
        if not is_team_start(i):
            i += 1
            continue

        away_name = tokens[i].strip()
        away_rec  = tokens[i+1].strip()

        # collect away block until next team start
        away_block = []
        j = i + 2
        while j < n - 1 and len(away_block) < 14:
            if is_team_start(j):
                break
            away_block.append(tokens[j])
            j += 1

        # must be followed by a home team
        if not is_team_start(j):
            i += 1
            continue

        home_name = tokens[j].strip()
        home_rec  = tokens[j+1].strip()

        home_block = []
        k = j + 2
        while k < n - 1 and len(home_block) < 14:
            if is_team_start(k):
                break
            home_block.append(tokens[k])
            k += 1

        a_spread, a_total, a_ml = classify(away_block)
        h_spread, h_total, h_ml = classify(home_block)

        # ESPN leaks the under onto the home row — pick whichever side got it
        total = a_total if a_total is not None else h_total
        if total is None:
            i = k
            continue

        games.append({
            "away":        away_name,
            "away_record": away_rec,
            "away_spread": a_spread,
            "away_total":  a_total,
            "away_ml":     a_ml,
            "home":        home_name,
            "home_record": home_rec,
            "home_spread": h_spread,
            "home_total":  h_total,
            "home_ml":     h_ml,
            "total":       total,
        })
        i = k

    return games
#+--|-------------------------------------------->>>
#+--| add-on function 21 : RAPHAEL GRIP — parse single-game odds
#+--|-------------------------------------------->>>
#+--|
SPREAD_RE   = re.compile(r'^[+-]\d+(\.\d+)?$')
OVER_RE     = re.compile(r'^o\d+(\.\d+)?$')
UNDER_RE    = re.compile(r'^u\d+(\.\d+)?$')
ML_RE       = re.compile(r'^[+-]\d{2,4}$')     # ML always |v| >= 100


