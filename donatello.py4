# ─── FIELD GRAPH GLYPHS (render_sparkline) ───
# The field is 4 quarter columns × 2 lanes (away top, home bottom).
# Skeleton is +--+--+--+--+ per lane, mid divider matches with + tracks.
FIELD_AWAY_LABEL = f"{DIM}away {R}"     # left gutter, away lane
FIELD_HOME_LABEL = f"{DIM}home {R}"     # left gutter, home lane
FIELD_GUTTER     = f"{DIM}     {R}"     # 5-space blank gutter (mid + labels)
FIELD_track       = f"{DIM}+{R}"         # quarter boundary track
FIELD_RAIL       = f"{DIM}-{R}"         # field rail between tracks
FIELD_MARK_AWAY  = "\033[94m🏉\033[0m"   # away score mark (blue)
FIELD_MARK_HOME  = "\033[91m🏉\033[0m"   # home score mark (red)
FIELD_MARK_TIE   = "\033[90m🏉\033[0m"   # tie score mark (grey)
FIELD_LABEL_Q    = f"{DIM}Q{{n}}{R}"    # quarter label template

def _read_timeline_for(key):
    """Read the last N samples for a game key from nfl-timeline.json."""
    try:
        data = json.loads(TIMELINE_FILE.read_text(encoding="utf-8"))
        return data.get("games", {}).get(key, [])
    except Exception:
        return []
#+--|-------------------------------------------->>>
#+--| render_sparkline()
#+--|-------------------------------------------->>>
#+--|
Q_COL = {"Q1": 0, "Q2": 1, "Q3": 2, "Q4": 3}

def render_sparkline(key, game=None, max_dots=24):
    events = []

    # source 1: live score-change log
    try:
        for line in NODES_FILE.read_text(encoding="utf-8").splitlines():
            parts = [p.strip() for p in line.split("|")]
            if len(parts) < 4 or parts[1] != key:
                continue
            old, _, new = parts[2].partition("→")
            oa, oh = map(int, old.split("-")); na, nh = map(int, new.split("-"))
            q = None
            for qk in ("Q1","Q2","Q3","Q4"):
                if qk in parts[3]: q = qk; break
            if q is None and "Final" in parts[3]: q = "Q4"
            if q is None: continue
            team = "away" if na > oa else "home" if nh > oh else None
            if team: events.append({"q": q, "team": team})
    except Exception:
        pass

    # source 2: quarter breakdown from the game itself
    if not events and game:
        qb = game.get("q_breakdown")
        if qb and "away" in qb and "home" in qb:
            for i, qk in enumerate(["Q1","Q2","Q3","Q4"]):
                if qb["away"][i] > 0: events.append({"q": qk, "team": "away"})
                if qb["home"][i] > 0: events.append({"q": qk, "team": "home"})

    width = 62
    col_w = width // 4

    away_row = list(" " * width)
    home_row = list(" " * width)

    for q_i in range(4):
        start = q_i * col_w
        for i in range(col_w):
            if start + i >= width: break
            ch = "+" if i == 0 else "-"
            away_row[start + i] = ch
            home_row[start + i] = ch

    col_use = {"away": [0, 0, 0, 0], "home": [0, 0, 0, 0]}
    for ev in events:
        q_i = Q_COL[ev["q"]]
        offset = col_use[ev["team"]][q_i]
        pos = q_i * col_w + 2 + offset * 3
        if pos < width:
            mark = FIELD_MARK_AWAY if ev["team"] == "away" else FIELD_MARK_HOME
            (away_row if ev["team"] == "away" else home_row)[pos] = mark
        col_use[ev["team"]][q_i] += 1

    mid_chars = list("-" * width)
    for q_i in range(4):
        pos = q_i * col_w
        if pos < width: mid_chars[pos] = "+"
    mid = "".join(mid_chars)

    q_labels = ""
    for lbl, start in zip(["[Q1]", "[Q2]", "[Q3]", "[Q4]"],
                          [i * col_w for i in range(4)]):
        q_labels += " " * max(0, start - len(q_labels)) + lbl

    return (FIELD_AWAY_LABEL + "".join(away_row) + "\n" +
            FIELD_GUTTER     + mid            + "\n" +
            FIELD_HOME_LABEL + "".join(home_row) + "\n" +
            FIELD_GUTTER     + q_labels)

#+--|-------------------------------------------->>>
#+--| render_field_description()
#+--|-------------------------------------------->>>
#+--|

def render_field_description(key):
    state = {}
    try:
        for line in PINNED_FILE.read_text(encoding="utf-8").splitlines():
            if line.startswith("state."):
                k, _, v = line.partition(":")
                state[k.replace("state.", "").strip()] = v.strip() or None
    except Exception:
        pass
    if not state:
        return ""

    parts = []

    dd   = state.get("down_distance")
    spot = state.get("ball_on")
    if dd and spot:
        parts.append(f"{dd} at {spot}")
    elif dd:
        parts.append(dd)

    if state.get("clock") and state.get("quarter"):
        parts.append(f"{state['clock']} {state['quarter']}")

    play = state.get("last_play")
    if play:
        if len(play) > 70:
            play = play[:69] + "…"
        parts.append(play)

    if not parts:
        return ""

    body = " · ".join(parts)
    return f"{ORG}✓ 🎤︎︎{R} {DIM}{body}{R}"

