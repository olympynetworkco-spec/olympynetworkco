#+--| fetch
#+--|-------------------------------------------->>>

def fetch(url, path=None, ttl=600):
    """
    Download url to path if missing or older than ttl seconds.
    If path is None, just fetch fresh (no cache).
    Returns the HTML as a string.
    """
    if path is not None and path.exists():
        age = time.time() - path.stat().st_mtime
        if age < ttl:
            return path.read_text(encoding="utf-8", errors="replace")

    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            html = r.read().decode("utf-8", errors="replace")
    except Exception as e:
        print(f"  {RED}fetch fail {url}: {e}{R}")
        # fall back to whatever's on disk, even if stale
        if path is not None and path.exists():
            return path.read_text(encoding="utf-8", errors="replace")
        return ""

    if path is not None:
        path.write_text(html, encoding="utf-8")
    return html


