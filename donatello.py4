# ─── ODDS TOKEN DETECTOR ───
ODDS_RE = re.compile(r'^[+-]?\d{1,3}(\.\d{1,2})?$')
ODDS_KEYWORDS = {"EVEN", "PK"}

def looks_like_odds(tok):
    if not tok:
        return False
    if tok.upper() in ODDS_KEYWORDS:
        return True
    return bool(ODDS_RE.match(tok))
