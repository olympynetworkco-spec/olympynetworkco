# ─── PARSE PBP TOKENS → structured plays ───
import math, html as _html

PBP_CLOCK_RE = re.compile(r'^(\d{1,2}:\d{2}) - (?:(\d)(?:st|nd|rd|th)|(OT))$')
PBP_SIT_RE   = re.compile(r'^\d(?:st|nd|rd|th) & (?:\d+|Goal) at (?:([A-Z]{2,3}) )?(\d+)$')
PBP_DRIVE_RE = re.compile(r'^(\d+) plays?, (-?\d+) yards?, (\d+:\d+)$')


#+--|-------------------------------------------->>>
#+--| add-on function 17 as much html_to_tokens()
#+--|-------------------------------------------->>>
#+--|

def html_to_tokens(html_text):
    t = re.sub(r'<script[^>]*>.*?</script>', ' ', html_text, flags=re.DOTALL)
    t = re.sub(r'<style[^>]*>.*?</style>', ' ', t, flags=re.DOTALL)
    t = re.sub(r'<[^>]+>', '\n', t)
    return [_html.unescape(x).strip() for x in t.split('\n') if x.strip()]

#+--|-------------------------------------------->>>
#+--| add-on function 17 as much _side_of()
#+--|-------------------------------------------->>>
#+--|

def _side_of(name, away, home):
    last = name.strip().split()[-1].lower() if name.strip() else ""
    if last == away.split()[-1].lower(): return "away"
    if last == home.split()[-1].lower(): return "home"
    return None

#+--|-------------------------------------------->>>
#+--| add-on function 17 as much est_wp_home()
#+--|-------------------------------------------->>>
#+--|

def est_wp_home(a, h, secs, off, z):
    """Rough home win-prob (0-100): score diff + possession value, normal CDF."""
    ep = 0.7
    if off and z is not None:
        y = (z + 50) if off == "away" else (50 - z)       # yards from offense's own goal
        ep = -0.6 + 0.07 * y
    ep *= min(1.0, secs / 600.0)                          # possession matters less late
    eff = (h - a) + (ep if off == "home" else -ep if off == "away" else 0)
    sd = 13.5 * math.sqrt(max(secs, 1) / 3600.0)
    wp = 0.5 * (1 + math.erf(eff / (sd * math.sqrt(2)))) * 100
    return round(max(0.5, min(99.5, wp)), 1)

#+--|-------------------------------------------->>>
#+--| add-on function 17 as much _pts()
#+--|-------------------------------------------->>>
#+--|
def _pts(ty, desc):
    t, d = ty.lower(), desc.lower()
    if "touchdown" in t:
        if "extra point is good" in d: return 7
        if "attempt succeeds" in d:    return 8
        return 6
    if "field goal" in t: return 3
    if "safety" in t:     return 2
    if "extra point" in t: return 1
    return 0

#+--|-------------------------------------------->>>
#+--| add-on function 17 as much parse_pbp_tokens()
#+--|-------------------------------------------->>>
#+--|
def parse_pbp_tokens(tokens, away, home):
    toks = [_html.unescape(t).strip() for t in (tokens or [])]
    n = len(toks)
    away_ab = NFL_ABBRS.get(away.split()[-1].lower(), [away.split()[-1][:3].upper()])
    home_ab = NFL_ABBRS.get(home.split()[-1].lower(), [home.split()[-1][:3].upper()])

    # pass 1 — drive headers: <team> <result> "N plays, N yards, M:SS" <score> <abbr> <score> <abbr>
    drives = []
    for j in range(2, n - 4):
        if not PBP_DRIVE_RE.match(toks[j]):
            continue
        end = None
        try:
            s1, s2 = int(toks[j+1]), int(toks[j+3])
            end = (s2, s1) if toks[j+2] in home_ab else (s1, s2)   # (away, home)
        except ValueError:
            pass
        drives.append({"i": j, "team": toks[j-2], "result": toks[j-1],
                       "side": _side_of(toks[j-2], away, home), "end": end})

    # pass 2 — plays: [type, "M:SS - Nth", desc, situation]
    plays, d, before, ptr = [], None, (0, 0), 0
    for i in range(1, n - 2):
        while ptr < len(drives) and drives[ptr]["i"] < i:
            if d and d["end"]:
                before = d["end"]
            d = drives[ptr]; ptr += 1

        m = PBP_CLOCK_RE.match(toks[i])
        if not m:
            continue
        q = int(m.group(2)) if m.group(2) else 5
        mm, ss = map(int, m.group(1).split(":"))
        clk  = mm * 60 + ss
        secs = clk if q == 5 else (4 - q) * 900 + clk

        ty, desc, sit = toks[i-1], toks[i+1], toks[i+2]
        z = None
        sm = PBP_SIT_RE.match(sit)
        sit_def_ab = None
        if sm:
            y, sit_def_ab = int(sm.group(2)), sm.group(1)
            z = 0 if not sit_def_ab else (50 - y if sit_def_ab in home_ab else -50 + y)
        else:
            sit = ""

        is_score = bool(re.search(r'touchdown|field goal|extra point|safety', ty, re.I)
                        and not re.search(r'no good|blocked|missed', desc, re.I))
        a, h = before
        if is_score and d and d["end"]:
            a, h = d["end"]
        off = None if is_score else (d["side"] if d else None)

        # derive side: drive side first, else infer from the situation string.
        # "4th & 5 at DEN 37" means the ball is on DEN's 37 → DEN is on defense → away has it.
        side = d["side"] if d else None
        if side is None and sit_def_ab:
            if sit_def_ab in home_ab:
                side = "away"
            elif sit_def_ab in away_ab:
                side = "home"

        wp_h = est_wp_home(a, h, secs, off, z)
        plays.append({
            "q": q, "clock": m.group(1), "secs_left": secs, "type": ty,
            "desc": desc[:200], "sit": sit, "z": z, "score": is_score,
            "team": d["team"] if d else "", "drive_result": d["result"] if d else "",
            "away_score": a, "home_score": h,
            "wp_home": wp_h, "wp_away": round(100 - wp_h, 1),
            "side": side,
            "pts":  _pts(ty, desc) if is_score else 0,
            "t_el": ((q - 1) * 900 + (900 - clk)) if q <= 4 else (3600 + 600 - clk),
        })

    # live pages list newest-first → flip to game order, then rebuild score + WP
    if len(plays) > 1 and plays[0]["t_el"] > plays[-1]["t_el"]:
        plays.reverse()
    plays.sort(key=lambda p: p["t_el"])          # stable
    a = h = 0
    for p in plays:
        if p["score"] and p["side"]:
            if p["side"] == "away": a += p["pts"]
            else:                   h += p["pts"]
        p["away_score"], p["home_score"] = a, h
        wp = est_wp_home(a, h, p["secs_left"], None if p["score"] else p["side"], p["z"])
        p["wp_home"], p["wp_away"] = wp, round(100 - wp, 1)

    # closing point so the line ends at the final result
    if drives and drives[-1]["result"] == "End of Game" and drives[-1]["end"]:
        a, h = drives[-1]["end"]
        wp_h = est_wp_home(a, h, 0, None, None)
        plays.append({"q": plays[-1]["q"] if plays else 4, "clock": "0:00", "secs_left": 0,
                      "type": "End of Game", "desc": f"Final {a}-{h}", "sit": "", "z": None,
                      "score": False, "team": "", "drive_result": "End of Game",
                      "away_score": a, "home_score": h,
                      "wp_home": wp_h, "wp_away": round(100 - wp_h, 1)})
    return plays
#+--|-------------------------------------------->>>
#+--| add-on function 17 as much functions here parse_scoreboard_quarters() 
#+--|-------------------------------------------->>>
#+--|

def parse_scoreboard_quarters(tokens):
    if not tokens:
        return {}
    out = {}
    i = 0
    n = len(tokens)
    while i < n - 4:
        if (tokens[i] == "1" and tokens[i+1] == "2" and
            tokens[i+2] == "3" and tokens[i+3] == "4" and
            tokens[i+4] == "T"):
            # collect next 10 ints after the header (5 away + 5 home)
            j = i + 5
            nums = []
            while j < n and len(nums) < 10:
                t = tokens[j]
                if t.isdigit() and len(t) <= 3:
                    nums.append(int(t))
                j += 1
            if len(nums) == 10:
                away_q = nums[0:5][:-1] + [0]*(4-len(nums[0:5][:-1]))
                home_q = nums[5:10][:-1] + [0]*(4-len(nums[5:10][:-1]))
                # need team names — walk backwards/forwards from header
                # (kept minimal here; your current nickname resolution is fine)
                ...
            i += 5
            continue
        i += 1
    return out
#+--|-------------------------------------------->>>
#+--| add-on function 18 — def parse_yahoo_wp(html)
#+--|-------------------------------------------->>>
#+--|

def parse_yahoo_wp(html):
    """
    Extracts the live Win Probability from the Yahoo Sports page.
    Looks for the "GB 100%" or "DAL 0%" text and returns {"away": 0.0, "home": 100.0}
    """
    if not html:
        return {}
    
    # Strip HTML to simple text
    text = re.sub(r'<script[^>]*>.*?</script>', ' ', html, flags=re.DOTALL)
    text = re.sub(r'<style[^>]*>.*?</style>', ' ', text, flags=re.DOTALL)
    text = re.sub(r'<[^>]+>', '\n', text)
    
    # Look for the exact Win Probability block (e.g., "GB 100%" or "DAL 0%")
    # Yahoo puts the away team on top and home team on bottom in the chart
    away_match = re.search(r'\b([A-Z]{2,3})\s+(\d{1,3})%', text)
    if away_match:
        # Yahoo lists the away team first in the chart block
        return {
            "away_abbr": away_match.group(1),
            "away_pct": float(away_match.group(2))
        }
        
    return {}

#+--|-------------------------------------------->>>
#+--| add-on function 18 — parse_probabilities(game, chart, win_probability)
#+--| reads ESPN game page PROBABILITIES panel → away/home WP
#+--|-------------------------------------------->>>
#+--|
def parse_probabilities(game, chart, win_probability):
    """
    Read the PROBABILITIES panel from ESPN game page tokens.

      game              : {"away": "Buccaneers", "home": "Cowboys"}
      chart             : tokens of the WP chart section (or None)
      win_probability   : tokens of the PROBABILITIES block (or None)

    Returns {"away": pct, "home": pct} or {} if not found.

    Panel renders flat as:
        "PROBABILITIES"
        "Win Probability"
        "Cover Probability"
        "Tampa Bay Buccaneers logo"
        "TB"
        "100%"
        "1st" "2nd" "3rd" "4th"
        "100" "50" "100"
        "Dallas Cowboys logo"
        "DAL"
        "0%"
    """
    tokens = win_probability or chart or []
    if not tokens or not game:
        return {}

    n = len(tokens)

    # ── anchor on "PROBABILITIES" ──
    anchor = None
    for i, t in enumerate(tokens):
        tl = (t or "").lower()
        if tl.startswith("probabilities"):
            anchor = i
            break
    if anchor is None:
        return {}

    away_abbr = game["away"].split()[-1][:3].upper()
    home_abbr = game["home"].split()[-1][:3].upper()

    out = {}

    i = anchor
    while i < n and i < anchor + 40:
        t = (tokens[i] or "").strip()

        # single-token: "TB 100%"
        m = re.search(r'\b([A-Z]{2,4})\s+(\d{1,3}(?:\.\d+)?)\s*%', t)
        if m:
            out.setdefault(m.group(1), float(m.group(2)))
            i += 1
            continue

        # two-token: "TB" then "100%"
        if re.fullmatch(r'[A-Z]{2,4}', t):
            for j in range(i + 1, min(i + 3, n)):
                m2 = re.fullmatch(r'(\d{1,3}(?:\.\d+)?)\s*%', (tokens[j] or "").strip())
                if m2:
                    out.setdefault(t, float(m2.group(1)))
                    break
            i += 1
            continue

        i += 1



    away_pct = out.get(away_abbr)
    home_pct = out.get(home_abbr)
    if away_pct is None and home_pct is None:
        return {}

    # ESPN leaves the closing WP panel rendered on Final games.
    if {away_pct, home_pct} == {100.0, 0.0}:
        return {}

    return {"away": away_pct, "home": home_pct}

