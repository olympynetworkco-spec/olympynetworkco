#+--| add-on function 16 as much functions here parse_pinned_state() 
#+--|-------------------------------------------->>>
#+--|
def parse_pinned_state(tokens):
    """
    Extract live play-by-play state from pinned ESPN tokens:
      down_distance, ball_on, clock, quarter, last_play
    """
    state = {
        "down_distance": None,
        "ball_on": None,
        "clock": None,
        "quarter": None,
        "last_play": None,
    }
    if not tokens:
        return state

    for t in tokens:
        m = re.match(r'^(\d(?:st|nd|rd|th) & \d+)$', t)
        if m:
            state["down_distance"] = m.group(1)
            break

    for i, t in enumerate(tokens):
        m = re.match(r'^(\d{1,2}:\d{2})$', t)
        if m:
            state["clock"] = m.group(1)
            for j in range(i + 1, min(i + 4, len(tokens))):
                q = re.match(r'^(1st|2nd|3rd|4th)$', tokens[j])
                if q:
                    state["quarter"] = q.group(1)
                    break
            if state["quarter"]:
                break

    for i, t in enumerate(tokens):
        if t.rstrip(':') == "Ball on":
            for j in range(i + 1, min(i + 4, len(tokens))):
                m = re.match(r'^([A-Z]{2,3}) (\d{1,2})$', tokens[j])
                if m:
                    state["ball_on"] = tokens[j]
                    break
            break

    for i, t in enumerate(tokens):
        if t == "Last Play":
            for j in range(i + 1, min(i + 6, len(tokens))):
                if len(tokens[j]) > 15:
                    state["last_play"] = tokens[j]
                    break
            break

    return state

