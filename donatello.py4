    print(f"  🦄  ESPN NFL → nfl-scores.json + nfl-odds.json + nfl-timeline.json")
    print(f"  🦄  interval {INTERVAL}s  │  output {DATA_DIR}")
    print(f"{RED}{'═' * 70}{R}\n")


    try:
        _st = json.loads(FINALS_FILE.read_text(encoding="utf-8"))
        if "previous_scores" in _st:
            previous_scores.update(_st["previous_scores"])
    except Exception:
        pass

    while True:
        try:
            cycle()
            cooldown_meter(INTERVAL)
        except KeyboardInterrupt:
            print(f"\n{RED}🦄 Donatello resting. State saved.{R}")
            write_state()
            break
        except Exception as e:
            print(f"  {RED}cycle error: {e}{R}")
            log(f"cycle error: {e}")

#+--|-------------------------------------------->>>
#+--|  chapter 1 turbo execution main
#+--|-------------------------------------------->>>
if __name__ == "__main__":
    main()
