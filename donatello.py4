            # flatten to readable text and write as .txt
            tokens = html_to_tokens(html_pin)
            (DATA_DIR / f"espn-pinned-{gid}.txt").write_text(
                "\n".join(tokens), encoding="utf-8"
            )

            tokens = []
            if html_pin:
                text = re.sub(r'<script[^>]*>.*?</script>', ' ', html_pin, flags=re.DOTALL)
                text = re.sub(r'<style[^>]*>.*?</style>', ' ', text, flags=re.DOTALL)
                text = re.sub(r'<[^>]+>', '\n', text)
                tokens = [t.strip() for t in text.split('\n') if t.strip()]

            # ── WP from the game page (PROBABILITIES panel) ──
            wp = {}
            if tokens:
                wp = parse_probabilities(pin, None, tokens)

                state = parse_pinned_state(tokens)
                try:
                    payload = json.loads(PINNED_FILE.read_text(encoding="utf-8"))
                    payload["state"] = state
                    PINNED_FILE.write_text(json.dumps(payload, indent=2),
                                           encoding="utf-8")
                except Exception:
                    pass

            if wp and wp.get("away") is not None and wp.get("home") is not None:
                key = f"{pin['away']}@{pin['home']}"
                pinned_wps[key] = {
                    "away": wp["away"],
                    "home": wp["home"],
                }

            # ── SCORE + q_breakdown — derive from the play-by-play we already grip ──
            #   The pinned game page's box score is unreliable (ESPN swaps in a
            #   stripped 2-column scoreboard strip early in the game, and a
            #   field-yard graphic "10 20 30 40 50 ..." later on the page).
            #   The play-by-play page always lists every scoring play with its
            #   points, so it's the only stable source for score.
            pin_score = {}
            pbp_url = f"https://www.espn.com/nfl/playbyplay/_/gameId/{gid}"
            try:
                html_pbp_pin = fetch(pbp_url)
                pbp_tokens_pin = html_to_tokens(html_pbp_pin)
                plays_pin = parse_pbp_tokens(pbp_tokens_pin, pin["away"], pin["home"])

                if plays_pin:
                    last = plays_pin[-1]
                    q_break = {"away": [0, 0, 0, 0, 0], "home": [0, 0, 0, 0, 0]}
                    for pl in plays_pin:
                        if pl.get("score") and pl.get("pts"):
                            qi = (pl["q"] - 1) if 1 <= pl.get("q", 0) <= 4 else 4
                            if pl["side"] == "away":
                                q_break["away"][qi] += pl["pts"]
                            else:
                                q_break["home"][qi] += pl["pts"]

                    away_total = sum(q_break["away"])
                    home_total = sum(q_break["home"])

                    # status: prefer the game-page clock if we have one
                    status = ""
                    if tokens:
                        for k, t in enumerate(tokens):
                            mm = re.match(r'^(\d{1,2}:\d{2})$', t)
                            if mm:
                                for qq in range(k + 1, min(k + 5, len(tokens))):
                                    qm = re.match(r'^(1st|2nd|3rd|4th|OT)$', tokens[qq])
                                    if qm:
                                        status = f"{qm.group(1)} {mm.group(1)}"
                                        break
                                if status:
                                    break

                    pin_score = {
                        "away_score":  away_total,
                        "home_score":  home_total,
                        "status":      status or f"Q{last.get('q', 1)} {last.get('clock', '')}".strip(),
                        "q_breakdown": q_break,
                    }
            except Exception as e:
                log_error(f"pbp-derived score failed for {gid}: {e}")

            # ── WP from the game page (Win Prob. panel via parse_pinned_wp) ──
            if tokens:
                wp2 = parse_pinned_wp(tokens)
                if wp2:
                    key = f"{pin['away']}@{pin['home']}"
                    away_abbr = team_abbr(pin["away"])
                    home_abbr = team_abbr(pin["home"])
                    pinned_wps[key] = {
                        "away": wp2.get(away_abbr),
                        "home": wp2.get(home_abbr),
                    }

            # ── stash the score we derived from pbp ──
            if pin_score:
                pinned_scores[f"{pin['away']}@{pin['home']}"] = pin_score

