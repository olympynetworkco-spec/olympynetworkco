# ─── LIVE PROGRESS HELPERS ───
import itertools

_LIVE_LINE_LOCK = threading.Lock()

def live_spin(stop_event, label="gripping", t0=None):
    """Background thread: animates a braille spinner + elapsed seconds."""
    if t0 is None:
        t0 = time.time()
    for ch in itertools.cycle(SPIN_FRAMES):
        if stop_event.is_set():
            break
        elapsed = time.time() - t0
        with _LIVE_LINE_LOCK:
            sys.stdout.write(f"\r  {RED}{ch}{R}  {DIM}{label}  {elapsed:5.1f}s{R}   ")
            sys.stdout.flush()
        time.sleep(0.1)
    with _LIVE_LINE_LOCK:
        sys.stdout.write("\r" + " " * 60 + "\r")
        sys.stdout.flush()


def spinner_wrap(label, func, *args, **kwargs):
    """
    Run func(*args, **kwargs) while showing a live braille spinner.
    Returns func's return value.
    """
    stop = threading.Event()
    t = threading.Thread(target=live_spin, args=(stop, label), daemon=True)
    t.start()
    try:
        return func(*args, **kwargs)
    finally:
        stop.set()
        t.join(timeout=1)


def cooldown_meter(seconds):
    """
    Countdown bar: shows a moving bar and remaining seconds, one update/sec.
    Any keypress (Ctrl+C) exits early.
    """
    total = seconds
    for remaining in range(total, 0, -1):
        frac = (total - remaining) / total
        width = 40
        filled = int(frac * width)
        bar = "█" * filled + "░" * (width - filled)
        mm, ss = divmod(remaining, 60)
        with _LIVE_LINE_LOCK:
            sys.stdout.write(
                f"\r  {DIM}next cycle in {R}{RED}{mm:02d}:{ss:02d}{R}  "
                f"{RED}{bar}{R}   ")
            sys.stdout.flush()
        time.sleep(1)
    with _LIVE_LINE_LOCK:
        sys.stdout.write("\r" + " " * 80 + "\r")
        sys.stdout.flush()

class Spinner:
    """Braille spinner that flips to ✓ briefly on score change, then resumes."""
    def __init__(self):
        self.frame = 0
        self.flash = False

    def track(self):
        if self.flash:
            return CHK + "✓" + R
        self.frame = (self.frame + 1) % len(SPIN_FRAMES)
        return SPIN_FRAMES[self.frame]

    def flash_check(self):
        self.flash = True

    def resume(self):
        self.flash = False

