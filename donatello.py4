# ─── SPEAK (macOS native `say` — offline, no flags to break) ───
# voice lock — one say at a time, no overlap
_VOICE_LOCK = threading.Lock()

def speak_score_change(away, home, old_score, new_score):
    text = f"Score change detected. {away} at {home}. {old_score} to {new_score}."
    try:
        with _VOICE_LOCK:                      # only one say runs at a time
            subprocess.run(
                ["say", "-v", DONATELLO_VOICE, text],
                check=True, timeout=20         # bumped from 15 → 20
            )
        print(f"  {RED}🦄 Donatello voice dropped: say -v {DONATELLO_VOICE}{R}")
        CYCLE_STATS["voice"] += 1
        log(f"VOICE {away}@{home} {old_score}→{new_score}")
    except FileNotFoundError:
        print(f"  {ORG}⚠️  say not found (macOS only){R}")
    except subprocess.TimeoutExpired:
        print(f"  {ORG}⚠️  say timeout — voice queue stuck{R}")
    except Exception as e:
        print(f"  {ORG}⚠️  speak failed: {e}{R}")

