def render_wp_chart(key, width=62):
    wp_a, wp_h = [], []
    try:
        for line in TIMELINE_FILE.read_text(encoding="utf-8").splitlines():
            parts = [p.strip() for p in line.split("|")]
            if len(parts) < 4 or parts[1] != key:
                continue
            # format: HH:MM:SS | key | A-H | wp A/H
            wp_field = parts[3]              # "wp 12.3/20.6"
            m = re.match(r'wp\s+([\d.]+)/([\d.]+)', wp_field)
            if m:
                wp_a.append(float(m.group(1)))
                wp_h.append(float(m.group(2)))
    except Exception:
        pass
    if not wp_a or not wp_h:
        return ""

    def stretch(vals, w):
        n = len(vals)
        if n == 0:
            return []
        if n == 1:
            return [vals[0]] * w
        out = []
        for i in range(w):
            src = i * (n - 1) / (w - 1)
            lo = int(src)
            hi = min(lo + 1, n - 1)
            frac = src - lo
            out.append(vals[lo] * (1 - frac) + vals[hi] * frac)
        return out

    BLOCKS = "▁▂▃▄▅▆▇█"

    def render_line(vals, w):
        out = []
        for v in stretch(vals, w):
            v = max(0.0, min(100.0, v))
            idx = int(v / 100.0 * (len(BLOCKS) - 1))
            out.append(BLOCKS[idx])
        return "".join(out)

    away_line = render_line(wp_a, width)
    home_line = render_line(wp_h, width)

    # ruler — 16 marks (4 per quarter), evenly spaced across width
    marks = 16
    ruler = ["▔"] * width
    for i in range(marks + 1):
        pos = round(i * (width - 1) / marks)
        if 0 <= pos < width:
            ruler[pos] = "|"
    ruler_str = "".join(ruler)

#+--|-------------------------------------------->>>
#+--| chart index render my chart the %
#+--|-------------------------------------------->>>
#+--|

    away_abbr = key.split("@")[0].split()[-1][:3].upper()
    home_abbr = key.split("@")[1].split()[-1][:3].upper()

    AWAY_C = "\033[94m"   # blue
    HOME_C = "\033[91m"   # red

    # ── diagnostics: show what's actually being plotted ──
    def _stat(vals):
        return (f"n={len(vals)} "
                f"min={min(vals):5.1f}% "
                f"max={max(vals):5.1f}% "
                f"last={vals[-1]:5.1f}%")

    away_stat = _stat(wp_a)
    home_stat = _stat(wp_h)

    return (
        f"{AWAY_C}{away_abbr}{R}  {DIM}{away_stat}{R}\n" +
        ruler_str + "\n" +
        f"{AWAY_C}{away_line}{R}\n" +
        ruler_str + "\n" +
        f"{HOME_C}{home_line}{R}\n" +
        ruler_str + "\n" +
        f"{HOME_C}{home_abbr}{R}  {DIM}{home_stat}{R}"
    )

