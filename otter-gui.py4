class BookmarksPanel(PanelPage):
    title = "Bookmarks"
    def __init__(self, browser):
        super().__init__(browser)
        self.list = QListWidget()

        # --- Vertical column of icon tiles (matches the left rail) ---
        self.list.setViewMode(QListWidget.ViewMode.ListMode)
        self.list.setFlow(QListWidget.Flow.TopToBottom)
        self.list.setWrapping(False)
        self.list.setIconSize(QSize(24, 24))
        self.list.setSpacing(4)
        self.list.setMovement(QListWidget.Movement.Static)
        self.list.setUniformItemSizes(True)

        # Each row = a centered block, just like the rail buttons
        self.list.setStyleSheet("""
            QListWidget {
                background: transparent;
                border: none;
                outline: none;
                padding: 4px;
            }
            QListWidget::item {
                background-color: rgba(15, 155, 142, 0.15);
                border: 1px solid rgba(15, 155, 142, 0.4);
                border-radius: 8px;
                padding: 6px;
                margin: 2px 0px;
            }
            QListWidget::item:hover {
                background-color: rgba(15, 155, 142, 0.4);
                border: 1px solid #7fe7dc;
            }
            QListWidget::item:selected {
                background-color: rgba(255, 184, 77, 0.2);
                border: 1px solid #ffb84d;
            }
        """)

        self.list.itemActivated.connect(self._open)
        self.list.itemClicked.connect(self._open)  # single click opens
        self.list.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
        self.list.customContextMenuRequested.connect(self._ctx)

        self.root.addWidget(self.list, 1)

        row = QHBoxLayout()
        b_add = QPushButton("☆ Bookmark current")
        b_add.clicked.connect(browser.add_bookmark)
        b_manage = QPushButton("Edit…")
        b_manage.clicked.connect(self._edit)
        row.addWidget(b_add, 1)
        row.addWidget(b_manage)
        self.root.addLayout(row)
        self.refresh()

    def refresh(self):
        self.list.clear()
        for bm in BOOKMARKS.items:
            it = QListWidgetItem()
            it.setText("")
            it.setToolTip(f"{bm['title']}\n{bm['url']}")
            it.setData(Qt.ItemDataRole.UserRole, bm["url"])
            it.setSizeHint(QSize(0, 40))  # fixed row height, matches rail button
            it.setTextAlignment(Qt.AlignmentFlag.AlignCenter)
            self.list.addItem(it)
            self._fetch_favicon(it, bm["url"])

    def _fetch_favicon(self, item, url):
        """Dynamically downloads the favicon for the bookmark."""
        try:
            domain = urlparse(url).netloc
            if not domain:
                return

            icon_url = f"https://www.google.com/s2/favicons?domain={domain}&sz=64"
            manager = QNetworkAccessManager(self)

            def on_finished(reply):
                if reply.error() == QNetworkReply.NetworkError.NoError:
                    data = reply.readAll()
                    pixmap = QPixmap()
                    if pixmap.loadFromData(data):
                        item.setIcon(QIcon(pixmap))
                reply.deleteLater()

            reply = manager.get(QNetworkRequest(QUrl(icon_url)))
            reply.finished.connect(lambda r=reply: on_finished(r))

            if not hasattr(self, "_net_managers"):
                self._net_managers = []
            self._net_managers.append((manager, reply))
        except Exception:
            pass

    def _open(self, it):
        self.browser.open_target(it.data(Qt.ItemDataRole.UserRole))

    def _ctx(self, pos):
        it = self.list.itemAt(pos)
        if not it:
            return
        m = QMenu(self)
        m.addAction("Open", lambda: self._open(it))
        m.addAction("Remove", lambda: (
            BOOKMARKS.remove(it.data(Qt.ItemDataRole.UserRole)),
            self.refresh()
        ))
        m.exec(self.list.mapToGlobal(pos))

    def _edit(self):
        d = QDialog(self)
        d.setWindowTitle("Edit bookmarks")
        d.resize(460, 400)
        v = QVBoxLayout(d)
        lst = QListWidget()
        for bm in BOOKMARKS.items:
            it = QListWidgetItem(f"{bm['title']}  —  {bm['url']}")
            it.setData(Qt.ItemDataRole.UserRole, bm["url"])
            lst.addItem(it)
        v.addWidget(lst)
        row = QHBoxLayout()

        def _rename():
            it = lst.currentItem()
            if not it:
                return
            url = it.data(Qt.ItemDataRole.UserRole)
            new, ok = QInputDialog.getText(d, "Rename", "New title:",
                                           text=it.text().split("  —  ")[0])
            if ok and new.strip():
                for bm in BOOKMARKS.items:
                    if bm["url"] == url:
                        bm["title"] = new.strip()
                _save_json(OTTER_BOOKMARKS, BOOKMARKS.items)
                self.refresh()
                d.accept()

        def _del():
            it = lst.currentItem()
            if not it:
                return
            BOOKMARKS.remove(it.data(Qt.ItemDataRole.UserRole))
            self.refresh()
            d.accept()

        b_r = QPushButton("Rename"); b_r.clicked.connect(_rename)
        b_d = QPushButton("Delete"); b_d.clicked.connect(_del)
        b_c = QPushButton("Close");  b_c.clicked.connect(d.accept)
        row.addWidget(b_r); row.addWidget(b_d); row.addStretch(); row.addWidget(b_c)
        v.addLayout(row)
        d.exec()


class HistoryPanel(PanelPage):
    title = "History"
    def __init__(self, browser):
