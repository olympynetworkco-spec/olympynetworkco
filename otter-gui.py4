# ────────────────────────────────────────────────────────────────────────────
# OtterPage
# ────────────────────────────────────────────────────────────────────────────
class OtterPage(QWebEnginePage):
    def __init__(self, profile, parent=None):
        super().__init__(profile, parent)
        s = self.settings()
        for attr in ("JavascriptEnabled","LocalStorageEnabled","PluginsEnabled",
                     "FullScreenSupportEnabled","ScreenCaptureEnabled","WebGLEnabled",
                     "Accelerated2dCanvasEnabled","LocalContentCanAccessRemoteUrls",
                     "LocalContentCanAccessFileUrls","ShowScrollBars"):
            try: s.setAttribute(getattr(QWebEngineSettings.WebAttribute, attr), True)
            except Exception: pass

        # Grant mic permission for websites
        try:
            self.featurePermissionRequested.connect(self._grant_feature)
        except Exception:
            pass

        self._voice_shim_installed = False
        self.loadFinished.connect(self._on_load_finished)

    def _grant_feature(self, origin, feature):
        # Native mic permission
        try:
            self.setFeaturePermission(
                origin, feature,
                QWebEnginePage.PermissionPolicy.PermissionGrantedByUser
            )
        except Exception:
            pass

        self._voice_shim_installed = False
        self.loadFinished.connect(self._on_load_finished)

# ────────────────────────────────────────────────────────────────────────────
# OtterPage - networklayer
# ────────────────────────────────────────────────────────────────────────────

    def javaScriptConsoleMessage(self, level, message, line, source):
        # The page talks to Python with console.log("__OTTER_STOP__:reason")
        if isinstance(message, str) and message.startswith("__OTTER_STOP__"):
            view = self.view()
            tab = getattr(view, "_otter_tab", None) if view else None
            if tab and tab.bridge._running:
                tab.bridge.stop_listening()
                tab.browser.statusBar().showMessage("🎤 stopped", 2000)
        # everything else stays silent

    def acceptNavigationRequest(self, url, nav_type, is_main_frame):
        u = url.toString().lower()

        # Block known memory-hog ad domains even in sub-resource requests
        blocklist_domains = [
            "trustedstack.com", "registerdisney.go.com",
            "googletagmanager.com", "doubleclick.net",
            "googlesyndication.com", "adnxs.com",
            "taboola.com", "outbrain.com",
        ]
        if any(d in u for d in blocklist_domains):
            log_event("adblock-net", u)
            return False

        if is_main_frame and nav_type == QWebEnginePage.NavigationType.NavigationTypeOther:
            if not any(safe in u for safe in ["onhockey", "new.video", "localhost",
                                               "youtube", "google", "duckduckgo",
                                               "duck.ai", "yahoo.com", "deepseek.com"]):
                log_event("adblock-redirect", u)
                return False
        if SETTINGS.get("adblock", True) and is_main_frame:
            if any(tok in u for tok in AD_BLOCKLIST):
                log_event("adblock", u); return False
        return super().acceptNavigationRequest(url, nav_type, is_main_frame)


    # ── JS voice shim ───────────────────────────────────────────────────
    def _on_load_finished(self, ok):
        # Reset the flag on every navigation, then reinstall the shim
        self._voice_shim_installed = False
        self._install_voice_shim()

    # ── JS voice shim ───────────────────────────────────────────────────

    def _install_voice_shim(self):
        # Native Chromium speech recognition is better than a Python bridge.
        # Do nothing here — the browser engine handles the mic natively.
        return

        # 2. Otherwise, inject the shim for external websites
        js = r"""
        (function(){
            if (window.__otterVoiceInstalled) return;
            window.__otterVoiceInstalled = true;
            window.__otterVoiceRequested = false;

            function makeRecog(){
                var rec = {
                    continuous: false, interimResults: false, lang: "en-US",
                    onresult: null, onerror: null, onend: null, onstart: null,
                    _started: false,
                    addEventListener: function(){}, removeEventListener: function(){},
                    abort: function(){ this._started = false; },
                    stop: function(){ this._started = false; if (this.onend) this.onend({}); },
                    start: function(){
                        var self = this;
                        if (self.onstart) self.onstart();
                        self._started = true;
                        window.__otterVoiceRequested = true;
                        var poll = setInterval(function(){
                            if (typeof window.__otterVoiceResult === 'string'){
                                clearInterval(poll);
                                var txt = window.__otterVoiceResult;
                                window.__otterVoiceResult = null;
                                window.__otterVoiceRequested = false;
                                if (txt === '__OTTER_FAIL__') {
                                    if (self.onerror) self.onerror({ error: 'no-speech' });
                                    if (self.onend) self.onend({});
                                    return;
                                }
                                if (self.onresult){
                                    self.onresult({ results: [[ { transcript: txt, confidence: 1.0 } ]], resultIndex: 0 });
                                }
                                if (self.onend) self.onend({});
                            }
                        }, 200);
                    }
                };
                return rec;
            }
            window.SpeechRecognition = window.SpeechRecognition || makeRecog;
            window.webkitSpeechRecognition = window.webkitSpeechRecognition || makeRecog;
            console.log("[otter] voice shim installed");
        })();
        """
        self.runJavaScript(js)
        self._voice_shim_installed = True


    # ── existing nav guard / cert handling (unchanged) ─────────────────
    def createWindow(self, _type):
        browser = self.parent().window()
        if not hasattr(browser, 'open_pip'):
            return super().createWindow(_type)
        
        # Get the URL that triggered this popup
        # We need to give Qt a blank page to load into, but tell it to use our PiP instead
        # of a real popup window (which QtWebEngine handles poorly).
        
        # 1. Create the PiP window with a placeholder URL
        current_url = self.url().toString() or "about:blank"
        
        # Use the browser's local profile to avoid auth conflicts on sign-ins
        prof = browser.local_profile if is_local_url(QUrl(current_url)) else browser.profile
        
        # 2. Open it in a PiP window
        # Note: The actual target URL is captured by `urlChanged` inside the PipWindow automatically
        # when the page loads its next redirect.
        
        # We create it with `_type` as a hint, then let the page navigate naturally
        pip = PipWindow(current_url, prof, parent=browser, on_top=True)
        pip.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose, True)
        pip.show()
        browser._pips.append(pip)
        
        # 3. Return the pip's view page so Qt can inject the popup target URL into it
        return pip.view.page()

    def acceptNavigationRequest(self, url, nav_type, is_main_frame):
        u = url.toString().lower()
        if is_main_frame and nav_type == QWebEnginePage.NavigationType.NavigationTypeOther:
            if not any(safe in u for safe in ["onhockey", "new.video", "localhost",
                                               "youtube", "google", "duckduckgo",
                                               "duck.ai"]):
                log_event("adblock-redirect", u)
                return False
        if SETTINGS.get("adblock", True) and is_main_frame:
            if any(tok in u for tok in AD_BLOCKLIST):
                log_event("adblock", u); return False
        return super().acceptNavigationRequest(url, nav_type, is_main_frame)

    def certificateError(self, error):
        try: host = error.url().host()
        except Exception: host = ""
        if host in LOCAL_HOSTS or host in TRUSTED:
            error.acceptCertificate(); return True
        try:
            r = QMessageBox.question(None, "🦦 Otter — Certificate",
                f"Accept certificate for {host}?\n\n{error.description()}",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
            if r == QMessageBox.StandardButton.Yes:
                TRUSTED.add(host); error.acceptCertificate(); return True
        except Exception: pass
        return super().certificateError(error)


# ────────────────────────────────────────────────────────────────────────────
# Voice bridge — reuses pluto.py4's working mic pipeline
# ────────────────────────────────────────────────────────────────────────────
try:
    import speech_recognition as sr
    _SR_AVAILABLE = True
except ImportError:
    _SR_AVAILABLE = False
    print("[otter] speech_recognition not installed — voice input disabled")

PLUTO_LOG = Path("/Users/olympynetworkco/Desktop/data/pluto.log")
PLUTO_TXT = Path("/Users/olympynetworkco/Desktop/data/pluto.txt")
PLUTO_LOG.parent.mkdir(parents=True, exist_ok=True)


def _pluto_log(text, glyphs=""):
    """Same log shape pluto.py4 uses."""
    stamp = datetime.now().isoformat()
    line = f"{stamp} | {text}\n{glyphs}\n"
    try:
        with open(PLUTO_LOG, "a", encoding="utf-8") as f: f.write(line)
        with open(PLUTO_TXT, "a", encoding="utf-8") as f: f.write(line)
    except Exception as e:
        print(f"[otter/voice] log fail: {e}")


def _sister_whisper_filter(text):
    if not text or len(text.strip()) < 2:
        return None
    return text.strip()


def otter_listen(should_stop=None):
    """Same as pluto.py4's listen, but can be told to stop."""
    if not _SR_AVAILABLE:
        return None
    stop = should_stop or (lambda: False)

    try:
        r = sr.Recognizer()
        r.pause_threshold = 4
        with sr.Microphone() as source:
            r.adjust_for_ambient_noise(source, duration=1)
            if stop():
                return None

            print("\n⠋Listening... (4 second silence to stop)")
            audio = None
            while audio is None:
                if stop():
                    return None
                try:
                    audio = r.listen(source, timeout=1)   # re-checks stop every second
                except sr.WaitTimeoutError:
                    continue

            if stop():
                return None
            text = r.recognize_google(audio)
            filtered = _sister_whisper_filter(text)
            if filtered:
                print(f"🎤 transcribed: {filtered}")
                _pluto_log(f"otter-transcribed: {filtered}", "🎤︎︎")
            return filtered

    except sr.UnknownValueError:
        print("Could not understand audio")
        return None
    except sr.RequestError as e:
        print(f"API error: {e}")
        return None
    except Exception as e:
        print(f"Error: {e}")
        return None


# ────────────────────────────────────────────────────────────────────────────
#class SpeechBridge(QObject):
# ────────────────────────────────────────────────────────────────────────────

class SpeechBridge(QObject):
    textReady    = Signal(str)
    stateChanged = Signal(str)

    def __init__(self, parent=None):
        super().__init__(parent)
        self._running = False
        self._gen = 0

    def _alive(self, gen):
        return self._running and gen == self._gen

    def start_listening(self):
        if self._running: return
        self._running = True
        self._gen += 1
        import threading
        threading.Thread(target=self._loop, args=(self._gen,), daemon=True).start()
        self.stateChanged.emit("listening")

    def stop_listening(self):
        self._running = False
        self._gen += 1                      # any in-flight listen is now stale
        self.stateChanged.emit("idle")

    def _loop(self, gen):
        while self._alive(gen):
            t = otter_listen(lambda: not self._alive(gen))
            if t and len(t.strip()) >= 2 and self._alive(gen):
                self.textReady.emit(t.strip())

# ────────────────────────────────────────────────────────────────────────────
# PiP window
# ────────────────────────────────────────────────────────────────────────────
class PipWindow(QMainWindow):
    def __init__(self, target, profile, parent=None, on_top=True):
        super().__init__(parent)
        self.setWindowTitle(f"📺 {target[:60]}")
        flags = Qt.WindowType.Window
        if on_top: flags |= Qt.WindowType.WindowStaysOnTopHint
        self.setWindowFlags(flags)
        self.resize(520, 320)
        self.setStyleSheet("QMainWindow { background: #041012; }")

        self.page = OtterPage(profile, self)
        self.view = QWebEngineView(); self.view.setPage(self.page)

        bar = QWidget(); bl = QHBoxLayout(bar)
        bl.setContentsMargins(4,4,4,4); bl.setSpacing(4)

        self.btn_top = make_icon_button("pip", "Always on top", None, size=18, btn_size=30)
        self.btn_top.setCheckable(True); self.btn_top.setChecked(on_top)
        self.btn_top.toggled.connect(self._toggle_on_top)
        bl.addWidget(self.btn_top)

        self.btn_mute = QPushButton("🔊"); self.btn_mute.setCheckable(True)
        self.btn_mute.setFixedSize(32, 28); self.btn_mute.toggled.connect(self._toggle_mute)
        bl.addWidget(self.btn_mute)

        bl.addStretch()
        b_close = make_icon_button("close", "Close", self.close, size=16, btn_size=30)
        bl.addWidget(b_close)

        central = QWidget(); v = QVBoxLayout(central); v.setContentsMargins(0,0,0,0)
        v.addWidget(bar); v.addWidget(self.view, stretch=1)
        self.setCentralWidget(central)

        url = QUrl(target)
        if not target.startswith(("http://","https://","file://","about:")):
            p = Path(target).expanduser()
            if p.exists(): url = QUrl.fromLocalFile(str(p.resolve()))
            else:          url = QUrl("https://" + target)
        self.view.setUrl(url)

        n = len(getattr(parent, "_pips", [])) if parent else 0
        self.move(220 + n * 30, 140 + n * 30)

    def _toggle_on_top(self, on):
        self.setWindowFlag(Qt.WindowType.WindowStaysOnTopHint, on); self.show()
    def _toggle_mute(self, m):
        self.page.setAudioMuted(m); self.btn_mute.setText("🔇" if m else "🔊")
    def closeEvent(self, e):
        self.view.setPage(None); self.view.deleteLater(); self.page.deleteLater()
        super().closeEvent(e)

# ────────────────────────────────────────────────────────────────────────────
# Side panel pages
# ────────────────────────────────────────────────────────────────────────────
class PanelPage(QWidget):
    """Base panel with a header."""
    title = "Panel"
    def __init__(self, browser, parent=None):
        super().__init__(parent)
        self.browser = browser
        self.root = QVBoxLayout(self)
        self.root.setContentsMargins(14, 14, 14, 14)
        self.root.setSpacing(10)
        h = QLabel(self.title.upper())
        # CHANGE THIS COLOR FROM #7fe7dc TO #0b1a1f (Black)
        h.setStyleSheet("color:#0b1a1f; font-weight:bold; letter-spacing:2px; font-size:11px;")

        self.root.addWidget(h)

# ────────────────────────────────────────────────────────────────────────────
# class BookmarksPanel(PanelPage):
# ────────────────────────────────────────────────────────────────────────────

class BookmarksPanel(PanelPage):
    title = "Bookmarks"
    def __init__(self, browser):
        super().__init__(browser)
        self.list = QListWidget()

        # --- Vertical column of icon tiles (matches the left rail) ---
        self.list.setViewMode(QListWidget.ViewMode.ListMode)
        self.list.setFlow(QListWidget.Flow.TopToBottom)
        self.list.setWrapping(False)
        self.list.setIconSize(QSize(24, 24))
        self.list.setSpacing(4)
        self.list.setMovement(QListWidget.Movement.Static)
        self.list.setUniformItemSizes(True)

        # Each row = a centered block, just like the rail buttons
        self.list.setStyleSheet("""
            QListWidget {
                background: transparent;
                border: none;
                outline: none;
                padding: 4px;
            }
            QListWidget::item {
                background-color: rgba(15, 155, 142, 0.15);
                border: 1px solid rgba(15, 155, 142, 0.4);
                border-radius: 8px;
                padding: 6px;
                margin: 2px 0px;
            }
            QListWidget::item:hover {
                background-color: rgba(15, 155, 142, 0.4);
                border: 1px solid #7fe7dc;
            }
            QListWidget::item:selected {
                background-color: rgba(255, 184, 77, 0.2);
                border: 1px solid #ffb84d;
            }
        """)

        self.list.itemActivated.connect(self._open)
        self.list.itemClicked.connect(self._open)  # single click opens
        self.list.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
        self.list.customContextMenuRequested.connect(self._ctx)

        self.root.addWidget(self.list, 1)

        row = QHBoxLayout()
        b_add = QPushButton("☆ Bookmark current")
        b_add.clicked.connect(browser.add_bookmark)
        b_manage = QPushButton("Edit…")
        b_manage.clicked.connect(self._edit)
        row.addWidget(b_add, 1)
        row.addWidget(b_manage)
        self.root.addLayout(row)
        self.refresh()

    def refresh(self):
        self.list.clear()
        for bm in BOOKMARKS.items:
            it = QListWidgetItem()
            it.setText("")
            it.setToolTip(f"{bm['title']}\n{bm['url']}")
            it.setData(Qt.ItemDataRole.UserRole, bm["url"])
            it.setSizeHint(QSize(0, 40))  # fixed row height, matches rail button
            it.setTextAlignment(Qt.AlignmentFlag.AlignCenter)
            self.list.addItem(it)
            self._fetch_favicon(it, bm["url"])

    def _fetch_favicon(self, item, url):
        """Dynamically downloads the favicon for the bookmark."""
        try:
            domain = urlparse(url).netloc
            if not domain:
                return

            icon_url = f"https://www.google.com/s2/favicons?domain={domain}&sz=64"
            manager = QNetworkAccessManager(self)

            def on_finished(reply):
                if reply.error() == QNetworkReply.NetworkError.NoError:
                    data = reply.readAll()
                    pixmap = QPixmap()
                    if pixmap.loadFromData(data):
                        item.setIcon(QIcon(pixmap))
                reply.deleteLater()

            reply = manager.get(QNetworkRequest(QUrl(icon_url)))
            reply.finished.connect(lambda r=reply: on_finished(r))

            if not hasattr(self, "_net_managers"):
                self._net_managers = []
            self._net_managers.append((manager, reply))
        except Exception:
            pass

    def _open(self, it):
        self.browser.open_target(it.data(Qt.ItemDataRole.UserRole))

    def _ctx(self, pos):
        it = self.list.itemAt(pos)
        if not it:
            return
        m = QMenu(self)
        m.addAction("Open", lambda: self._open(it))
        m.addAction("Remove", lambda: (
            BOOKMARKS.remove(it.data(Qt.ItemDataRole.UserRole)),
            self.refresh()
        ))
        m.exec(self.list.mapToGlobal(pos))

    def _edit(self):
        d = QDialog(self)
        d.setWindowTitle("Edit bookmarks")
        d.resize(460, 400)
        v = QVBoxLayout(d)
        lst = QListWidget()
        for bm in BOOKMARKS.items:
            it = QListWidgetItem(f"{bm['title']}  —  {bm['url']}")
            it.setData(Qt.ItemDataRole.UserRole, bm["url"])
            lst.addItem(it)
        v.addWidget(lst)
        row = QHBoxLayout()

        def _rename():
            it = lst.currentItem()
            if not it:
                return
            url = it.data(Qt.ItemDataRole.UserRole)
            new, ok = QInputDialog.getText(d, "Rename", "New title:",
                                           text=it.text().split("  —  ")[0])
            if ok and new.strip():
                for bm in BOOKMARKS.items:
                    if bm["url"] == url:
                        bm["title"] = new.strip()
                _save_json(OTTER_BOOKMARKS, BOOKMARKS.items)
                self.refresh()
                d.accept()

        def _del():
            it = lst.currentItem()
            if not it:
                return
            BOOKMARKS.remove(it.data(Qt.ItemDataRole.UserRole))
            self.refresh()
            d.accept()

        b_r = QPushButton("Rename"); b_r.clicked.connect(_rename)
        b_d = QPushButton("Delete"); b_d.clicked.connect(_del)
        b_c = QPushButton("Close");  b_c.clicked.connect(d.accept)
        row.addWidget(b_r); row.addWidget(b_d); row.addStretch(); row.addWidget(b_c)
        v.addLayout(row)
        d.exec()


class HistoryPanel(PanelPage):
    title = "History"
    def __init__(self, browser):
        super().__init__(browser)
        self.list = QListWidget(); self.list.itemActivated.connect(self._open)
        self.root.addWidget(self.list, 1)

        row = QHBoxLayout()
        b_refresh = QPushButton("Refresh"); b_refresh.clicked.connect(self.refresh)
        b_clear   = QPushButton("Clear");   b_clear.clicked.connect(self._clear)
        row.addWidget(b_refresh); row.addWidget(b_clear)
        self.root.addLayout(row)
        self.refresh()

    def refresh(self):
        self.list.clear()
        for h in reversed(_load_json(OTTER_HISTORY, [])[-500:]):
            txt = f"{h.get('ts','')[:19]}  ·  {h.get('kind','')}  ·  {h.get('payload','')}"
            it = QListWidgetItem(txt[:120])
            it.setData(Qt.ItemDataRole.UserRole, h.get("payload",""))
            it.setToolTip(txt); self.list.addItem(it)

    def _open(self, it):
        u = it.data(Qt.ItemDataRole.UserRole)
        if isinstance(u, str) and u.startswith(("http","file","about")):
            self.browser.open_target(u)

    def _clear(self):
        if QMessageBox.question(self, "Clear", "Erase all history?") == QMessageBox.StandardButton.Yes:
            _save_json(OTTER_HISTORY, []); self.refresh()


class DownloadsPanel(PanelPage):
    title = "Downloads"
    def __init__(self, browser):
        super().__init__(browser)
        self._rows = {}
        self._timers = [] # Keep track of timers so they aren't garbage collected
        
        self.table = QTableWidget(0, 3)
        self.table.setHorizontalHeaderLabels(["File", "Progress", "Status"])
        self.table.horizontalHeader().setSectionResizeMode(0, QHeaderView.ResizeMode.Stretch)
        self.table.horizontalHeader().setSectionResizeMode(1, QHeaderView.ResizeMode.ResizeToContents)
        self.table.horizontalHeader().setSectionResizeMode(2, QHeaderView.ResizeMode.ResizeToContents)
        self.table.setEditTriggers(QAbstractItemView.EditTrigger.NoEditTriggers)
        self.table.verticalHeader().setVisible(False)
        self.root.addWidget(self.table, 1)

        row = QHBoxLayout()
        b_open = QPushButton("Open folder")
        b_open.clicked.connect(lambda: QDesktopServices.openUrl(QUrl.fromLocalFile(str(DOWNLOADS_DIR))))
        b_clear = QPushButton("Clear done"); b_clear.clicked.connect(self._clear_done)
        row.addWidget(b_open); row.addWidget(b_clear)
        self.root.addLayout(row)

    def add_download(self, item):
        r = self.table.rowCount(); self.table.insertRow(r)
        self.table.setItem(r, 0, QTableWidgetItem(item.downloadFileName()))
        
        prog = QProgressBar(); prog.setRange(0, 100); prog.setValue(0)
        prog.setTextVisible(False); prog.setFixedHeight(14)
        self.table.setCellWidget(r, 1, prog)
        self.table.setItem(r, 2, QTableWidgetItem("starting…"))
        
        self._rows[item] = (r, prog)

        # PySide6 removed the downloadProgress signal. 
        # We use a QTimer to poll the receivedBytes instead.
        timer = QTimer(self)
        timer.setInterval(200) # Check every 200ms
        
        def update_progress():
            try:
                if item.isFinished():
                    prog.setValue(100)
                    self.table.setItem(r, 2, QTableWidgetItem("✅ done"))
                    timer.stop()
                else:
                    total = item.totalBytes()
                    received = item.receivedBytes()
                    if total > 0:
                        pct = int(received * 100 / total)
                        prog.setValue(pct)
                        self.table.setItem(r, 2, QTableWidgetItem(f"⬇ {pct}%"))
            except Exception:
                timer.stop()

        timer.timeout.connect(update_progress)
        timer.start()
        
        # Store the timer so it doesn't get garbage collected
        self._timers.append(timer)

    def _clear_done(self):
        for item, (r, _) in list(self._rows.items()):
            try:
                if item.isFinished():
                    self.table.removeRow(r); del self._rows[item]
                    # re-index remaining rows so future removals don't break
                    for k, (rr, _p) in list(self._rows.items()):
                        if rr > r: self._rows[k] = (rr - 1, _p)
            except Exception: pass


class SearchPanel(PanelPage):
    title = "Search"
    def __init__(self, browser):
        super().__init__(browser)
        self.box = QComboBox(); self.box.addItems(SEARCH_ENGINES.keys())
        self.box.setCurrentText(SETTINGS.get("search_engine", "DuckDuckGo"))
        self.box.currentTextChanged.connect(lambda t: SETTINGS.set("search_engine", t))
        self.root.addWidget(self.box)

        self.q = QLineEdit(); self.q.setPlaceholderText("Search…")
        self.q.returnPressed.connect(self._go)
        self.root.addWidget(self.q)
        b = QPushButton("Search"); b.clicked.connect(self._go)
        self.root.addWidget(b)

        lbl = QLabel("SHORTCUT SITES")
        lbl.setStyleSheet("color:#7fe7dc; font-weight:bold; letter-spacing:2px; font-size:11px; margin-top:10px;")
        self.root.addWidget(lbl)
        for name, url in SHORTCUT_SITES:
            bb = QPushButton(name); bb.setStyleSheet("text-align:left; padding-left:12px;")
            bb.clicked.connect(lambda _=False, u=url: browser.open_target(u))
