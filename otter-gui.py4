def _load_json(path, default):
    try:
        if path.exists():
            return json.loads(path.read_text(encoding="utf-8"))
    except Exception as e:
        print(f"[otter] load {path.name}: {e}")
    return default

def _save_json(path, data):
    try:
        path.write_text(json.dumps(data, indent=2), encoding="utf-8")
    except Exception as e:
        print(f"[otter] save {path.name}: {e}")

def log_event(kind, payload):
    stamp = datetime.now().isoformat()
    try:
        with open(OTTER_LOG, "a", encoding="utf-8") as f:
            f.write(f"{stamp} | {kind} | {payload}\n")
    except Exception:
        pass
    try:
        hist = _load_json(OTTER_HISTORY, [])
        hist.append({"ts": stamp, "kind": kind, "payload": str(payload)})
        _save_json(OTTER_HISTORY, hist[-5000:])
    except Exception:
        pass


# ────────────────────────────────────────────────────────────────────────────
# Tombstone — archive anything before removing it
# ────────────────────────────────────────────────────────────────────────────
TOMBSTONE_DIR = DATA_DIR / "tombstone"
TOMBSTONE_DIR.mkdir(parents=True, exist_ok=True)

def tombstone(path, reason=""):
    """Move any file/folder into the tombstone with a timestamp.
    Nothing is ever deleted — you can restore it later."""
    try:
        src = Path(path)
        if not src.exists():
            return None
        stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        dest = TOMBSTONE_DIR / f"{src.name}.{stamp}"
        if src.is_dir():
            import shutil
            shutil.move(str(src), str(dest))
        else:
            src.rename(dest)
        if reason:
            (TOMBSTONE_DIR / f"{src.name}.{stamp}.reason.txt").write_text(reason, encoding="utf-8")
        print(f"[otter/tombstone] → {dest.name}  ({reason or 'archived'})")
        return dest
    except Exception as e:
        print(f"[otter/tombstone] fail: {e}")
        return None

def restore_from_tombstone(original_name):
    """Restore the most recent tombstoned copy of a file/folder."""
    matches = sorted(TOMBSTONE_DIR.glob(f"{original_name}.*"), reverse=True)
    for m in matches:
        if m.name.endswith(".reason.txt"):
            continue
        try:
            # destination: strip the timestamp suffix
            parts = m.name.rsplit(".", 2)
            dest = DATA_DIR / parts[0]
            if dest.exists():
                print(f"[otter/tombstone] {dest.name} already exists — tombstone it first")
                return None
            if m.is_dir():
                import shutil
                shutil.move(str(m), str(dest))
            else:
                m.rename(dest)
            print(f"[otter/tombstone] restored → {dest}")
            return dest
        except Exception as e:
            print(f"[otter/tombstone] restore fail: {e}")
            return None
    print(f"[otter/tombstone] no backup found for {original_name}")
    return None
