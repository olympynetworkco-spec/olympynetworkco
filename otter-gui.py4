# ────────────────────────────────────────────────────────────────────────────
# OtterPage
# ────────────────────────────────────────────────────────────────────────────
class OtterPage(QWebEnginePage):
    def __init__(self, profile, parent=None):
        super().__init__(profile, parent)
        s = self.settings()
        for attr in ("JavascriptEnabled","LocalStorageEnabled","PluginsEnabled",
                     "FullScreenSupportEnabled","ScreenCaptureEnabled","WebGLEnabled",
                     "Accelerated2dCanvasEnabled","LocalContentCanAccessRemoteUrls",
                     "LocalContentCanAccessFileUrls","ShowScrollBars"):
            try: s.setAttribute(getattr(QWebEngineSettings.WebAttribute, attr), True)
            except Exception: pass

    def createWindow(self, _type): return self


    def javaScriptConsoleMessage(self, level, message, line, source):
        # Optional: catch console errors for debugging
        pass

    def acceptNavigationRequest(self, url, nav_type, is_main_frame):
        # (Keep your existing adblock code here)
        return super().acceptNavigationRequest(url, nav_type, is_main_frame)


    def acceptNavigationRequest(self, url, nav_type, is_main_frame):
        if SETTINGS.get("adblock", True) and is_main_frame:
            u = url.toString().lower()
            if any(tok in u for tok in AD_BLOCKLIST):
                log_event("adblock", u); return False
        return super().acceptNavigationRequest(url, nav_type, is_main_frame)

    def featurePermissionRequested(self, origin, feature):
        self.setFeaturePermission(origin, feature,
            QWebEnginePage.PermissionPolicy.PermissionGrantedByUser)

    def certificateError(self, error):
        try: host = error.url().host()
        except Exception: host = ""
        if host in LOCAL_HOSTS or host in TRUSTED:
            error.acceptCertificate(); return True
        try:
            r = QMessageBox.question(None, "🦦 Otter — Certificate",
                f"Accept certificate for {host}?\n\n{error.description()}",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
            if r == QMessageBox.StandardButton.Yes:
                TRUSTED.add(host); error.acceptCertificate(); return True
        except Exception: pass
        return super().certificateError(error)

# ────────────────────────────────────────────────────────────────────────────
# PiP window
# ────────────────────────────────────────────────────────────────────────────
class PipWindow(QMainWindow):
    def __init__(self, target, profile, parent=None, on_top=True):
        super().__init__(parent)
        self.setWindowTitle(f"📺 {target[:60]}")
        flags = Qt.WindowType.Window
        if on_top: flags |= Qt.WindowType.WindowStaysOnTopHint
        self.setWindowFlags(flags)
        self.resize(520, 320)
        self.setStyleSheet("QMainWindow { background: #041012; }")

        self.page = OtterPage(profile, self)
        self.view = QWebEngineView(); self.view.setPage(self.page)

        bar = QWidget(); bl = QHBoxLayout(bar)
        bl.setContentsMargins(4,4,4,4); bl.setSpacing(4)

        self.btn_top = make_icon_button("pip", "Always on top", None, size=18, btn_size=30)
        self.btn_top.setCheckable(True); self.btn_top.setChecked(on_top)
        self.btn_top.toggled.connect(self._toggle_on_top)
        bl.addWidget(self.btn_top)

        self.btn_mute = QPushButton("🔊"); self.btn_mute.setCheckable(True)
        self.btn_mute.setFixedSize(32, 28); self.btn_mute.toggled.connect(self._toggle_mute)
        bl.addWidget(self.btn_mute)

        bl.addStretch()
        b_close = make_icon_button("close", "Close", self.close, size=16, btn_size=30)
        bl.addWidget(b_close)

        central = QWidget(); v = QVBoxLayout(central); v.setContentsMargins(0,0,0,0)
        v.addWidget(bar); v.addWidget(self.view, stretch=1)
        self.setCentralWidget(central)

        url = QUrl(target)
        if not target.startswith(("http://","https://","file://","about:")):
            p = Path(target).expanduser()
            if p.exists(): url = QUrl.fromLocalFile(str(p.resolve()))
            else:          url = QUrl("https://" + target)
        self.view.setUrl(url)

        n = len(getattr(parent, "_pips", [])) if parent else 0
        self.move(220 + n * 30, 140 + n * 30)

    def _toggle_on_top(self, on):
        self.setWindowFlag(Qt.WindowType.WindowStaysOnTopHint, on); self.show()
    def _toggle_mute(self, m):
        self.page.setAudioMuted(m); self.btn_mute.setText("🔇" if m else "🔊")
    def closeEvent(self, e):
        self.view.setPage(None); self.view.deleteLater(); self.page.deleteLater()
        super().closeEvent(e)

# ────────────────────────────────────────────────────────────────────────────
# Side panel pages
# ────────────────────────────────────────────────────────────────────────────
class PanelPage(QWidget):
    """Base panel with a header."""
    title = "Panel"
    def __init__(self, browser, parent=None):
        super().__init__(parent)
        self.browser = browser
        self.root = QVBoxLayout(self)
        self.root.setContentsMargins(14, 14, 14, 14)
        self.root.setSpacing(10)
        h = QLabel(self.title.upper())
        h.setStyleSheet("color:#7fe7dc; font-weight:bold; letter-spacing:2px; font-size:11px;")
        self.root.addWidget(h)

class BookmarksPanel(PanelPage):
    title = "Bookmarks"
    def __init__(self, browser):
        super().__init__(browser)
        self.list = QListWidget()
        self.list.itemActivated.connect(self._open)
        self.list.itemDoubleClicked.connect(self._open)
        self.list.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
        self.list.customContextMenuRequested.connect(self._ctx)
        self.root.addWidget(self.list, 1)

        row = QHBoxLayout()
        b_add = QPushButton("☆ Bookmark current")
        b_add.clicked.connect(browser.add_bookmark)
        b_manage = QPushButton("Edit…"); b_manage.clicked.connect(self._edit)
        row.addWidget(b_add, 1); row.addWidget(b_manage)
        self.root.addLayout(row)
        self.refresh()

    def refresh(self):
        self.list.clear()
        for bm in BOOKMARKS.items:
            it = QListWidgetItem(f"{bm['title']}")
            it.setToolTip(bm["url"])
            it.setData(Qt.ItemDataRole.UserRole, bm["url"])
            self.list.addItem(it)

    def _open(self, it):
        self.browser.open_target(it.data(Qt.ItemDataRole.UserRole))

    def _ctx(self, pos):
        it = self.list.itemAt(pos)
        if not it: return
        m = QMenu(self)
        m.addAction("Open",        lambda: self._open(it))
        m.addAction("Remove",      lambda: (BOOKMARKS.remove(it.data(Qt.ItemDataRole.UserRole)),
                                            self.refresh()))
        m.exec(self.list.mapToGlobal(pos))

    def _edit(self):
        # simple inline editor: rename or delete
        d = QDialog(self); d.setWindowTitle("Edit bookmarks"); d.resize(460, 400)
        v = QVBoxLayout(d); lst = QListWidget()
        for bm in BOOKMARKS.items:
            it = QListWidgetItem(f"{bm['title']}  —  {bm['url']}")
            it.setData(Qt.ItemDataRole.UserRole, bm["url"]); lst.addItem(it)
        v.addWidget(lst)
        row = QHBoxLayout()
        def _rename():
            it = lst.currentItem()
            if not it: return
            url = it.data(Qt.ItemDataRole.UserRole)
            new, ok = QInputDialog.getText(d, "Rename", "New title:",
                                           text=it.text().split("  —  ")[0])
            if ok and new.strip():
                for bm in BOOKMARKS.items:
                    if bm["url"] == url: bm["title"] = new.strip()
                _save_json(OTTER_BOOKMARKS, BOOKMARKS.items); self.refresh(); d.accept()
        def _del():
            it = lst.currentItem()
            if not it: return
            BOOKMARKS.remove(it.data(Qt.ItemDataRole.UserRole)); self.refresh(); d.accept()
        b_r = QPushButton("Rename"); b_r.clicked.connect(_rename)
        b_d = QPushButton("Delete"); b_d.clicked.connect(_del)
        b_c = QPushButton("Close"); b_c.clicked.connect(d.accept)
        row.addWidget(b_r); row.addWidget(b_d); row.addStretch(); row.addWidget(b_c)
        v.addLayout(row); d.exec()

class HistoryPanel(PanelPage):
    title = "History"
    def __init__(self, browser):
        super().__init__(browser)
        self.list = QListWidget(); self.list.itemActivated.connect(self._open)
        self.root.addWidget(self.list, 1)

        row = QHBoxLayout()
        b_refresh = QPushButton("Refresh"); b_refresh.clicked.connect(self.refresh)
        b_clear   = QPushButton("Clear");   b_clear.clicked.connect(self._clear)
        row.addWidget(b_refresh); row.addWidget(b_clear)
        self.root.addLayout(row)
        self.refresh()

    def refresh(self):
        self.list.clear()
        for h in reversed(_load_json(OTTER_HISTORY, [])[-500:]):
            txt = f"{h.get('ts','')[:19]}  ·  {h.get('kind','')}  ·  {h.get('payload','')}"
            it = QListWidgetItem(txt[:120])
            it.setData(Qt.ItemDataRole.UserRole, h.get("payload",""))
            it.setToolTip(txt); self.list.addItem(it)

    def _open(self, it):
        u = it.data(Qt.ItemDataRole.UserRole)
        if isinstance(u, str) and u.startswith(("http","file","about")):
            self.browser.open_target(u)

    def _clear(self):
        if QMessageBox.question(self, "Clear", "Erase all history?") == QMessageBox.StandardButton.Yes:
            _save_json(OTTER_HISTORY, []); self.refresh()


class DownloadsPanel(PanelPage):
    title = "Downloads"
    def __init__(self, browser):
        super().__init__(browser)
        self._rows = {}
        self._timers = [] # Keep track of timers so they aren't garbage collected
        
        self.table = QTableWidget(0, 3)
        self.table.setHorizontalHeaderLabels(["File", "Progress", "Status"])
        self.table.horizontalHeader().setSectionResizeMode(0, QHeaderView.ResizeMode.Stretch)
        self.table.horizontalHeader().setSectionResizeMode(1, QHeaderView.ResizeMode.ResizeToContents)
        self.table.horizontalHeader().setSectionResizeMode(2, QHeaderView.ResizeMode.ResizeToContents)
        self.table.setEditTriggers(QAbstractItemView.EditTrigger.NoEditTriggers)
        self.table.verticalHeader().setVisible(False)
        self.root.addWidget(self.table, 1)

        row = QHBoxLayout()
        b_open = QPushButton("Open folder")
        b_open.clicked.connect(lambda: QDesktopServices.openUrl(QUrl.fromLocalFile(str(DOWNLOADS_DIR))))
        b_clear = QPushButton("Clear done"); b_clear.clicked.connect(self._clear_done)
        row.addWidget(b_open); row.addWidget(b_clear)
        self.root.addLayout(row)

    def add_download(self, item):
        r = self.table.rowCount(); self.table.insertRow(r)
        self.table.setItem(r, 0, QTableWidgetItem(item.downloadFileName()))
        
        prog = QProgressBar(); prog.setRange(0, 100); prog.setValue(0)
        prog.setTextVisible(False); prog.setFixedHeight(14)
        self.table.setCellWidget(r, 1, prog)
        self.table.setItem(r, 2, QTableWidgetItem("starting…"))
        
        self._rows[item] = (r, prog)

        # PySide6 removed the downloadProgress signal. 
        # We use a QTimer to poll the receivedBytes instead.
        timer = QTimer(self)
        timer.setInterval(200) # Check every 200ms
        
        def update_progress():
            try:
                if item.isFinished():
                    prog.setValue(100)
                    self.table.setItem(r, 2, QTableWidgetItem("✅ done"))
                    timer.stop()
                else:
                    total = item.totalBytes()
                    received = item.receivedBytes()
                    if total > 0:
                        pct = int(received * 100 / total)
                        prog.setValue(pct)
                        self.table.setItem(r, 2, QTableWidgetItem(f"⬇ {pct}%"))
            except Exception:
                timer.stop()

        timer.timeout.connect(update_progress)
        timer.start()
        
        # Store the timer so it doesn't get garbage collected
        self._timers.append(timer)

    def _clear_done(self):
        for item, (r, _) in list(self._rows.items()):
            try:
                if item.isFinished():
                    self.table.removeRow(r); del self._rows[item]
                    # re-index remaining rows so future removals don't break
                    for k, (rr, _p) in list(self._rows.items()):
                        if rr > r: self._rows[k] = (rr - 1, _p)
            except Exception: pass


class SearchPanel(PanelPage):
    title = "Search"
    def __init__(self, browser):
        super().__init__(browser)
        self.box = QComboBox(); self.box.addItems(SEARCH_ENGINES.keys())
        self.box.setCurrentText(SETTINGS.get("search_engine", "DuckDuckGo"))
        self.box.currentTextChanged.connect(lambda t: SETTINGS.set("search_engine", t))
        self.root.addWidget(self.box)

        self.q = QLineEdit(); self.q.setPlaceholderText("Search…")
        self.q.returnPressed.connect(self._go)
        self.root.addWidget(self.q)
        b = QPushButton("Search"); b.clicked.connect(self._go)
        self.root.addWidget(b)

        lbl = QLabel("SHORTCUT SITES")
        lbl.setStyleSheet("color:#7fe7dc; font-weight:bold; letter-spacing:2px; font-size:11px; margin-top:10px;")
        self.root.addWidget(lbl)
        for name, url in SHORTCUT_SITES:
            bb = QPushButton(name); bb.setStyleSheet("text-align:left; padding-left:12px;")
            bb.clicked.connect(lambda _=False, u=url: browser.open_target(u))
            self.root.addWidget(bb)
        self.root.addStretch()

    def _go(self):
        t = self.q.text().strip()
        if t: self.browser.open_target(normalize(t))

class SettingsPanel(PanelPage):
    title = "Settings"
    def __init__(self, browser):
        super().__init__(browser)
        def chk(label, key, default):
            c = QCheckBox(label); c.setChecked(SETTINGS.get(key, default))
            c.toggled.connect(lambda v, k=key: SETTINGS.set(k, v))
            self.root.addWidget(c); return c
        chk("Ad / tracker block",       "adblock",         True)
        chk("Use Otter UA",             "custom_ua",       False)
        chk("Restore session on launch","restore_session", True)
        chk("PiP always on top",        "pip_on_top",      True)


        self.root.addSpacing(10)
        zoom_lbl = QLabel("Default Zoom Level")
        zoom_lbl.setStyleSheet("color:#7fe7dc; font-weight:bold; font-size:11px;")
        self.root.addWidget(zoom_lbl)

        z_row = QHBoxLayout()
        self.zoom_in_btn = QPushButton("Zoom In +")
        self.zoom_in_btn.clicked.connect(self._zoom_in)
        self.zoom_out_btn = QPushButton("Zoom Out -")
        self.zoom_out_btn.clicked.connect(self._zoom_out)
        z_row.addWidget(self.zoom_out_btn)
        z_row.addWidget(self.zoom_in_btn)
        self.root.addLayout(z_row)

        self.zoom_status = QLabel(f"Current: {int(SETTINGS.get('default_zoom', 0.8) * 100)}%")
        self.zoom_status.setStyleSheet("color:#ffd28a; font-size:12px;")
        self.root.addWidget(self.zoom_status)


        self.root.addSpacing(12)
        row = QHBoxLayout()
        b_cache = QPushButton("Clear cache / cookies"); b_cache.clicked.connect(browser.clear_storage)
        row.addWidget(b_cache)
        self.root.addLayout(row)

        self.root.addSpacing(12)
        b_save = QPushButton("💾 Save session now"); b_save.clicked.connect(browser.save_session)
        self.root.addWidget(b_save)

        info = QLabel(
            f"log       : {OTTER_LOG.name}\n"
            f"profile   : {OTTER_PROFILE_DIR.name}\n"
            f"downloads : {DOWNLOADS_DIR}\n"
            f"shots     : {OTTER_SCREENSHOTS.name}"
        )
        info.setStyleSheet("color:#7fe7dc; font-size:11px;")
        self.root.addSpacing(12); self.root.addWidget(info)
        self.root.addStretch()

    def _zoom_in(self):
        current = float(SETTINGS.get("default_zoom", 0.8))
        new_zoom = min(2.0, current + 0.1)
        SETTINGS.set("default_zoom", new_zoom)
        self.zoom_status.setText(f"Current: {int(new_zoom * 100)}%")
        self.browser.zoom_reset() # Applies to current page
        
    def _zoom_out(self):
        current = float(SETTINGS.get("default_zoom", 0.8))
        new_zoom = max(0.3, current - 0.1)
        SETTINGS.set("default_zoom", new_zoom)
        self.zoom_status.setText(f"Current: {int(new_zoom * 100)}%")
        self.browser.zoom_reset() # Applies to current page

# ────────────────────────────────────────────────────────────────────────────
# class MediaPanel(PanelPage):
# ────────────────────────────────────────────────────────────────────────────

class MediaPanel(PanelPage):
    title = "Media Player"
    def __init__(self, browser):
        super().__init__(browser)
        self.root.setContentsMargins(8, 10, 8, 10)
        self.root.setSpacing(6)

        # Video output
        self.video = QVideoWidget()
        self.video.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)
        self.video.setStyleSheet("background: #000; border-radius: 8px;")
        self.root.addWidget(self.video, stretch=2)

        # Media Engine
        self.player = QMediaPlayer(self)
        self.audio = QAudioOutput(self)
        self.player.setAudioOutput(self.audio)
        self.player.setVideoOutput(self.video)
        
        # Title
        self.lbl_title = QLabel("—")
        self.lbl_title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.lbl_title.setStyleSheet("color: #ffd28a; font-weight: bold;")
        self.root.addWidget(self.lbl_title)

        # Slider
        self.seek = QSlider(Qt.Orientation.Horizontal)
        self.seek.setRange(0, 0)
        self.seek.sliderMoved.connect(self.player.setPosition)
        self.root.addWidget(self.seek)

        # Controls row
        controls = QHBoxLayout()
        controls.setSpacing(4)
        
        btn_play = QPushButton("▶")
        btn_play.setFixedSize(32, 32)
        btn_play.clicked.connect(self._toggle)
        
        btn_stop = QPushButton("■")
        btn_stop.setFixedSize(32, 32)
        btn_stop.clicked.connect(self.player.stop)

        controls.addWidget(btn_play)
        controls.addWidget(btn_stop)
        self.root.addLayout(controls)

        # File List
        self.list = QListWidget()
        self.list.setStyleSheet("font-size: 11px;")
        self.list.itemDoubleClicked.connect(self._play_item)
        self.root.addWidget(self.list, stretch=1)

        # Connections
        self.player.positionChanged.connect(self._on_pos)
        self.player.durationChanged.connect(self._on_dur)

        self._scan()

    def _scan(self):
        self.list.clear()
        media_dir = Path.home() / "Desktop" / "media"
        if not media_dir.exists(): return
        for p in sorted(media_dir.iterdir()):
            if p.suffix.lower() in {".mp4", ".mov", ".mp3", ".m4a", ".webm"}:
                tag = "🎬" if p.suffix.lower() in {".mp4", ".mov", ".webm"} else "🎵"
                it = QListWidgetItem(f"{tag} {p.name}")
                it.setData(Qt.ItemDataRole.UserRole, str(p))
                self.list.addItem(it)

    def _play_item(self, item):
        path = item.data(Qt.ItemDataRole.UserRole)
        self.lbl_title.setText(Path(path).name)
        self.player.setSource(QUrl.fromLocalFile(path))
        self.player.play()

    def _toggle(self):
        if self.player.playbackState() == QMediaPlayer.PlaybackState.PlayingState:
            self.player.pause()
        else:
            self.player.play()

    def _on_pos(self, pos):
        if not self.seek.isSliderDown(): self.seek.setValue(pos)

    def _on_dur(self, dur):
        self.seek.setRange(0, dur)

# ────────────────────────────────────────────────────────────────────────────
# Left icon rail
# ────────────────────────────────────────────────────────────────────────────
class IconRail(QWidget):
    """Vertical rail of icon buttons that drive the side panel."""
    iconClicked = Signal(str)   # panel key

    PANELS = [
        ("home",     "Home"),
        ("plus",     "New tab"),
        ("search",   "Search"),
        ("music",    "Media Player"), # <--- CHANGED BACK TO MUSIC
        ("bookmark", "Bookmarks"),
        ("clock",    "History"),
        ("download", "Downloads"),
        ("reader",   "Reader mode"),
        ("camera",   "Screenshot"),
        ("pip",      "Picture-in-Picture"),
        ("devtools", "DevTools"),
    ]

    def __init__(self, browser):
        super().__init__(browser)
        self.browser = browser
        self.setFixedWidth(52)
        self.setStyleSheet("background:#041012;")
        v = QVBoxLayout(self); v.setContentsMargins(6, 10, 6, 10); v.setSpacing(4)

        self._buttons = {}
        for name, tip in self.PANELS:
            b = make_icon_button(name, tip, btn_size=38, size=22)
            b.clicked.connect(lambda _=False, n=name: self._on_click(n))
            v.addWidget(b, 0, Qt.AlignmentFlag.AlignHCenter)
            self._buttons[name] = b

        v.addStretch()
        # bottom pinned settings
        b_set = make_icon_button("settings", "Settings", btn_size=38, size=22)
        b_set.clicked.connect(lambda: self._on_click("settings"))
        v.addWidget(b_set, 0, Qt.AlignmentFlag.AlignHCenter)
        self._buttons["settings"] = b_set

        # bottom incognito toggle (visual only; new tabs go incognito)
        self.incog = make_icon_button("sun", "New incognito tab", btn_size=38, size=22, color="#ffb84d")
        self.incog.clicked.connect(lambda: browser.new_tab(incognito=True))
        v.addWidget(self.incog, 0, Qt.AlignmentFlag.AlignHCenter)

    def _on_click(self, name):
        # immediate actions
        if name == "home":   self.browser.home(); return
        if name == "plus":   self.browser.new_tab(); return
        if name == "reader": self.browser.reader_mode(); return
        if name == "camera": self.browser.screenshot(); return
        if name == "pip":    self.browser.open_pip(); return
        if name == "devtools": self.browser.toggle_devtools(); return
        
        # Launch the standalone media player
        if name == "music":
            import subprocess
            subprocess.Popen(["python3", MEDIA_PLAYER])
            return

        # panel keys
        self.iconClicked.emit(name)

    def set_active(self, key):
        for k, b in self._buttons.items():
            b.setChecked(k == key)

# ────────────────────────────────────────────────────────────────────────────
# Side panel (collapsible container)
# ────────────────────────────────────────────────────────────────────────────
class SidePanel(QWidget):
    def __init__(self, browser):
        super().__init__(browser)
        self.browser = browser
        self._anim = None
        self.setMaximumWidth(360)
        self.setMinimumWidth(0)
        self.setStyleSheet("background:#0b1a1f; border-right:1px solid #0f9b8e;")

        v = QVBoxLayout(self); v.setContentsMargins(0,0,0,0); v.setSpacing(0)
        self.stack = QStackedWidget()
        v.addWidget(self.stack, 1)

        self.pages = {
            "search":    SearchPanel(browser),
            "bookmark":  BookmarksPanel(browser),
            "clock":     HistoryPanel(browser),
            "download":  DownloadsPanel(browser),
            "music":     MediaPanel(browser),     # <--- ADD THIS
            "settings":  SettingsPanel(browser),
        }
        for p in self.pages.values():
            self.stack.addWidget(p)

        self.setVisible(False)  # start collapsed
        self._current = None
        self.setFixedWidth(0)

    def toggle(self, key):
        if self._current == key and self.isVisible():
            self.collapse(); return
        self._current = key
        self.stack.setCurrentWidget(self.pages[key])
        # refresh dynamic pages
        if key == "bookmark" and hasattr(self.pages[key], "refresh"):
            self.pages[key].refresh()
        if key == "clock" and hasattr(self.pages[key], "refresh"):
            self.pages[key].refresh()
        self.expand()

    def expand(self):
        target = int(SETTINGS.get("side_panel_width", 280))
        self.setVisible(True)
        self._animate_to(target)

    def collapse(self):
        self._current = None
        self._animate_to(0)

    def _animate_to(self, w):
        self._anim = QPropertyAnimation(self, b"maximumWidth", self)
        self._anim.setDuration(180)
        self._anim.setStartValue(self.maximumWidth())
        self._anim.setEndValue(w)
        self._anim.setEasingCurve(QEasingCurve.Type.OutCubic)
        # also animate minimumWidth so the splitter cooperates
        self._anim2 = QPropertyAnimation(self, b"minimumWidth", self)
        self._anim2.setDuration(180)
        self._anim2.setStartValue(self.minimumWidth())
        self._anim2.setEndValue(w)
        self._anim2.setEasingCurve(QEasingCurve.Type.OutCubic)
        self._anim.start(); self._anim2.start()
        if w == 0:
            self._anim.finished.connect(lambda: self.setVisible(False))

# ────────────────────────────────────────────────────────────────────────────
# Tab helpers
# ────────────────────────────────────────────────────────────────────────────
class Tab:
    def __init__(self, browser, profile, url=None):
        self.browser = browser
        self.page = OtterPage(profile, browser)
        self.view = QWebEngineView(); self.view.setPage(self.page)
        self.zoom = 1.0
        self.view._otter_tab = self
        if url: self.view.setUrl(QUrl(url))
    def set_zoom(self, f):
        self.zoom = max(0.25, min(5.0, f)); self.view.setZoomFactor(self.zoom)

# ────────────────────────────────────────────────────────────────────────────
# Main window
# ────────────────────────────────────────────────────────────────────────────
class OtterBrowser(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Otter Browser")
        self.setGeometry(180, 100, 1180, 780)
        self.setMinimumSize(640, 460)

        self._pips = []
        self._fact_timer = QTimer(self); self._fact_timer.timeout.connect(self._rotate_fact)
        self._fact_timer.start(9000)

        # ── Profiles ────────────────────────────────────────────────────
        self.profile = self._make_profile("otter-main", OTTER_PROFILE_DIR, True)
        self.local_profile = QWebEngineProfile(self)
        self.local_profile.setHttpUserAgent(REAL_UA)
        self.incognito_profile = self._make_profile("otter-incognito", OTTER_INCOGNITO, False)

        for prof in (self.profile, self.local_profile, self.incognito_profile):
            prof.downloadRequested.connect(self._on_download)

        # ── YouTube skipper ────────────────────────────────────────────────────
        self._inject_ad_skipper()


        # ── Root: rail | side panel | main column ───────────────────────
        central = QWidget(); self.setCentralWidget(central)
        root = QHBoxLayout(central); root.setContentsMargins(0,0,0,0); root.setSpacing(0)

        self.rail = IconRail(self)
        self.rail.iconClicked.connect(self._on_rail)
        root.addWidget(self.rail)

        self.side = SidePanel(self)
        root.addWidget(self.side)

        # main column: top bar + tabs
        main = QWidget(); mv = QVBoxLayout(main)
        mv.setContentsMargins(0,0,0,0); mv.setSpacing(0)
        root.addWidget(main, 1)

        # ── Top bar (minimal) ───────────────────────────────────────────
        top = QWidget(); top.setStyleSheet("background:#0b1a1f;")
        tv = QHBoxLayout(top); tv.setContentsMargins(10, 8, 10, 6); tv.setSpacing(6)

        self.btn_back = make_icon_button("back", "Back (Alt+←)", self.go_back, size=18, btn_size=32)
        self.btn_fwd  = make_icon_button("forward", "Forward (Alt+→)", self.go_forward, size=18, btn_size=32)
        self.btn_rl   = make_icon_button("reload", "Reload (Ctrl+R)", self.reload, size=18, btn_size=32)
        tv.addWidget(self.btn_back); tv.addWidget(self.btn_fwd); tv.addWidget(self.btn_rl)

        self.url = QLineEdit(); self.url.setPlaceholderText("🔍 URL, path, or search…")
        self.url.setClearButtonEnabled(True); self.url.returnPressed.connect(self.go)
        self.url.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
        self.url.setMinimumHeight(32)
        tv.addWidget(self.url, 1)

        self.btn_menu = make_icon_button("menu", "Menu", self.show_menu, size=18, btn_size=32)
        tv.addWidget(self.btn_menu)

        mv.addWidget(top)

        # ── Tabs ────────────────────────────────────────────────────────
        self.tabs = QTabWidget()
        self.tabs.setTabsClosable(True)
        self.tabs.setMovable(True)
        self.tabs.setDocumentMode(True)
        self.tabs.tabCloseRequested.connect(self.close_tab)
        self.tabs.currentChanged.connect(self._on_tab_changed)
        self.tabs.tabBar().setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
        self.tabs.tabBar().customContextMenuRequested.connect(self._tab_ctx)
        mv.addWidget(self.tabs, 1)

        # Tab bar "+" button via corner widget
        plus = make_icon_button("plus", "New tab (Ctrl+T)", lambda: self.new_tab(),
                                size=16, btn_size=26)
        self.tabs.setCornerWidget(plus, Qt.Corner.TopRightCorner)

        # ── Status bar ──────────────────────────────────────────────────
        self.setStatusBar(QStatusBar(self))
        self.status_label = QLabel("ready · engine: QtWebEngine 6")
        self.statusBar().addWidget(self.status_label, 1)
        self.fact_label = QLabel(random.choice(OTTER_FACTS))
        self.fact_label.setStyleSheet("color:#7fe7dc;")
        self.statusBar().addPermanentWidget(self.fact_label)

        self._install_shortcuts()

        # ── Restore / home ──────────────────────────────────────────────
        if SETTINGS.get("restore_session", True) and OTTER_SESSION.exists():
            sess = _load_json(OTTER_SESSION, {})
            for u in (sess.get("tabs") or [HOME_PAGE]):
                self.new_tab(u, focus=False)
            if self.tabs.count() == 0: self.new_tab(HOME_PAGE)
            idx = sess.get("active", 0)
            if 0 <= idx < self.tabs.count(): self.tabs.setCurrentIndex(idx)
        else:
            self.new_tab(HOME_PAGE)

    # ── profiles ────────────────────────────────────────────────────────
    def _make_profile(self, name, dir_path, persistent):
        # Force a fixed name for the storage so the path doesn't change
        prof_name = "otter-persistent-profile" if persistent else "otter-incognito-profile"
        
        prof = QWebEngineProfile(prof_name, self)
        
        if persistent:
            prof.setPersistentStoragePath(str(dir_path / "storage"))
            prof.setCachePath(str(dir_path / "cache"))
            # FORCE cookies to save to disk
            prof.setPersistentCookiesPolicy(QWebEngineProfile.PersistentCookiesPolicy.ForcePersistentCookies)
            prof.setHttpCacheType(QWebEngineProfile.HttpCacheType.DiskHttpCache)
        else:
            prof.setPersistentCookiesPolicy(QWebEngineProfile.PersistentCookiesPolicy.NoPersistentCookies)
            prof.setHttpCacheType(QWebEngineProfile.HttpCacheType.MemoryHttpCache)
            
        # Version 2.0: Always use the standard REAL_UA to pass Google's checks
        prof.setHttpUserAgent(REAL_UA)
        return prof

    # ── side panel routing ──────────────────────────────────────────────
    def _on_rail(self, key):
        self.side.toggle(key)
        self.rail.set_active(key if self.side.isVisible() else None)

    # ── tabs ────────────────────────────────────────────────────────────
    def new_tab(self, url=None, focus=True, incognito=False):
        prof = self.incognito_profile if incognito else self.profile
        if url and is_local_url(QUrl(url)): prof = self.local_profile
        tab = Tab(self, prof, url=url or None)
        
        # APPLY SAVED ZOOM TO THE NEW TAB
        try:
            zoom = float(SETTINGS.get("default_zoom", 0.8))
            tab.view.setZoomFactor(zoom)
        except Exception: pass

        tab.view.titleChanged.connect(lambda t, tb=tab: self._set_tab_title(tb, t))
        tab.view.urlChanged.connect(lambda u: self._on_url_changed(u))
        idx = self.tabs.addTab(tab.view, "New Tab")
        if not url: tab.view.setUrl(QUrl(HOME_PAGE))
        self.tabs.setTabToolTip(idx, url or HOME_PAGE)
        if focus: self.tabs.setCurrentIndex(idx); self.url.setFocus()
        return tab

    def close_tab(self, index):
        if self.tabs.count() == 1: self.home(); return
        w = self.tabs.widget(index)
        if w:
            try: w.setPage(None)
            except Exception: pass
            w.deleteLater()
        self.tabs.removeTab(index)

    def _set_tab_title(self, tab, title):
        idx = self.tabs.indexOf(tab.view)
        if idx >= 0: self.tabs.setTabText(idx, (title or "Untitled")[:28])

    def _active_view(self):
        w = self.tabs.currentWidget()
        return w if isinstance(w, QWebEngineView) else None

    # ── nav ─────────────────────────────────────────────────────────────
    def _swap_page_if_needed(self, url: QUrl):
        v = self._active_view()
        if not v: return
        want_local = is_local_url(url); has_local = is_local_url(v.url())
        if want_local and not has_local:
            v.setPage(OtterPage(self.local_profile, self))
            v.page().urlChanged.connect(self._on_url_changed)
        elif not want_local and has_local:
            v.setPage(OtterPage(self.profile, self))
            v.page().urlChanged.connect(self._on_url_changed)

    def go(self):
        url = normalize(self.url.text())
        if not url: return
        self._swap_page_if_needed(QUrl(url))
        v = self._active_view()
        if v: v.setUrl(QUrl(url))
        log_event("visit", url)

    def home(self):
        self.url.setText(SETTINGS.get("home", HOME_PAGE)); self.go()
    def reload(self):
        v = self._active_view()
        if v: v.reload()
    def go_back(self):
        v = self._active_view()
        if v: v.back()
    def go_forward(self):
        v = self._active_view()
        if v: v.forward()

    def open_target(self, target):
        url = normalize(target)
        if not url: return
        self._swap_page_if_needed(QUrl(url))
        v = self._active_view()
        if v: v.setUrl(QUrl(url))
        log_event("open", url)

    def _on_url_changed(self, qurl):
        s = qurl.toString()
        self.url.setText(s[7:] if s.startswith("file://") else s)
        marker = "🔒 local" if is_local_url(qurl) else "🌐"
        self.statusBar().showMessage(f"{marker} {s}", 4000)

    def _on_tab_changed(self, idx):
        v = self.tabs.widget(idx)
        if isinstance(v, QWebEngineView):
            self._on_url_changed(v.url())

    # ── actions ─────────────────────────────────────────────────────────
    def add_bookmark(self):
        v = self._active_view()
        if not v: return
        BOOKMARKS.add(v.title(), v.url().toString())
        if "bookmark" in self.side.pages: self.side.pages["bookmark"].refresh()
        self.statusBar().showMessage("★ bookmarked", 2500)

    def reader_mode(self):
        v = self._active_view()
        if not v: return
        js = r"""
        (function(){
            var a = document.querySelector('article') || document.querySelector('main') || document.body;
            if (!a) return document.title;
            var html = '<html><head><meta charset="utf-8"><style>'
                     + 'body{max-width:720px;margin:40px auto;padding:0 20px;'
                     + 'font-family:Georgia,serif;line-height:1.6;color:#222;background:#fdfdf7;}'
                     + 'img{max-width:100%;height:auto;}'
                     + '</style></head><body><h1>' + document.title + '</h1>'
                     + a.innerHTML + '</body></html>';
            document.open(); document.write(html); document.close();
            return document.title;
        })();"""
        v.page().runJavaScript(js)
        self.statusBar().showMessage("📄 reader mode applied", 3000)

    def screenshot(self):
        v = self._active_view()
        if not v: return
        pix = v.grab()
        stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        path = OTTER_SCREENSHOTS / f"otter-{stamp}.png"
        pix.save(str(path), "PNG")
        self.statusBar().showMessage(f"📸 saved → {path}", 5000)
        log_event("screenshot", str(path))

    def toggle_devtools(self):
        v = self._active_view()
        if not v: return
        try:
            d = QWebEngineView(); d.setPage(v.page())
            d.setWindowTitle("🦦 DevTools"); d.resize(900, 600); d.show()
        except Exception as e:
            self.statusBar().showMessage(f"DevTools: {e}", 4000)

    def open_pip(self):
        v = self._active_view()
        current = v.url().toString() if v else HOME_PAGE
        if current == "about:blank": current = HOME_PAGE
        text, ok = QInputDialog.getText(self, "📺 Alfred", "Paste a URL for the PiP:", text=current)
        if not ok or not text.strip(): return
        u = normalize(text.strip()) or HOME_PAGE
        prof = self.local_profile if is_local_url(QUrl(u)) else self.profile
        pip = PipWindow(u, prof, parent=self, on_top=SETTINGS.get("pip_on_top", True))
        pip.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose, True)
        pip.destroyed.connect(self._on_pip_closed)
        pip.show(); self._pips.append(pip)
        self.statusBar().showMessage(f"📺 {len(self._pips)} PiP open", 3000)

    def _on_pip_closed(self, *_):
        self._pips = [p for p in self._pips if p is not None and p.isVisible()]

    def clear_storage(self):
        if QMessageBox.question(self, "Clear", "Clear cache, cookies and site data?") \
                != QMessageBox.StandardButton.Yes: return
        try:
            self.profile.clearHttpCache()
            self.profile.clearAllVisitedLinks()
            self.profile.cookieStore().deleteAllCookies()
            self.statusBar().showMessage("🧹 storage cleared", 4000)
        except Exception as e:
            self.statusBar().showMessage(f"clear failed: {e}", 4000)

    def save_session(self):
        tabs = [self.tabs.widget(i).url().toString()
                for i in range(self.tabs.count())
                if isinstance(self.tabs.widget(i), QWebEngineView)]
        _save_json(OTTER_SESSION, {"tabs": tabs, "active": self.tabs.currentIndex()})
        self.statusBar().showMessage("💾 session saved", 3000)

    # ── downloads ───────────────────────────────────────────────────────
    def _on_download(self, item):
        suggested = item.downloadFileName() or "download"
        target = DOWNLOADS_DIR / suggested
        stem, suffix = target.stem, target.suffix; n = 1
        while target.exists():
            target = DOWNLOADS_DIR / f"{stem} ({n}){suffix}"; n += 1
        item.setDownloadDirectory(str(DOWNLOADS_DIR))
        item.setDownloadFileName(target.name)
        dlp = self.side.pages.get("download")
        if dlp: dlp.add_download(item)
        self.side.toggle("download")
        self.rail.set_active("download")
        self.statusBar().showMessage(f"⬇ {target.name}", 4000)

    # ── menu (⋯) ────────────────────────────────────────────────────────
    def show_menu(self):
        m = QMenu(self)
        m.addAction("＋ New Tab",           "Ctrl+T", lambda: self.new_tab())
        m.addAction("🕶 New Incognito Tab",  lambda: self.new_tab(incognito=True))
        m.addSeparator()
        m.addAction("🔍 Search panel",      lambda: self._on_rail("search"))
        m.addAction("📚 Bookmarks panel",   lambda: self._on_rail("bookmark"))
        m.addAction("🕘 History panel",     lambda: self._on_rail("clock"))
        m.addAction("⬇ Downloads panel",    lambda: self._on_rail("download"))
        m.addAction("⚙ Settings panel",     lambda: self._on_rail("settings"))
        m.addSeparator()
        m.addAction("📄 Reader mode",       self.reader_mode)
        m.addAction("📸 Screenshot",        self.screenshot)
        m.addAction("📺 Picture-in-Picture",self.open_pip)
        m.addAction("🛠 DevTools",          self.toggle_devtools)
        m.addSeparator()
        zoom = m.addMenu("🔎 Zoom")
        zoom.addAction("Zoom In",  self.zoom_in)
        zoom.addAction("Zoom Out", self.zoom_out)
        zoom.addAction("Reset",    self.zoom_reset)
        m.addSeparator()
        m.addAction("💾 Save session now", self.save_session)
        m.addAction("✕ Quit",              self.close)
        m.exec(self.btn_menu.mapToGlobal(QPoint(0, self.btn_menu.height())))

    def zoom_in(self):
        v = self._active_view()
        if v: v.setZoomFactor(min(5.0, v.zoomFactor() + 0.1))
    def zoom_out(self):
        v = self._active_view()
        if v: v.setZoomFactor(max(0.25, v.zoomFactor() - 0.1))

    def zoom_reset(self):
        v = self._active_view()
        if v: 
            try:
                saved_zoom = float(SETTINGS.get("default_zoom", 0.8))
                v.setZoomFactor(saved_zoom)
            except Exception:
                v.setZoomFactor(1.0)

    # ── shortcuts ───────────────────────────────────────────────────────
    def _install_shortcuts(self):
        S = QShortcut
        S(QKeySequence("Ctrl+T"), self, activated=lambda: self.new_tab())
        S(QKeySequence("Ctrl+W"), self, activated=lambda: self.close_tab(self.tabs.currentIndex()))
        S(QKeySequence("Ctrl+L"), self, activated=lambda: (self.url.setFocus(), self.url.selectAll()))
        S(QKeySequence("Ctrl+R"), self, activated=self.reload)
        S(QKeySequence("F5"),     self, activated=self.reload)
        S(QKeySequence("F11"),    self, activated=self._toggle_fullscreen)
        S(QKeySequence("F12"),    self, activated=self.toggle_devtools)
        S(QKeySequence("Ctrl+D"), self, activated=self.add_bookmark)
        S(QKeySequence("Ctrl+B"), self, activated=lambda: self._on_rail("bookmark"))
        S(QKeySequence("Ctrl+H"), self, activated=lambda: self._on_rail("clock"))
        S(QKeySequence("Ctrl+J"), self, activated=lambda: self._on_rail("download"))
        S(QKeySequence("Ctrl+,"), self, activated=lambda: self._on_rail("settings"))
        S(QKeySequence("Ctrl+K"), self, activated=lambda: self._on_rail("search"))
        S(QKeySequence("Ctrl++"), self, activated=self.zoom_in)
        S(QKeySequence("Ctrl+="), self, activated=self.zoom_in)
        S(QKeySequence("Ctrl+-"), self, activated=self.zoom_out)
        S(QKeySequence("Ctrl+0"), self, activated=self.zoom_reset)
        S(QKeySequence("Ctrl+Shift+P"), self, activated=self.open_pip)
        S(QKeySequence("Ctrl+Shift+S"), self, activated=self.screenshot)
        S(QKeySequence("Ctrl+Shift+R"), self, activated=self.reader_mode)
        S(QKeySequence("Alt+Left"),  self, activated=self.go_back)
        S(QKeySequence("Alt+Right"), self, activated=self.go_forward)
        S(QKeySequence("Ctrl+Shift+W"), self, activated=self._close_other_tabs)

    def _close_other_tabs(self):
        cur = self.tabs.currentIndex()
        for i in reversed(range(self.tabs.count())):
            if i != cur: self.close_tab(i)

    def _toggle_fullscreen(self):
        if self.isFullScreen(): self.showNormal()
        else: self.showFullScreen()

    # ── fact ticker ─────────────────────────────────────────────────────
    def _rotate_fact(self):
        self.fact_label.setText(random.choice(OTTER_FACTS))

    # ── tab context menu ────────────────────────────────────────────────
    def _tab_ctx(self, pos):
        idx = self.tabs.tabBar().tabAt(pos)
        if idx < 0: return
        m = QMenu(self)
        m.addAction("Reload",       lambda: self.tabs.widget(idx).reload())
        m.addAction("Duplicate",    lambda: self.new_tab(self.tabs.widget(idx).url().toString()))
        m.addAction("Close",        lambda: self.close_tab(idx))
        m.addAction("Close others", self._close_other_tabs)
        m.exec(self.tabs.tabBar().mapToGlobal(pos))

    # ── close ───────────────────────────────────────────────────────────
    def closeEvent(self, event):
        try: self.save_session()
        except Exception: pass
        for p in list(self._pips):
            try: p.close()
            except Exception: pass
        for i in range(self.tabs.count()):
            w = self.tabs.widget(i)
            if isinstance(w, QWebEngineView):
                try: w.setPage(None)
                except Exception: pass
        super().closeEvent(event)


    # ── YouTube init skip ───────────────────────────────────────────────────────────

    def _inject_ad_skipper(self):
        script_code = """
        (function() {
            setInterval(function() {
                var skipBtn = document.querySelector('.ytp-ad-skip-button');
                if (skipBtn) skipBtn.click();
                var overlayAd = document.querySelector('.ytp-ad-overlay-close-button');
                if (overlayAd) overlayAd.click();
            }, 1000);
        })();
        """
        script = QWebEngineScript()
        script.setSourceCode(script_code)
        script.setInjectionPoint(QWebEngineScript.InjectionPoint.DocumentReady)
        script.setWorldId(QWebEngineScript.ScriptWorldId.MainWorld)
        script.setRunsOnSubFrames(True)
        self.profile.scripts().insert(script)
        self.local_profile.scripts().insert(script)

# ────────────────────────────────────────────────────────────────────────────
# Banner / main
# ────────────────────────────────────────────────────────────────────────────
def banner():
    print("\n" + "=" * 68)
    print("  🦦  otter.py4 — Turbo Otter Browser · side-panel edition")
    print("  layout  : left icon rail · collapsible side panel · clean tabs")
    print("  features: bookmarks · history · downloads · search · settings")
    print("            reader · screenshot · PiP · devtools · incognito")
    print("=" * 68)
    print(f"  log       : {OTTER_LOG}")
    print(f"  profile   : {OTTER_PROFILE_DIR}")
    print(f"  downloads : {DOWNLOADS_DIR}")
    print(f"  shots     : {OTTER_SCREENSHOTS}")
    print("=" * 68 + "\n")

def main():
    banner()
    app = QApplication(sys.argv)
    app.setApplicationName("otter.py4")
    apply_otter_theme(app)
    win = OtterBrowser()
    win.show()
    sys.exit(app.exec())

if __name__ == "__main__":
    main()
#+--|!/usr/bin/env python4
