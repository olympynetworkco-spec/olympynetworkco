# ────────────────────────────────────────────────────────────────────────────
# OtterPage
# ────────────────────────────────────────────────────────────────────────────
class OtterPage(QWebEnginePage):
    def __init__(self, profile, parent=None):
        super().__init__(profile, parent)
        s = self.settings()
        for attr in ("JavascriptEnabled","LocalStorageEnabled","PluginsEnabled",
                     "FullScreenSupportEnabled","ScreenCaptureEnabled","WebGLEnabled",
                     "Accelerated2dCanvasEnabled","LocalContentCanAccessRemoteUrls",
                     "LocalContentCanAccessFileUrls","ShowScrollBars"):
            try: s.setAttribute(getattr(QWebEngineSettings.WebAttribute, attr), True)
            except Exception: pass

        # Grant mic permission for websites
        try:
            self.featurePermissionRequested.connect(self._grant_feature)
        except Exception:
            pass

        self._voice_shim_installed = False
        self.loadFinished.connect(self._on_load_finished)

    def _grant_feature(self, origin, feature):
        # Native mic permission
        try:
            self.setFeaturePermission(
                origin, feature,
                QWebEnginePage.PermissionPolicy.PermissionGrantedByUser
            )
        except Exception:
            pass

        self._voice_shim_installed = False
        self.loadFinished.connect(self._on_load_finished)

# ────────────────────────────────────────────────────────────────────────────
# OtterPage - networklayer
# ────────────────────────────────────────────────────────────────────────────

    def javaScriptConsoleMessage(self, level, message, line, source):
        # The page talks to Python with console.log("__OTTER_STOP__:reason")
        if isinstance(message, str) and message.startswith("__OTTER_STOP__"):
            view = self.view()
            tab = getattr(view, "_otter_tab", None) if view else None
            if tab and tab.bridge._running:
                tab.bridge.stop_listening()
                tab.browser.statusBar().showMessage("🎤 stopped", 2000)

        if isinstance(message, str) and message.startswith("__OTTER_ACTIVE__"):
            view = self.view()
            if view:
                tab = getattr(view, "_otter_tab", None)
                if tab:
                    import time
                    tab.browser._last_activity[id(view)] = time.time()
        # everything else stays silent


        if isinstance(message, str) and message.startswith("__OTTER_FACTS__:"):
            try:
                payload = message.split("__OTTER_FACTS__:", 1)[1]
                items = json.loads(payload)
                
                # Fix: Get the browser window from the page's parent
                parent = self.parent()
                browser = parent.window() if parent else None
                
                if browser and hasattr(browser, "_apply_scraped_facts"):
                    browser._apply_scraped_facts(items)
            except Exception as e:
                print(f"[otter] facts parse: {e}")




    def acceptNavigationRequest(self, url, nav_type, is_main_frame):
        u = url.toString().lower()
        
        # ── BLOCK OAUTH CALLBACK FROM LOADING IN WEBVIEW ──
        if "127.0.0.1:8765/oauth2callback" in u:
            log_event("oauth-callback", u)
            return False
        # ──────────────────────────────────────────────────


        # Block known memory-hog ad domains even in sub-resource requests
        blocklist_domains = [
            "trustedstack.com", "registerdisney.go.com",
            "googletagmanager.com", "doubleclick.net",
            "googlesyndication.com", "adnxs.com",
            "taboola.com", "outbrain.com",
        ]
        if any(d in u for d in blocklist_domains):
            log_event("adblock-net", u)
            return False

        if is_main_frame and nav_type == QWebEnginePage.NavigationType.NavigationTypeOther:
            if not any(safe in u for safe in ["onhockey", "new.video", "localhost",
                                               "youtube", "google", "duckduckgo",
                                               "duck.ai", "yahoo.com", "deepseek.com"]):
                log_event("adblock-redirect", u)
                return False
        if SETTINGS.get("adblock", True) and is_main_frame:
            if any(tok in u for tok in AD_BLOCKLIST):
                log_event("adblock", u); return False
        return super().acceptNavigationRequest(url, nav_type, is_main_frame)


    # ── JS voice shim ───────────────────────────────────────────────────
    def _on_load_finished(self, ok):
        # Reset the flag on every navigation, then reinstall the shim
        self._voice_shim_installed = False
        self._install_voice_shim()

    # ── JS voice shim ───────────────────────────────────────────────────

    def _install_voice_shim(self):
        # Activity pings — must run BEFORE the return so it actually fires
        activity_js = r"""
        (function(){
            if (window.__otterActivityHooked) return;
            window.__otterActivityHooked = true;
            ['keydown', 'mousedown', 'scroll', 'input'].forEach(function(evt) {
                document.addEventListener(evt, function() {
                    console.log('__OTTER_ACTIVE__');
                }, { passive: true });
            });
        })();
        """
        self.runJavaScript(activity_js)

        # Voice shim intentionally disabled
        return

        # ── Everything below is dead code, preserved for future ──
        js = r"""
        (function() {
            try {
                var out = [];
                var seen = {};
                
                // Grab ALL links on the page
                document.querySelectorAll('a').forEach(function(a) {
                    // Get the text from inside the link, or fall back to aria-label
                    var t = (a.innerText || a.getAttribute('aria-label') || '').trim();
                    
                    // Filter out short/long garbage, and strip out extra whitespace/newlines
                    t = t.replace(/\s+/g, ' ');
                    if (t.length < 15 || t.length > 160) return;
                    
                    // Ignore generic UI links
                    if (t.toLowerCase() === 'read more' || t.toLowerCase() === 'see all' || t.toLowerCase().includes('sign in')) return;
                    
                    if (seen[t]) return;
                    seen[t] = 1;
                    out.push(t);
                });
                
                // Take the first 25 valid headlines we found
                out = out.slice(0, 25);
                console.log('__OTTER_FACTS__:' + JSON.stringify(out));
            } catch(e) {
                console.log('__OTTER_FACTS__:' + JSON.stringify([]));
            }
        })();
        """
        self.runJavaScript(js)
        self._voice_shim_installed = True


    # ── existing nav guard / cert handling (unchanged) ─────────────────
    def createWindow(self, _type):
        browser = self.parent().window()
        if not hasattr(browser, 'open_pip'):
            return super().createWindow(_type)
        
        # Get the URL that triggered this popup
        # We need to give Qt a blank page to load into, but tell it to use our PiP instead
        # of a real popup window (which QtWebEngine handles poorly).
        
        # 1. Create the PiP window with a placeholder URL
        current_url = self.url().toString() or "about:blank"
        
        # Use the browser's local profile to avoid auth conflicts on sign-ins
        prof = browser.local_profile if is_local_url(QUrl(current_url)) else browser.profile
        
        # 2. Open it in a PiP window
        # Note: The actual target URL is captured by `urlChanged` inside the PipWindow automatically
        # when the page loads its next redirect.
        
        # We create it with `_type` as a hint, then let the page navigate naturally
        pip = PipWindow(current_url, prof, parent=browser, on_top=True)
        pip.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose, True)
        pip.show()
        browser._pips.append(pip)
        
        # 3. Return the pip's view page so Qt can inject the popup target URL into it
        return pip.view.page()

    def acceptNavigationRequest(self, url, nav_type, is_main_frame):
        u = url.toString().lower()
        if is_main_frame and nav_type == QWebEnginePage.NavigationType.NavigationTypeOther:
            if not any(safe in u for safe in ["onhockey", "new.video", "localhost",
                                               "youtube", "google", "duckduckgo",
                                               "duck.ai"]):
                log_event("adblock-redirect", u)
                return False
        if SETTINGS.get("adblock", True) and is_main_frame:
            if any(tok in u for tok in AD_BLOCKLIST):
                log_event("adblock", u); return False
        return super().acceptNavigationRequest(url, nav_type, is_main_frame)

    def certificateError(self, error):
        try: host = error.url().host()
        except Exception: host = ""
        if host in LOCAL_HOSTS or host in TRUSTED:
            error.acceptCertificate(); return True
        try:
            r = QMessageBox.question(None, "🦦 Otter — Certificate",
                f"Accept certificate for {host}?\n\n{error.description()}",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
            if r == QMessageBox.StandardButton.Yes:
                TRUSTED.add(host); error.acceptCertificate(); return True
        except Exception: pass
        return super().certificateError(error)


# ────────────────────────────────────────────────────────────────────────────
# Voice bridge — reuses pluto.py4's working mic pipeline
# ────────────────────────────────────────────────────────────────────────────
try:
    import speech_recognition as sr
    _SR_AVAILABLE = True
except ImportError:
    _SR_AVAILABLE = False
    print("[otter] speech_recognition not installed — voice input disabled")

PLUTO_LOG = Path("/Users/olympynetworkco/Desktop/data/pluto.log")
PLUTO_TXT = Path("/Users/olympynetworkco/Desktop/data/pluto.txt")
PLUTO_LOG.parent.mkdir(parents=True, exist_ok=True)


def _pluto_log(text, glyphs=""):
    """Same log shape pluto.py4 uses."""
    stamp = datetime.now().isoformat()
    line = f"{stamp} | {text}\n{glyphs}\n"
    try:
        with open(PLUTO_LOG, "a", encoding="utf-8") as f: f.write(line)
        with open(PLUTO_TXT, "a", encoding="utf-8") as f: f.write(line)
    except Exception as e:
        print(f"[otter/voice] log fail: {e}")


def _sister_whisper_filter(text):
    if not text or len(text.strip()) < 2:
        return None
    return text.strip()


def otter_listen(should_stop=None):
    """Same as pluto.py4's listen, but can be told to stop."""
    if not _SR_AVAILABLE:
        return None
    stop = should_stop or (lambda: False)

    try:
        r = sr.Recognizer()
        r.pause_threshold = 4
        with sr.Microphone() as source:
            r.adjust_for_ambient_noise(source, duration=1)
            if stop():
                return None

            print("\n⠋Listening... (4 second silence to stop)")
            audio = None
            while audio is None:
                if stop():
                    return None
                try:
                    audio = r.listen(source, timeout=1)   # re-checks stop every second
                except sr.WaitTimeoutError:
                    continue

            if stop():
                return None
            text = r.recognize_google(audio)
            filtered = _sister_whisper_filter(text)
            if filtered:
                print(f"🎤 transcribed: {filtered}")
                _pluto_log(f"otter-transcribed: {filtered}", "🎤︎︎")
            return filtered

    except sr.UnknownValueError:
        print("Could not understand audio")
        return None
    except sr.RequestError as e:
        print(f"API error: {e}")
        return None
    except Exception as e:
        print(f"Error: {e}")
        return None


# ────────────────────────────────────────────────────────────────────────────
#class SpeechBridge(QObject):
# ────────────────────────────────────────────────────────────────────────────

class SpeechBridge(QObject):
    textReady    = Signal(str)
    stateChanged = Signal(str)

    def __init__(self, parent=None):
        super().__init__(parent)
        self._running = False
        self._gen = 0

    def _alive(self, gen):
        return self._running and gen == self._gen

    def start_listening(self):
        if self._running: return
        self._running = True
        self._gen += 1
        import threading
        threading.Thread(target=self._loop, args=(self._gen,), daemon=True).start()
        self.stateChanged.emit("listening")

    def stop_listening(self):
        self._running = False
        self._gen += 1                      # any in-flight listen is now stale
        self.stateChanged.emit("idle")

    def _loop(self, gen):
        while self._alive(gen):
            t = otter_listen(lambda: not self._alive(gen))
            if t and len(t.strip()) >= 2 and self._alive(gen):
                self.textReady.emit(t.strip())

# ────────────────────────────────────────────────────────────────────────────
# PiP window
# ────────────────────────────────────────────────────────────────────────────
class PipWindow(QMainWindow):
    def __init__(self, target, profile, parent=None, on_top=True):
        super().__init__(parent)
        self.setWindowTitle(f"📺 {target[:60]}")
        flags = Qt.WindowType.Window
        if on_top: flags |= Qt.WindowType.WindowStaysOnTopHint
        self.setWindowFlags(flags)
        self.resize(520, 320)
        self.setStyleSheet("QMainWindow { background: #041012; }")

        self.page = OtterPage(profile, self)
        self.view = QWebEngineView(); self.view.setPage(self.page)

        bar = QWidget(); bl = QHBoxLayout(bar)
        bl.setContentsMargins(4,4,4,4); bl.setSpacing(4)

        self.btn_top = make_icon_button("pip", "Always on top", None, size=18, btn_size=30)
        self.btn_top.setCheckable(True); self.btn_top.setChecked(on_top)
        self.btn_top.toggled.connect(self._toggle_on_top)
        bl.addWidget(self.btn_top)

        self.btn_mute = QPushButton("🔊"); self.btn_mute.setCheckable(True)
        self.btn_mute.setFixedSize(32, 28); self.btn_mute.toggled.connect(self._toggle_mute)
        bl.addWidget(self.btn_mute)

        bl.addStretch()
        b_close = make_icon_button("close", "Close", self.close, size=16, btn_size=30)
        bl.addWidget(b_close)

        central = QWidget(); v = QVBoxLayout(central); v.setContentsMargins(0,0,0,0)
        v.addWidget(bar); v.addWidget(self.view, stretch=1)
        self.setCentralWidget(central)

        url = QUrl(target)
        if not target.startswith(("http://","https://","file://","about:")):
            p = Path(target).expanduser()
            if p.exists(): url = QUrl.fromLocalFile(str(p.resolve()))
            else:          url = QUrl("https://" + target)
        self.view.setUrl(url)

        n = len(getattr(parent, "_pips", [])) if parent else 0
        self.move(220 + n * 30, 140 + n * 30)

    def _toggle_on_top(self, on):
        self.setWindowFlag(Qt.WindowType.WindowStaysOnTopHint, on); self.show()
    def _toggle_mute(self, m):
        self.page.setAudioMuted(m); self.btn_mute.setText("🔇" if m else "🔊")
    def closeEvent(self, e):
        self.view.setPage(None); self.view.deleteLater(); self.page.deleteLater()
        super().closeEvent(e)

# ────────────────────────────────────────────────────────────────────────────
# notes app pip
# ────────────────────────────────────────────────────────────────────────────

class NotesWindow(QMainWindow):
    """PiP-style floating notes window, always-on-top, with debounced autosave."""
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("📝 Otter Notes")
        self.resize(520, 480)
        self.setWindowFlag(Qt.WindowType.WindowStaysOnTopHint, True)
        self.setStyleSheet("QMainWindow { background: #041012; }")

        self._save_timer = QTimer(self)
        self._save_timer.setSingleShot(True)
        self._save_timer.setInterval(2000)   # 2s after last keystroke
        self._save_timer.timeout.connect(self._save_now)

        central = QWidget(); v = QVBoxLayout(central)
        v.setContentsMargins(10, 10, 10, 10); v.setSpacing(6)

        # header row
        bar = QWidget(); bl = QHBoxLayout(bar)
        bl.setContentsMargins(0, 0, 0, 0); bl.setSpacing(4)

        self.lbl_status = QLabel("ready")
        self.lbl_status.setStyleSheet("color:#7fe7dc; font-size:11px;")
        bl.addWidget(self.lbl_status)
        bl.addStretch()

        b_save = QPushButton("💾 Save now"); b_save.clicked.connect(self._save_now)
        b_edit = QPushButton("open -e");    b_edit.clicked.connect(self._open_in_textedit)
        b_close = QPushButton("✕");         b_close.clicked.connect(self.close)
        b_close.setFixedWidth(32)
        bl.addWidget(b_save); bl.addWidget(b_edit); bl.addWidget(b_close)
        v.addWidget(bar)

        # editor
        self.editor = QPlainTextEdit()
        self.editor.setPlaceholderText("Take a note…")
        self.editor.textChanged.connect(self._on_edit)
        v.addWidget(self.editor, stretch=1)

        self.setCentralWidget(central)

        self.notes_path   = DATA_DIR / "otter-notes.txt"
        self.notes_json   = DATA_DIR / "otter-notes.json"
        self._load()

    # ── load / save ──────────────────────────────────────────────────
    def _load(self):
        try:
            if self.notes_path.exists():
                self.editor.blockSignals(True)
                self.editor.setPlainText(self.notes_path.read_text(encoding="utf-8"))
                self.editor.blockSignals(False)
                self.lbl_status.setText(f"loaded · {len(self.editor.toPlainText())} chars")
        except Exception as e:
            self.lbl_status.setText(f"⚠ load failed: {e}")

    def _on_edit(self):
        # debounce: restart timer on every keystroke
        self._save_timer.start()

    def _save_now(self):
        text = self.editor.toPlainText()
        try:
            self.notes_path.write_text(text, encoding="utf-8")
            import json as _json
            self.notes_json.write_text(_json.dumps({
                "saved": datetime.now().isoformat(),
                "chars": len(text),
            }, indent=2), encoding="utf-8")
            self.lbl_status.setText(f"✓ saved {datetime.now().strftime('%H:%M:%S')} · {len(text)} chars")
        except Exception as e:
            self.lbl_status.setText(f"⚠ save failed: {e}")

    # ── open -e in TextEdit ──────────────────────────────────────────
    def _open_in_textedit(self):
        try:
            self._save_now()  # flush first so TextEdit sees latest
            import subprocess
            subprocess.Popen(["open", "-e", str(self.notes_path)])
            self.lbl_status.setText("→ opened in TextEdit")
        except Exception as e:
            self.lbl_status.setText(f"⚠ open failed: {e}")

    # ── cleanup ──────────────────────────────────────────────────────
    def closeEvent(self, e):
        # flush any pending autosave before vanishing
        if self._save_timer.isActive():
            self._save_timer.stop()
            self._save_now()
        super().closeEvent(e)

