# ────────────────────────────────────────────────────────────────────────────
# Persistence
# ────────────────────────────────────────────────────────────────────────────
def _load_json(path, default):
    try:
        if path.exists():
            return json.loads(path.read_text(encoding="utf-8"))
    except Exception as e:
        print(f"[otter] load {path.name}: {e}")
    return default

def _save_json(path, data):
    try:
        path.write_text(json.dumps(data, indent=2), encoding="utf-8")
    except Exception as e:
        print(f"[otter] save {path.name}: {e}")

def log_event(kind, payload):
    stamp = datetime.now().isoformat()
    try:
        with open(OTTER_LOG, "a", encoding="utf-8") as f:
            f.write(f"{stamp} | {kind} | {payload}\n")
    except Exception: pass
    try:
        hist = _load_json(OTTER_HISTORY, [])
        hist.append({"ts": stamp, "kind": kind, "payload": str(payload)})
        _save_json(OTTER_HISTORY, hist[-5000:])
    except Exception: pass

class Settings:
    def __init__(self):
        self.data = _load_json(OTTER_SETTINGS, {})
        self.data.setdefault("search_engine", "DuckDuckGo")
        self.data.setdefault("custom_ua", False)
        self.data.setdefault("adblock", True)
        self.data.setdefault("restore_session", True)
        self.data.setdefault("pip_on_top", True)
        self.data.setdefault("home", HOME_PAGE)
        self.data.setdefault("side_panel_width", 280)
    def get(self, k, d=None): return self.data.get(k, d)
    def set(self, k, v):
        self.data[k] = v
        _save_json(OTTER_SETTINGS, self.data)
SETTINGS = Settings()

class Bookmarks:
    def __init__(self):
        self.items = _load_json(OTTER_BOOKMARKS, [
            {"title": "DuckDuckGo", "url": HOME_PAGE},
            {"title": "GitHub",     "url": "https://github.com"},
        ])
    def add(self, title, url):
        if not url: return
        for it in self.items:
            if it["url"] == url: return
        self.items.insert(0, {"title": title or url, "url": url})
        _save_json(OTTER_BOOKMARKS, self.items)
    def remove(self, url):
        self.items = [i for i in self.items if i["url"] != url]
        _save_json(OTTER_BOOKMARKS, self.items)
BOOKMARKS = Bookmarks()

