def load_accounts():
    """log.json equivalent — stores METADATA only, never passwords."""
    default = [
        {"id": "acct1", "label": "Personal", "email": "you1@gmail.com", "color": "#7fe7dc"},
        {"id": "acct2", "label": "Work",     "email": "you2@gmail.com", "color": "#ffb84d"},
        {"id": "acct3", "label": "Alt",      "email": "you3@gmail.com", "color": "#ff5a5a"},
    ]
    return _load_json(OTTER_ACCOUNTS, default)

def save_accounts(accounts):
    _save_json(OTTER_ACCOUNTS, accounts)


class TrustedHosts:
    def __init__(self):
        self.hosts = set(_load_json(OTTER_TRUSTED, list(LOCAL_HOSTS)))
    def add(self, h):
        self.hosts.add(h); _save_json(OTTER_TRUSTED, sorted(self.hosts))
    def __contains__(self, h): return h in self.hosts
TRUSTED = TrustedHosts()

def is_local_url(qurl):
    try: return qurl.host() in LOCAL_HOSTS or qurl.host() in TRUSTED
    except Exception: return False

def normalize(text: str):
    text = (text or "").strip()
    if not text: return None
    p = Path(text).expanduser()
    if p.exists(): return p.resolve().as_uri()
    if text.startswith(("http://","https://","file://","about:","data:","view-source:")):
        return text
    if "." in text and " " not in text and not text.startswith("?"):
        return "https://" + text
    engine = SETTINGS.get("search_engine", "DuckDuckGo")
    return SEARCH_ENGINES.get(engine, SEARCH_ENGINES["DuckDuckGo"]).format(quote_plus(text))

# ────────────────────────────────────────────────────────────────────────────
# Vector icons (drawn, no external assets)
# ────────────────────────────────────────────────────────────────────────────
def _pen(color, w=1.8):
    p = QPen(QColor(color)); p.setWidthF(w)
    p.setCapStyle(Qt.PenCapStyle.RoundCap); p.setJoinStyle(Qt.PenJoinStyle.RoundJoin)
    return p

def draw_icon(name: str, size: int = 22, color: str = "#7fe7dc") -> QPixmap:
    pm = QPixmap(size, size); pm.fill(Qt.GlobalColor.transparent)
    p = QPainter(pm); p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setPen(_pen(color))
    p.setBrush(Qt.BrushStyle.NoBrush)
    s = size
    m = s * 0.18  # margin

    if name == "home":
        p.drawPolyline(QPolygonF([
            QRectF(0,0,0,0).topLeft().__class__(m, s*0.55),
        ]))
        # house
        p.drawLine(int(m), int(s*0.55), int(s/2), int(m))
        p.drawLine(int(s/2), int(m), int(s-m), int(s*0.55))
        p.drawRect(int(m+2), int(s*0.55), int(s-2*m-4), int(s*0.28))
        # door
        p.drawRect(int(s/2 - s*0.06), int(s*0.68), int(s*0.12), int(s*0.15))

    elif name == "plus":
        p.drawLine(int(s/2), int(m), int(s/2), int(s-m))
        p.drawLine(int(m), int(s/2), int(s-m), int(s/2))

    elif name == "search":
        r = s*0.28
        p.drawEllipse(QRectF(m, m, r*2, r*2))
        p.drawLine(int(m+r*1.7), int(m+r*1.7), int(s-m), int(s-m))

    elif name == "bookmark":
        path = QPainterPath()
        path.moveTo(m, m)
        path.lineTo(s-m, m)
        path.lineTo(s-m, s-m)
        path.lineTo(s/2, s*0.65)
        path.lineTo(m, s-m)
        path.closeSubpath()
        p.drawPath(path)

    elif name == "clock":
        r = s/2 - m
        p.drawEllipse(QRectF(m, m, r*2, r*2))
        p.drawLine(int(s/2), int(s/2), int(s/2), int(m + r*0.5))
        p.drawLine(int(s/2), int(s/2), int(s/2 + r*0.55), int(s/2))

    elif name == "download":
        p.drawLine(int(s/2), int(m), int(s/2), int(s*0.62))
        p.drawPolyline(QPolygonF([
            QRectF(0,0,0,0).topLeft().__class__(int(s*0.32), int(s*0.42)),
            QRectF(0,0,0,0).topLeft().__class__(int(s/2), int(s*0.66)),
            QRectF(0,0,0,0).topLeft().__class__(int(s*0.68), int(s*0.42)),
        ]))
        p.drawLine(int(m), int(s-m), int(s-m), int(s-m))

    elif name == "pip":
        p.drawRect(int(m), int(m), int(s-2*m), int(s-2*m))
        p.drawRect(int(s*0.4), int(s*0.4), int(s*0.42), int(s*0.34))

    elif name == "reader":
        for i, y in enumerate([0.3, 0.45, 0.6, 0.75]):
            x2 = s-m if i % 2 == 0 else s*0.75
            p.drawLine(int(m), int(s*y), int(x2), int(s*y))

    elif name == "camera":
        p.drawRect(int(m), int(s*0.32), int(s-2*m), int(s*0.5))
        p.drawEllipse(QRectF(s*0.32, s*0.42, s*0.36, s*0.36))
        p.drawLine(int(m + s*0.15), int(s*0.32), int(m + s*0.2), int(s*0.22))
        p.drawLine(int(m + s*0.2),  int(s*0.22), int(s*0.6),     int(s*0.22))

    elif name == "devtools":
        p.drawLine(int(m), int(s/2), int(s*0.35), int(s*0.2))
        p.drawLine(int(m), int(s/2), int(s*0.35), int(s*0.8))
        p.drawLine(int(s-m), int(s/2), int(s*0.65), int(s*0.2))
        p.drawLine(int(s-m), int(s/2), int(s*0.65), int(s*0.8))
        p.drawLine(int(s*0.42), int(s*0.7), int(s*0.58), int(s*0.3))

    elif name == "settings":
        # gear
        cx, cy, r = s/2, s/2, s*0.22
        p.drawEllipse(QRectF(cx-r, cy-r, r*2, r*2))
        for i in range(8):
            a = i * math.pi/4
            x1 = cx + math.cos(a) * (r + 1)
            y1 = cy + math.sin(a) * (r + 1)
            x2 = cx + math.cos(a) * (r + 4)
            y2 = cy + math.sin(a) * (r + 4)
            p.drawLine(int(x1), int(y1), int(x2), int(y2))

    elif name == "back":
        p.drawPolyline(QPolygonF([
            QRectF(0,0,0,0).topLeft().__class__(int(s*0.6), int(m)),
            QRectF(0,0,0,0).topLeft().__class__(int(m),     int(s/2)),
            QRectF(0,0,0,0).topLeft().__class__(int(s*0.6), int(s-m)),
        ]))

    elif name == "forward":
        p.drawPolyline(QPolygonF([
            QRectF(0,0,0,0).topLeft().__class__(int(s*0.4), int(m)),
            QRectF(0,0,0,0).topLeft().__class__(int(s-m),   int(s/2)),
            QRectF(0,0,0,0).topLeft().__class__(int(s*0.4), int(s-m)),
        ]))

    elif name == "reload":
        r = s/2 - m
        p.drawArc(QRectF(m, m, r*2, r*2), 45*16, 270*16)
        p.drawLine(int(s/2 + r*0.7), int(s/2 - r*0.5),
                   int(s/2 + r*0.9), int(s/2 - r*0.9))
        p.drawLine(int(s/2 + r*0.7), int(s/2 - r*0.5),
                   int(s/2 + r*0.3), int(s/2 - r*0.4))

    elif name == "close":
        p.drawLine(int(m), int(m), int(s-m), int(s-m))
        p.drawLine(int(s-m), int(m), int(m), int(s-m))

    elif name == "menu":
        for y in [0.32, 0.5, 0.68]:
            p.drawLine(int(m), int(s*y), int(s-m), int(s*y))

    elif name == "sun":  # incognito-ish mask
        p.drawEllipse(QRectF(m, m, s-2*m, s-2*m))
        p.drawLine(int(m + s*0.15), int(s*0.55), int(s-m-s*0.15), int(s*0.55))

    elif name == "music":
        p.drawLine(int(s*0.4), int(s*0.2), int(s*0.4), int(s*0.7))
        p.drawLine(int(s*0.4), int(s*0.2), int(s*0.8), int(s*0.2))
        p.drawLine(int(s*0.8), int(s*0.2), int(s*0.8), int(s*0.6))
        p.drawEllipse(QRectF(s*0.25, s*0.6, s*0.3, s*0.2))
        p.drawEllipse(QRectF(s*0.65, s*0.5, s*0.3, s*0.2))

    p.end()
    return pm

def make_icon_button(name, tooltip, slot=None, size=22, btn_size=38, color="#7fe7dc"):
    b = QToolButton()
    b.setIcon(QIcon(draw_icon(name, size, color)))
    b.setIconSize(QSize(size, size))
    b.setFixedSize(btn_size, btn_size)
    b.setToolTip(tooltip)
    b.setAutoRaise(True)
    b.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
    b.setStyleSheet("""
        QToolButton { background: transparent; border: none; border-radius: 8px; }
        QToolButton:hover   { background: rgba(15,155,142,0.28); }
        QToolButton:pressed { background: rgba(255,184,77,0.35); }
        QToolButton:checked { background: rgba(15,155,142,0.45); }
    """)
    if slot: b.clicked.connect(slot)
    return b

