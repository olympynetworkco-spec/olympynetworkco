# ── Google OAuth: system-browser loopback ─────────────────────────────
GOOGLE_REDIRECT_PORT = 8765
GOOGLE_REDIRECT_URI  = f"http://127.0.0.1:{GOOGLE_REDIRECT_PORT}/oauth2callback"
GOOGLE_SCOPES = [
    "https://www.googleapis.com/auth/gmail.readonly",
    "https://www.googleapis.com/auth/userinfo.email",
    "https://www.googleapis.com/auth/userinfo.profile",
]

class _OAuthCatcher(BaseHTTPRequestHandler):
    def do_GET(self):
        params = parse_qs(urlparse(self.path).query)
        self.server.captured = {
            "code":  params.get("code",  [None])[0],
            "state": params.get("state", [None])[0],
            "error": params.get("error", [None])[0],
        }
        body = b"""<!doctype html><html><body style="font-family:-apple-system,sans-serif;
        background:#0b1a1f;color:#eaf7f2;text-align:center;padding-top:80px;">
        <h1 style="color:#7fe7dc;">&#129446; Otter got it</h1>
        <p>You can close this tab and return to Otter.</p></body></html>"""
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
    def log_message(self, *a):
        pass


def _catch_oauth_redirect(timeout=180):
    """Block on a background thread until Google redirects back. Returns dict or None."""
    try:
        server = HTTPServer(("127.0.0.1", GOOGLE_REDIRECT_PORT), _OAuthCatcher)
    except OSError as e:
        print(f"[otter/oauth] port {GOOGLE_REDIRECT_PORT} busy: {e}")
        return None
    server.timeout = timeout
    server.captured = None
    server.handle_request()
    server.server_close()
    return server.captured



def google_sign_in(browser, on_done):
    """
    System-browser OAuth for Google.
    Uses google_auth_oauthlib (same as ollama.py4's Gmail flow).
    Reads GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from env.txt via dotenv.
    """
    import os
    client_id     = os.getenv("GOOGLE_CLIENT_ID")
    client_secret = os.getenv("GOOGLE_CLIENT_SECRET")

    if not client_id or not client_secret:
        QMessageBox.warning(
            browser, "Otter — Google sign-in",
            "GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET not found.\n\n"
            "Put them in your env.txt (same file Ollama uses):\n"
            "  GOOGLE_CLIENT_ID=...\n"
            "  GOOGLE_CLIENT_SECRET=...\n\n"
            "Then add http://127.0.0.1:8765/oauth2callback to that\n"
            "OAuth client's Authorized redirect URIs in Google Console."
        )
        on_done(None)
        return

    flow = Flow.from_client_config(
        {
            "installed": {
                "client_id":     client_id,
                "client_secret": client_secret,
                "auth_uri":      "https://accounts.google.com/o/oauth2/auth",
                "token_uri":     "https://oauth2.googleapis.com/token",
                "redirect_uris": [GOOGLE_REDIRECT_URI],
            }
        },
        scopes=GOOGLE_SCOPES,
        redirect_uri=GOOGLE_REDIRECT_URI,
    )

    auth_url, state = flow.authorization_url(
        access_type="offline",
        prompt="consent",
        include_granted_scopes="true",
    )

    captured = {"value": None}
    listener = threading.Thread(
        target=lambda: captured.update(value=_catch_oauth_redirect()),
        daemon=True,
    )
    listener.start()


    import subprocess

    print(f"[otter/oauth] Handing off to Safari: {auth_url[:80]}...")


    print(f"\n[OTTER-DEBUG] FULL URL → {auth_url}\n")

    subprocess.Popen(["open", "-a", "Firefox", auth_url])

    browser.statusBar().showMessage(
        "🌐 Finish sign-in in your browser, then return to Otter…", 6000
    )

    def _poll():
        if captured["value"] is None:
            if not listener.is_alive():
                QMessageBox.warning(browser, "Otter — Google sign-in",
                                    "Sign-in window closed or timed out.")
                on_done(None)
                return
            QTimer.singleShot(300, _poll)
            return

        result = captured["value"]
        if result.get("error"):
            QMessageBox.warning(browser, "Otter — Google sign-in",
                                f"Google returned: {result['error']}")
            on_done(None)
            return
        if not result.get("code"):
            QMessageBox.warning(browser, "Otter — Google sign-in",
                                "No authorization code returned.")
            on_done(None)
            return
        if result.get("state") != state:
            QMessageBox.warning(browser, "Otter — Google sign-in",
                                "State mismatch (possible CSRF). Aborting.")
            on_done(None)
            return

        try:
            flow.fetch_token(code=result["code"])
            creds = flow.credentials
        except Exception as e:
            QMessageBox.warning(browser, "Otter — Google sign-in",
                                f"Token exchange failed:\n{e}")
            on_done(None)
            return

        _fetch_profile_and_save(browser, creds, on_done)

    QTimer.singleShot(300, _poll)


def _fetch_profile_and_save(browser, creds, on_done):
    """Use the token to hit Google's userinfo endpoint, then save."""
    import requests
    try:
        r = requests.get(
            "https://www.googleapis.com/oauth2/v2/userinfo",
            headers={"Authorization": f"Bearer {creds.token}"},
            timeout=15,
        )
        info = r.json() if r.status_code == 200 else {}
    except Exception as e:
        QMessageBox.warning(browser, "Otter — Google sign-in",
                            f"Could not fetch profile: {e}")
        on_done(None)
        return

    email = info.get("email", "unknown@gmail.com")
    name  = info.get("name") or email.split("@")[0]

    account = {
        "id":     "g-" + secrets.token_hex(4),
        "label":  name,
        "email":  email,
        "color":  "#7fe7dc",
        "tokens": {
            "access_token":  creds.token,
            "refresh_token": creds.refresh_token,
            "expiry":        creds.expiry.isoformat() if creds.expiry else None,
            "scopes":        list(creds.scopes or []),
        },
    }

    accounts = load_accounts()
    if not isinstance(accounts, list):
        accounts = []
    accounts = [a for a in accounts if a.get("email") != email]
    accounts.append(account)
    save_accounts(accounts)
    on_done(account)



def load_accounts():
    """log.json equivalent — stores METADATA only, never passwords."""
    default = [
        {"id": "acct1", "label": "Personal", "email": "@gmail.com", "color": "#7fe7dc"},
        {"id": "acct2", "label": "Work",     "email": "@gmail.com", "color": "#ffb84d"},
        {"id": "acct3", "label": "Alt",      "email": "@gmail.com", "color": "#ff5a5a"},
    ]
    return _load_json(OTTER_ACCOUNTS, default)

def save_accounts(accounts):
    _save_json(OTTER_ACCOUNTS, accounts)


class TrustedHosts:
    def __init__(self):
        self.hosts = set(_load_json(OTTER_TRUSTED, list(LOCAL_HOSTS)))
    def add(self, h):
        self.hosts.add(h); _save_json(OTTER_TRUSTED, sorted(self.hosts))
    def __contains__(self, h): return h in self.hosts
TRUSTED = TrustedHosts()

def is_local_url(qurl):
    try: return qurl.host() in LOCAL_HOSTS or qurl.host() in TRUSTED
    except Exception: return False

def normalize(text: str):
    text = (text or "").strip()
    if not text: return None
    p = Path(text).expanduser()
    if p.exists(): return p.resolve().as_uri()
    if text.startswith(("http://","https://","file://","about:","data:","view-source:")):
        return text
    if "." in text and " " not in text and not text.startswith("?"):
        return "https://" + text
    engine = SETTINGS.get("search_engine", "DuckDuckGo")
    return SEARCH_ENGINES.get(engine, SEARCH_ENGINES["DuckDuckGo"]).format(quote_plus(text))

# ────────────────────────────────────────────────────────────────────────────
# Vector icons (drawn, no external assets)
# ────────────────────────────────────────────────────────────────────────────
def _pen(color, w=1.8):
    p = QPen(QColor(color)); p.setWidthF(w)
    p.setCapStyle(Qt.PenCapStyle.RoundCap); p.setJoinStyle(Qt.PenJoinStyle.RoundJoin)
    return p

def draw_icon(name: str, size: int = 22, color: str = "#7fe7dc") -> QPixmap:
    pm = QPixmap(size, size); pm.fill(Qt.GlobalColor.transparent)
    p = QPainter(pm); p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setPen(_pen(color))
    p.setBrush(Qt.BrushStyle.NoBrush)
    s = size
    m = s * 0.18  # margin

    if name == "home":
        p.drawPolyline(QPolygonF([
            QRectF(0,0,0,0).topLeft().__class__(m, s*0.55),
        ]))
        # house
        p.drawLine(int(m), int(s*0.55), int(s/2), int(m))
        p.drawLine(int(s/2), int(m), int(s-m), int(s*0.55))
        p.drawRect(int(m+2), int(s*0.55), int(s-2*m-4), int(s*0.28))
        # door
        p.drawRect(int(s/2 - s*0.06), int(s*0.68), int(s*0.12), int(s*0.15))

    elif name == "plus":
        p.drawLine(int(s/2), int(m), int(s/2), int(s-m))
        p.drawLine(int(m), int(s/2), int(s-m), int(s/2))

    elif name == "search":
        r = s*0.28
        p.drawEllipse(QRectF(m, m, r*2, r*2))
        p.drawLine(int(m+r*1.7), int(m+r*1.7), int(s-m), int(s-m))

    elif name == "bookmark":
        path = QPainterPath()
        path.moveTo(m, m)
        path.lineTo(s-m, m)
        path.lineTo(s-m, s-m)
        path.lineTo(s/2, s*0.65)
        path.lineTo(m, s-m)
        path.closeSubpath()
        p.drawPath(path)

    elif name == "clock":
        r = s/2 - m
        p.drawEllipse(QRectF(m, m, r*2, r*2))
        p.drawLine(int(s/2), int(s/2), int(s/2), int(m + r*0.5))
        p.drawLine(int(s/2), int(s/2), int(s/2 + r*0.55), int(s/2))

    elif name == "download":
        p.drawLine(int(s/2), int(m), int(s/2), int(s*0.62))
        p.drawPolyline(QPolygonF([
            QRectF(0,0,0,0).topLeft().__class__(int(s*0.32), int(s*0.42)),
            QRectF(0,0,0,0).topLeft().__class__(int(s/2), int(s*0.66)),
            QRectF(0,0,0,0).topLeft().__class__(int(s*0.68), int(s*0.42)),
        ]))
        p.drawLine(int(m), int(s-m), int(s-m), int(s-m))

    elif name == "pip":
        p.drawRect(int(m), int(m), int(s-2*m), int(s-2*m))
        p.drawRect(int(s*0.4), int(s*0.4), int(s*0.42), int(s*0.34))

    elif name == "reader":
        for i, y in enumerate([0.3, 0.45, 0.6, 0.75]):
            x2 = s-m if i % 2 == 0 else s*0.75
            p.drawLine(int(m), int(s*y), int(x2), int(s*y))

    elif name == "camera":
        p.drawRect(int(m), int(s*0.32), int(s-2*m), int(s*0.5))
        p.drawEllipse(QRectF(s*0.32, s*0.42, s*0.36, s*0.36))
        p.drawLine(int(m + s*0.15), int(s*0.32), int(m + s*0.2), int(s*0.22))
        p.drawLine(int(m + s*0.2),  int(s*0.22), int(s*0.6),     int(s*0.22))

    elif name == "devtools":
        p.drawLine(int(m), int(s/2), int(s*0.35), int(s*0.2))
        p.drawLine(int(m), int(s/2), int(s*0.35), int(s*0.8))
        p.drawLine(int(s-m), int(s/2), int(s*0.65), int(s*0.2))
        p.drawLine(int(s-m), int(s/2), int(s*0.65), int(s*0.8))
        p.drawLine(int(s*0.42), int(s*0.7), int(s*0.58), int(s*0.3))

    elif name == "settings":
        # gear
        cx, cy, r = s/2, s/2, s*0.22
        p.drawEllipse(QRectF(cx-r, cy-r, r*2, r*2))
        for i in range(8):
            a = i * math.pi/4
            x1 = cx + math.cos(a) * (r + 1)
            y1 = cy + math.sin(a) * (r + 1)
            x2 = cx + math.cos(a) * (r + 4)
            y2 = cy + math.sin(a) * (r + 4)
            p.drawLine(int(x1), int(y1), int(x2), int(y2))

    elif name == "back":
        p.drawPolyline(QPolygonF([
            QRectF(0,0,0,0).topLeft().__class__(int(s*0.6), int(m)),
            QRectF(0,0,0,0).topLeft().__class__(int(m),     int(s/2)),
            QRectF(0,0,0,0).topLeft().__class__(int(s*0.6), int(s-m)),
        ]))

    elif name == "forward":
        p.drawPolyline(QPolygonF([
            QRectF(0,0,0,0).topLeft().__class__(int(s*0.4), int(m)),
            QRectF(0,0,0,0).topLeft().__class__(int(s-m),   int(s/2)),
            QRectF(0,0,0,0).topLeft().__class__(int(s*0.4), int(s-m)),
        ]))

    elif name == "reload":
        r = s/2 - m
        p.drawArc(QRectF(m, m, r*2, r*2), 45*16, 270*16)
        p.drawLine(int(s/2 + r*0.7), int(s/2 - r*0.5),
                   int(s/2 + r*0.9), int(s/2 - r*0.9))
        p.drawLine(int(s/2 + r*0.7), int(s/2 - r*0.5),
                   int(s/2 + r*0.3), int(s/2 - r*0.4))

    elif name == "close":
        p.drawLine(int(m), int(m), int(s-m), int(s-m))
        p.drawLine(int(s-m), int(m), int(m), int(s-m))

    elif name == "menu":
        for y in [0.32, 0.5, 0.68]:
            p.drawLine(int(m), int(s*y), int(s-m), int(s*y))

    elif name == "sun":  # incognito-ish mask
        p.drawEllipse(QRectF(m, m, s-2*m, s-2*m))
        p.drawLine(int(m + s*0.15), int(s*0.55), int(s-m-s*0.15), int(s*0.55))

    elif name == "music":
        p.drawLine(int(s*0.4), int(s*0.2), int(s*0.4), int(s*0.7))
        p.drawLine(int(s*0.4), int(s*0.2), int(s*0.8), int(s*0.2))
        p.drawLine(int(s*0.8), int(s*0.2), int(s*0.8), int(s*0.6))
        p.drawEllipse(QRectF(s*0.25, s*0.6, s*0.3, s*0.2))
        p.drawEllipse(QRectF(s*0.65, s*0.5, s*0.3, s*0.2))


    elif name == "globe":
        cx, cy = s/2, s/2
        r = s*0.32
        p.drawEllipse(QRectF(cx-r, cy-r, r*2, r*2))
        p.drawLine(int(cx-r), int(cy), int(cx+r), int(cy))
        p.drawLine(int(cx), int(cy-r), int(cx), int(cy+r))
        p.drawArc(QRectF(cx-r*0.55, cy-r, r*1.1, r*2), 90*16, 180*16)
        p.drawArc(QRectF(cx-r*0.55, cy-r, r*1.1, r*2), -90*16, 180*16)


    elif name == "notes":
        # small notepad: rounded rect + top clip + lines
        w, h = s*0.62, s*0.72
        x0, y0 = (s - w) / 2, (s - h) / 2
        # outer page
        p.drawRoundedRect(QRectF(x0, y0, w, h), s*0.06, s*0.06)
        # top binding strip
        p.drawLine(int(x0 + w*0.15), int(y0 + h*0.12),
                   int(x0 + w*0.85), int(y0 + h*0.12))
        # ruled lines
        for i, y in enumerate([0.35, 0.52, 0.69]):
            p.drawLine(int(x0 + w*0.18), int(y0 + h*y),
                       int(x0 + w*(0.55 + 0.2*i)), int(y0 + h*y))








    elif name == "mic":
        # Mic capsule
        p.drawRoundedRect(QRectF(s*0.35, m, s*0.3, s*0.45), s*0.15, s*0.15)
        # Mic stand
        p.drawArc(QRectF(s*0.25, s*0.35, s*0.5, s*0.3), 180*16, 180*16)
        # Stem and base
        p.drawLine(int(s/2), int(s*0.65), int(s/2), int(s*0.8))
        p.drawLine(int(s*0.35), int(s*0.8), int(s*0.65), int(s*0.8))


    elif name == "user":
        # head
        p.drawEllipse(QRectF(s*0.32, s*0.18, s*0.36, s*0.36))
        # shoulders
        p.drawArc(QRectF(s*0.20, s*0.60, s*0.60, s*0.42), 0, 180*16)



    p.end()
    return pm

def make_icon_button(name, tooltip, slot=None, size=22, btn_size=38, color="#7fe7dc"):
    b = QToolButton()
    b.setIcon(QIcon(draw_icon(name, size, color)))
    b.setIconSize(QSize(size, size))
    b.setFixedSize(btn_size, btn_size)
    b.setToolTip(tooltip)
    b.setAutoRaise(True)
    b.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
    b.setStyleSheet("""
        QToolButton { background: transparent; border: none; border-radius: 8px; }
        QToolButton:hover   { background: rgba(15,155,142,0.28); }
        QToolButton:pressed { background: rgba(255,184,77,0.35); }
        QToolButton:checked { background: rgba(15,155,142,0.45); }
    """)
    if slot: b.clicked.connect(slot)
    return b

