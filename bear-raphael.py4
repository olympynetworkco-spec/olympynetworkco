# ═══════════════════════════════════════════════════════════════
# SECTION 2: BEAR BOX FILLER SYSTEM
# ═══════════════════════════════════════════════════════════════

def wrap_text(text, width):
    words = text.split()
    lines = []
    current = ""
    for word in words:
        if len(current) + len(word) + 1 <= width:
            current += (" " if current else "") + word
        else:
            if current:
                lines.append(current)
            current = word
    if current:
        lines.append(current)
    return lines

def draw_box(content, width=BOX_WIDTH, max_lines=BOX_HEIGHT):
    lines = []
    lines.append(TOP_LEFT + HORIZ * (width - 2) + TOP_RIGHT)
    
    if isinstance(content, str):
        content = [content]
    
    fitted = []
    for item in content:
        if isinstance(item, str):
            if len(item) <= width - 2:
                fitted.append(item)
            else:
                wrapped = wrap_text(item, width - 4)
                fitted.extend(wrapped)
        else:
            fitted.extend(item)
    
    while len(fitted) < max_lines:
        fitted.append("")
    
    if len(fitted) > max_lines:
        fitted = fitted[:max_lines]
    
    for line in fitted:
        if len(line) > width - 2:
            line = line[:width - 5] + "..."
        padding = width - len(line) - 3
        if padding < 0:
            padding = 0
        lines.append(VERT + " " + line + " " * padding + VERT)
    
    lines.append(BOT_LEFT + HORIZ * (width - 2) + BOT_RIGHT)
    return lines

def draw_divider():
    return "|" + HORIZ * 50 + "|"

def fetch_html(url):
    try:
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        req = urllib.request.Request(url, headers={'User-Agent': 'Raphael-Bear/1.0'})
        with urllib.request.urlopen(req, timeout=15, context=ctx) as r:
            return r.read().decode('utf-8', errors='ignore')
    except Exception as e:
        return f"Error: {e}"

def generate_qr(url, path):
    try:
        q = qrcode.QRCode(box_size=4, border=2)
        q.add_data(url)
        q.make_image(fill_color="black", back_color="white").save(path)
        return True
    except:
        return False

def parse_text_into_blocks(text, max_width=46, max_lines=12):
    lines = text.split('\n')
    
    clean_lines = []
    for line in lines:
        if line:
            clean_lines.append(line)
    
    processed_lines = []
    for line in clean_lines:
        indent = len(line) - len(line.lstrip())
        content = line.lstrip()
        
        if len(line) <= max_width:
            processed_lines.append(line)
        else:
            words = content.split()
            current = " " * indent
            for word in words:
                if len(current) + len(word) + 1 <= max_width:
                    current += (" " if current != " " * indent else "") + word
                else:
                    if current:
                        processed_lines.append(current)
                    current = " " * indent + word
            if current:
                processed_lines.append(current)
    
    merged_lines = []
    i = 0
    while i < len(processed_lines):
        current_line = processed_lines[i]
        while i + 1 < len(processed_lines):
            next_line = processed_lines[i + 1]
            next_indent = len(next_line) - len(next_line.lstrip())
            current_indent = len(current_line) - len(current_line.lstrip())
            
            if next_indent == current_indent and len(current_line) + len(next_line) + 1 <= max_width:
                current_line += " " + next_line.lstrip()
                i += 1
            else:
                break
        merged_lines.append(current_line)
        i += 1
    
    blocks = []
    for i in range(0, len(merged_lines), max_lines):
        block = merged_lines[i:i+max_lines]
        blocks.append(block)
    
    return blocks

def get_clipboard():
    try:
        script = 'the clipboard as text'
        result = subprocess.run(['osascript', '-e', script], capture_output=True, text=True)
        return result.stdout
    except Exception as e:
        return f"Clipboard error: {e}"

def bear_box_process(url, filename, folder):
    """Main Bear box filler process - generates QR and boxed template"""
    folder_path = Path(folder)
    folder_path.mkdir(parents=True, exist_ok=True)
    
    print("\n📡 Fetching HTML...")
    html = fetch_html(url)
    
    html_path = folder_path / f"{filename}.html"
    with open(html_path, 'w', encoding='utf-8') as f:
        f.write(html)
    print(f"✅ HTML saved: {html_path}")
    
    qr_path = folder_path / f"{filename}.qr.png"
    if generate_qr(url, qr_path):
        print(f"✅ QR saved: {qr_path}")
    
    print(f"\n🌐 Opening browser...")
    webbrowser.open(url)
    
    print("\n⏳ Waiting 12 seconds for page to load...")
    for i in range(12, 0, -1):
        print(f"   {i}s", end="", flush=True)
        time.sleep(1)
    print("\r   ✓")
    
    print("\n📋 Copying content...")
    time.sleep(0.5)
    subprocess.run(['osascript', '-e', 'tell application "System Events" to keystroke "a" using command down'])
    time.sleep(0.3)
    subprocess.run(['osascript', '-e', 'tell application "System Events" to keystroke "c" using command down'])
    time.sleep(0.5)
    
    content = get_clipboard()
    if not content:
        content = html[:5000]
    
    txt_path = folder_path / f"{filename}.txt"
    with open(txt_path, 'w', encoding='utf-8') as f:
        f.write(content)
    print(f"✅ TXT saved: {txt_path}")
    
    print("\n" + "="*60)
    print("📊 Bear Box Template")
    print("="*60 + "\n")
    
    blocks = parse_text_into_blocks(content)
    
    output = []
    output.append(draw_divider())
    
    # Raphael header
    header_content = [
        f"⚡ RAPHAEL YOSHI",
        f"URL: {url[:43]}",
        f"Time: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"
    ]
    output.extend(draw_box(header_content, 50, 3))
    output.append(draw_divider())
    
    output.extend(draw_box([f"URL: {url[:45]}"], 50, 2))
    output.append(draw_divider())
    
    output.extend(draw_box([f"Search: {filename.replace('_', ' ')}"], 50, 2))
    output.append(draw_divider())
    
    for block in blocks:
        output.extend(draw_box(block, 50, 12))
        output.append(draw_divider())
    
    print("\n".join(output))
    
    template_path = folder_path / f"{filename}_template.txt"
    with open(template_path, 'w', encoding='utf-8') as f:
        f.write("\n".join(output))
    print(f"\n✅ Template saved: {template_path}")
    
    return output

