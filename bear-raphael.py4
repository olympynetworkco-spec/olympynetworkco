# ─── BOX DRAWING ───
TOP_LEFT = "╭"
TOP_RIGHT = "╮"
BOT_LEFT = "╰"
BOT_RIGHT = "╯"
HORIZ = "─"
VERT = "│"
BOX_WIDTH = 50
BOX_HEIGHT = 12

# ─── TELEGRAM CONFIG ───
