def speak(text):
    """RAPHAEL speaks using macOS say command"""
    try:
        subprocess.run(['say', text], capture_output=True, timeout=10)
        return True
    except Exception as e:
        print(f"[RAPHAEL] Speak failed: {e}")
        return False

def send_notification(title, message, subtitle=""):
    """Send macOS notification"""
    try:
        script = f'display notification "{message}" with title "{title}"'
        if subtitle:
            script += f' subtitle "{subtitle}"'
        subprocess.run(['osascript', '-e', script], capture_output=True)
    except:
        pass

def main():
    print("\n" + "="*70)
    print("⎚-⎚ Raphael Yoshi — Bear Box Integration")
    print("-"*70)
    print(f"➪ Active: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print("➪ RAPHAEL Skills On.")
    speak("Raphael skills on")
    
    print("➪ Commands: /bear /goggles /exit")
    print("➪ Output: .txt, .html, .qr.png, .template.txt (BEAR BOX)")
    print("➪ Proxy: http://localhost:9000/proxy/?url=")
    print("-"*70)
    
    # Start proxy in background
    proxy_thread = threading.Thread(target=start_proxy, daemon=True)
    proxy_thread.start()
    time.sleep(1)
    
    # Start Telegram listener
    if load_telegram_config():
        print("[✆] [✓] Telegram active")
        speak("Telegram active")
        send_telegram("[⚕] Raphael configured")
        # Start listener thread
        def tg_listener():
            while True:
                try:
                    msg = listen_telegram()
                    if msg:
                        print(f"[TG] Received: {msg}")
                        url = extract_url(msg)
                        if url:
                            send_telegram(f"🔗 URL detected: {url[:40]}...")
                            filename = f"telegram_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
                            folder = str(Path.home() / "Desktop" / "raphael_output")
                            bear_box_process(url, filename, folder)
                            send_telegram(f"✅ Done: {filename}")
                        elif msg.strip().lower() == '/bear':
                            send_telegram("🐻 Bear mode triggered!")
                            send_telegram("Send a URL to box-fill")
                        elif msg.strip().lower() == '/goggles':
                            send_telegram("🔴 GOGGLES TRIGGERED")
                            send_notification("RAPHAEL GOGGLES", "Alert sent")
                        elif msg.strip().lower() == '/exit':
                            send_telegram("🛑 Raphael stopping")
                            sys.exit(0)
                        else:
                            send_telegram(f"✓ Got: {msg[:30]}...")
                    time.sleep(2)
                except Exception as e:
                    print(f"[TG] Listener error: {e}")
                    time.sleep(5)
        
        threading.Thread(target=tg_listener, daemon=True).start()
    else:
        print("[TG] Not configured - local mode only")
    
    # ─── MAIN INTERACTIVE LOOP ───
    while True:
        try:
            print("\n" + "─"*50)
            url = input("🔗 URL (or /exit to quit): ").strip()
            
            if url.lower() in ['/exit', '/quit', 'exit', 'quit']:
                print("\n🛑 Raphael stopped.")
                speak("Goodbye")
                sys.exit(0)
            
            if url.lower() == '/bear':
                print("🐻 Bear mode active - send a URL to box-fill")
                continue
            
            if url.lower() == '/goggles':
                print("🔴 GOGGLES TRIGGERED")
                send_notification("RAPHAEL GOGGLES", "Alert sent", "URGENT")
                speak("Goggles triggered")
                continue
            
            if not url:
                url = "https://example.com"
            
            filename = input("📄 Filename: ").strip()
            if not filename:
                filename = f"raphael_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
            
            folder = input("📁 Folder (default: ~/Desktop/raphael_output): ").strip()
            if not folder:
                folder = str(Path.home() / "Desktop" / "raphael_output")
            
            # ─── RUN BEAR BOX PROCESS ───
            bear_box_process(url, filename, folder)
            
            print("\n" + "="*70)
            print("⚡ RAPHAEL — Ready for next URL")
            print("="*70)
            
        except KeyboardInterrupt:
            print("\n\n🛑 Raphael stopped by user.")
            speak("Turbo stop")
            sys.exit(0)
        except Exception as e:
            print(f"\n❌ Error: {e}")
            print("🔄 Continuing...\n")

