#+--|def scout_league_odds(league_games):
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

def scout_league_odds(league_games):
    """
    Loop over every game on tonight's board and pull ESPN's odds for each.
    Returns a list of {game_id, matchup, provider, away_ml, home_ml, spread, total, details}
    """
    if not league_games:
        return []
    all_rows = []
    for g in league_games:
        gid = g.get("game_id") or g.get("id")
        if not gid:
            continue
        rows = scout_odds(
            gid,
            away_abbr=g.get("away_abbr"),
            home_abbr=g.get("home_abbr"),
        )
        if not rows:
            continue
        # tag each row with the matchup so the JSON is self-contained
        matchup = f"{g.get('away','Away')} @ {g.get('home','Home')}"
        for r in rows:
            r["game_id"] = gid
            r["matchup"] = matchup
        all_rows.extend(rows)
    return all_rows


def save_league_odds(rows, source="ESPN_NHL"):
    """Write ESPN league-wide odds to espn-nhl-odds.json."""
    data = {
        "source":     source.upper(),
        "fetched_at": datetime.now().isoformat(),
        "total":      len(rows),
        "games":      rows,
    }
    path = DATA_DIR / "espn-nhl-odds.json"
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
    # print(f"  💾  ESPN NHL odds: {path}  ({len(rows)} rows)")   <--- DELETE THIS LINE
    return path


def print_league_odds(rows):
    """Pretty-print ESPN league odds to the terminal."""
    if not rows:
        print(f"  {YLW}⚠ no ESPN odds returned{R}")
        return
    section("ESPN NHL ODDS — LEAGUE WIDE", [
        f"{DIM}{'MATCHUP':<26} {'AWAY ML':>8} {'HOME ML':>9} "
        f"{'SPREAD':>7} {'TOTAL':>6} {'PROVIDER':<12}{R}",
    ] + [
        f"{r.get('matchup','?'):<26} "
        f"{str(r.get('away_ml','—')):>8} "
        f"{str(r.get('home_ml','—')):>9} "
        f"{str(r.get('away_spread','—')):>7} "
        f"{str(r.get('total','—')):>6} "
        f"{r.get('provider','ESPN BET'):<12}"
        for r in rows
    ])

