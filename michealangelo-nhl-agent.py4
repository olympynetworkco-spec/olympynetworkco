def save_leonardo_compat(games):
    away = games[0]["team1"] if games else "Away"
    home = games[0]["team2"] if games else "Home"
    
    # 1. Grab the raw status
    raw_status = games[0]["status"] if games else "Scheduled"
    
    # 2. FIX: If the clock is 0:00, force "End of..." so the dashboard knows
    if "0:00" in raw_status and "End" not in raw_status:
        per = raw_status.split()[0]
        status = f"End of {per}"
    else:
        status = raw_status

    payload = {
        "timestamp": datetime.now().isoformat(),
        "source_url": GAMECAST_NHL_GAME,
        "game_data": {
            "teams": [
                {"name": away, "abbr": FULL_TO_ABBR.get(away, away[:3].upper())},
                {"name": home, "abbr": FULL_TO_ABBR.get(home, home[:3].upper())},
            ],
            "away_score": games[0]["score1"] if games else "0",
            "home_score": games[0]["score2"] if games else "0",
            "status": status, # <--- USES THE FIXED STATUS
            "recent_plays": [],
            "win_prob_away": None,
            "win_prob_home": None,
        },
    }
    path = DATA_DIR / "nhl_live.json"
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(payload, f, indent=2, ensure_ascii=False)
    print(f"  💾  Leonardo-compat: {path}")
    return path


#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| CHAPTER 4: 𝒊 ζ zeta — VERIFIERS
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

previous_scores = {}
_prev_numeric = {}

def check_score_changes(games):
    global previous_scores, _prev_numeric
    changes = []
    for g in games:
        team1 = g.get('team1', '')
        team2 = g.get('team2', '')
        key = f"{team1}|{team2}"
        score1 = g.get('score1', '0')
        score2 = g.get('score2', '0')
        cur = f"{score1}-{score2}"
        status = g.get('status', 'Unknown')

        try:
            s1, s2 = int(score1), int(score2)
            total_now = s1 + s2
        except Exception:
            total_now = None

        prev_total = _prev_numeric.get(key)

        # only fire when the total strictly increased (goals are monotonic)
        if key in previous_scores and previous_scores[key] != cur:
            if total_now is None or prev_total is None or total_now > prev_total:
                changes.append({
                    'game': f"{team1} @ {team2}",
                    'old': previous_scores[key],
                    'new': cur,
                    'status': status,
                })

        previous_scores[key] = cur
        if total_now is not None:
            _prev_numeric[key] = total_now
    return changes

def send_score_notification(change):
    try:
        script = f'''
        display notification "{change['game']}: {change['old']} → {change['new']}" with title "🏒 GOAL" subtitle "{change['status']}" sound name "Ping"
        '''
        subprocess.run(['osascript', '-e', script], capture_output=True, timeout=5)
        print(f"  {ORG}🔔 Score change!{R}")
        print(f"  {GRN}  {change['game']}: {change['old']} → {change['new']}{R}")
    except Exception as e:
        print(f"  {RED}⚠️ Notification failed: {e}{R}")


def speak_score_change(change):
    text = f"Goal. {change['game']}. {change['old']} to {change['new']}."
    try:
        mp3 = DATA_DIR / "thomas_nhl_voice.mp3"
        r = subprocess.run([
            "edge-tts",
            "--voice", THOMAS_VOICE,
            "--text", text,
            "--write-media", str(mp3)
        ], capture_output=True, text=True, timeout=15)
        if r.returncode != 0:
            print(f"  {YLW}⚠️ TTS skipped (edge-tts 403 — Bing token issue){R}")
            return
        subprocess.run(['afplay', str(mp3)], check=False)
        print(f"  {GRN}🎩 Thomas voice dropped{R}")
    except FileNotFoundError:
        print(f"  {YLW}⚠️ edge-tts not installed — run: pip install edge-tts{R}")
    except Exception as e:
        print(f"  {YLW}⚠️ TTS failed: {e}{R}")


def darwin_format(games, source):
    output = []
    output.append(DIV)
    output.append(f"🏒  nhl SCOREBOARD  —  {time.strftime('%A, %B %d, %Y — %I:%M %p')}  🟠🐢")
    output.append(DIV)
    if games:
        output.append(f"  📡 Source: {source.upper()}")
        output.append(DIV)
        for i, game in enumerate(games, 1):
            team1 = game.get('team1', '?')
            team2 = game.get('team2', '?')
            score1 = game.get('score1', '0')
            score2 = game.get('score2', '0')
            status = game.get('status', 'Scheduled')
            if 'Final' in status:
                output.append(f"  {i:2}. {team1:24} {score1} — {score2} {team2:24}  [DONE] Final")
            elif status == 'Scheduled':
                output.append(f"  {i:2}. {team1:24} vs {team2:24}  ⏰ Scheduled")
            else:
                output.append(f"  {i:2}. {team1:24} {score1} — {score2} {team2:24}  🏒 {status}")
            output.append(DIV)
    else:
        output.append("  ⏳ No game found")
        output.append(DIV)
    return "\n".join(output)


def mikey_countdown(seconds=25):
    frames = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏']
    idx = 0
    for remaining in range(seconds, 0, -1):
        for _ in range(10):
            print(f"\r  {ORG}{frames[idx % len(frames)]}{R}  {DIM}next grip in {remaining:3}s{R}",
                  end="", flush=True)
            idx += 1
            time.sleep(0.08)
    print()


def exit_handler(sig, frame):
    print(f"\n  {ORG}🟠  Mikey dropping the nunchucks...{R}")
    print(f"  {ORG}🟠  COWABUNGA forever. ❤️{R}\n")
    sys.exit(0)

signal.signal(signal.SIGINT, exit_handler)
signal.signal(signal.SIGTERM, exit_handler)


#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| CHAPTER 1: 𝒊 α alpha — LAUNCH SYMBOL
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

def main():
    print("\n" + DIV)
    print("🟠  MICHELANGELO  —  NHL SCOREBOARD SCOUT")
    print("📅", time.strftime("%A, %B %d, %Y — %I:%M %p"))
    print(f"📡  GAMECAST: {GAMECAST_NHL_GAME or '(auto-pick live game)'}")
    print(f"📡  PBP:      {PLAY_BY_PLAY_NHL}")
    print(f"⏱️  REFRESH: Every {REFRESH_SECONDS} seconds")
    print(DIV + "\n")

    show_glassnotes()

    last_odds_refresh = 0          # ← initialized ONCE, before the loop
    last_wp_refresh   = 0          # ← initialized ONCE, before the loop

    cycle = 0
    while True:
        cycle += 1

        # ── pinned game scout (rink, PBP, goals, goalies) ──
        try:
            games, source, pbp_rows, goals, goalies = scout_dump()
        except Exception as e:
            print(f"  {RED}scout error: {e}{R}")
            mikey_countdown(REFRESH_SECONDS)
            continue

        # ── league-wide scoreboard (ALL games tonight) ──
        league_games = scout_league_scoreboard()
        if league_games:
            save_league_scores(league_games, source)
            
            # 🔥 NEW: Override the broken boxscore score with the accurate league score!
            if games:
                gid = games[0].get("game_id")
                for lg in league_games:
                    if str(lg.get("id")) == str(gid):
                        games[0]["score1"] = lg.get("away_score")
                        games[0]["score2"] = lg.get("home_score")
                        games[0]["status"] = lg.get("status")
                        break
        else:
            print(f"  {YLW}⚠ league scoreboard empty — leaving nhlscores.json as-is{R}")

        if not games:
            mikey_countdown(REFRESH_SECONDS)
            continue

        changes = check_score_changes(games)
        for change in changes:
            send_score_notification(change)
            threading.Thread(target=speak_score_change, args=(change,), daemon=True).start()

        output = darwin_format(games, source)
        print("\n" + output)

        txt_file = DATA_DIR / f"{source}_scoreboard.txt"
        with open(txt_file, 'w', encoding='utf-8') as f:
            f.write(output)
        print(f"  💾  Saved TXT: {txt_file}")

        # ── odds — pinned game only, refresh every 10 min ──
        if time.time() - last_odds_refresh > 250:
            g0 = games[0] if games else {}
            gid = g0.get("game_id")
            rows = scout_odds(
                gid,
                away_abbr=FULL_TO_ABBR.get(g0.get("team1", ""), (g0.get("team1") or "")[:3].upper()),
                home_abbr=FULL_TO_ABBR.get(g0.get("team2", ""), (g0.get("team2") or "")[:3].upper()),
            )


            if rows:
                save_odds(rows, gid)
            last_odds_refresh = time.time()

        save_leonardo_compat(games)

        # save full play-by-play JSON
        save_playbyplay_json(pbp_rows, goals, goalies,
                             game=games[0] if games else None)

        # ── yahoo win-prob → nhl-chart.json (pinned game only, hourly) ──
        # ── yahoo win-prob → nhl-chart.json (pinned game only, hourly) ──
        if WP and time.time() - last_wp_refresh > 12:
            wp = scout_yahoo_winprob(WP)
            if wp:
                payload = {
                    "source":     "YAHOO",
                    "game_id":    games[0].get("game_id") if games else None,
                    "fetched_at": datetime.now().isoformat(),
                    "series":     wp,
                }
                path = DATA_DIR / "nhl-chart.json"
                with open(path, 'w', encoding='utf-8') as f:
                    json.dump(payload, f, indent=2, ensure_ascii=False)
                print(f"  💾  Win-prob: {path}  ({len(wp)} points)")

                # mirror latest win prob into nhl_live.json
                try:
                    leo = DATA_DIR / "nhl_live.json"
                    if leo.exists():
                        with open(leo, 'r', encoding='utf-8') as f:
                            leo_data = json.load(f)
                        latest = wp[-1]
                        leo_data["game_data"]["win_prob_away"] = latest.get("away_pct")
                        leo_data["game_data"]["win_prob_home"] = latest.get("home_pct")
                        with open(leo, 'w', encoding='utf-8') as f:
                            json.dump(leo_data, f, indent=2, ensure_ascii=False)
                except Exception as e:
                    print(f"  {YLW}⚠ win-prob mirror failed: {e}{R}")

                last_wp_refresh = time.time()
                
                # 🔥 UPDATE LEONARDO JSON WITH WIN PROB
                latest = wp[-1]
                leo_path = DATA_DIR / "nhl_live.json"
                if leo_path.exists():
                    with open(leo_path, 'r') as f:
                        leo = json.load(f)
                    leo["game_data"]["win_prob_away"] = latest.get("away_pct")
                    leo["game_data"]["win_prob_home"] = latest.get("home_pct")
                    with open(leo_path, 'w') as f:
                        json.dump(leo, f, indent=2)
                        
            last_wp_refresh = time.time()




        print(f"\r  {GRN}[DONE]  Cycle {cycle} · {len(games)} game(s). Waiting {REFRESH_SECONDS}s...{R}")
        mikey_countdown(REFRESH_SECONDS)


if __name__ == "__main__":
    main()