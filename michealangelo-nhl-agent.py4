def section(title, lines):
    print(f"  {ORG}{DIV}{R}")
    print(f"  {ORG}▌ {title}{R}")
    print(f"  {ORG}{DIV}{R}")
    for ln in lines:
        print(f"  {ln}")
    print(f"  {ORG}{DIV}{R}")


def banner(title, subtitle=""):
    print(f"  {ORG}{DIV}{R}")
    print(f"  {ORG}🏒  {title}{R}")
    if subtitle:
        print(f"  {ORG}{subtitle}{R}")
    print(f"  {ORG}{DIV}{R}")


