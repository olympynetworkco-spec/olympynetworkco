def read_glassnotes():
    try:
        with open(GLASSNOTES, 'r', encoding='utf-8') as f:
            content = f.read()
        print(f"  {ORG}🟠  GlassNotes loaded!{R}")
        return content
    except Exception as e:
        print(f"  {RED}❌  GlassNotes not found: {e}{R}")
        return None

def strip_html(html):
    html = re.sub(r'<style[^>]*>.*?</style>', '', html, flags=re.DOTALL)
    html = re.sub(r'<script[^>]*>.*?</script>', '', html, flags=re.DOTALL)
    html = re.sub(r'<[^>]+>', ' ', html)
    html = re.sub(r'\s+', ' ', html)
    return html.strip()

def extract_intel(html):
    clean = strip_html(html)
    clean = clean.replace('&nbsp;', ' ')
    clean = re.sub(r'\s+', ' ', clean)
    clean = re.sub(r'\.\s+', '.\n  • ', clean)
    return clean[:5000]

MIKEY_BRAIN = read_glassnotes()

def show_glassnotes():
    if MIKEY_BRAIN:
        intel = extract_intel(MIKEY_BRAIN)
        print(f"\n  {ORG}📋  MIKEY'S INTEL{R}")
        print(f"  {ORG}{'─' * 70}{R}")
        print(intel)
        print(f"  {ORG}{'─' * 70}{R}")
        print(f"  {GRN}[DONE]  Mikey sees the INTEL!{R}\n")

def html_to_tokens(html):
    text = re.sub(r'<script[^>]*>.*?</script>', ' ', html, flags=re.DOTALL)
    text = re.sub(r'<style[^>]*>.*?</style>', ' ', text, flags=re.DOTALL)
    text = re.sub(r'<[^>]+>', '\n', text)
    import html as _h
    return [_h.unescape(t).strip() for t in text.split('\n') if t.strip()]

