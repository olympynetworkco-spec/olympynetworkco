#+--| def scout_yahoo_winprob(url):
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

def scout_yahoo_winprob(url):
    """
    Fetch a Yahoo boxscore page and pull the embedded win-prob timeline.
    Returns list of {clock, period, home_pct, away_pct, home_score, away_score}.
    """
    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
    try:
        raw = urllib.request.urlopen(req, timeout=15).read().decode('utf-8', 'replace')
    except Exception as e:
        print(f"  {RED}⚠ winprob fetch failed: {e}{R}")
        return []

    # 1. Grab the escaped React payload strings and unescape them
    blobs = re.findall(r'self\.__next_f\.push\(\[1,("(?:[^"\\]|\\.)*")\]\)', raw)
    joined = ""
    for b in blobs:
        try:
            joined += json.loads(b)
        except Exception:
            continue

    # Fallback: if Next.js blobs failed, just use the raw HTML
    if not joined:
        joined = raw

    # 2. Find the start of the timeline array
    key = '"winProbabilityTimeline":'
    idx = joined.find(key)
    if idx == -1:
        # Yahoo only publishes win-prob after puck drop — silent during pregame
        return []

    start_bracket = joined.find('[', idx)
    if start_bracket == -1:
        return []

    # 3. Use a bracket counter to extract the exact JSON array (handles nested brackets safely)
    depth = 0
    end_bracket = -1
    for i in range(start_bracket, len(joined)):
        char = joined[i]
        if char == '[':
            depth += 1
        elif char == ']':
            depth -= 1
            if depth == 0:
                end_bracket = i
                break

    if end_bracket == -1:
        return []

    json_str = joined[start_bracket:end_bracket+1]

    # 4. Parse the array
    try:
        series = json.loads(json_str)
    except Exception as e:
        print(f"  {RED}⚠ winprob parse failed: {e}{R}")
        return []

    # Helper to unwrap nested values like {"value": 63.9} -> 63.9
    def get_val(obj):
        if isinstance(obj, dict):
            return obj.get("value", 0)
        return obj if obj is not None else 0

    out = []
    for p in series:
        clock = p.get("clock") or ""
        per = None
        mmss = None
        
        # "1st 0:32" → period=1, mm:ss="0:32"
        mm = re.match(r'^(1st|2nd|3rd|OT)\s+(\d{1,2}:\d{2})$', clock)
        if mm:
            per = {"1st": 1, "2nd": 2, "3rd": 3, "OT": 4}[mm.group(1)]
            mmss = mm.group(2)
            
        out.append({
            "clock":       clock,
            "period":      per,
            "time":        mmss,
            "home_pct":    get_val(p.get("homeTeamProbability")),
            "away_pct":    get_val(p.get("awayTeamProbability")),
            "home_score":  get_val(p.get("homeScore")),
            "away_score":  get_val(p.get("awayScore")),
        })
        
    return out



