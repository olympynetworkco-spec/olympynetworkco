def save_leonardo_compat(games):
    away = games[0]["team1"] if games else "Away"
    home = games[0]["team2"] if games else "Home"
    
    # 1. Grab the raw status
    raw_status = games[0]["status"] if games else "Scheduled"
    
    # 2. FIX: If the clock is 0:00, force "End of..." so the dashboard knows
    if "0:00" in raw_status and "End" not in raw_status:
        per = raw_status.split()[0]
        status = f"End of {per}"
    else:
        status = raw_status

    payload = {
        "timestamp": datetime.now().isoformat(),
        "source_url": GAMECAST_NHL_GAME,
        "game_data": {
            "teams": [
                {"name": away, "abbr": FULL_TO_ABBR.get(away, away[:3].upper())},
                {"name": home, "abbr": FULL_TO_ABBR.get(home, home[:3].upper())},
            ],
            "away_score": games[0]["score1"] if games else "0",
            "home_score": games[0]["score2"] if games else "0",
            "status": status, # <--- USES THE FIXED STATUS
            "recent_plays": [],
            "win_prob_away": None,
            "win_prob_home": None,
        },
    }
    path = DATA_DIR / "nhl_live.json"
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(payload, f, indent=2, ensure_ascii=False)
    print(f"  💾  Leonardo-compat: {path}")
    return path


#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| CHAPTER 4: 𝒊 ζ zeta — VERIFIERS
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

previous_scores = {}
_prev_numeric = {}

def check_score_changes(games):
    global previous_scores, _prev_numeric
    changes = []
    for g in games:
        team1 = g.get('team1', '')
        team2 = g.get('team2', '')
        key = f"{team1}|{team2}"
        score1 = g.get('score1', '0')
        score2 = g.get('score2', '0')
        cur = f"{score1}-{score2}"
        status = g.get('status', 'Unknown')

        try:
            s1, s2 = int(score1), int(score2)
            total_now = s1 + s2
        except Exception:
            total_now = None

        prev_total = _prev_numeric.get(key)

        # only fire when the total strictly increased (goals are monotonic)
        if key in previous_scores and previous_scores[key] != cur:
            if total_now is None or prev_total is None or total_now > prev_total:
                changes.append({
                    'game': f"{team1} @ {team2}",
                    'old': previous_scores[key],
                    'new': cur,
                    'status': status,
                })

        previous_scores[key] = cur
        if total_now is not None:
            _prev_numeric[key] = total_now
    return changes

#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| CHAPTER 4: 𝒊 ζ zeta — VERIFIERS def parse_start_time_et(status):
#+--| PRE-GAME ALERT from zeta  — 5 min before puck drop
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

# track which games have already been alerted (game_id → True)
_alerted_pregame = set()

def parse_start_time_et(status):
    """
    Parse ESPN's pregame status string into a local naive datetime.
    Handles:
      "7:30 PM ET"
      "7:30 PM EST"
      "Wed, November 4th at 7:30 PM EST"
    Returns naive local datetime, or None if unparseable.
    """
    if not status:
        return None

    s = status.strip()

    # Try the short form first: "7:30 PM ET"
    m = re.match(r'^(\d{1,2}):(\d{2})\s*(AM|PM)(?:\s*E[DS]T)?$', s, re.I)
    if not m:
        # Long form: "Wed, November 4th at 7:30 PM EST"
        m = re.search(r'(\d{1,2}):(\d{2})\s*(AM|PM)(?:\s*E[DS]T)?', s, re.I)
    if not m:
        return None

    hour = int(m.group(1)) % 12
    if m.group(3).upper() == "PM":
        hour += 12
    minute = int(m.group(2))

    now = datetime.now()

    # Build the ET time as a naive datetime for "today"
    et_naive_today = now.replace(hour=hour, minute=minute, second=0, microsecond=0)

    try:
        from zoneinfo import ZoneInfo
        et_tz = ZoneInfo("America/New_York")
        local_tz = datetime.now().astimezone().tzinfo

        et_aware = et_naive_today.replace(tzinfo=et_tz)
        local_aware = et_aware.astimezone(local_tz)
        return local_aware.replace(tzinfo=None)
    except Exception:
        # If zoneinfo is unavailable or conversion fails, assume ET == local
        return et_naive_today



def check_pregame_alerts(games):
    """
    Fire a 5-minute-before alert for any game still in pregame state.
    Fires ONCE per game_id.
    """
    fired = []
    now = datetime.now()

    for g in games:
        status = g.get("status", "")
        gid    = g.get("game_id") or g.get("id")

        # only pregame rows
        if not re.match(r'^\d{1,2}:\d{2}\s*(AM|PM)', status.strip(), re.I):
            continue
        if not gid:
            continue
        if gid in _alerted_pregame:
            continue

        start = parse_start_time_et(status)
        if not start:
            continue

        delta_sec = (start - now).total_seconds()
        # fire when we're within the 5-minute window (and not already past)
        if 0 < delta_sec <= 5 * 60:
            _alerted_pregame.add(gid)
            fired.append({
                "game_id":  gid,
                "away":     g.get("away") or g.get("team1") or "Away",
                "home":     g.get("home") or g.get("team2") or "Home",
                "start":    status,
                "minutes":  max(1, round(delta_sec / 60)),
            })
    return fired


def send_pregame_notification(alert):
    title = f"🏒 Puck drop in {alert['minutes']} min!"
    body  = f"{alert['away']} @ {alert['home']} — {alert['start']}"
    script = f'''
    display notification "{body}" with title "{title}" subtitle "Michelangelo 🟠" sound name "Glass"
    '''
    try:
        subprocess.run(['osascript', '-e', script], capture_output=True, timeout=5)
        print(f"  {ORG}🔔 PRE-GAME ALERT: {body}{R}")
    except Exception as e:
        print(f"  {RED}⚠ pregame notification failed: {e}{R}")


def speak_pregame_alert(alert):
    text = (
        f"Heads up. Puck drop in {alert['minutes']} minutes. "
        f"{alert['away']} at {alert['home']}. Get to your seat."
    )
    try:
        mp3 = DATA_DIR / "thomas_pregame.mp3"
        r = subprocess.run([
            "edge-tts",
            "--voice", THOMAS_VOICE,
            "--text", text,
            "--write-media", str(mp3)
        ], capture_output=True, text=True, timeout=20)
        if r.returncode != 0:
            print(f"  {YLW}⚠️ pregame TTS skipped{R}")
            return
        subprocess.run(['afplay', str(mp3)], check=False)
        print(f"  {GRN}🎩 Thomas: puck drop in {alert['minutes']} min{R}")
    except Exception as e:
        print(f"  {YLW}⚠️ pregame TTS failed: {e}{R}")

#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| CHAPTER 4: 𝒊 ζ zeta — VERIFIERS def show_pregame_countdown(games, window_minutes=5):
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

_pregame_countdown_shown = set()   # game_ids we've already printed a line for

def show_pregame_countdown(games, window_minutes=5):
    """
    Print a live countdown line for every game in pregame state that's
    within the alert window (default: 60 min out → 5 min out).
    Shows `⏳ OTT @ BUF — puck drop in 12m 34s (alert at 5m)`.
    Clears the line once the alert fires.
    """
    now = datetime.now()
    any_shown = False

    for g in games:
        status = g.get("status", "")
        gid    = g.get("game_id") or g.get("id")
        if not gid:
            continue

        # skip if not pregame
        if not re.match(r'^\d{1,2}:\d{2}\s*(AM|PM)', status.strip(), re.I):
            continue

        # already alerted → show "GO" and skip
        if gid in _alerted_pregame:
            away = g.get("away") or "Away"
            home = g.get("home") or "Home"
            print(f"  {GRN}🏒 {away} @ {home} — PUCK DROP!{R}")
            continue

        start = parse_start_time_et(status)
        if not start:
            continue

        delta_sec = (start - now).total_seconds()

        # only show countdown when we're 60 min out → 0
        if not (0 < delta_sec <= 60 * 60):
            continue

        minutes = int(delta_sec // 60)
        seconds = int(delta_sec % 60)

        # when do we fire the alert?
        alert_in = max(0, delta_sec - window_minutes * 60)
        am = int(alert_in // 60)
        asec = int(alert_in % 60)

        away = g.get("away") or "Away"
        home = g.get("home") or "Home"

        if delta_sec <= window_minutes * 60:
            # inside the alert window (alert should have fired this cycle)
            color = RED
            tag   = "🔥 ALERT WINDOW"
        elif delta_sec <= 15 * 60:
            color = YLW
            tag   = "soon"
        else:
            color = CYN
            tag   = "waiting"

        # pad to clear previous line
        line = (
            f"  {color}⏳ {away} @ {home}  —  puck drop in "
            f"{minutes:>2}m {seconds:02d}s  "
            f"(alert in {am}m {asec:02d}s)  [{tag}]{R}"
        )
        print(line.ljust(120))
        any_shown = True

    if any_shown:
        print()   # breathing room

