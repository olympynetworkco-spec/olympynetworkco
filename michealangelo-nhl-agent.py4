def pick_live_nhl_game():
    try:
        req = urllib.request.Request(ESPN_NHL_SCOREBOARD,
                                     headers={'User-Agent': 'Mozilla/5.0'})
        html = urllib.request.urlopen(req, timeout=15).read().decode('utf-8', 'replace')
        m = re.findall(r'/nhl/game/_/gameId/(\d+)/([a-z0-9\-]+)', html)
        if m:
            gid, slug = m[0]
            return f"https://www.espn.com/nhl/game/_/gameId/{gid}/{slug}"
    except Exception as e:
        print(f"  {RED}⚠ auto-pick failed: {e}{R}")
    return None


#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| odds def scout_odds(game_id):
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

def scout_odds(game_id, away_abbr=None, home_abbr=None):
    if not game_id:
        return []
    url = f"https://site.api.espn.com/apis/site/v2/sports/hockey/nhl/summary?event={game_id}"
    try:
        req = urllib.request.Request(url, headers={
            'User-Agent': 'Mozilla/5.0',
            'Accept': 'application/json',
        })
        raw  = urllib.request.urlopen(req, timeout=15).read().decode('utf-8', 'replace')
        data = json.loads(raw)
    except Exception as e:
        print(f"  {RED}⚠ odds fetch failed: {e}{R}")
        return []

    pc = data.get("pickcenter") or data.get("odds") or []
    rows = []
    for e in pc:
        a = e.get("awayTeamOdds") or {}
        h = e.get("homeTeamOdds") or {}
        rows.append({
            "provider":     (e.get("provider") or {}).get("name", "ESPN BET"),
            "away_abbr":    ((a.get("team") or {}).get("abbreviation") or away_abbr),
            "home_abbr":    ((h.get("team") or {}).get("abbreviation") or home_abbr),
            "away_ml":      a.get("moneyLine"),
            "home_ml":      h.get("moneyLine"),
            "away_spread":  e.get("spread"),
            "away_sp_odds": a.get("spreadOdds"),
            "home_sp_odds": h.get("spreadOdds"),
            "total":        e.get("overUnder"),
            "over_odds":    e.get("overOdds"),
            "under_odds":   e.get("underOdds"),
            "details":      e.get("details") or "",
        })
    return rows



#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| saves odds json for alfy def save_odds(rows, game_id=None, source="ESPN_NHL"):
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
def save_odds(rows, game_id=None, source="ESPN_NHL"):
    data = {
        "source":     source.upper(),
        "fetched_at": datetime.now().isoformat(),
        "game_id":    game_id,
        "total":      len(rows),
        "games":      rows,
    }
    path = DATA_DIR / "nhl-odds.json"
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
    print(f"  💾  Odds: {path}  ({len(rows)})")
    return path


