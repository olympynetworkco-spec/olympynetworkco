def main():
    print("\n" + DIV)
    print("🟠  MICHELANGELO  —  NHL SCOREBOARD SCOUT")
    print("📅", time.strftime("%A, %B %d, %Y — %I:%M %p"))
    print(f"📡  GAMECAST: {GAMECAST_NHL_GAME or '(auto-pick live game)'}")
    print(f"📡  PBP:      {PLAY_BY_PLAY_NHL}")
    print(f"⏱️  REFRESH: Every {REFRESH_SECONDS} seconds")
    print(DIV + "\n")

    show_glassnotes()

    last_odds_refresh = 0          # ← initialized ONCE, before the loop
    last_wp_refresh   = 0          # ← initialized ONCE, before the loop

    cycle = 0
    while True:
        cycle += 1

        # ── pinned game scout (rink, PBP, goals, goalies) ──
        try:
            games, source, pbp_rows, goals, goalies = scout_dump()
        except Exception as e:
            print(f"  {RED}scout error: {e}{R}")
            mikey_countdown(REFRESH_SECONDS)
            continue

        # ── league-wide scoreboard (ALL games tonight) ──
        league_games = scout_league_scoreboard()
        if league_games:
            save_league_scores(league_games, source)
        else:
            print(f"  {YLW}⚠ league scoreboard empty — leaving nhlscores.json as-is{R}")

        # ── 5-minute pre-game countdown (prints every cycle) ──
        show_pregame_countdown(league_games, window_minutes=5)

        # ── 5-minute pre-game alerts (fires once per game) ──
        pregame_alerts = check_pregame_alerts(league_games)
        for alert in pregame_alerts:
            send_pregame_notification(alert)
            threading.Thread(target=speak_pregame_alert, args=(alert,), daemon=True).start()

        # 🔥 Override the pinned-game score with the accurate league score
        if games and league_games:
            gid = games[0].get("game_id")
            for lg in league_games:
                if str(lg.get("id")) == str(gid):
                    games[0]["score1"] = lg.get("away_score")
                    games[0]["score2"] = lg.get("home_score")
                    games[0]["status"] = lg.get("status")
                    break

        if not games:
            mikey_countdown(REFRESH_SECONDS)
            continue

        changes = check_score_changes(games)
        for change in changes:
            send_score_notification(change)
            threading.Thread(target=speak_score_change, args=(change,), daemon=True).start()

        # ── 1. ODDS FETCHING COMES FIRST ──
        current_game_odds = []
        if time.time() - last_odds_refresh > 60: 
            g0 = games[0] if games else {}
            gid = g0.get("game_id")
            current_game_odds = scout_odds(
                gid,
                away_abbr=FULL_TO_ABBR.get(g0.get("team1", ""), (g0.get("team1") or "")[:3].upper()),
                home_abbr=FULL_TO_ABBR.get(g0.get("team2", ""), (g0.get("team2") or "")[:3].upper()),
            )

            if current_game_odds:
                save_odds(current_game_odds, gid)
            
            last_odds_refresh = time.time()

            # ── NEW: league-wide ESPN odds → espn-nhl-odds.json + terminal print ──
            # ── NEW: league-wide ESPN odds → espn-nhl-odds.json (SILENT) ──
            try:
                league_odds = scout_league_odds(league_games)
                if league_odds:
                    save_league_odds(league_odds)
            except Exception as e:
                pass  # Silent fail so it doesn't interrupt the main game view


        # ✨ FALLBACK: If we didn't fetch fresh odds this cycle (because of the 60s timer),
        # load the cached odds from the file so the box still prints!
        if not current_game_odds:
            try:
                cache_path = DATA_DIR / "nhl-odds.json"
                if cache_path.exists():
                    with open(cache_path, 'r', encoding='utf-8') as f:
                        cached_data = json.load(f)
                        current_game_odds = cached_data.get("games", [])
            except Exception:
                pass


        # ── 2. PRINT SCOREBOARD ONCE (with odds) ──
        output = darwin_format(games, source, current_game_odds)
        print("\n" + output)

        txt_file = DATA_DIR / f"{source}_scoreboard.txt"
        with open(txt_file, 'w', encoding='utf-8') as f:
            f.write(output)
        print(f"  💾  Saved TXT: {txt_file}")

        save_leonardo_compat(games)

        # save full play-by-play JSON
        save_playbyplay_json(pbp_rows, goals, goalies,
                             game=games[0] if games else None)

        # ── yahoo win-prob → nhl-chart.json (pinned game only, hourly) ──
        if WP and time.time() - last_wp_refresh > 12:
            wp = scout_yahoo_winprob(WP)
            if wp:
                payload = {
                    "source":     "YAHOO",
                    "game_id":    games[0].get("game_id") if games else None,
                    "fetched_at": datetime.now().isoformat(),
                    "series":     wp,
                }
                path = DATA_DIR / "nhl-chart.json"
                with open(path, 'w', encoding='utf-8') as f:
                    json.dump(payload, f, indent=2, ensure_ascii=False)
                print(f"  💾  Win-prob: {path}  ({len(wp)} points)")

                # mirror latest win prob into nhl_live.json
                try:
                    leo = DATA_DIR / "nhl_live.json"
                    if leo.exists():
                        with open(leo, 'r', encoding='utf-8') as f:
                            leo_data = json.load(f)
                        latest = wp[-1]
                        leo_data["game_data"]["win_prob_away"] = latest.get("away_pct")
                        leo_data["game_data"]["win_prob_home"] = latest.get("home_pct")
                        with open(leo, 'w', encoding='utf-8') as f:
                            json.dump(leo_data, f, indent=2, ensure_ascii=False)
                except Exception as e:
                    print(f"  {YLW}⚠ win-prob mirror failed: {e}{R}")

                last_wp_refresh = time.time()
                
                # 🔥 UPDATE LEONARDO JSON WITH WIN PROB
                latest = wp[-1]
                leo_path = DATA_DIR / "nhl_live.json"
                if leo_path.exists():
                    with open(leo_path, 'r') as f:
                        leo = json.load(f)
                    leo["game_data"]["win_prob_away"] = latest.get("away_pct")
                    leo["game_data"]["win_prob_home"] = latest.get("home_pct")
                    with open(leo_path, 'w') as f:
                        json.dump(leo, f, indent=2)
                        
            last_wp_refresh = time.time()

        print(f"\r  {GRN}[DONE]  Cycle {cycle} · {len(games)} game(s). Waiting {REFRESH_SECONDS}s...{R}")
        mikey_countdown(REFRESH_SECONDS)

