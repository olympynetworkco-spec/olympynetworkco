#+--| def scout_league_scoreboard(): add this near pick live NHL games
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

ESPN_NHL_SCOREBOARD_JSON = (
    "https://site.api.espn.com/apis/site/v2/sports/hockey/nhl/scoreboard"
)

def scout_league_scoreboard():
    """
    Hit ESPN's site API for the NHL scoreboard (all games on the board tonight).
    Returns list of dicts shaped for nhlscores.json.
    """
    try:
        req = urllib.request.Request(
            ESPN_NHL_SCOREBOARD_JSON,
            headers={
                'User-Agent': 'Mozilla/5.0',
                'Accept':     'application/json',
            },
        )
        raw = urllib.request.urlopen(req, timeout=15).read().decode('utf-8', 'replace')
        data = json.loads(raw)
    except Exception as e:
        print(f"  {RED}⚠ league scoreboard JSON fetch failed: {e}{R}")
        return []

    events = data.get("events", []) or []
    out = []

    for ev in events:
        try:
            comp = (ev.get("competitions") or [{}])[0]
            teams = comp.get("competitors") or []
            if len(teams) < 2:
                continue

            # ESPN marks home/away with 'homeAway'
            by_side = {t.get("homeAway"): t for t in teams}
            away = by_side.get("away") or teams[0]
            home = by_side.get("home") or teams[1]

            away_team = away.get("team") or {}
            home_team = home.get("team") or {}

            away_full = away_team.get("displayName") or away_team.get("name") or "Away"
            home_full = home_team.get("displayName") or home_team.get("name") or "Home"
            away_abbr = (away_team.get("abbreviation") or FULL_TO_ABBR.get(away_full, away_full[:3])).upper()
            home_abbr = (home_team.get("abbreviation") or FULL_TO_ABBR.get(home_full, home_full[:3])).upper()

            away_score = away.get("score")
            home_score = home.get("score")
            # ESPN gives scores as strings already; default to "0" pregame
            away_score = str(away_score) if away_score not in (None, "") else "0"
            home_score = str(home_score) if home_score not in (None, "") else "0"

            # status
            status_obj = (comp.get("status") or ev.get("status") or {})
            st_type    = status_obj.get("type") or {}
            st_desc    = st_type.get("description") or st_type.get("detail") or "Scheduled"
            st_state   = st_type.get("state") or ""     # 'pre' | 'in' | 'post'
            st_detail  = status_obj.get("displayClock") or ""
            st_period  = status_obj.get("period") or 0

            # ── real puck-drop clock (ESPN puts it in comp.status.type.detail or ev.date) ──
            start_time_str = None
            raw_detail = (st_type.get("detail") or "").strip()

            # "7:30 PM ET" — short form
            m_short = re.match(r'^(\d{1,2}:\d{2}\s*(?:AM|PM))', raw_detail, re.I)
            if m_short:
                start_time_str = m_short.group(1) + " ET"

            # "Wed, November 4th at 7:30 PM EST" — long form
            if not start_time_str:
                m_long = re.search(r'(\d{1,2}:\d{2}\s*(?:AM|PM))', raw_detail, re.I)
                if m_long:
                    start_time_str = m_long.group(1) + " ET"

            # Fall back to ev.date (ISO 8601 UTC)
            if not start_time_str and st_state == "pre" and ev.get("date"):
                try:
                    from datetime import datetime as _dt
                    utc_dt = _dt.fromisoformat(ev["date"].replace("Z", "+00:00"))
                    try:
                        from zoneinfo import ZoneInfo
                        et_dt = utc_dt.astimezone(ZoneInfo("America/New_York"))
                        start_time_str = et_dt.strftime("%-I:%M %p ET")
                    except Exception:
                        start_time_str = utc_dt.strftime("%-I:%M %p ET")
                except Exception:
                    pass



                # ISO 8601 UTC — convert to ET and format like ESPN does
                try:
                    from datetime import datetime as _dt, timezone
                    utc_dt = _dt.fromisoformat(ev["date"].replace("Z", "+00:00"))
                    try:
                        from zoneinfo import ZoneInfo
                        et_dt = utc_dt.astimezone(ZoneInfo("America/New_York"))
                        start_time_str = et_dt.strftime("%-I:%M %p ET")
                    except Exception:
                        # fallback: use UTC hour as-is (wrong tz but at least parseable)
                        start_time_str = utc_dt.strftime("%-I:%M %p ET")
                except Exception:
                    pass

            # ── real puck-drop clock (ESPN puts it in comp.status.type.detail or ev.date) ──
            start_time_str = None
            # comp.status.type.detail is like "7:30 PM ET" during pregame
            raw_detail = (st_type.get("detail") or "").strip()
            if re.match(r'^\d{1,2}:\d{2}\s*(AM|PM)', raw_detail, re.I):
                start_time_str = raw_detail
            elif st_state == "pre" and ev.get("date"):
                # ISO 8601 UTC — convert to ET and format like ESPN does
                try:
                    from datetime import datetime as _dt, timezone
                    utc_dt = _dt.fromisoformat(ev["date"].replace("Z", "+00:00"))
                    try:
                        from zoneinfo import ZoneInfo
                        et_dt = utc_dt.astimezone(ZoneInfo("America/New_York"))
                        start_time_str = et_dt.strftime("%-I:%M %p ET")
                    except Exception:
                        # fallback: use UTC hour as-is (wrong tz but at least parseable)
                        start_time_str = utc_dt.strftime("%-I:%M %p ET")
                except Exception:
                    pass

            # ── real puck-drop clock (ESPN puts it in comp.status.type.detail or ev.date) ──
            start_time_str = None
            # comp.status.type.detail is like "7:30 PM ET" during pregame
            raw_detail = (st_type.get("detail") or "").strip()
            if re.match(r'^\d{1,2}:\d{2}\s*(AM|PM)', raw_detail, re.I):
                start_time_str = raw_detail
            elif st_state == "pre" and ev.get("date"):
                # ISO 8601 UTC — convert to ET and format like ESPN does
                try:
                    from datetime import datetime as _dt, timezone
                    utc_dt = _dt.fromisoformat(ev["date"].replace("Z", "+00:00"))
                    try:
                        from zoneinfo import ZoneInfo
                        et_dt = utc_dt.astimezone(ZoneInfo("America/New_York"))
                        start_time_str = et_dt.strftime("%-I:%M %p ET")
                    except Exception:
                        # fallback: use UTC hour as-is (wrong tz but at least parseable)
                        start_time_str = utc_dt.strftime("%-I:%M %p ET")
                except Exception:
                    pass

            # Build a compact status like "3rd 5:21", "Final", "7:00 PM ET"
            if st_state == "in":
                status = st_desc
                if st_detail and st_detail not in status:
                    ord_per = {1: "1st", 2: "2nd", 3: "3rd", 4: "OT", 5: "SO"}.get(
                        int(st_period) or 0, ""
                    )
                    status = f"{ord_per} {st_detail}".strip()
            elif st_state == "post":
                status = st_desc if "Final" in (st_desc or "") else "Final"
            else:
                # pregame — prefer the real start time over "Scheduled"
                status = start_time_str or st_desc or "Scheduled"

            # winner flags
            try:
                s1, s2 = int(away_score), int(home_score)
            except Exception:
                s1, s2 = 0, 0
            away_winner = away.get("winner") if isinstance(away.get("winner"), bool) else (s1 > s2 and st_state == "post")
            home_winner = home.get("winner") if isinstance(home.get("winner"), bool) else (s2 > s1 and st_state == "post")

            gid = ev.get("id") or comp.get("id")

            out.append({
                "id":          gid,
                "game_id":     gid,
                "away":        away_full,
                "home":        home_full,
                "away_abbr":   away_abbr,
                "home_abbr":   home_abbr,
                "away_score":  away_score,
                "home_score":  home_score,
                "status":      status,
                "away_winner": bool(away_winner),
                "home_winner": bool(home_winner),
            })
        except Exception as e:
            print(f"  {YLW}⚠ league row skipped: {e}{R}")
            continue

    return out


#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| ICE RINK — 4-zone horizontal rink in box-drawing chars render rink
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>


def render_rink(puck_zone=None, away_abbr="AWAY", home_abbr="HOME"):
    """
    Horizontal NHL rink, 4 even columns.
    Columns left→right: away zone | away blue-line side | home blue-line side | home zone
    """
    L = "│"
    TL, TR, BL, BR = "╭", "╮", "╰", "╯"
    TJ, TJB, CROSS = "┬", "┴", "┼"
    H = "─"

    col = 11   # each column interior width

    # top border
    top = f"  {TL}" + H*col + TJ + H*col + TJ + H*col + TJ + H*col + TR
    bot = f"  {BL}" + H*col + TJB + H*col + TJB + H*col + TJB + H*col + BR

    # faceoff dot row — dots in the middle of each column
    def dot_row(left_dot=True, right_dot=True):
        a = "    ◯      " if left_dot  else "           "
        b = "           "
        c = "           "
        d = "      ◯    " if right_dot else "           "
        return f"  {L}{a}{L}{b}{L}{c}{L}{d}{L}"

    def blank_row():
        return f"  {L}{' '*col}{L}{' '*col}{L}{' '*col}{L}{' '*col}{L}"

    # crease rows — the two middle columns share a symmetric crease
    def crease_row(top=True):
        midL = "  ╭─────╮  "
        midR = "  ╰─────╯  "
        if top:
            # both crescents curl inward facing each other
            return f"  {L}{' '*col}{L}  ╭───┬───╮  {L}{' '*col}{L}"
        else:
            return f"  {L}{' '*col}{L}  ╰───┴───╯  {L}{' '*col}{L}"

    lines = []
    lines.append(top)
    lines.append(blank_row())
    lines.append(dot_row())
    lines.append(blank_row())
    lines.append(f"  {L}{' '*col}{L} ╭───┼───╮ {L}{' '*col}{L}")
    lines.append(f"  {L}{' '*col}{L} │   │   │ {L}{' '*col}{L}")
    lines.append(f"  {L}{' '*col}{L} ╰───┼───╯ {L}{' '*col}{L}")
    lines.append(blank_row())
    lines.append(dot_row())
    lines.append(blank_row())
    lines.append(bot)

    # team labels under the rink, aligned to the outer columns
    label_line = (
        f"  {ORG}{away_abbr:^{col}}{R}"
        f"{' '*col}"
        f"{' '*col}"
        f"{ORG}{home_abbr:^{col}}{R}"
    )
    lines.append(label_line)

    return lines


#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| def xfactor_for(name):
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--|

def xfactor_for(name):
    """
    Look up X-Factor class(es) for a scorer by last name.
    Strips (N), [PP], [EN] tags before lookup.
    Returns list of class names, or [] if none matched.
    """
    if not name:
        return []
    # strip parens and [tags]
    clean = re.sub(r'\([^)]*\)', '', name)
    clean = re.sub(r'\[[^\]]*\]', '', clean)
    clean = clean.strip()
    if not clean:
        return []
    last = clean.split()[-1]
    
    # If the player's last name exists in the X-Factors dict, return it
    if last in NHL_XFACTORS:
        return [last]
    return []
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| def scout_dump(): scout dump
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--|

def scout_dump():
    """Grip ESPN NHL Gamecast via JSON summary API → sectioned terminal dump."""

    url = GAMECAST_NHL_GAME or pick_live_nhl_game()
    if not url:
        print(f"  {RED}⚠ no NHL game URL{R}")
        return [], "none", [], [], []

    m = re.search(r'/gameId/(\d+)', url)
    gid = m.group(1) if m else None
    if not gid:
        print(f"  {RED}⚠ no gameId in URL: {url}{R}")
        return [], "none", [], [], []

    api = f"https://site.api.espn.com/apis/site/v2/sports/hockey/nhl/summary?event={gid}"
    print(f"  {CYN}🏒  summary API:  {api}{R}")

    try:
        req = urllib.request.Request(api, headers={
            'User-Agent': 'Mozilla/5.0', 'Accept': 'application/json'})
        data = json.loads(urllib.request.urlopen(req, timeout=15).read().decode('utf-8', 'replace'))
    except Exception as e:
        print(f"  {RED}⚠ summary API fetch failed: {e}{R}")
        return [], "none", [], [], []

    (DATA_DIR / "espn-nhl-summary.json").write_text(
        json.dumps(data, indent=2, ensure_ascii=False), encoding='utf-8')

    # ── header ──
    hdr = (data.get("header") or {})
    comps = hdr.get("competitions") or []
    comp = comps[0] if comps else {}
    teams = comp.get("competitors") or []

    by_side = {t.get("homeAway"): t for t in teams}
    away = by_side.get("away") or (teams[0] if teams else {})
    home = by_side.get("home") or (teams[1] if len(teams) > 1 else {})

    away_team = away.get("team") or {}
    home_team = home.get("team") or {}

    away_full = away_team.get("displayName") or away_team.get("name") or "Away"
    home_full = home_team.get("displayName") or home_team.get("name") or "Home"
    away_abbr = (away_team.get("abbreviation") or FULL_TO_ABBR.get(away_full, away_full[:3])).upper()
    home_abbr = (home_team.get("abbreviation") or FULL_TO_ABBR.get(home_full, home_full[:3])).upper()

    away_score = away.get("score")
    home_score = home.get("score")
    away_score = str(away_score) if away_score not in (None, "") else "0"
    home_score = str(home_score) if home_score not in (None, "") else "0"

    status_obj = comp.get("status") or {}
    st_type    = status_obj.get("type") or {}
    st_state   = st_type.get("state") or ""       # 'pre' | 'in' | 'post'
    st_desc    = st_type.get("description") or st_type.get("detail") or "Scheduled"
    st_detail  = status_obj.get("displayClock") or ""
    st_period  = status_obj.get("period") or 0

    if st_state == "in":
        ord_per = {1: "1st", 2: "2nd", 3: "3rd", 4: "OT", 5: "SO"}.get(int(st_period) or 0, "")
        period  = ord_per or st_desc
        clock   = st_detail
        status  = f"{period} {clock}".strip()
    elif st_state == "post":
        period  = st_desc
        clock   = None
        status  = "Final" if "Final" not in st_desc else st_desc
    else:
        # pregame — prefer the real start time
        raw_detail = (st_type.get("detail") or "").strip()
        if re.match(r'^\d{1,2}:\d{2}\s*(AM|PM)', raw_detail, re.I):
            status = raw_detail
        elif comp.get("date"):
            try:
                from datetime import datetime as _dt
                utc_dt = _dt.fromisoformat(comp["date"].replace("Z", "+00:00"))
                try:
                    from zoneinfo import ZoneInfo
                    et_dt = utc_dt.astimezone(ZoneInfo("America/New_York"))
                    status = et_dt.strftime("%-I:%M %p ET")
                except Exception:
                    status = utc_dt.strftime("%-I:%M %p ET")
            except Exception:
                status = st_desc or "Scheduled"
        else:
            status = st_desc or "Scheduled"
        period = status
        clock  = None

    matchup = f"{away_full} @ {home_full}"

    # ── box score (period by period) ──
    def line_score(side):
        ls = side.get("linescores") or []
        per = [int(p.get("value") or 0) for p in ls]
        return (per + [0]*3)[:3] + [int(side.get("score") or 0)]
    away_p = line_score(away) if (away.get("linescores") or away.get("score") is not None) else None
    home_p = line_score(home) if (home.get("linescores") or home.get("score") is not None) else None



    # ── scoring plays ──
    # ── scoring plays (parsed from PBP since scoringPlays[] is missing) ──
    goals = []
    for p in (data.get("plays") or []):
        # look for play types that indicate a goal
        p_type = (p.get("type") or {}).get("text", "").lower()
        if "goal" in p_type and "goalie" not in p_type:
            try:
                pnum = int((p.get("period") or {}).get("number") or 0)
                pname = {1: "1ST", 2: "2ND", 3: "3RD", 4: "OT", 5: "SO"}.get(pnum, f"P{pnum}")
                clock_g = (p.get("clock") or {}).get("displayValue") or ""


                scorer_name = "—"
                assists_list = []
                
                # 1. Get the play text (e.g. "Yegor Sharangovich Goal (3) Tip-In, assists: Zach Whitecloud (2), Morgan Frost (6)")
                text = p.get("text") or ""
                
                # 2. Extract the scorer (they are always the first participant with a name)
                for part in (p.get("participants") or []):
                    ath = part.get("athlete") or {}
                    name = ath.get("displayName")
                    if name:
                        scorer_name = name
                        break
                        
                # 3. Extract the assists using a Regex on the text
                m_assists = re.search(r'assists?:\s*(.+)', text, re.IGNORECASE)
                if m_assists:
                    # Split "Zach Whitecloud (2), Morgan Frost (6)" by comma
                    raw_assists = m_assists.group(1).split(',')
                    for raw_a in raw_assists:
                        # Remove the "(2)" number tags
                        clean_a = re.sub(r'\(\d+\)', '', raw_a).strip()
                        if clean_a:
                            assists_list.append(clean_a)
                
                away_r = p.get("awayScore")
                home_r = p.get("homeScore")
                
                goals.append({
                    "period":  f"{pname} PERIOD",
                    "clock":   clock_g,
                    "scorer":  scorer_name,
                    "assists": ("Assists: " + ", ".join(assists_list)) if assists_list else "Unassisted",
                    "score":   f"{away_r}-{home_r}" if away_r is not None else "",
                })


            except Exception:
                continue




    # sort by period asc, clock desc (same as before)
    def goal_sort_key(g):
        per_num = {"1ST": 1, "2ND": 2, "3RD": 3, "OT": 4, "SO": 5}.get(g["period"].split()[0], 1)
        try:
            mm, ss = g["clock"].split(":")
            secs = int(mm) * 60 + int(ss)
        except Exception:
            secs = 0
        return (per_num, -secs)
    goals.sort(key=goal_sort_key)

    # ── goalies (from boxscore.playerByTeam) ──
    goalies = []
    boxscore = data.get("boxscore") or {}
    for team_block in (boxscore.get("playerByTeam") or []):
        for stat_group in (team_block.get("statistics") or []):
            if (stat_group.get("name") or "").lower() not in ("goalies", "goaltending"):
                continue
            keys = [k.lower() for k in (stat_group.get("names") or [])]
            for athlete in (stat_group.get("athletes") or []):
                ath = athlete.get("athlete") or {}
                name = ath.get("displayName") or "—"
                # shorten to "J. Doe"
                parts = name.split()
                short = f"{parts[0][0]}. {parts[-1]}" if len(parts) >= 2 else name
                stats = athlete.get("stats") or []
                def gv(key):
                    try:
                        return stats[keys.index(key)]
                    except Exception:
                        return "—"
                goalies.append({
                    "name": short,
                    "sa":   gv("shotsagainst") or gv("shotsagainst"),
                    "ga":   gv("goalsagainst") or gv("goalsagainst"),
                    "sv":   gv("saves") or gv("saves"),
                    "svp":  gv("savepct") or gv("savepercentage"),
                })

    # ── play-by-play (from plays[]) ──
    pbp_rows = []
    for p in (data.get("plays") or []):
        try:
            clock_p = (p.get("clock") or {}).get("displayValue") or ""
            pnum    = int((p.get("period") or {}).get("number") or 0)
            pname   = {1: "1ST", 2: "2ND", 3: "3RD", 4: "OT", 5: "SO"}.get(pnum, "")
            desc    = p.get("text") or p.get("shortText") or ""
            if not desc:
                continue
            score   = ""
            if p.get("awayScore") is not None and p.get("homeScore") is not None:
                score = f"{p['awayScore']}-{p['homeScore']}"
            pbp_rows.append({
                "period": f"{pname} PERIOD" if pname else "",
                "clock":  clock_p,
                "score":  score,
                "desc":   desc,
            })
        except Exception:
            continue


    # ESPN ships newest-first — flip so oldest prints first
    pbp_rows.reverse()

    # ═══════════════════════════════════════════════════════════
    #  PRINT (same shape as before)
    # ═══════════════════════════════════════════════════════════

    print()
    banner("MICHELANGELO  ·  ESPN NHL GAMECAST",
           f"{matchup}" + (f"  ·  {status}" if status and status != "Scheduled" else ""))

    section("ANCHOR TREE", [
        f"{RED}ᛉ  source    = JSON summary API{R}",
        f"{RED}ᛉ  game_id   = {gid}{R}",
        f"{RED}ᛉ  live: {away_abbr} {away_score} - {home_score} {home_abbr}  ·  {status}{R}",
        f"{RED}ᛉ  pbp rows  = {len(pbp_rows)}{R}",
        f"{RED}ᛉ  goals     = {len(goals)}{R}",
        f"{RED}ᛉ  goalies   = {len(goalies)}{R}",
    ])

    if away_p and home_p:
        section("BOX SCORE", [
            f"{DIM}         1    2    3    T{R}",
            f"{GRN}{away_abbr:<5}{R}  " + "  ".join(f"{v:>3}" for v in away_p),
            f"{GRN}{home_abbr:<5}{R}  " + "  ".join(f"{v:>3}" for v in home_p),
        ])

    section("ICE RINK", render_rink(
        puck_zone=None,
        away_abbr=away_abbr or "AWAY",
        home_abbr=home_abbr or "HOME",
    ))

    if goals:
        lines = []
        last_p = None
        for g in goals:
            if g["period"] != last_p:
                lines.append(f"{ORG}{g['period']}{R}")
                last_p = g["period"]
            
            # Format the scorer and their X-Factors
            scorer = g['scorer']
            xf = xfactor_for(scorer)
            xf_str = f" [{', '.join(xf)}]" if xf else ""
            
            lines.append(f"{DIM}{g['clock']:>6}{R}   {YLW}⭐ {scorer}{xf_str}{R}")
            if g["assists"]:
                lines.append(f"{DIM}        {g['assists']}{R}")
            if g["score"]:
                lines.append(f"{DIM}        {g['score']}{R}")
        section("SCORING SUMMARY - X factor stars of the game ⭐", lines)
        print(f"\n  {ORG}{'═' * 70}{R}\n")

    if goalies:
        lines = []
        for g in goalies:
            lines.append(
                f"{g['name']:<15} {g['sa']:>3} SA  {g['ga']:>2} GA  {g['sv']:>3} SV  {g['svp']}"
            )
        section("GOALIES", lines)
        print(f"\n  {ORG}{'═' * 70}{R}\n")

    if pbp_rows:
        lines = []
        last_p = None
        for p in pbp_rows:
            if p["period"] and p["period"] != last_p:
                lines.append(f"{ORG}{p['period']}{R}")
                last_p = p["period"]
            score = f"({p['score']}) " if p["score"] else ""
            lines.append(f"{DIM}{p['clock']:>6}{R}  {score}{p['desc']}")
        section("PLAY-BY-PLAY", lines)
    else:
        section("PLAY-BY-PLAY", [f"{DIM}no plays yet — game may not have started{R}"])

    print()

    game = {
        "team1": away_full,
        "team2": home_full,
        "score1": away_score,
        "score2": home_score,
        "status": status,
        "game_id": gid,
    }
    return [game], "espn_nhl", pbp_rows, goals, goalies

#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| def save_playbyplay_json( add this near alfred 
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

def save_playbyplay_json(pbp_rows, goals, goalies, game=None):
    """Dump FULL play-by-play, goals, and goalies to JSON."""
    payload = {
        "source": "ESPN_NHL",
        "fetched_at": datetime.now().isoformat(),
        "game": game or {},
        "play_by_play_count": len(pbp_rows),
        "play_by_play": pbp_rows,          # ← ALL rows, nothing truncated
        "goals_count": len(goals),
        "goals": goals,
        "goalies": goalies,
    }
    path = DATA_DIR / "nhl-playbyplay.json"
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(payload, f, indent=2, ensure_ascii=False)
    print(f"  💾  Play-by-Play JSON: {path}  ({len(pbp_rows)} rows)")
    return path



