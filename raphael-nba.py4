def section(title, lines):
    print(f"  {RED2}{DIV}{R}")
    print(f"  {RED2}▌ {title}{R}")
    print(f"  {RED2}{DIV}{R}")
    for ln in lines:
        print(f"  {ln}")
    print(f"  {RED2}{DIV}{R}")


def banner(title, subtitle=""):
    print(f"  {RED2}{DIV}{R}")
    print(f"  {RED2}🏀  {title}{R}")
    if subtitle:
        print(f"  {RED2}{subtitle}{R}")
    print(f"  {RED2}{DIV}{R}")


