def save_scores_for_alfred(games, source="ESPN_NBA"):
    data = {
        "source": source.upper(),
        "fetched_at": datetime.now().isoformat(),
        "total": len(games),
        "games": []
    }
    for game in games:
        team1 = game.get('team1', 'Unknown')
        team2 = game.get('team2', 'Unknown')
        score1 = game.get('score1', '0')
        score2 = game.get('score2', '0')
        status = game.get('status', 'Scheduled')
        try:
            s1, s2 = int(score1), int(score2)
        except:
            s1, s2 = 0, 0
        data["games"].append({
            "away": team1,
            "home": team2,
            "away_score": str(score1),
            "home_score": str(score2),
            "status": status,
            "away_winner": s1 > s2,
            "home_winner": s2 > s1,
        })
    json_path = DATA_DIR / "nbascores.json"
    with open(json_path, 'w', encoding='utf-8') as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
    print(f"  💾  JSON saved for Alfred: {json_path}")
    return json_path


