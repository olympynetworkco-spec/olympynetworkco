def pick_live_nba_game():
    try:
        req = urllib.request.Request(ESPN_NBA_SCOREBOARD,
                                     headers={'User-Agent': 'Mozilla/5.0'})
        html = urllib.request.urlopen(req, timeout=15).read().decode('utf-8', 'replace')
        m = re.findall(r'/nba/game/_/gameId/(\d+)/([a-z0-9\-]+)', html)
        if m:
            gid, slug = m[0]
            return f"https://www.espn.com/nba/game/_/gameId/{gid}/{slug}"
    except Exception as e:
        print(f"  {RED}⚠ auto-pick failed: {e}{R}")
    return None


#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| odds def scout_odds(game_id):
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

def scout_odds(game_id, away_abbr=None, home_abbr=None):
    if not game_id:
        return []
    url = f"https://site.api.espn.com/apis/site/v2/sports/basketball/nba/summary?event={game_id}"
    try:
        req = urllib.request.Request(url, headers={
            'User-Agent': 'Mozilla/5.0',
            'Accept': 'application/json',
        })
        raw  = urllib.request.urlopen(req, timeout=15).read().decode('utf-8', 'replace')
        data = json.loads(raw)
    except Exception as e:
        print(f"  {RED}⚠ odds fetch failed: {e}{R}")
        return []

    pc = data.get("pickcenter") or data.get("odds") or []
    rows = []
    for e in pc:
        a = e.get("awayTeamOdds") or {}
        h = e.get("homeTeamOdds") or {}
        rows.append({
            "provider":     (e.get("provider") or {}).get("name", "ESPN BET"),
            "away_abbr":    ((a.get("team") or {}).get("abbreviation") or away_abbr),
            "home_abbr":    ((h.get("team") or {}).get("abbreviation") or home_abbr),
            "away_ml":      a.get("moneyLine"),
            "home_ml":      h.get("moneyLine"),
            "away_spread":  e.get("spread"),
            "away_sp_odds": a.get("spreadOdds"),
            "home_sp_odds": h.get("spreadOdds"),
            "total":        e.get("overUnder"),
            "over_odds":    e.get("overOdds"),
            "under_odds":   e.get("underOdds"),
            "details":      e.get("details") or "",
        })
    return rows


#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| def scout_game_leaders(data):
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

def scout_game_leaders(data):
    """
    Extract per-team game leaders from ESPN summary `leaders` block.
    Returns:
      {
        "OKC": {
          "points":   {"name": ..., "short": ..., "jersey": ..., "value": ..., "line": ...},
          "rebounds": {...},
          "assists":  {...},
        },
        "POR": {...},
      }
    """
    out = {}
    for team_block in (data.get("leaders") or []):
        tm = team_block.get("team") or {}
        ab = (tm.get("abbreviation") or "").upper()
        if not ab:
            continue
        team_out = {}
        for cat in (team_block.get("leaders") or []):
            cname = (cat.get("name") or "").lower()
            if cname not in ("points", "rebounds", "assists"):
                continue
            top = (cat.get("leaders") or [{}])[0]
            ath = top.get("athlete") or {}
            val = top.get("value")
            if isinstance(val, dict):
                val = val.get("value")
            team_out[cname] = {
                "name":   ath.get("displayName") or "—",
                "short":  ath.get("shortName") or ath.get("displayName") or "—",
                "jersey": ath.get("jersey") or "",
                "value":  str(val) if val not in (None, "") else "—",
                "line":   top.get("mainStat") or "",
            }
        if team_out:
            out[ab] = team_out
    return out


