def save_odds(rows, game_id=None, source="ESPN_NBA"):
    data = {
        "source":     source.upper(),
        "fetched_at": datetime.now().isoformat(),
        "game_id":    game_id,
        "total":      len(rows),
        "games":      rows,
    }
    path = DATA_DIR / "nba-odds.json"
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
    print(f"  💾  Odds: {path}  ({len(rows)})")
    return path


