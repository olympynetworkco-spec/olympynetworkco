#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

def save_playbyplay_json(pbp_rows, scoring_plays, leaders, game=None):
    payload = {
        "source": "ESPN_NBA",
        "fetched_at": datetime.now().isoformat(),
        "game": game or {},
        "play_by_play_count": len(pbp_rows),
        "play_by_play": pbp_rows,
        "scoring_count": len(scoring_plays),
        "scoring_plays": scoring_plays,
        "game_leaders": leaders or {},
    }
    path = DATA_DIR / "nba-playbyplay.json"
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(payload, f, indent=2, ensure_ascii=False)
    print(f"  💾  Play-by-Play JSON: {path}  ({len(pbp_rows)} rows)")
    return path


