#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
def send_score_notification(change):
    try:
        script = f'''
        display notification "{change['game']}: {change['old']} → {change['new']}" with title "🏀 SCORE" subtitle "{change['status']}" sound name "Ping"
        '''
        subprocess.run(['osascript', '-e', script], capture_output=True, timeout=5)
        print(f"  {RED2}🔔 Score change!{R}")
        print(f"  {GRN}  {change['game']}: {change['old']} → {change['new']}{R}")
    except Exception as e:
        print(f"  {RED}⚠️ Notification failed: {e}{R}")


def speak_score_change(change):
    text = f"Score. {change['game']}. {change['old']} to {change['new']}."
    try:
        mp3 = DATA_DIR / "thomas_nba_voice.mp3"
        r = subprocess.run([
            "edge-tts",
            "--voice", THOMAS_VOICE,
            "--text", text,
            "--write-media", str(mp3)
        ], capture_output=True, text=True, timeout=15)
        if r.returncode != 0:
            print(f"  {YLW}⚠️ TTS skipped (edge-tts 403 — Bing token issue){R}")
            return
        subprocess.run(['afplay', str(mp3)], check=False)
        print(f"  {GRN}🎩 Thomas voice dropped{R}")
    except FileNotFoundError:
        print(f"  {YLW}⚠️ edge-tts not installed — run: pip install edge-tts{R}")
    except Exception as e:
        print(f"  {YLW}⚠️ TTS failed: {e}{R}")


def format_odds_box(odds_row):
    if not odds_row:
        return [f"  {DIM}Odds: Not available yet{R}"]

    away_abbr = odds_row.get("away_abbr", "AWY")
    home_abbr = odds_row.get("home_abbr", "HME")
    provider  = odds_row.get("provider", "ESPN BET")
    
    def fmt_odds(val):
        if val is None or val == "—": return "—"
        if isinstance(val, float) and val.is_integer(): val = int(val)
        if isinstance(val, (int, float)) and val > 0: return f"+{val}"
        return str(val)

    def fmt_spread(val):
        if val is None or val == "—": return "—"
        if isinstance(val, float) and val.is_integer(): val = int(val)
        if isinstance(val, (int, float)) and val > 0: return f"+{val}"
        return str(val)

    away_ml = fmt_odds(odds_row.get("away_ml"))
    home_ml = fmt_odds(odds_row.get("home_ml"))
    
    raw_spread = odds_row.get("away_spread")
    
    if isinstance(raw_spread, (int, float)):
        away_sp = fmt_spread(-raw_spread)
        home_sp = fmt_spread(raw_spread)
    else:
        away_sp = "—"
        home_sp = "—"

    total = odds_row.get("total") or "—"
    over_odds = fmt_odds(odds_row.get("over_odds"))
    under_odds = fmt_odds(odds_row.get("under_odds"))
    away_sp_odds = fmt_odds(odds_row.get("away_sp_odds"))
    home_sp_odds = fmt_odds(odds_row.get("home_sp_odds"))
    
    over_str = f"o{total} ({over_odds})" if total != "—" else "—"
    under_str = f"u{total} ({under_odds})" if total != "—" else "—"
    
    away_sp_str = f"{away_sp} ({away_sp_odds})" if away_sp != "—" else "—"
    home_sp_str = f"{home_sp} ({home_sp_odds})" if home_sp != "—" else "—"

    box = []
    box.append(f"  {RED2}╭─ Odds by {provider} ──────────────────────────────────────╮{R}")
    box.append(f"  {RED2}│{R}  TEAM   ML       SPREAD          TOTAL             {RED2}│{R}")
    box.append(f"  {RED2}│{R}  {away_abbr:<5}  {away_ml:<8} {away_sp_str:<15} {over_str:<17} {RED2}│{R}")
    box.append(f"  {RED2}│{R}  {home_abbr:<5}  {home_ml:<8} {home_sp_str:<15} {under_str:<17} {RED2}│{R}")
    box.append(f"  {RED2}╰────────────────────────────────────────────────────────────╯{R}")
    return box


def darwin_format(games, source, current_odds=None):
    output = []
    output.append(DIV)
    output.append(f"🏀  nba SCOREBOARD  —  {time.strftime('%A, %B %d, %Y — %I:%M %p')}  🔴🐢")
    output.append(DIV)
    if games:
        output.append(f"  📡 Source: {source.upper()}")
        
        if current_odds:
            odds_box = format_odds_box(current_odds[0])
            output.extend(odds_box)
            
        output.append(DIV)
        for i, game in enumerate(games, 1):
            team1 = game.get('team1', '?')
            team2 = game.get('team2', '?')
            score1 = game.get('score1', '0')
            score2 = game.get('score2', '0')
            status = game.get('status', 'Scheduled')
            if 'Final' in status:
                output.append(f"  {i:2}. {team1:24} {score1} — {score2} {team2:24}  [DONE] Final")
            elif status == 'Scheduled':
                output.append(f"  {i:2}. {team1:24} vs {team2:24}  ⏰ Scheduled")
            else:
                output.append(f"  {i:2}. {team1:24} {score1} — {score2} {team2:24}  🏀 {status}")
            output.append(DIV)
    else:
        output.append("  ⏳ No game found")
        output.append(DIV)
    return "\n".join(output)


def mikey_countdown(seconds=25):
    frames = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏']
    idx = 0
    for remaining in range(seconds, 0, -1):
        for _ in range(10):
            print(f"\r  {RED2}{frames[idx % len(frames)]}{R}  {DIM}next grip in {remaining:3}s{R}",
                  end="", flush=True)
            idx += 1
            time.sleep(0.08)
    print()


def exit_handler(sig, frame):
    print(f"\n  {RED2}🔴  Raphael dropping the ball...{R}")
    print(f"  {RED2}🔴  Kobe forever. ❤️{R}\n")
    sys.exit(0)

signal.signal(signal.SIGINT, exit_handler)
signal.signal(signal.SIGTERM, exit_handler)


