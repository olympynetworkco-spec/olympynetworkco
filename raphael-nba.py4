#+--|def scout_league_odds(league_games):
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

def scout_league_odds(league_games):
    if not league_games:
        return []
    all_rows = []
    for g in league_games:
        gid = g.get("game_id") or g.get("id")
        if not gid:
            continue
        rows = scout_odds(
            gid,
            away_abbr=g.get("away_abbr"),
            home_abbr=g.get("home_abbr"),
        )
        if not rows:
            continue
        matchup = f"{g.get('away','Away')} @ {g.get('home','Home')}"
        for r in rows:
            r["game_id"] = gid
            r["matchup"] = matchup
        all_rows.extend(rows)
    return all_rows


def save_league_odds(rows, source="ESPN_NBA"):
    data = {
        "source":     source.upper(),
        "fetched_at": datetime.now().isoformat(),
        "total":      len(rows),
        "games":      rows,
    }
    path = DATA_DIR / "espn-nba-odds.json"
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
    return path


def print_league_odds(rows):
    if not rows:
        print(f"  {YLW}⚠ no ESPN odds returned{R}")
        return
    section("ESPN NBA ODDS — LEAGUE WIDE", [
        f"{DIM}{'MATCHUP':<26} {'AWAY ML':>8} {'HOME ML':>9} "
        f"{'SPREAD':>7} {'TOTAL':>6} {'PROVIDER':<12}{R}",
    ] + [
        f"{r.get('matchup','?'):<26} "
        f"{str(r.get('away_ml','—')):>8} "
        f"{str(r.get('home_ml','—')):>9} "
        f"{str(r.get('away_spread','—')):>7} "
        f"{str(r.get('total','—')):>6} "
        f"{r.get('provider','ESPN BET'):<12}"
        for r in rows
    ])

#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| def scout_yahoo_winprob(url):
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

def scout_yahoo_winprob(url):
    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
    try:
        raw = urllib.request.urlopen(req, timeout=15).read().decode('utf-8', 'replace')
    except Exception as e:
        print(f"  {RED}⚠ winprob fetch failed: {e}{R}")
        return []

    blobs = re.findall(r'self\.__next_f\.push\(\[1,("(?:[^"\\]|\\.)*")\]\)', raw)
    joined = ""
    for b in blobs:
        try:
            joined += json.loads(b)
        except Exception:
            continue

    if not joined:
        joined = raw

    key = '"winProbabilityTimeline":'
    idx = joined.find(key)
    if idx == -1:
        return []

    start_bracket = joined.find('[', idx)
    if start_bracket == -1:
        return []

    depth = 0
    end_bracket = -1
    for i in range(start_bracket, len(joined)):
        char = joined[i]
        if char == '[':
            depth += 1
        elif char == ']':
            depth -= 1
            if depth == 0:
                end_bracket = i
                break

    if end_bracket == -1:
        return []

    json_str = joined[start_bracket:end_bracket+1]

    try:
        series = json.loads(json_str)
    except Exception as e:
        print(f"  {RED}⚠ winprob parse failed: {e}{R}")
        return []

    def get_val(obj):
        if isinstance(obj, dict):
            return obj.get("value", 0)
        return obj if obj is not None else 0

    out = []
    for p in series:
        clock = p.get("clock") or ""
        per = None
        mmss = None
        
        mm = re.match(r'^(1st|2nd|3rd|4th|OT)\s+(\d{1,2}:\d{2})$', clock)
        if mm:
            per = {"1st": 1, "2nd": 2, "3rd": 3, "4th": 4, "OT": 5}[mm.group(1)]
            mmss = mm.group(2)
            
        out.append({
            "clock":       clock,
            "period":      per,
            "time":        mmss,
            "home_pct":    get_val(p.get("homeTeamProbability")),
            "away_pct":    get_val(p.get("awayTeamProbability")),
            "home_score":  get_val(p.get("homeScore")),
            "away_score":  get_val(p.get("awayScore")),
        })
        
    return out


#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| def scout_league_scoreboard():
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

ESPN_NBA_SCOREBOARD_JSON = (
    "https://site.api.espn.com/apis/site/v2/sports/basketball/nba/scoreboard"
)

def scout_league_scoreboard():
    try:
        req = urllib.request.Request(
            ESPN_NBA_SCOREBOARD_JSON,
            headers={
                'User-Agent': 'Mozilla/5.0',
                'Accept':     'application/json',
            },
        )
        raw = urllib.request.urlopen(req, timeout=15).read().decode('utf-8', 'replace')
        data = json.loads(raw)
    except Exception as e:
        print(f"  {RED}⚠ league scoreboard JSON fetch failed: {e}{R}")
        return []

    events = data.get("events", []) or []
    out = []

    for ev in events:
        try:
            comp = (ev.get("competitions") or [{}])[0]
            teams = comp.get("competitors") or []
            if len(teams) < 2:
                continue

            by_side = {t.get("homeAway"): t for t in teams}
            away = by_side.get("away") or teams[0]
            home = by_side.get("home") or teams[1]

            away_team = away.get("team") or {}
            home_team = home.get("team") or {}

            away_full = away_team.get("displayName") or away_team.get("name") or "Away"
            home_full = home_team.get("displayName") or home_team.get("name") or "Home"
            away_abbr = (away_team.get("abbreviation") or FULL_TO_ABBR.get(away_full, away_full[:3])).upper()
            home_abbr = (home_team.get("abbreviation") or FULL_TO_ABBR.get(home_full, home_full[:3])).upper()

            away_score = away.get("score")
            home_score = home.get("score")
            away_score = str(away_score) if away_score not in (None, "") else "0"
            home_score = str(home_score) if home_score not in (None, "") else "0"

            status_obj = (comp.get("status") or ev.get("status") or {})
            st_type    = status_obj.get("type") or {}
            st_desc    = st_type.get("description") or st_type.get("detail") or "Scheduled"
            st_state   = st_type.get("state") or ""
            st_detail  = status_obj.get("displayClock") or ""
            st_period  = status_obj.get("period") or 0

            # ── tip-off clock ──
            start_time_str = None
            raw_detail = (st_type.get("detail") or "").strip()

            m_short = re.match(r'^(\d{1,2}:\d{2}\s*(?:AM|PM))', raw_detail, re.I)
            if m_short:
                start_time_str = m_short.group(1) + " ET"

            if not start_time_str:
                m_long = re.search(r'(\d{1,2}:\d{2}\s*(?:AM|PM))', raw_detail, re.I)
                if m_long:
                    start_time_str = m_long.group(1) + " ET"

            if not start_time_str and st_state == "pre" and ev.get("date"):
                try:
                    from datetime import datetime as _dt
                    utc_dt = _dt.fromisoformat(ev["date"].replace("Z", "+00:00"))
                    try:
                        from zoneinfo import ZoneInfo
                        et_dt = utc_dt.astimezone(ZoneInfo("America/New_York"))
                        start_time_str = et_dt.strftime("%-I:%M %p ET")
                    except Exception:
                        start_time_str = utc_dt.strftime("%-I:%M %p ET")
                except Exception:
                    pass

            if st_state == "in":
                status = st_desc
                if st_detail and st_detail not in status:
                    ord_per = {1: "1st", 2: "2nd", 3: "3rd", 4: "4th", 5: "OT", 6: "2OT"}.get(
                        int(st_period) or 0, ""
                    )
                    status = f"{ord_per} {st_detail}".strip()
            elif st_state == "post":
                status = st_desc if "Final" in (st_desc or "") else "Final"
            else:
                status = start_time_str or st_desc or "Scheduled"

            try:
                s1, s2 = int(away_score), int(home_score)
            except Exception:
                s1, s2 = 0, 0
            away_winner = away.get("winner") if isinstance(away.get("winner"), bool) else (s1 > s2 and st_state == "post")
            home_winner = home.get("winner") if isinstance(home.get("winner"), bool) else (s2 > s1 and st_state == "post")

            gid = ev.get("id") or comp.get("id")

            out.append({
                "id":          gid,
                "game_id":     gid,
                "away":        away_full,
                "home":        home_full,
                "away_abbr":   away_abbr,
                "home_abbr":   home_abbr,
                "away_score":  away_score,
                "home_score":  home_score,
                "status":      status,
                "away_winner": bool(away_winner),
                "home_winner": bool(home_winner),
            })
        except Exception as e:
            print(f"  {YLW}⚠ league row skipped: {e}{R}")
            continue

    return out


#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| BASKETBALL COURT — half-court box-drawing render
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

def render_court(away_abbr="AWAY", home_abbr="HOME"):
    L = "│"
    TL, TR, BL, BR = "╭", "╮", "╰", "╯"
    TJ, TJB = "┬", "┴"
    H = "─"

    col = 15

    top = f"  {TL}" + H*col + TJ + H*col + TJ + H*col + TJ + H*col + TR
    bot = f"  {BL}" + H*col + TJB + H*col + TJB + H*col + TJB + H*col + BR

    def blank():
        return f"  {L}{' '*col}{L}{' '*col}{L}{' '*col}{L}{' '*col}{L}"

    def key_row():
        return f"  {L}{' '*col}{L}  ╭───┬───╮  {L}{' '*col}{L}"

    def key_mid():
        return f"  {L}{' '*col}{L}  │   │   │  {L}{' '*col}{L}"

    def key_bot():
        return f"  {L}{' '*col}{L}  ╰───┴───╯  {L}{' '*col}{L}"

    def three_arc():
        return f"  {L}{' '*col}{L} ╭───────╮ {L}{' '*col}{L}"

    def three_arc_bot():
        return f"  {L}{' '*col}{L} ╰───────╯ {L}{' '*col}{L}"

    lines = [top, blank(), three_arc(), blank(), key_row(), key_mid(), key_bot(), blank(), three_arc_bot(), blank(), bot]

    label_line = (
        f"  {RED2}{away_abbr:^{col}}{R}"
        f"{' '*col}"
        f"{' '*col}"
        f"{RED2}{home_abbr:^{col}}{R}"
    )
    lines.append(label_line)

    return lines


#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| def xfactor_for(name) — game leaders from ESPN summary
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

_LEADERS_CACHE = {"gid": None, "data": {}}

def _fetch_game_leaders(gid):
    """Pull the ESPN summary `leaders` block for a gameId → {TEAM: {cat: {...}}}"""
    if not gid:
        return {}
    if _LEADERS_CACHE["gid"] == gid and _LEADERS_CACHE["data"]:
        return _LEADERS_CACHE["data"]
    url = f"https://site.api.espn.com/apis/site/v2/sports/basketball/nba/summary?event={gid}"
    try:
        req = urllib.request.Request(url, headers={
            'User-Agent': 'Mozilla/5.0', 'Accept': 'application/json'})
        data = json.loads(urllib.request.urlopen(req, timeout=15).read().decode('utf-8', 'replace'))
    except Exception:
        return {}

    out = {}
    for team_block in (data.get("leaders") or []):
        tm = team_block.get("team") or {}
        ab = (tm.get("abbreviation") or "").upper()
        if not ab:
            continue
        team_out = {}
        for cat in (team_block.get("leaders") or []):
            cname = (cat.get("name") or "").lower()
            if cname not in ("points", "rebounds", "assists"):
                continue
            top = (cat.get("leaders") or [{}])[0]
            ath = top.get("athlete") or {}
            val = top.get("value")
            if isinstance(val, dict):
                val = val.get("value")
            team_out[cname] = {
                "label": cat.get("displayName") or cname.title(),
                "name":  ath.get("displayName") or "—",
                "short": ath.get("shortName") or ath.get("displayName") or "—",
                "value": str(val) if val not in (None, "") else "—",
                "line":  top.get("mainStat") or "",
            }
        if team_out:
            out[ab] = team_out
    _LEADERS_CACHE["gid"] = gid
    _LEADERS_CACHE["data"] = out
    return out


def xfactor_for(name):
    """Return the categories a player leads in (Points/Rebounds/Assists) from ESPN leaders block."""
    if not name:
        return []

    clean = re.sub(r'\([^)]*\)', '', name)
    clean = re.sub(r'\[[^\]]*\]', '', clean)
    clean = re.sub(r'#\d+', '', clean)
    clean = clean.strip()
    if not clean:
        return []

    if re.search(
        r'\b(makes|made|misses|missed|shot|pass|rebound|assist|turnover|'
        r'foul|free throw|layup|dunk|three|block|steal)\b',
        clean, re.I
    ):
        return []

    m = re.search(r'/gameId/(\d+)', GAMECAST_NBA_GAME or "")
    gid = m.group(1) if m else None
    leaders = _fetch_game_leaders(gid)
    if not leaders:
        return []

    tokens = clean.split()
    last = tokens[-1].lower()
    full = clean.lower()

    hits = []
    for team_cats in leaders.values():
        for cat_key, ld in team_cats.items():
            short = (ld.get("short") or "").lower()
            display = (ld.get("name") or "").lower()
            short_last = short.split()[-1] if short else ""
            display_last = display.split()[-1] if display else ""
            if last in (short_last, display_last) or full == display or full == short:
                label = ld.get("label") or cat_key.title()
                if label not in hits:
                    hits.append(label)
    return hits


#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| def scout_dump(): scout dump
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

def scout_dump():
    """Grip ESPN NBA Gamecast via JSON summary API → sectioned terminal dump."""

    url = GAMECAST_NBA_GAME or pick_live_nba_game()
    if not url:
        print(f"  {RED}⚠ no NBA game URL{R}")
        return [], "none", [], [], {}

    m = re.search(r'/gameId/(\d+)', url)
    gid = m.group(1) if m else None
    if not gid:
        print(f"  {RED}⚠ no gameId in URL: {url}{R}")
        return [], "none", [], [], {}

    api = f"https://site.api.espn.com/apis/site/v2/sports/basketball/nba/summary?event={gid}"
    print(f"  {CYN}🏀  summary API:  {api}{R}")

    try:
        req = urllib.request.Request(api, headers={
            'User-Agent': 'Mozilla/5.0', 'Accept': 'application/json'})
        data = json.loads(urllib.request.urlopen(req, timeout=15).read().decode('utf-8', 'replace'))
    except Exception as e:
        print(f"  {RED}⚠ summary API fetch failed: {e}{R}")
        return [], "none", [], [], {}

    (DATA_DIR / "espn-nba-summary.json").write_text(
        json.dumps(data, indent=2, ensure_ascii=False), encoding='utf-8')

    # ── header ──
    hdr = (data.get("header") or {})
    comps = hdr.get("competitions") or []
    comp = comps[0] if comps else {}
    teams = comp.get("competitors") or []

    by_side = {t.get("homeAway"): t for t in teams}
    away = by_side.get("away") or (teams[0] if teams else {})
    home = by_side.get("home") or (teams[1] if len(teams) > 1 else {})

    away_team = away.get("team") or {}
    home_team = home.get("team") or {}

    away_full = away_team.get("displayName") or away_team.get("name") or "Away"
    home_full = home_team.get("displayName") or home_team.get("name") or "Home"
    away_abbr = (away_team.get("abbreviation") or FULL_TO_ABBR.get(away_full, away_full[:3])).upper()
    home_abbr = (home_team.get("abbreviation") or FULL_TO_ABBR.get(home_full, home_full[:3])).upper()

    away_score = away.get("score")
    home_score = home.get("score")
    away_score = str(away_score) if away_score not in (None, "") else "0"
    home_score = str(home_score) if home_score not in (None, "") else "0"

    status_obj = comp.get("status") or {}
    st_type    = status_obj.get("type") or {}
    st_state   = st_type.get("state") or ""
    st_desc    = st_type.get("description") or st_type.get("detail") or "Scheduled"
    st_detail  = status_obj.get("displayClock") or ""
    st_period  = status_obj.get("period") or 0

    if st_state == "in":
        ord_per = {1: "1st", 2: "2nd", 3: "3rd", 4: "4th", 5: "OT", 6: "2OT"}.get(int(st_period) or 0, "")
        period  = ord_per or st_desc
        clock   = st_detail
        status  = f"{period} {clock}".strip()
    elif st_state == "post":
        period  = st_desc
        clock   = None
        status  = "Final" if "Final" not in st_desc else st_desc
    else:
        raw_detail = (st_type.get("detail") or "").strip()
        if re.match(r'^\d{1,2}:\d{2}\s*(AM|PM)', raw_detail, re.I):
            status = raw_detail
        elif comp.get("date"):
            try:
                from datetime import datetime as _dt
                utc_dt = _dt.fromisoformat(comp["date"].replace("Z", "+00:00"))
                try:
                    from zoneinfo import ZoneInfo
                    et_dt = utc_dt.astimezone(ZoneInfo("America/New_York"))
                    status = et_dt.strftime("%-I:%M %p ET")
                except Exception:
                    status = utc_dt.strftime("%-I:%M %p ET")
            except Exception:
                status = st_desc or "Scheduled"
        else:
            status = st_desc or "Scheduled"
        period = status
        clock  = None

    matchup = f"{away_full} @ {home_full}"

    # ── box score (quarter by quarter) ──
    def line_score(side):
        ls = side.get("linescores") or []
        per = [int(p.get("value") or 0) for p in ls if p.get("value") not in (None, "")]
        if not per:
            tm_id = (side.get("team") or {}).get("id")
            for bt in ((data.get("boxscore") or {}).get("teams") or []):
                if str((bt.get("team") or {}).get("id")) == str(tm_id):
                    per = [int(p.get("value") or 0) for p in (bt.get("linescores") or [])]
                    break
        return (per + [0]*4)[:4] + [int(side.get("score") or 0)]

    away_p = line_score(away) if (away.get("linescores") or away.get("score") is not None) else None
    home_p = line_score(home) if (home.get("linescores") or home.get("score") is not None) else None

    # ── scoring plays ──
    scoring_plays = []
    for p in (data.get("plays") or []):
        try:
            if not p.get("scoringPlay"):
                continue
            pnum = int((p.get("period") or {}).get("number") or 0)
            pname = {1: "1ST", 2: "2ND", 3: "3RD", 4: "4TH", 5: "OT"}.get(pnum, f"Q{pnum}")
            clock_s = (p.get("clock") or {}).get("displayValue") or ""
            text = p.get("text") or ""
            scorer_name = "—"
            m_scorer = re.match(r'^([A-Z][A-Za-z\.\-\'\s]+?)\s+(?:makes|drains|hits|scores|converts)\b', text)
            if m_scorer:
                scorer_name = m_scorer.group(1).strip()
            away_r = p.get("awayScore")
            home_r = p.get("homeScore")
            scoring_plays.append({
                "period":  f"{pname} QUARTER",
                "clock":   clock_s,
                "scorer":  scorer_name,
                "text":    text,
                "score":   f"{away_r}-{home_r}" if away_r is not None else "",
            })
        except Exception:
            continue

    def score_sort_key(s):
        per_num = {"1ST": 1, "2ND": 2, "3RD": 3, "4TH": 4, "OT": 5}.get(s["period"].split()[0], 1)
        try:
            mm, ss = s["clock"].split(":")
            secs = int(mm) * 60 + int(ss)
        except Exception:
            secs = 0
        return (per_num, -secs)
    scoring_plays.sort(key=score_sort_key)

    # ── GAME LEADERS (from ESPN `leaders` block) ──
    leaders = scout_game_leaders(data)

    # ── play-by-play (from plays[]) ──
    pbp_rows = []
    for p in (data.get("plays") or []):
        try:
            clock_p = (p.get("clock") or {}).get("displayValue") or ""
            pnum    = int((p.get("period") or {}).get("number") or 0)
            pname   = {1: "1ST", 2: "2ND", 3: "3RD", 4: "4TH", 5: "OT"}.get(pnum, "")
            desc    = p.get("text") or p.get("shortText") or ""
            if not desc:
                continue
            score   = ""
            if p.get("awayScore") is not None and p.get("homeScore") is not None:
                score = f"{p['awayScore']}-{p['homeScore']}"
            pbp_rows.append({
                "period": f"{pname} QUARTER" if pname else "",
                "clock":  clock_p,
                "score":  score,
                "desc":   desc,
            })
        except Exception:
            continue

    pbp_rows.reverse()

    # ═══════════════════════════════════════════════════════════
    #  PRINT
    # ═══════════════════════════════════════════════════════════

    print()
    banner("RAPHAEL  ·  ESPN NBA GAMECAST",
           f"{matchup}" + (f"  ·  {status}" if status and status != "Scheduled" else ""))

    section("ANCHOR TREE", [
        f"{RED2}ᛉ  source    = JSON summary API{R}",
        f"{RED2}ᛉ  game_id   = {gid}{R}",
        f"{RED2}ᛉ  live: {away_abbr} {away_score} - {home_score} {home_abbr}  ·  {status}{R}",
        f"{RED2}ᛉ  pbp rows  = {len(pbp_rows)}{R}",
        f"{RED2}ᛉ  scores    = {len(scoring_plays)}{R}",
    ])

    if away_p and home_p:
        section("BOX SCORE", [
            f"{DIM}         1    2    3    4    T{R}",
            f"{GRN}{away_abbr:<5}{R}  " + "  ".join(f"{v:>3}" for v in away_p),
            f"{GRN}{home_abbr:<5}{R}  " + "  ".join(f"{v:>3}" for v in home_p),
        ])

    section("HALF COURT", render_court(
        away_abbr=away_abbr or "AWAY",
        home_abbr=home_abbr or "HOME",
    ))

    if scoring_plays:
        lines = []
        last_p = None
        for s in scoring_plays:
            if s["period"] != last_p:
                lines.append(f"{RED2}{s['period']}{R}")
                last_p = s["period"]
            
            scorer = s['scorer']
            xf = xfactor_for(scorer)
            xf_str = f" [{', '.join(xf)}]" if xf else ""
            
            lines.append(f"{DIM}{s['clock']:>6}{R}   {YLW}⭐ {scorer}{xf_str}{R}")
            if s["text"]:
                lines.append(f"{DIM}        {s['text']}{R}")
            if s["score"]:
                lines.append(f"{DIM}        {s['score']}{R}")
        section("SCORING PLAYS - X factor stars of the game ⭐", lines)
        print(f"\n  {RED2}{'═' * 70}{R}\n")

    if leaders:
        lines = []
        for abbr_ in (away_abbr, home_abbr):
            team = leaders.get(abbr_)
            if not team:
                continue
            lines.append(f"{RED2}{abbr_}{R}")
            for cat in ("points", "rebounds", "assists"):
                ld = team.get(cat)
                if not ld:
                    continue
                jersey = f"#{ld['jersey']}" if ld["jersey"] else ""
                lines.append(f"  {YLW}{cat.title():<10}{R} {ld['short']}{jersey:<4} {ld['value']:>3}")
                if ld["line"]:
                    lines.append(f"  {'':<10} {DIM}{ld['line']}{R}")
            lines.append("")
        section("GAME LEADERS", lines)
        print(f"\n  {RED2}{'═' * 70}{R}\n")

    if pbp_rows:
        lines = []
        last_p = None
        for p in pbp_rows:
            if p["period"] and p["period"] != last_p:
                lines.append(f"{RED2}{p['period']}{R}")
                last_p = p["period"]
            score = f"({p['score']}) " if p["score"] else ""
            lines.append(f"{DIM}{p['clock']:>6}{R}  {score}{p['desc']}")
        section("PLAY-BY-PLAY", lines)
    else:
        section("PLAY-BY-PLAY", [f"{DIM}no plays yet — game may not have started{R}"])

    print()

    game = {
        "team1": away_full,
        "team2": home_full,
        "score1": away_score,
        "score2": home_score,
        "status": status,
        "game_id": gid,
    }
    return [game], "espn_nba", pbp_rows, scoring_plays, leaders


