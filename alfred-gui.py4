    # ── downloads ──
    def _unique_path(self, name):
        target = DOWNLOADS / name
        n = 1
        stem, suffix = target.stem, target.suffix
        while target.exists():
            target = DOWNLOADS / f"{stem} ({n}){suffix}"
            n += 1
        return target

#+--|---------------------------------------------------------------------------------------->>>>
#+--|    def download_file(self):
#+--|---------------------------------------------------------------------------------------->>>>
#+--|

    def download_file(self):
        url = self.current_url()
        if not url:
            return
        name = url.split("/")[-1].split("?")[0] or "download"
        if "." not in name:
            name += ".html"
        target = self._unique_path(name)
        self.SetStatusText(f"Downloading → {target}")
        self._run_thread(self._fetch_file, url, target)

    def _fetch_file(self, url, target):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=30) as r, open(target, "wb") as f:
                while True:
                    chunk = r.read(65536)
                    if not chunk:
                        break
                    f.write(chunk)
            wx.CallAfter(self.SetStatusText, f"✅ Saved {target}")
        except Exception as e:
            wx.CallAfter(self.SetStatusText, f"⚠ {e}")

    def download_video(self):
        self._open_downloader(VIDEO_DOWNLOAD, "Video")

#+--|---------------------------------------------------------------------------------------->>>>
#+--|    def download_audio(self):
#+--|---------------------------------------------------------------------------------------->>>>
#+--|

    def download_audio(self):
        self._open_downloader(AUDIO_DOWNLOAD, "Audio")


    def _open_downloader(self, site_url, kind):
        src = self.current_url()
        if not src:
            self.SetStatusText(f"⚠ No URL to send to {kind} downloader")
            return
        if wx.TheClipboard.Open():
            wx.TheClipboard.SetData(wx.TextDataObject(src))
            wx.TheClipboard.Close()
        self.new_tab(site_url)
        self.SetStatusText(f"{kind}: pasting → {src}")


    def _run_thread(self, fn, *args):
        t = threading.Thread(target=fn, args=args, daemon=True)
        t.start()


    def open_file_picker(self):
        dlg = FilePickerDialog(self)
        if dlg.ShowModal() == wx.ID_OK:
            f = dlg.selected_file()
            if f:
                self.new_tab(f.as_uri())
        dlg.Destroy()


    def on_key_press(self, event):
        if event.CmdDown():
            if event.GetKeyCode() in (wx.WXK_NUMPAD_ADD, ord('='), ord('+')):
                self.zoom_in()
                return
            elif event.GetKeyCode() in (wx.WXK_NUMPAD_SUBTRACT, ord('-')):
                self.zoom_out()
                return
            elif event.GetKeyCode() == ord('0'):
                self.zoom_reset()
                return
        event.Skip()

    def zoom_in(self):
        self.zoom_level = min(3.0, self.zoom_level + 0.1)
        self._apply_zoom()

    def zoom_out(self):
        self.zoom_level = max(0.3, self.zoom_level - 0.1)
        self._apply_zoom()

    def zoom_reset(self):
        self.zoom_level = 1.0
        self._apply_zoom()

    def _apply_zoom(self):
        w = self.current()
        if w:
            w.RunScript(f"document.body.style.zoom = '{self.zoom_level}';")
#+--|---------------------------------------------------------------------------------------->>>>
#+--| CHAPTER 1 : TURBO EXECUTION
