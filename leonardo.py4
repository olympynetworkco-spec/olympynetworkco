  .chat-panel{position:fixed;top:0;bottom:56px;right:0;width:360px;max-width:88vw;flex-shrink:0;
    background:var(--panel);border-left:1px solid var(--line);
    display:flex;transform:translateX(100%);transition:transform .22s ease;
    z-index:15;box-shadow:-8px 0 24px rgba(0,0,0,.4);overflow:hidden}
  .chat-panel.open{transform:translateX(0)}
  .chat-inner{width:100%;display:flex;height:100%;flex-shrink:0}

  .collapse-rail{position:fixed;top:50%;right:0;transform:translateY(-50%);width:36px;
    border:1px solid var(--line);border-right:none;background:var(--panel2);
    display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:10px;
    cursor:pointer;padding:14px 6px;border-radius:10px 0 0 10px;box-shadow:-4px 0 14px rgba(0,0,0,.35);
    z-index:16;transition:right .22s ease}
  .collapse-rail.open{right:360px}
  .collapse-rail:hover{background:#1a212b}
  .collapse-rail .chev{width:14px;height:14px;stroke:var(--sub);transition:transform .22s}
  .collapse-rail.open .chev{transform:rotate(180deg)}
  .collapse-rail .bubble{width:22px;height:22px;border-radius:6px;background:var(--amber);
    display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .collapse-rail .bubble svg{width:12px;height:12px;stroke:#08111F;stroke-width:2}
  .collapse-rail .lbl{writing-mode:vertical-rl;font-size:10px;letter-spacing:.06em;color:var(--sub);
    font-weight:600;margin-top:2px}
  @media (max-width:520px){ .collapse-rail.open{right:88vw} }

  .conv-list{width:120px;border-right:1px solid var(--line);overflow-y:auto;flex-shrink:0}
  .conv-item{padding:12px 10px;border-bottom:1px solid #1a2029;cursor:pointer;font-size:12px;color:var(--sub)}
  .conv-item .nm{color:var(--text);font-weight:600;font-size:12px}
  .conv-item .prev{font-size:10.5px;margin-top:2px;line-height:1.3;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .conv-item.active{background:var(--panel2);border-left:2px solid var(--amber)}

  .chat-main{flex:1;display:flex;flex-direction:column;min-width:0}
  .chat-head{padding:14px 14px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:8px}
  .chat-head .av{width:26px;height:26px;border-radius:50%;background:var(--amber-dim);flex-shrink:0}
  .chat-head .nm{font-size:13px;font-weight:600}
  .chat-head .sub{font-size:10.5px;color:var(--sub)}

  .messages{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px}
  .msg{max-width:82%;font-size:12.5px;line-height:1.4;padding:8px 10px;border-radius:8px}
  .msg.them{background:var(--panel2);align-self:flex-start;border:1px solid var(--line)}
  .msg.me{background:#152036;align-self:flex-end;color:#CFE0FA;border:1px solid var(--amber-dim)}
  .msg .t{font-size:9.5px;color:var(--sub);margin-top:4px}
  .file-chip{display:flex;align-items:center;gap:6px;background:var(--panel);border:1px solid var(--line);
    border-radius:6px;padding:6px 8px;font-size:11px;align-self:flex-start;color:var(--amber);cursor:pointer}
  .file-chip:hover{border-color:var(--amber)}

  /* mini PiP file viewer — draggable via its handle */
  .pip{position:fixed;left:24px;bottom:80px;width:280px;max-width:80vw;background:var(--panel);
    border:1px solid var(--line);border-radius:10px;box-shadow:0 12px 30px rgba(0,0,0,.5);
    z-index:50;display:none;flex-direction:column;overflow:hidden}
  .pip.show{display:flex}
  .pip-head{display:flex;align-items:center;gap:8px;padding:8px 10px;background:var(--panel2);
    border-bottom:1px solid var(--line);cursor:grab;touch-action:none}
  .pip-head:active{cursor:grabbing}
  .pip-head .grip{display:flex;flex-direction:column;gap:2px;flex-shrink:0}
  .pip-head .grip span{width:3px;height:3px;border-radius:50%;background:var(--sub)}
  .pip-head .grip{display:grid;grid-template-columns:1fr 1fr;gap:2px}
  .pip-title{font-size:11.5px;font-weight:600;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .pip-close{width:18px;height:18px;border-radius:4px;display:flex;align-items:center;justify-content:center;
    cursor:pointer;color:var(--sub);flex-shrink:0}
  .pip-close:hover{background:var(--line);color:var(--text)}
  .pip-body{padding:10px;overflow:auto;max-height:340px;font-size:11.5px}
  .pip-body img{max-width:100%;border-radius:6px;display:block}
  .pip-body audio{width:100%}
  .pip-body pre{white-space:pre-wrap;word-break:break-word;font-family:var(--mono);font-size:10.5px;
    color:var(--text);margin:0;line-height:1.5}
  .pip-body iframe{width:100%;height:220px;border:1px solid var(--line);border-radius:6px;background:#fff}
  .pip-meta-row{display:flex;justify-content:space-between;font-size:10.5px;color:var(--sub);padding:3px 0}
  .pip-meta-row .v{color:var(--text);font-family:var(--mono)}
  .pip-tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:6px}
  .pip-tag{font-size:9.5px;background:var(--panel2);border:1px solid var(--line);border-radius:10px;
    padding:2px 8px;color:var(--sub)}
  .pip-btnrow{display:flex;gap:6px;margin:8px 0}
  .pip-btn{flex:1;text-align:center;padding:6px 0;border-radius:6px;font-size:11px;cursor:pointer}
  .pip-btn.primary{background:var(--amber);color:#08111F;font-weight:600}
  .pip-btn.ghost{background:var(--panel2);border:1px solid var(--line);color:var(--text)}
  .pip-hint{color:var(--sub);font-size:10.5px}

  .composer{border-top:1px solid var(--line);padding:10px 12px;display:flex;align-items:center;gap:8px}
  .picker-btn{width:28px;height:28px;border-radius:6px;border:1px solid var(--line);background:var(--panel2);
    display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0}
  .picker-btn svg{width:14px;height:14px;stroke:var(--sub)}
  .picker-btn:hover{border-color:var(--amber)}
  input[type=text]{flex:1;background:var(--panel2);border:1px solid var(--line);border-radius:6px;
    padding:8px 10px;color:var(--text);font-size:12.5px;outline:none}
  input[type=text]:focus{border-color:var(--amber)}
  .send-btn{width:28px;height:28px;border-radius:6px;background:var(--amber);border:none;flex-shrink:0;
    display:flex;align-items:center;justify-content:center;cursor:pointer}
  .send-btn svg{width:13px;height:13px;fill:#08111F}
  #filein{display:none}

  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:#242b35;border-radius:3px}

  @media (max-width:820px){
    .conv-list{width:0;display:none}
  }
</style>
</head>
<body>
<div class="app" id="app">

  <!-- LEFT DOCK TAB -->
<div class="left-rail open" id="leftRail">

    <div class="bubble"><svg viewBox="0 0 24 24" fill="none"><path d="M4 19V5M10 19V9M16 19V12M22 19V6"/></svg></div>
    <span class="lbl">LIVE</span>
    <svg class="chev" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
  </div>

  <!-- LEFT DATA PANEL -->
<div class="data-panel open" id="dataPanel">
    <div class="brand"><span class="mark">▲</span><h1>LINE &amp; LENGTH</h1><span class="clock" id="clock">--:--</span></div>

<div class="section">
  <h2>LIVE — NFL</h2>
  <div class="game" id="nflAway"><div class="team lead"><span class="dot"></span>—</div><div class="score">—</div><div class="clockstate">—</div></div>
  <div class="game" id="nflHome"><div class="team">—</div><div class="score">—</div><div class="clockstate">—</div></div>
  <div class="winbar-row">
    <div class="winbar-label"><span id="nflAwayPct">—</span><span id="nflHomePct">—</span></div>
    <div class="winbar"><div class="a" id="nflBarA" style="width:50%"></div><div class="b" id="nflBarB" style="width:50%"></div></div>
  </div>
</div>

<div class="section">
  <h2>AROUND THE LEAGUE</h2>
  <div id="aroundLeague"></div>
</div>

<div class="section">
  <h2>AFC EAST STANDINGS</h2>
  <div id="standingsBox"></div>
</div>

    <div class="section">
      <h2 id="trendTitle">WIN % TREND — —</h2>
      <div class="chart-wrap">
        <svg viewBox="0 0 300 90" preserveAspectRatio="none">
          <polyline id="trendLine" points=""
            fill="none" stroke="#F2A44C" stroke-width="2"/>
          <text x="0" y="86" class="axis-lbl" id="trendLblA">—</text>
          <text x="140" y="86" class="axis-lbl">mid</text>
          <text x="270" y="86" class="axis-lbl" id="trendLblB">—</text>
        </svg>
      </div>
      <div class="stat-grid">
        <div class="stat"><div class="v" id="trendCur">—%</div><div class="l" id="trendCurLbl">CURRENT WIN PROB</div></div>
        <div class="stat"><div class="v" id="trendMove">—</div><div class="l">WP MOVE</div></div>
      </div>
    </div>
  </div>

  <!-- CENTER -->
  <div class="feed">
    <div class="hub-head">
      <h1>Home</h1>
      <div class="wx">☀ 18°C · Toronto</div>
    </div>

    <div class="hub-grid">
<div class="card collapsed" data-card="1">

<h2><span class="cardnum">1</span><span class="live"></span>Sports — LIVE<span class="card-toggle">☰</span></h2>
<div class="card-body">
  <div id="sportsLiveBox"></div>
</div>

<div class="card collapsed" data-card="2">

        <h2><span class="cardnum">2</span>MLB · PLAYOFF FINALS<span class="card-toggle">☰</span></h2>
        <div class="card-body">
        <div class="standing-row"><span class="rk">1</span><span class="nm">Rays</span><span class="rec">98–64 .605</span></div>
        <div class="standing-row"><span class="rk">2</span><span class="nm">Brewers</span><span class="rec">103–59 .636</span></div>
        </div>
      </div>

<div class="card collapsed" data-card="3">

        <h2><span class="cardnum">3</span>TEAM INSIGHTS<span class="card-toggle">☰</span></h2>
<div class="card-body">
  <div class="team-hero">
    <div class="ring"><span id="ti-wp">—%</span></div>
    <div>
      <div class="nm" id="ti-matchup">—</div>
      <div class="sub" id="ti-status">—</div>
    </div>
  </div>
  <div class="stat-grid">
    <div class="stat"><div class="v" id="ti-away-score">—</div><div class="l" id="ti-away-abbr">AWAY</div></div>
    <div class="stat"><div class="v" id="ti-home-score">—</div><div class="l" id="ti-home-abbr">HOME</div></div>
    <div class="stat"><div class="v" id="ti-away-wp">—%</div><div class="l">AWAY WP</div></div>
    <div class="stat"><div class="v" id="ti-home-wp">—%</div><div class="l">HOME WP</div></div>
  </div>
</div>
      </div>

<div class="card map-card collapsed" data-card="4">

        <h2><span class="cardnum">4</span>REGIONAL MAP<span class="card-toggle">☰</span></h2>
        <div class="card-body">
        <iframe src="https://localhost:9000/data/mlb_live.pdf" title="Regional map placeholder" loading="lazy"
          style="width:100%;height:850px;zoom:47%;border:1px solid var(--line);border-radius:16px;background:#fff"></iframe>
        <a href="https://example.com" target="_blank" rel="noopener" class="pip-hint" style="display:block;margin-top:6px">Open full map →</a>
        </div>
      </div>
    </div>

    <div class="hub-grid" style="margin-top:14px">


<div class="card collapsed" data-card="5">

        <h2><span class="cardnum">5</span>AGENTS · 6 ONLINE<span class="card-toggle">☰</span></h2>
        <div class="card-body">
        <div class="agents-row">
          <div class="agent"><div class="av"></div>Alfred</div>
          <div class="agent"><div class="av"></div>Bruce</div>
          <div class="agent"><div class="av"></div>Leonardo</div>
          <div class="agent"><div class="av"></div>Donatello</div>
          <div class="agent"><div class="av"></div>Mikey</div>
          <div class="agent"><div class="av"></div>Raphael</div>
        </div>
        </div>
      </div>

<div class="card collapsed" data-card="6">

        <h2><span class="cardnum">6</span>SYSTEM<span class="card-toggle">☰</span></h2>
        <div class="card-body">
        <div class="sys-row"><span>Local</span><span class="v">Offline mode</span></div>
        <div class="sys-row"><span>Runtime</span><span class="v">Python 4</span></div>
        <div class="sys-row"><span>Bridge</span><span class="v">qDuna</span></div>
        <div class="sys-row"><span>Channel</span><span class="v">Telegram</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- RIGHT CHAT PANEL -->
<div class="chat-panel open" id="chatPanel">



    <div class="chat-inner">
      <div class="conv-list" id="convList"></div>
      <div class="chat-main">
        <div class="chat-head">
          <div class="av"></div>
          <div><div class="nm" id="chatName">Bruce</div><div class="sub">Strategic Advisor · Notes &amp; Intel</div></div>
        </div>
        <div class="messages" id="messages"></div>
        <div class="composer">
          <div class="picker-btn" id="pickBtn" title="Attach a file">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M21 12.5V7a2 2 0 0 0-2-2H9L7 3H3v18h18v-8.5"/></svg>
          </div>
          <input type="file" id="filein">
          <input type="text" id="msgInput" placeholder="Type a message…">
          <button class="send-btn" id="sendBtn"><svg viewBox="0 0 24 24"><path d="M2 21l21-9L2 3v7l15 2-15 2z"/></svg></button>
        </div>
      </div>
    </div>
  </div>
<div class="collapse-rail open" id="collapseRail">

    <div class="bubble"><svg viewBox="0 0 24 24" fill="none"><path d="M4 4h16v12H7l-3 3V4z"/></svg></div>
    <span class="lbl">CHAT</span>
    <svg class="chev" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
  </div>

  <!-- MINI PIP FILE VIEWER -->
  <div class="pip" id="pip">
    <div class="pip-head" id="pipHead">
      <div class="grip"><span></span><span></span><span></span><span></span><span></span><span></span></div>
      <div class="pip-title" id="pipTitle">file.txt</div>
      <div class="pip-close" id="pipClose">✕</div>
    </div>
    <div class="pip-body" id="pipBody"></div>
  </div>
</div>

<div class="bottom-dock">
  <div class="dock-btn active" title="Home"><svg viewBox="0 0 24 24"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/></svg></div>
  <div class="dock-btn" id="dockChat" title="Chat"><svg viewBox="0 0 24 24"><path d="M4 4h16v12H7l-3 3V4z"/></svg></div>
  <div class="dock-btn" id="dockData" title="Live data"><svg viewBox="0 0 24 24"><path d="M4 19V5M10 19V9M16 19V12M22 19V6"/></svg></div>
  <div class="dock-sep"></div>
  <div class="dock-btn" title="Map"><svg viewBox="0 0 24 24"><path d="M9 3v15l-6 3V6l6-3zM9 3l6 3M15 6v15l6-3V3l-6 3z"/></svg></div>
  <div class="dock-btn" title="Files"><svg viewBox="0 0 24 24"><path d="M3 7h6l2 2h10v10H3V7z"/></svg></div>
  <div class="dock-btn" title="Calendar"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg></div>
  <div class="dock-btn" title="Settings"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 00.3 1.9l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.9-.3 1.7 1.7 0 00-1 1.6V21a2 2 0 11-4 0v-.1a1.7 1.7 0 00-1-1.6 1.7 1.7 0 00-1.9.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.9 1.7 1.7 0 00-1.6-1H3a2 2 0 110-4h.1a1.7 1.7 0 001.6-1 1.7 1.7 0 00-.3-1.9l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.9.3H9a1.7 1.7 0 001-1.6V3a2 2 0 114 0v.1a1.7 1.7 0 001 1.6 1.7 1.7 0 001.9-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.9V9a1.7 1.7 0 001.6 1H21a2 2 0 110 4h-.1a1.7 1.7 0 00-1.6 1z"/></svg></div>
</div>

<script>
const fileStore = {
  'mock-leads': {mock:true, name:'Leads_Sept9.pdf', size:'2.4 MB', type:'PDF',
    tags:['leads','business','cnc','montreal'],
    list:['Rénovation Plus (kitchens)','Bois & Design (closets)','Meubles Lavoie (vanities)','Atelier CNC (reseller)','Prestige Construction','Groupe Habitat']},
  'don-json':   { url:'/mlb_live.json', name:'mlb_live.json', type:'JSON' }
};




/* ---- conversation array for the agents array array convos · live real broadcasters not A I ---- */

const convos = [
  { name:"Bruce",     sub:"Strategic Advisor · Notes", msgs:[
    {who:"them",t:"Standing by. Ping me when you want a read on the game.",time:"now"}
  ]},
  { name:"Leonardo",  sub:"Yahoo tracker",              msgs:[] },
  { name:"Donatello", sub:"Play-by-play · live from mlb_live.json", msgs:[] },
  { name:"Raphael",   sub:"StatsAPI tree",              msgs:[] },
];




let active = 0;

function fmtMsg(m){
  if(m.who==='file') return `<div class="file-chip" data-file-id="${m.fileId}">📄 ${m.t}</div>`;
  return `<div class="msg ${m.who==='me'?'me':'them'}">${m.t}<div class="t">${m.time||''}</div></div>`;
}
function render(){
  const c = convos[active];
  document.getElementById('chatName').textContent = c.name;
  document.getElementById('messages').innerHTML = c.msgs.map(fmtMsg).join('');
  document.getElementById('messages').scrollTop = 1e9;
  document.querySelectorAll('.file-chip').forEach(el=>{ el.onclick = ()=> openPip(el.dataset.fileId); });



document.getElementById('convList').innerHTML = convos.map((cv,i)=>{
  var last = cv.msgs && cv.msgs.length ? cv.msgs[cv.msgs.length-1].t : (cv.sub || '');
  return `
    <div class="conv-item ${i===active?'active':''}" data-i="${i}">
      <div class="nm">${cv.name}</div>
      <div class="prev">${last}</div>
    </div>`;
}).join('');



  document.querySelectorAll('.conv-item').forEach(el=>{
    el.onclick=()=>{active=+el.dataset.i; render();};
  });
}
render();

document.getElementById('sendBtn').onclick = sendMsg;
document.getElementById('msgInput').addEventListener('keydown', e=>{ if(e.key==='Enter') sendMsg(); });
function sendMsg(){
  const inp = document.getElementById('msgInput');
  if(!inp.value.trim()) return;
  convos[active].msgs.push({who:'me', t:inp.value.trim(), time:'now'});
  inp.value='';
  render();
}



/* ---- At the top of the script, next to fileStore: — Add the don-json file entry ---- */


document.getElementById('pickBtn').onclick = ()=> document.getElementById('filein').click();
document.getElementById('filein').addEventListener('change', e=>{
  const f = e.target.files[0];
  if(!f) return;

  const id = 'f'+Date.now();

  fileStore[id] = {mock:false, file:f, name:f.name, size:(f.size/1024).toFixed(0)+' KB'};



  convos[active].msgs.push({who:'file', t:`${f.name} · ${(f.size/1024).toFixed(0)} KB`, fileId:id});
  render();
});

/* ---- Mini PiP file viewer ---- */
const pip = document.getElementById('pip');
const pipBody = document.getElementById('pipBody');
const pipTitle = document.getElementById('pipTitle');

function escapeHtml(s){ return s.replace(/[&<>]/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c])); }


/* ---- DONATELLO · live play-by-play ---- */
var _donState = { lastPlays: null, first: true };

async function pumpDonatello(){
  try{
    const r = await fetch('/mlb_live.json?t='+Date.now(), {cache:'no-store'});
    if(!r.ok) return;
    const p = await r.json();
    const d = p.game_data || {};
    const plays = d.recent_plays || [];
    if(!plays.length) return;

    const prev = _donState.lastPlays;

    // seed on first run — no spam
    // first run — dump what's already there so chat isn't empty
    if(_donState.first){
      _donState.first = false;
      _donState.lastPlays = plays;

      const teams0 = d.teams || [];
      const a0 = teams0[0] ? teams0[0].abbr : '?';
      const h0 = teams0[1] ? teams0[1].abbr : '?';
      const line0 = a0 + ' ' + (d.away_score||'?') + ' @ ' + h0 + ' ' + (d.home_score||'?');

      const don0 = convos.find(function(c){ return c.name === 'Donatello'; });
      if(don0){
        don0.msgs.push({ who:'them', t:'— recent plays —', time:nowStr() });
        plays.slice().reverse().forEach(function(play){
          don0.msgs.push({ who:'them', t:play, time:nowStr() });
        });
        don0.msgs.push({ who:'file', t:'mlb_live.json · '+line0, fileId:'don-json' });
        render();
      }
      return;
    }

    const same = JSON.stringify(plays) === JSON.stringify(prev);
    if(same) return;

    const teams = d.teams || [];
    const a = teams[0] ? teams[0].abbr : '?';
    const h = teams[1] ? teams[1].abbr : '?';
    const line = a + ' ' + (d.away_score||'?') + ' @ ' + h + ' ' + (d.home_score||'?');

    // only the entries we haven't shown yet
    const fresh = plays.filter(function(x){ return (prev||[]).indexOf(x) === -1; });

    const don = convos.find(function(c){ return c.name === 'Donatello'; });
    if(!don) return;

    // Yahoo lists newest-first; flip so oldest new play speaks first
    fresh.slice().reverse().forEach(function(play){
      don.msgs.push({ who:'them', t:play, time:nowStr() });
    });
    don.msgs.push({ who:'file', t:'mlb_live.json · '+line, fileId:'don-json' });

    _donState.lastPlays = plays;

    if(convos[active].name === 'Donatello') render();
  }catch(e){ /* Leo not running */ }
}

function nowStr(){
  return new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
}

