# ─── SAVE DATA ─── /Users/olympynetworkco/Desktop/data
def save_data(data, url, game_id):
    full_data = {
        'timestamp': datetime.now().isoformat(),
        'source_url': url,
        'game_data': data
    }
    json_path = os.path.join(OUTPUT_DIR, f"mlb_live.json")
    txt_path  = os.path.join(OUTPUT_DIR, f"mlb_live.txt")
    with open(json_path, 'w', encoding='utf-8') as f:
        json.dump(full_data, f, indent=2)
    with open(txt_path, 'w', encoding='utf-8') as f:
        f.write(format_text_output(data))



#+--|------------------------------------------------>>>>
#+--|format_text_output
#+--|------------------------------------------------>>>>
#+--|
def format_text_output(data):
    lines = []
    lines.append("=" * 30)
    lines.append(f"YAHOO LIVE DATA — {datetime.now().strftime('%I:%M:%S %p')}")
    lines.append("=" * 30)

    if not data or 'teams' not in data:
        lines.append("No data available")
        return "\n".join(lines)

    away = data['teams'][0]; home = data['teams'][1]
    lines.append(f"{away['name']} ({away['abbr']}) {data.get('away_score','?')} @ "
                 f"{home['name']} ({home['abbr']}) {data.get('home_score','?')}")
    lines.append(f"Status: {data.get('status','Live')}")

    if data.get('win_prob_away') or data.get('win_prob_home'):
        lines.append("")
        lines.append("Win Probability:")
        if data.get('win_prob_away'): lines.append(f"  Away: {data['win_prob_away']}")
        if data.get('win_prob_home'): lines.append(f"  Home: {data['win_prob_home']}")

    if data.get('recent_plays'):
        lines.append("")
        lines.append("Recent Plays:")
        for p in data['recent_plays'][:5]:
            lines.append(f"  • {p}")

    if data.get('due_up'):
        lines.append("")
        lines.append("Due Up:")
        for b in data['due_up']:
            lines.append(f"  • {b}")

    if data.get('stat_leaders'):
        lines.append("")
        lines.append("Stat Leaders:")
        for l in data['stat_leaders']:
            lines.append(f"  • {l}")

    if data.get('odds'):
        lines.append("")
        lines.append("Odds:")
        for o in data['odds']:
            lines.append(f"  {o}")

    if data.get('game_details'):
        lines.append("")
        lines.append("Game Details:")
        for g in data['game_details']:
            lines.append(f"  {g}")

    lines.append("=" * 30)
    return "\n".join(lines)

#+--|------------------------------------------------>>>>
#+--| DISPLAY DATA sparkling the baseball field scores miniboards all the nice things
#+--|------------------------------------------------>>>>
#+--|
# ─── DISPLAY DATA ───
def display_game_data(data, changes=None):
    print("\n" + "=" * 80)
    print(f"  {CYN}⚾ YAHOO SPORTS — GAME DATA{R}")
    print(f"  {DIM}📅 {datetime.now().strftime('%A, %B %d, %Y — %I:%M:%S %p')}{R}")
    print("=" * 80)
    
    if not data:
        print(f"  {RED}❌ No data available{R}")
        return
    
    if 'teams' in data and len(data['teams']) >= 2:
        away = data['teams'][0]
        home = data['teams'][1]
        
        away_score = data.get('away_score', '?')
        home_score = data.get('home_score', '?')
        status = data.get('status', 'Live')
        
        print(f"\n  {ORG}⚾ {away['name']}{R} ({away['abbr']})")
        print(f"     {GRN}➜ {away_score} runs{R}")
        print(f"")
        print(f"  {ORG}⚾ {home['name']}{R} ({home['abbr']})")
        print(f"     {GRN}➜ {home_score} runs{R}")
        print(f"")
        print(f"  {BLU}┌─ STATUS ──────────────────────────────────────────────{R}")
        print(f"  │  {YLW}{status}{R}")
        print(f"  └─────────────────────────────────────────────────────────{R}")
        
        if data.get('win_prob_away') or data.get('win_prob_home'):
            print(f"")
            print(f"  {BLU}┌─ WIN PROBABILITY ──────────────────────────────────────{R}")
            if data.get('win_prob_away'):
                print(f"  │  {ORG}{away['abbr']}: {BOLD}{data['win_prob_away']}{R}")
            if data.get('win_prob_home'):
                print(f"  │  {ORG}{home['abbr']}: {BOLD}{data['win_prob_home']}{R}")
            print(f"  └─────────────────────────────────────────────────────────{R}")
        
        if 'odds' in data:
            print(f"")
            print(f"  {BLU}┌─ ODDS ─────────────────────────────────────────────────{R}")
            for o in data['odds']:
                print(f"  │  {o['team']}: {YLW}{o['money_line']}{R}")
            print(f"  └─────────────────────────────────────────────────────────{R}")
        
        if 'recent_plays' in data:
            print(f"")
            print(f"  {BLU}┌─ RECENT PLAYS ────────────────────────────────────────{R}")
            for i, play in enumerate(data['recent_plays'][:3], 1):
                print(f"  │  {i}. {ORG}{play}{R}")
            print(f"  └─────────────────────────────────────────────────────────{R}")
        
        if 'current_batter' in data:
            print(f"")
            print(f"  {BLU}┌─ CURRENT BATTER ──────────────────────────────────────{R}")
            print(f"  │  {ORG}{data['current_batter']}{R}")
            print(f"  └─────────────────────────────────────────────────────────{R}")

        if data.get('due_up'):
            print(f"\n  {BLU}┌─ DUE UP ───────────────────────────────────────────────{R}")
            for b in data['due_up']:
                print(f"  │  {ORG}{b}{R}")
            print(f"  └─────────────────────────────────────────────────────────{R}")

        if data.get('stat_leaders'):
            print(f"\n  {BLU}┌─ STAT LEADERS ─────────────────────────────────────────{R}")
            for l in data['stat_leaders']:
                print(f"  │  {ORG}{l}{R}")
            print(f"  └─────────────────────────────────────────────────────────{R}")

        if data.get('game_details'):
            print(f"\n  {BLU}┌─ GAME DETAILS ─────────────────────────────────────────{R}")
            for g in data['game_details']:
                print(f"  │  {DIM}{g}{R}")
            print(f"  └─────────────────────────────────────────────────────────{R}")

    print("=" * 80 + "\n")
