// ─── LIVE NFL from nfl-scores.json (Donatello) ───
async function refreshNFL() {
  try {
    const r = await fetch('/nfl-scores.json?t=' + Date.now());
    if (!r.ok) return;
    const data = await r.json();
    if (!data.games || !data.games.length) return;

    // pick first live game, else first game
    let g = data.games.find(x => /live|q[1-4]/i.test(x.status || '')) || data.games[0];

    const awayAbbr = (g.away || '').split(' ').pop().slice(0,3).toUpperCase();
    const homeAbbr = (g.home || '').split(' ').pop().slice(0,3).toUpperCase();

    // away row
    document.getElementById('nflAway').innerHTML = `
      <div class="team lead"><span class="dot"></span>${awayAbbr}</div>
      <div class="score">${g.away_score ?? '—'}</div>
      <div class="clockstate">${g.status || ''}</div>`;
    // home row
    document.getElementById('nflHome').innerHTML = `
      <div class="team">${homeAbbr}</div>
      <div class="score">${g.home_score ?? '—'}</div>
      <div class="clockstate"></div>`;

    // win bar — use edge as a rough proxy if no WP
    const aw = parseFloat(g.away_score || 0);
    const hw = parseFloat(g.home_score || 0);
    const tot = Math.max(1, aw + hw);
    const aPct = Math.round((aw / tot) * 100);
    const hPct = 100 - aPct;

    document.getElementById('nflAwayPct').textContent = `${awayAbbr} ${aPct}%`;
    document.getElementById('nflHomePct').textContent = `${homeAbbr} ${hPct}%`;
    document.getElementById('nflBarA').style.width = aPct + '%';
    document.getElementById('nflBarB').style.width = hPct + '%';

    // set the section title to include the animal
    const h2 = document.querySelector('.section h2');
    if (h2 && g.animal) h2.textContent = `LIVE — NFL · ${g.animal}${g.prime ? ' 🦄' : ''}`;
  } catch (e) {
    console.warn('nfl fetch failed:', e);
  }
}

refreshNFL();
setInterval(refreshNFL, 15000);  // refresh every 15s









