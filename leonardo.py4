# ─── SHOW CHANGE NOTIFICATION ───
def show_terminal_notification(changes):
    if not changes:
        return
    print(f"\n{BLINK}{BOLD}{ORG}🔔 SCORE CHANGE DETECTED!{R}")
    print("═" * 30)
    for change in changes:
        print(f"  {BOLD}{GRN}▶{R} {change}")
    print("═" * 30 + "\n")

