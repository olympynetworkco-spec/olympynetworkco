# ─── MAC NOTIFICATION ───
def send_mac_notification(title, message, subtitle=""):
    if not NOTIFICATION_ENABLED:
        return
    try:
        script = f'''
        display notification "{message}" with title "{title}" subtitle "{subtitle}"
        '''
        subprocess.run(['osascript', '-e', script], capture_output=True, timeout=5)
        print(f"  {GRN}🔔 Notification sent!{R}")
    except Exception as e:
        print(f"  {RED}⚠️ Notification failed: {e}{R}")

TELEGRAM_FILE = Path.home() / "Desktop" / "telegram.json"
DEFAULT_TOKEN   = "create-your-token"
DEFAULT_CHAT_ID = "create-your-token"

def load_telegram_config():
    try:
        with open(TELEGRAM_FILE, 'r', encoding='utf-8') as f:
            cfg = json.load(f)
        if 'bots' in cfg:
            for bot in cfg['bots']:
                if bot.get('active', True):
                    t = bot.get('token'); c = str(bot.get('chat_id'))
                    if t and c: return {'token': t, 'chat_id': c}
        if 'primary' in cfg and 'active_bot' in cfg:
            bot = cfg.get(cfg.get('active_bot', 'primary'))
            if bot and bot.get('active', True):
                t = bot.get('token'); c = str(bot.get('chat_id'))
                if t and c: return {'token': t, 'chat_id': c}
        t = cfg.get('token'); c = str(cfg.get('chat_id'))
        if t and c: return {'token': t, 'chat_id': c}
        t = cfg.get('token_secondary'); c = str(cfg.get('chat_id_secondary'))
        if t and c: return {'token': t, 'chat_id': c}
    except Exception:
        pass
    return {'token': DEFAULT_TOKEN, 'chat_id': DEFAULT_CHAT_ID}

def send_telegram(message):
    cfg = load_telegram_config()
    if not cfg or not cfg['token']: return False
    try:
        import ssl
        ctx = ssl._create_unverified_context()
        msg = json.dumps({"chat_id": cfg['chat_id'], "text": message}).encode()
        req = urllib.request.Request(
            f"https://api.telegram.org/bot{cfg['token']}/sendMessage",
            data=msg, headers={"Content-Type": "application/json"})
        urllib.request.urlopen(req, timeout=3, context=ctx)
        print(f"[TG] Sent: {message[:60]}...")
        return True
    except Exception as e:
        print(f"[TG] Send failed: {e}")
        return False

