# ─── CHECK FOR CHANGES ───
def check_for_changes(new_data, game_id):
    if game_id not in previous_states:
        previous_states[game_id] = {
            'away_score': None,
            'home_score': None,
            'away_name': None,
            'home_name': None,
            'status': None,
        }


    prev = previous_states[game_id]
    changes = []

    new_away = new_data.get('away_score')
    new_home = new_data.get('home_score')

    away_name = "Away"
    home_name = "Home"
    if 'teams' in new_data and len(new_data['teams']) >= 2:
        away_name = new_data['teams'][0]['name']
        home_name = new_data['teams'][1]['name']



    if prev['away_score'] is not None and prev['away_score'] != '?':
        if new_away and new_away != '?' and new_away != prev['away_score']:
            try:
                diff = int(new_away) - int(prev['away_score'])
                changes.append(f"{away_name} scored! {prev['away_score']} → {new_away} (+{diff})")
                send_mac_notification(
                    title=f"⚾ {away_name} SCORES!",
                    message=f"{away_name} {new_away} - {new_home or '?'} {home_name}",
                    subtitle=f"{prev['away_score']} → {new_away} (+{diff})"
                )
            except:
                pass

    if prev['home_score'] is not None and prev['home_score'] != '?':
        if new_home and new_home != '?' and new_home != prev['home_score']:
            try:
                diff = int(new_home) - int(prev['home_score'])
                changes.append(f"{home_name} scored! {prev['home_score']} → {new_home} (+{diff})")
                send_mac_notification(
                    title=f"⚾ {home_name} SCORES!",
                    message=f"{home_name} {new_home} - {new_away or '?'} {away_name}",
                    subtitle=f"{prev['home_score']} → {new_home} (+{diff})"
                )
            except:
                pass

    prev['away_score'] = new_away
    prev['home_score'] = new_home
    prev['away_name'] = away_name
    prev['home_name'] = home_name

    return changes

