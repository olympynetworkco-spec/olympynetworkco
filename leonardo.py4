# ─── PARSE DATA FROM HTML ───
def parse_game_data(html):
    data = {}
    if not html:
        return data

    # ─── Build a clean text blob once ───
    import html as _h
    _t = re.sub(r'<script[^>]*>.*?</script>', ' ', html, flags=re.DOTALL)
    _t = re.sub(r'<style[^>]*>.*?</style>',  ' ', _t,   flags=re.DOTALL)
    _t = re.sub(r'<[^>]+>', '\n', _t)
    lines = [_h.unescape(x).strip() for x in _t.split('\n') if x.strip()]

    # ─── Title: score + status ───
    title_match = re.search(r'<title>([^<]+)</title>', html)
    away_score = home_score = "?"
    status = "Live"
    away_name, home_name = "Away", "Home"
    if title_match:
        title = title_match.group(1)
        sm = re.search(r'([A-Za-z .]+?)\s+(\d+)\s*-\s*([A-Za-z .]+?)\s+(\d+)', title)
        if sm:
            away_name  = sm.group(1).strip()
            away_score = sm.group(2)
            home_name  = sm.group(3).strip()
            home_score = sm.group(4)
        if ':' in title:
            status = title.split(':', 1)[1].replace('- Yahoo Sports', '').strip()

    # ─── Abbreviations from page, fall back to name map ───
    TEAM_ABBR = {
        'Boston Red Sox':'BOS','New York Yankees':'NYY','Chicago Cubs':'CHC',
        'San Diego Padres':'SD','Chicago White Sox':'CWS','Houston Astros':'HOU',
        'Philadelphia Phillies':'PHI','Atlanta Braves':'ATL','Milwaukee Brewers':'MIL',
        'Cincinnati Reds':'CIN','Cleveland Guardians':'CLE','Detroit Tigers':'DET',
        'Baltimore Orioles':'BAL','Toronto Blue Jays':'TOR','Tampa Bay Rays':'TB',
        'Minnesota Twins':'MIN','Kansas City Royals':'KC','Texas Rangers':'TEX',
        'Seattle Mariners':'SEA','Los Angeles Angels':'LAA','Los Angeles Dodgers':'LAD',
        'San Francisco Giants':'SF','Arizona Diamondbacks':'AZ','Colorado Rockies':'COL',
        'New York Mets':'NYM','Washington Nationals':'WSH','Miami Marlins':'MIA',
        'Pittsburgh Pirates':'PIT','St. Louis Cardinals':'STL','Athletics':'ATH',
    }
    abbrs = re.findall(r'<span class="_ys_uc3zi7[^"]*"[^>]*>([A-Z]{2,4})</span>', html)
    away_abbr = abbrs[0] if len(abbrs) >= 1 else TEAM_ABBR.get(away_name, away_name[:3].upper())
    home_abbr = abbrs[1] if len(abbrs) >= 2 else TEAM_ABBR.get(home_name, home_name[:3].upper())

    data['away_score'] = away_score
    data['home_score'] = home_score
    data['status']     = status
    data['teams'] = [
        {'name': away_name, 'abbr': away_abbr},
        {'name': home_name, 'abbr': home_abbr},
    ]

    # ─── Win Probability ───
    m = re.search(r'Win Probability\s+([A-Z]{2,4})\s+(\d{1,3}(?:\.\d+)?)%', "\n".join(lines))
    if m:
        leader = m.group(1); pct = float(m.group(2)); other = round(100.0 - pct, 1)
        if leader == away_abbr:
            data['win_prob_away'] = f"{pct:.1f}%"; data['win_prob_home'] = f"{other:.1f}%"
        elif leader == home_abbr:
            data['win_prob_home'] = f"{pct:.1f}%"; data['win_prob_away'] = f"{other:.1f}%"
        else:
            data['win_prob_home'] = f"{pct:.1f}%"; data['win_prob_away'] = f"{other:.1f}%"

    # ─── Section-anchor helper: grab N lines after a header ───
    def slice_after(header_re, stop_re, max_lines=40):
        for i, ln in enumerate(lines):
            if re.search(header_re, ln, re.I):
                out = []
                for j in range(i + 1, min(i + 1 + max_lines, len(lines))):
                    if stop_re and re.search(stop_re, lines[j], re.I):
                        break
                    out.append(lines[j])
                return out
        return []

    # ─── RECENT PLAYS ───
    # anchor on "Recent Plays", stop at "PLAYS", "STAT LEADERS", "ODDS", "GAME DETAILS"
    play_block = slice_after(
        r'^Recent Plays$',
        r'^(Plays|STAT LEADERS|ODDS|GAME DETAILS|Win Probability)$',
        max_lines=30
    )
    plays = []
    PLAY_VERB = re.compile(
        r'(singled|doubled|tripled|homered|flied|grounded|struck|walked|scored|'
        r'stole|filed|popped|lined|relieved|hit|out|End of Inning)',
        re.I
    )
    for ln in play_block:
        if ln in ('View All >', 'View All', 'Scoring Plays', 'All Plays'):
            continue
        if PLAY_VERB.search(ln) and 6 < len(ln) < 200:
            plays.append(ln)
    if plays:
        data['recent_plays'] = plays[:8]

    # ─── DUE UP (current batter) ───
    due_block = slice_after(r'^DUE UP$', r'^(RECENT PLAYS|Recent Plays|ON DECK|IN THE HOLE)$', 6)
    # real names come from ON DECK / IN THE HOLE cards
    on_deck  = slice_after(r'^ON DECK$',  r'^IN THE HOLE$', 4)
    in_hole  = slice_after(r'^IN THE HOLE$', r'^(RECENT PLAYS|Recent Plays)$', 4)
    def pick_name(block):
        for ln in block:
            if re.match(r'^[A-Z]\.\s+[A-Z][a-zA-Z\-\']+$', ln):
                return ln
        return None
    batters = [x for x in (pick_name(on_deck), pick_name(in_hole)) if x]
    if batters:
        data['due_up'] = batters

    # ─── STAT LEADERS (strikeouts row) ───
    lead_block = slice_after(
        r'^STAT LEADERS$',
        r'^(WIN PROBABILITY|Win Probability|ODDS|Plays)$',
        20
    )
    leaders = []
    for ln in lead_block:
        if re.match(r'^[A-Z]\.\s+[A-Z][a-zA-Z\-\']+$', ln):
            leaders.append(ln)
    if leaders:
        data['stat_leaders'] = leaders[:4]

    # ─── ODDS ───
    odds_block = slice_after(r'^ODDS$', r'^(GAME DETAILS|STAT LEADERS|Plays)$', 10)
    odds = []
    for ln in odds_block:
        if re.match(r'^[+-]\d{3,4}$', ln) or re.match(r'^O/U\s*\d+(\.\d+)?$', ln):
            odds.append(ln)
    if odds:
        data['odds'] = odds[:4]

    # ─── GAME DETAILS (venue, weather, series) ───
    gd_block = slice_after(r'^GAME DETAILS$', r'^(Listen on SiriusXM|yahoo)', 8)
    gd = [x for x in gd_block if len(x) < 120 and not x.startswith('Umpires')]
    if gd:
        data['game_details'] = gd[:5]

    return data


