async function refreshMLBLive() {
  try {
    const r = await fetch('/mlbscores.json?t=' + Date.now());
    if (!r.ok) return;
    const data = await r.json();
    const box = document.getElementById('sportsLiveBox');
    if (!box) return;
    const games = (data.games || []).slice(0, 5);

    box.innerHTML = games.map(g => {
      const a = (g.away || '').split(' ').pop().slice(0, 3).toUpperCase();
      const h = (g.home || '').split(' ').pop().slice(0, 3).toUpperCase();
      const st = (g.status || '')
        .replace(/Final.*/i, 'Final')
        .replace(/Scheduled.*/i, 'Sched');
      return `<div class="mlb-row"><span class="nm">${a}</span><span class="sc">${g.away_score ?? '—'}</span><span>–</span><span class="sc">${g.home_score ?? '—'}</span><span class="nm">${h}</span><span class="st">${st}</span></div>`;
    }).join('');
  } catch (e) { console.warn('mlb-live fetch failed', e); }
}
