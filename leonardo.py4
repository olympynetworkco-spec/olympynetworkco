async function refreshAroundLeague() {
  try {
    const r = await fetch('/nfl-scores.json?t=' + Date.now());
    if (!r.ok) return;
    const data = await r.json();
    if (!data.games || !data.games.length) return;

    // skip the first game (it's the "live" one in the top panel)
    const rest = data.games.slice(1, 6);  // show up to 5

    const box = document.getElementById('aroundLeague');
    if (!box) return;

    box.innerHTML = rest.map((g, i) => {
      const awayAbbr = (g.away || '').split(' ').pop().slice(0,3).toUpperCase();
      const homeAbbr = (g.home || '').split(' ').pop().slice(0,3).toUpperCase();

      const aw = parseInt(g.away_score, 10);
      const hw = parseInt(g.home_score, 10);
      const awayLeads = !isNaN(aw) && !isNaN(hw) && aw > hw;
      const homeLeads = !isNaN(aw) && !isNaN(hw) && hw > aw;

      const awayCls = awayLeads ? 'team lead' : 'team';
      const homeCls = homeLeads ? 'team lead' : 'team';
      const statusTxt = (g.status || '').replace('Final', 'F').replace('Scheduled', 'Sched');

      // animal + edge as the clockstate
      const meta = g.animal
        ? `${g.animal}${g.prime ? ' 🦄' : ''} +${g.edge || 0}`
        : statusTxt;

      return `
        <div class="game" style="${i > 0 ? 'margin-top:6px' : ''}">
          <div class="${awayCls}">${awayAbbr}</div>
          <div class="score">${g.away_score ?? '—'}</div>
          <div class="${homeCls}">${homeAbbr}</div>
          <div class="score">${g.home_score ?? '—'}</div>
          <div class="clockstate">${meta}</div>
        </div>`;
    }).join('');
  } catch (e) {
    console.warn('around-league fetch failed:', e);
  }
}

refreshAroundLeague();
setInterval(refreshAroundLeague, 15000);

