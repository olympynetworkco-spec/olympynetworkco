async function refreshStandings() {
  try {
    const r = await fetch('/nfl-standings.json?t=' + Date.now());
    if (!r.ok) return;
    const data = await r.json();
    const box = document.getElementById('standingsBox');
    if (!box) return;

    let html = '';
    for (const league of (data.standings || [])) {
      for (const div of (league.divisions || [])) {
        html += `<div style="font-size:10px;color:var(--sub);margin-top:6px;letter-spacing:.05em">${league.league} ${div.name}</div>`;
        for (const t of (div.teams || [])) {
          html += `<div class="standing-row"><span class="rk">${t.rank}</span><span class="nm">${t.team}</span><span class="rec">${t.W}-${t.L} · ${(t.PCT*1).toFixed(3)}</span></div>`;
        }
      }
    }
    box.innerHTML = html;
  } catch (e) { console.warn('standings fetch failed', e); }
}
refreshStandings();
