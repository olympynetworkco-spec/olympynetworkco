# ─── MAIN ───
# ─── MAIN ───
def main():
    print("\n" + "=" * 30)
    print(f"  {CYN}⚾ YAHOO TRACKER — MULTI GAME{R}")
    print(f"  {DIM}📅 {datetime.now().strftime('%A, %B %d, %Y')}{R}")
    print(f"  {DIM}⏱️ REFRESH: Every {REFRESH_INTERVAL} seconds{R}")
    print(f"  {DIM}🎯 Watching {len(GAME_URLS)} game(s){R}")
    for u in GAME_URLS:
        print(f"      {DIM}• {u}{R}")
    print("=" * 30)
    print(f"  {DIM}🔄 Watching for score changes...{R}")
    print(f"  {DIM}🔔 Notifications will pop up on top right{R}")
    print("=" * 30 + "\n")

    cycle = 0
    while True:
        cycle += 1

        for url in GAME_URLS:
            m = re.search(r'-(\d{9,})/?$', url)
            game_id = m.group(1) if m else str(abs(hash(url)))[:10]

            html = fetch_page(url)
            if not html:
                print(f"  {RED}⚠️ Fetch failed for {game_id}{R}")
                continue

            # ─── PDF GRIP — full rendered page, chart included ───
            # ─── PDF grip — full rendered page ───
            # ─── PDF grip — full rendered page ───
            pdf_name = "mlb_live.pdf"
            pdf_path = os.path.join(OUTPUT_DIR, pdf_name)

            try:
                subprocess.run([
                    CHROME, '--headless=new', '--disable-gpu', '--no-sandbox',
                    f'--print-to-pdf={pdf_path}',
                    '--no-pdf-header-footer',
                    url
                ], capture_output=True, timeout=30)
                print(f"  {DIM}📄 PDF saved: {pdf_name}{R}")
            except Exception as e:
                print(f"  {RED}⚠️ PDF grip failed: {e}{R}")

            # ─── .txt written from the raw HTML Leonardo already has ───
            try:
                txt_path = os.path.join(OUTPUT_DIR, pdf_name.replace('.pdf', '.txt'))
                import html as _h
                t = re.sub(r'<script[^>]*>.*?</script>', ' ', html, flags=re.DOTALL)
                t = re.sub(r'<style[^>]*>.*?</style>', ' ', t, flags=re.DOTALL)
                t = re.sub(r'<[^>]+>', '\n', t)
                lines = [_h.unescape(x).strip() for x in t.split('\n') if x.strip()]

                START = "© 2026 Yahoo. All rights reserved."
                END   = "SiriusXM subscription required. Get started with a great offer."
                BAR   = "═" * 70

                out = []
                inside = False
                for ln in lines:
                    if ln == START:
                        inside = True
                        out.append(BAR)
                        out.append(ln)
                        out.append(BAR)
                        continue
                    if ln == END:
                        out.append(BAR)
                        out.append(ln)
                        out.append(BAR)
                        inside = False
                        continue
                    out.append(ln)

                with open(txt_path, 'w', encoding='utf-8') as f:
                    f.write("\n".join(out))
                print(f"  {DIM}📝 TXT: {os.path.basename(txt_path)}{R}")
            except Exception as e:
                print(f"  {RED}⚠️ txt write failed: {e}{R}")

            # ─── parse html into data ───
            data = parse_game_data(html)
            if not data:
                print(f"  {RED}⚠️ No data for {game_id}{R}")
                continue

            changes = check_for_changes(data, game_id)

            if changes:
                show_terminal_notification(changes)

            display_game_data(data)
            save_data(data, url, game_id)

            away = data['teams'][0]
            home = data['teams'][1]
            print(f"  {DIM}⚡ Cycle {cycle} | {away['abbr']} {data.get('away_score', '?')} @ {home['abbr']} {data.get('home_score', '?')}{R}")

        print(f"  {DIM}⏳ Next update in {REFRESH_INTERVAL} seconds...{R}")
        time.sleep(REFRESH_INTERVAL)

HTTP_PORT = 9002   # ← Leo's port. Not 9001 (Raphael). Not 9000 (Alfred proxy).

class LeoHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        rel = unquote(self.path.split("?", 1)[0]).lstrip("/")
        if rel in ("", "index.html"):
            body = HTML.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
            return
        target = (Path(OUTPUT_DIR) / rel).resolve()
        if not str(target).startswith(str(Path(OUTPUT_DIR).resolve())):
            self.send_response(403); self.end_headers(); return
        if not target.exists() or not target.is_file():
            self.send_response(404); self.end_headers(); self.wfile.write(b"not found"); return
        ctype = mimetypes.guess_type(str(target))[0] or "text/plain"
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(target.read_bytes())

    def log_message(self, *a): pass


def start_server():
    global HTML
    if GAME_URLS:
        m = re.search(r'-(\d{9,})/?$', GAME_URLS[0])
        gid = m.group(1) if m else ""
        HTML = HTML.replace("__GAME_ID__", gid)
    print(f"[leonardo] Page: http://localhost:{HTTP_PORT}/")
    ThreadingHTTPServer(("", HTTP_PORT), LeoHandler).serve_forever()


def auto_open():
    time.sleep(2)
    try:
        webbrowser.open(f"http://localhost:{HTTP_PORT}/")
    except Exception as e:
        print(f"[leonardo] auto-open failed: {e}")



