if __name__ == "__main__":
    print(f"  🎩 telegram: {'configured' if load_telegram_config() else 'default'}")
    send_telegram("🎩 Leonardo ONLINE — watching Yahoo game(s)")
    threading.Thread(target=start_server, daemon=True).start()
    threading.Thread(target=auto_open, daemon=True).start()
    try:
        main()
    except KeyboardInterrupt:
        send_telegram("🎩 Leonardo resting.")
        send_mac_notification(
            title="🛑 Live Tracker Stopped",
            message="The Yahoo live tracker has been stopped",
            subtitle="Goodbye!"
        )
