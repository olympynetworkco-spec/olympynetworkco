/* drag the PiP by its PANDA */
(function(){
  const head = document.getElementById('pipHead');
  let dragging=false, ox=0, oy=0;
  head.addEventListener('pointerdown', e=>{
    dragging=true; head.setPointerCapture(e.pointerId);
    const r = pip.getBoundingClientRect();
    ox = e.clientX - r.left; oy = e.clientY - r.top;
    pip.style.bottom='auto';
  });
  head.addEventListener('pointermove', e=>{
    if(!dragging) return;
    let x = e.clientX - ox, y = e.clientY - oy;
    x = Math.max(4, Math.min(window.innerWidth - pip.offsetWidth - 4, x));
    y = Math.max(4, Math.min(window.innerHeight - pip.offsetHeight - 4, y));
    pip.style.left = x+'px'; pip.style.top = y+'px';
  });
  head.addEventListener('pointerup', e=>{ dragging=false; head.releasePointerCapture(e.pointerId); });
})();

