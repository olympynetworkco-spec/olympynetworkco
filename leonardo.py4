async function refreshTeamInsights() {
  try {
    const r = await fetch('/mlb_live.json?t=' + Date.now(), { cache: 'no-store' });
    if (!r.ok) return;
    const payload = await r.json();
    const d = payload.game_data || {};

    updateTrendPanel(d);   // ← add this line

    const teams = d.teams || [];
    if (teams.length < 2) return;

    const awayAbbr = (teams[0].abbr || teams[0].name.slice(0,3)).toUpperCase();
    const homeAbbr = (teams[1].abbr || teams[1].name.slice(0,3)).toUpperCase();

    const awayScore = d.away_score || '—';
    const homeScore = d.home_score || '—';
    const status    = (d.status || '—').replace(/\s*-\s*Yahoo Sports\s*$/i, '').trim();
    const awayWp    = d.win_prob_away || '—%';
    const homeWp    = d.win_prob_home || '—%';

    const aNum = parseFloat(awayWp);
    const hNum = parseFloat(homeWp);
    let ringPct = isNaN(hNum) ? (isNaN(aNum) ? 0 : aNum) : hNum;
    let ringLabel = isNaN(hNum) ? awayWp : homeWp;

    function set(id, val){ var el = document.getElementById(id); if (el) el.textContent = val; }
    set('ti-wp',         ringLabel);
    set('ti-matchup',    awayAbbr + ' @ ' + homeAbbr);
    set('ti-status',     status);
    set('ti-away-abbr',  awayAbbr);
    set('ti-home-abbr',  homeAbbr);
    set('ti-away-score', awayScore);
    set('ti-home-score', homeScore);
    set('ti-away-wp',    awayWp);
    set('ti-home-wp',    homeWp);

    var ring = document.querySelector('.team-hero .ring');
    if (ring) {
      ring.style.background = 'conic-gradient(var(--amber) 0 ' + ringPct + '%, #232a34 ' + ringPct + '% 100%)';
    }
  } catch (e) {}
}

refreshTeamInsights();
setInterval(refreshTeamInsights, 15000);



/* ─── WIN % TREND — dynamic, driven by mlb_live.json ─── */
var _wpHistory = { key: null, away: [], home: [] };
var WP_HISTORY_MAX = 60;

function updateTrendPanel(d){
  var teams = d.teams || [];
  if (teams.length < 2) return;

  var awayAbbr = (teams[0].abbr || teams[0].name.slice(0,3)).toUpperCase();
  var homeAbbr = (teams[1].abbr || teams[1].name.slice(0,3)).toUpperCase();

  var hNum = parseFloat(d.win_prob_home);
  var aNum = parseFloat(d.win_prob_away);
  if (isNaN(hNum) && isNaN(aNum)) return;

  // Which side is the "leader" we're plotting? Default to home.
  var curHome = isNaN(hNum) ? 100 - aNum : hNum;
  var curAway = isNaN(aNum) ? 100 - hNum : aNum;

  // Reset history if the game changes
  var key = awayAbbr + '@' + homeAbbr;
  if (_wpHistory.key !== key){
    _wpHistory = { key: key, away: [], home: [] };
  }
  _wpHistory.home.push(curHome);
  _wpHistory.away.push(curAway);
  if (_wpHistory.home.length > WP_HISTORY_MAX) _wpHistory.home.shift();
  if (_wpHistory.away.length > WP_HISTORY_MAX) _wpHistory.away.shift();

  // ── Build the polyline ──
  var pts = _wpHistory.home;
  var n = pts.length;
  var poly = '';
  for (var i = 0; i < n; i++){
    var x = n === 1 ? 0 : (i / (n - 1)) * 300;
    // win % (0-100) → y (86 at 0%, 6 at 100%) so high prob = high line
    var y = 86 - (pts[i] / 100) * 80;
    poly += (i === 0 ? '' : ' ') + x.toFixed(1) + ',' + y.toFixed(1);
  }
  var line = document.getElementById('trendLine');
  if (line) line.setAttribute('points', poly);

  // ── Title, labels, stats ──
  var title = document.getElementById('trendTitle');
  if (title) title.textContent = 'WIN % TREND — ' + homeAbbr;

  var lA = document.getElementById('trendLblA');
  var lB = document.getElementById('trendLblB');
  if (lA) lA.textContent = awayAbbr;
  if (lB) lB.textContent = homeAbbr;

  var cur = document.getElementById('trendCur');
  var curLbl = document.getElementById('trendCurLbl');
  if (cur){
    cur.textContent = curHome.toFixed(1) + '%';
  }
  if (curLbl) curLbl.textContent = homeAbbr + ' WIN PROB';

  // ── Delta since first sample (or last 5 min) ──
  var move = document.getElementById('trendMove');
  if (move && n > 1){
    var first = _wpHistory.home[0];
    var delta = curHome - first;
    var sign = delta >= 0 ? '+' : '';
    move.textContent = sign + delta.toFixed(1) + '%';
    move.style.color = delta >= 0 ? 'var(--green)' : 'var(--red)';
  }
}


