function openPip(id){
  const entry = fileStore[id];
  if(!entry) return;




if(entry.url && entry.type === 'JSON'){
  pipTitle.textContent = entry.name;
  pip.classList.add('show');
  fetch(entry.url+'?t='+Date.now(),{cache:'no-store'})
    .then(function(r){ return r.json(); })
    .then(function(j){
      pipBody.innerHTML = '<pre>'+escapeHtml(JSON.stringify(j,null,2).slice(0,8000))+'</pre>';
    })
    .catch(function(){
      pipBody.innerHTML='<div class="pip-hint">Could not load '+entry.name+'</div>';
    });
  return;
}





  pipTitle.textContent = entry.name;
  pip.classList.add('show');

  if(entry.mock){
    pipBody.innerHTML = `
      <div class="pip-meta-row"><span>Type</span><span class="v">${entry.type}</span></div>
      <div class="pip-meta-row"><span>Size</span><span class="v">${entry.size}</span></div>
      <div class="pip-tags">${entry.tags.map(t=>`<span class="pip-tag">${t}</span>`).join('')}</div>
      <div class="pip-btnrow">
        <div class="pip-btn primary">Open</div>
        <div class="pip-btn ghost">Download</div>
      </div>
      <div class="pip-hint">Preview</div>
      <pre>${entry.list.map((x,i)=>`${i+1}. ${x}`).join('\n')}</pre>`;
    return;
  }

  const f = entry.file;
  const ext = f.name.split('.').pop().toLowerCase();
  const reader = new FileReader();
  const url = URL.createObjectURL(f);

  if(f.type.startsWith('image/')){
    pipBody.innerHTML = `<img src="${url}">`;
  } else if(f.type.startsWith('audio/')){
    pipBody.innerHTML = `<audio controls src="${url}"></audio>`;
  } else if(f.type.startsWith('video/') || ['mp4','webm','mov','m4v'].includes(ext)){
    pipBody.innerHTML = `<video controls playsinline src="${url}" style="width:100%;border-radius:6px"></video>`;
  } else if(ext === 'pdf' || f.type === 'application/pdf'){
    pipBody.innerHTML = `<iframe src="${url}" style="width:100%;height:340px;border:1px solid var(--line);border-radius:6px;background:#fff"></iframe>`;
  } else if(['txt','json','yaml','yml','md','csv','js','css','log','py','py4','sh','xml','goggles'].includes(ext) || f.type.startsWith('text/') || /\.txt$|\.json$|\.log$|\.py4?$/.test(f.name)){
    reader.onload = ()=> pipBody.innerHTML = `<pre>${escapeHtml(reader.result.slice(0,8000))}</pre>`;
    reader.readAsText(f);
  } else if(ext === 'html' || ext === 'htm' || f.type === 'text/html'){
    reader.onload = ()=> pipBody.innerHTML = `<iframe sandbox="" srcdoc="${escapeHtml(reader.result)}"></iframe>`;
    reader.readAsText(f);
  } else {
    pipBody.innerHTML = `<div class="pip-hint">No preview for <b>.${ext}</b> — try opening it directly.</div>`;
  }
}



document.getElementById('pipClose').onclick = ()=> pip.classList.remove('show');



