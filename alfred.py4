                  ("read", "Drop text → Thomas reads it aloud"),
                  ("call alfred", "Start a voice call"),
                  ("send stream", "Stream to the call")]),
            ]

            _chev = '<polyline points="6 9 12 15 18 9"/>'
            _mono = "ui-monospace,SFMono-Regular,Menlo,Consolas,monospace"

            def _svg(paths, size=18):
                return (f'<svg width="{size}" height="{size}" viewBox="0 0 24 24" fill="none" '
                        f'stroke="currentColor" stroke-width="2" stroke-linecap="round" '
                        f'stroke-linejoin="round" style="flex:none;">{paths}</svg>')

            def _esc(s):
                return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

            out = [
                '<style>.alf summary::-webkit-details-marker{display:none}'
                '.alf-chev{transition:transform .15s}'
                '.alf details[open] .alf-chev{transform:rotate(180deg)}'
                '.alf summary:hover{background:#faf9f7}</style>',

                '<div class="alf" style="font-family:-apple-system,BlinkMacSystemFont,\'Segoe UI\',sans-serif;'
                'max-width:560px;color:#1a1a1a;">',

                '<div style="background:#ffffff;border:1px solid #e7e7e5;border-bottom:none;border-radius:12px 12px 0 0;padding:14px 16px;'
                'display:flex;align-items:center;gap:10px;">'
                '<div style="flex:1;min-width:0;">'
                '<div style="font-size:15px;font-weight:700;color:#1a1a1a;">🎩 Alfred — Command Reference</div>'
                '<div style="font-size:12px;color:#6b6b6b;margin-top:2px;">Tap a section to see what it can do.</div>'
                '</div>'
                '</div>',

                '<div style="background:#ffffff;border:1px solid #e7e7e5;'
                'border-radius:0 0 12px 12px;padding:10px;display:flex;flex-direction:column;gap:8px;">',
            ]

            for i, (icon, title, sub, cmds) in enumerate(_groups):
                rows = "".join(
                    '<div style="display:flex;align-items:baseline;gap:8px;padding:6px 0;border-bottom:1px solid #f0f0ee;">'
                    f'<span style="flex:none;background:#f2f2f0;color:#1a1a1a;font-family:{_mono};font-size:11px;'
                    f'font-weight:700;padding:3px 8px;border-radius:6px;white-space:nowrap;border:1px solid #e7e7e5;">{_esc(c)}</span>'
                    f'<span style="font-size:12px;color:#6b6b6b;line-height:1.35;">{_esc(d)}</span></div>'
                    for c, d in cmds
                )

                out.append(
                    '<div style="background:#ffffff;border:1px solid #e7e7e5;border-radius:10px;overflow:hidden;">'
                    f'<details{" open" if i == 0 else ""}>'
                    '<summary style="list-style:none;display:flex;align-items:center;gap:12px;'
                    'padding:10px 12px;cursor:pointer;">'
                    '<span style="flex:none;width:32px;height:32px;border-radius:8px;background:#f2f2f0;'
                    'color:#6b21a8;display:flex;align-items:center;justify-content:center;">'
                    f'{_svg(icon)}</span>'
                    '<span style="flex:1;min-width:0;">'
                    f'<span style="display:block;font-size:14px;font-weight:700;color:#1a1a1a;">{_esc(title)}</span>'
                    f'<span style="display:block;font-size:12px;color:#6b6b6b;margin-top:1px;">{_esc(sub)}</span>'
                    '</span>'
                    '<span class="alf-chev" style="flex:none;width:24px;height:24px;border-radius:50%;'
                    'background:#f2f2f0;color:#1a1a1a;display:flex;align-items:center;justify-content:center;">'
                    f'{_svg(_chev, 14)}</span>'
                    '</summary>'
                    f'<div style="padding:4px 12px 10px 56px;border-top:1px solid #f0f0ee;background:#faf9f7;">{rows}</div>'
                    '</details></div>'
                )

            out.append(
                '<div style="padding:8px 4px 0;font-size:11px;color:#888;text-align:center;">'
                'OlympyNetworkCo Tm + NorthStar Connector</div>'
                '</div></div>'
            )

            # ← never return None to the bridge
            return "".join(out) if out else "🎩 Help unavailable, Sir."

        else:
            return """🎩 Yes Master Art, here is my full command list, Sir:

  🦅 SYSTEM & STATUS
  ══════════════════════════════════════════════════════════════════
    status                      - shows cpu, ram, uptime, errors, goals, searches, tabs 
    help                        - shows this guideline what Alfred can do
    time                        - tells time / date / and day
    read                        - reads the text Thomas voice edge play mp.3 Alfred

  🕸️ WEB & SEARCH
  ══════════════════════════════════════════════════════════════════
    search [query]               — Google search in browser
    tell me about [topic]        — Scrapes Wikipedia/News + downloads image to Downloads
    download [url] [name]        — Saves .pdf, .txt, .html, & .webloc + screenshot
                                   (Timeout fallback name if no reply: telegram-timestamp)
    open [url]                   — Opens any website you type

  ⚡ QUICK URLS (Just type: "open [word]")
  ══════════════════════════════════════════════════════════════════
    open localhost:900 | google | bing | youtube | github | github-trending | telegram | yahoo-nfl |
    
    yahoo-nba| yahoo-mlb | yahoo-nhl | espn-nfl | espn-nba | espn-mlb | espn-nhl | deepseek | 

    claude | bing-nhl | bing-nfl | bing-nba |
    
    moltbook | gmail | news | pippera | Facebook (marketpalce) | slack | sportsnet-youtube |

    ask deepseek                 — Opens deepseek and asks questions in Firefox 
    
    open media                   — Opens /Desktop/media in Firefox

  📁 FILES & MEMORY
   ══════════════════════════════════════════════════════════════════
   ls [folder]                  — List folder contents
    grip [filename]              — Read JSON / HTML / TXT (searches 6 folders)
    grip [filename] stats        — Show JSON size & keys
    remember [text]              — Save to memory
    recall                       — Show recent memories
    goal [text]                  — Set a goal
    error [text]                 — Log an error

  🦞 MOLTBOOK (Agent Network)
  ══════════════════════════════════════════════════════════════════
    moltbook open                — Open in browser
    moltbook show                — See latest learnings (formatted with time)
    moltbook sync                — Force a sync now
    moltbook share [text]        — Post wisdom

  🧮 MATH & CALCULATIONS
  ══════════════════════════════════════════════════════════════════
    calculate win-loss 8 5 
    calculate run-line 2.0
    calculate momentum 2 1 -1 3 0 4 2 -2 3 5
    calculate prediction 3 1 5 0 2 -1 4 2 6 1
    calculate coverage-rate 20 17
    calculate safer-bet 1.82 2.5
    calculate median 3 1 5 0 2
    calculate std-dev 3 1 5 0 2

  🖐️ MAC CONTROL & KEYBOARD
  ══════════════════════════════════════════════════════════════════
    tab / new tab / close tab / next tab
    enter                        — Press Enter

  📞 ALFRED'S CALL
  ══════════════════════════════════════════════════════════════════
    call alfred                  — TTS voice note via Telegram
    send stream                  — Sends stream link via Telegram

  🏈 SPORTS
  ══════════════════════════════════════════════════════════════════
    [sport] score / who won      — Alfred will ask for the sport (MLB, NFL, etc.)

  ❤️ EASTER EGGS
  ══════════════════════════════════════════════════════════════════
    love you                     — He returns the affection
    thank you                    — Gratitude acknowledged
    tell me about [topic] Alfy   — Adds "Always a pleasure, Sir" to the reply

  🧠 BACKGROUND SYSTEMS (Running 24/7)
  ══════════════════════════════════════════════════════════════════
    • Auto Dashboard: Writes alfred-state.json with CPU/RAM every loop.
    • Web Server: Runs a local HTTP server on port 8080.
    • Watchdog: Alerts Telegram if errors > 10.
    • Proton Tree: Scans /Desktop/data for new MLB/weather files & awards Protons.
    • GUI Bridge: Listens on port 11435 for our browser UI.
    • Telegram Listener: Catches texts, photos, and URLs.

  🛠️ TOOLS & ADDONS
  ══════════════════════════════════════════════════════════════════
    /python4                     — opens skelton.py4 ready for you to edit new scripts 
                                 - path=/Users/olympynetworkco/Desktop/ollama/python4/
                                                                     skeleton.py4.txt

  ══════════════════════════════════════════════════════════════════
    make a json                  — Build a JSON from a pasted text
    show json                    — Show the JSON you built during the session
  ══════════════════════════════════════════════════════════════════
    build html                   - drop a text -> converts to standard html
  ══════════════════════════════════════════════════════════════════
    npm                          — Runs `npm run dev` vite8 project as a tool (better than mcp)
  ══════════════════════════════════════════════════════════════════
    schedule                     — create calendar event in Mac by making a .ics
  ══════════════════════════════════════════════════════════════════
    • what does this graph show? + drop a graph chart screenshot for alfred to showcase small 
    analysis
  ══════════════════════════════════════════════════════════════════


"""

#+--|════════════════════════════════════════════════════════════════════
#+--| if intent send stream
#+--|════════════════════════════════════════════════════════════════════

    # ─── SEND STREAM TO TELEGRAM ───
    if intent == "send_stream":
        stream_url = "https://crackstreams.gdn/"
        send_telegram(f"🎩 Sir, here is the stream link: {stream_url}")
        return "🎩 Sent stream link to Telegram, Sir."

#+--|════════════════════════════════════════════════════════════════════
#+--| if intent open return opening .com in browser
#+--|════════════════════════════════════════════════════════════════════
    # ─── OPEN ───
    if intent == "open":
        target = user_input.lower().replace("alfred", "").replace("open", "").strip()

        # 1. Handle Media Folder explicitly
        if "media" in target:
            media_path = "/Users/olympynetworkco/Desktop/media"
            # This forces macOS to open a NEW tab in Firefox specifically
            subprocess.run(["open", "-a", "Firefox", media_path])
            return f"🎩 Opening Media folder on your request Master Art, its active now Sir, carry on your work i am watching."

        # 2. Quick URLs (google, youtube, etc)
        quick_urls = {
            "localhost:9000": "https://localhost:9000",

            "google": "https://www.google.com",
            "bing": "https://www.bing.com/webhp",
            "youtube": "https://www.youtube.com",

            "github": "https://github.com/olympynetworkco-spec",
            "github-trending": "https://github.com/trending",

            "telegram": "https://web.telegram.org/k/",

            "yahoo-nfl": "https://sports.yahoo.com/nfl/scoreboard/",
            "yahoo-nba": "https://sports.yahoo.com/nba/scoreboard/",
            "yahoo-mlb": "https://sports.yahoo.com/mlb/scoreboard/",
            "yahoo-nhl": "https://sports.yahoo.com/nhl/scoreboard/",

            "espn-nfl": "https://www.espn.com/nfl/scoreboard",
            "espn-nba": "https://www.espn.com/nba/scoreboard",
            "espn-nhl": "https://www.espn.com/nhl/scoreboard",
            "espn-mlb": "https://www.espn.com/mlb/scoreboard",

            "bing-nhl": "https://www.bing.com/sportsdetails?q=nhl%20score&sport=IceHockey&scenario=League&TimezoneId=Eastern%20Standard%20Time&IANATimezoneId=America/Toronto&ISOTimezoneKey=EST&league=IceHockey_NHL&intent=Score&seasonyear=2026&segment=sports&isl2=true&fromhere=1065494520&form=MOZLBR&",

            "bing-nba": "https://www.bing.com/sportsdetails?q=nba%20score&sport=Basketball&scenario=League&TimezoneId=Eastern%20Standard%20Time&IANATimezoneId=America/Toronto&ISOTimezoneKey=EST&league=Basketball_NBA&intent=Score&seasonyear=2026&segment=sports&isl2=true&fromhere=1065493620&form=QBRE&",


            "bing-nfl": "https://www.bing.com/sportsdetails?q=nfl%20score&sport=Football&scenario=League&TimezoneId=Eastern%20Standard%20Time&IANATimezoneId=America/Toronto&ISOTimezoneKey=EST&league=Football_NFL&intent=Score&seasonyear=2026&segment=sports&isl2=true&fromhere=1065492075&form=QBRE&",


            "sportsnet-youtube": "https://www.youtube.com/@sportsnet/videos",

            "news": "https://www.bing.com/news/search",

            "science": "https://www.bing.com/news/search?q=science&FORM=HDRSC7",

            "technology": "https://www.bing.com/news/search?q=technology&qs=n&form=QBNT&sp=-1&ghc=1&lq=0&pq=technology&sc=10-10&sk=&cvid=23FCA872FD8240DC93F3A09E6054CA59",
            "pippera": "https://northstarconnector-pippera.netlify.app/",

            "gmail": "https://mail.google.com/mail/u/0/#inbox",

            "slack": "https://app.slack.com/client/T0CDQ0NSV6H/C0CDDTR6MLP",

            "stream": "https://crackstreams.gdn/",

            "facebook": "https://www.facebook.com/marketplace",

            "deepseek": "https://chat.deepseek.com/a/chat/s/7df9bb6f-1029-4c32-9787-5b6fee551596",

            "claude": "https://claude.ai/chat/54d82870-733b-4524-83c5-025e182655ec",

            "moltbook": "https://moltbook.com/",
        }
        if target in quick_urls:
            webbrowser.open(quick_urls[target])
            return f"🎩 Opening {target.title()}"
            
        # 3. General URLs
        if any(target.startswith(x) for x in ["http://", "https://", "www."]) or \
           any(x in target for x in [".com", ".ir", ".io", ".org", ".net"]):
            if not target.startswith("http"):
                target = "https://" + target
            webbrowser.open(target)
            return f"🎩 Opening {target}"
            
        # 4. Fallback
        claw_open_file(target)
        return f"🎩 Opening {target}"

#+--|════════════════════════════════════════════════════════════════════
#+--| if intent about : research and teach me
#+--|════════════════════════════════════════════════════════════════════

    # ─── RESEARCH ───
    if intent == "research":
        # Strip the trigger phrase
        query = user_input.lower().replace("tell me about", "").strip()
        
        # Strip nicknames and greetings (but remember them)
        nickname_used = False
        for nick in ["alfy", "alfred", "alfredo", "bossman", "watchman"]:
            if nick in query:
                nickname_used = True
                query = query.replace(nick, "").strip()
        
        # Clean up extra punctuation and spaces
        query = re.sub(r'[^\w\s]', '', query).strip()
        query = re.sub(r'\s+', ' ', query)  # collapse multiple spaces
        
        if query:
            result = search_web(query)
            # If he used a nickname, add a small appreciation line
            if nickname_used:
                return f"🎩 Always a pleasure, Sir.\n\n{result}"
            return result
        
        return "🎩 What would you like me to research, Sir?"

#+--|════════════════════════════════════════════════════════════════════
#+--| if intent search return guidance google.com/search= print
#+--|════════════════════════════════════════════════════════════════════

    # ─── SEARCH (Bing, spaces encoded, short preview) ───
    if intent == "search":
        query = user_input.replace("search", "").replace("find", "").strip()
        if not query:
            return "🎩 What should I search for, Sir?"

        # Use quote to safely encode spaces (e.g. "frontend design" -> "frontend%20design")
        import urllib.parse
        url = f"https://www.bing.com/search?q={urllib.parse.quote(query)}"

        # 1. Bring Firefox forward + open NEW WINDOW (Cmd+N), then load URL
        subprocess.run(["osascript", "-e", 'tell application "Firefox" to activate'])
        time.sleep(0.5)
        subprocess.run([
            "osascript", "-e",
            'tell application "System Events" to keystroke "n" using command down'
        ])
        time.sleep(1.5)

        # ── SIZE THE NEW WINDOW TO 590 × 590 ──
        subprocess.run([
            "osascript", "-e",
            'tell application "Firefox"\n'
            '  set bounds of front window to {0, 0, 590, 590}\n'
            'end tell'
        ])
        time.sleep(0.3)

        # Load the URL in the fresh window
        subprocess.run(["open", "-a", "Firefox", url])
        time.sleep(28)  # keep your existing wait — Bing JS render


        # 2. Bring Firefox to front
        subprocess.run(["osascript", "-e", 'tell application "Firefox" to activate'])
        time.sleep(2)

        # 3. Click into page body
        subprocess.run([
            "osascript", "-e",
            'tell application "System Events" to click at {500, 400}'
        ])
        time.sleep(2)

        # 4. Select all + copy
        subprocess.run([
            "osascript", "-e",
            'tell application "System Events" to keystroke "a" using command down'
        ])
        time.sleep(1)
        subprocess.run([
            "osascript", "-e",
            'tell application "System Events" to keystroke "c" using command down'
        ])
        time.sleep(3)

        # 5. Grab clipboard + save raw for build html later
        raw = subprocess.getoutput("pbpaste")
        raw_path = Path("/Users/olympynetworkco/Desktop/data/bing-last-search.txt")
        try:
            raw_path.write_text(raw, encoding="utf-8")
        except Exception:
            raw_path = None

        # 6. Extract RESULTS — look for "title / url / snippet" triples
        lines = [l.strip() for l in raw.splitlines()]
        results = []
        i = 0
        while i < len(lines):
            line = lines[i]
            if line.startswith("https://") or line.startswith("http://"):
                url_line = line
                title = ""
                snippet = ""
                j = i + 1
                while j < len(lines) and not lines[j]:
                    j += 1
                if j < len(lines):
                    title = lines[j]
                    k = j + 1
                    while k < len(lines) and not lines[k]:
                        k += 1
                    if k < len(lines) and len(lines[k]) > 40:
                        snippet = lines[k]
                if title:
                    results.append((title, url_line, snippet))
                i = j + 1
                continue
            i += 1

        # 7. Return half the results (max 5) — short paste, Sir's rule
        max_results = 5
        top = results[:max_results]

        state["searches_performed"] = state.get("searches_performed", 0) + 1
        save_state(state)

        # ─── GUI MODE: return HTML cards ───
        if _via_gui:
            if not top:
                return (
                    f'<div style="font-family:-apple-system,sans-serif;color:#1a1a1a;padding:12px;">'
                    f'<div style="font-weight:600;margin-bottom:8px;">🔍 Bing: {query}</div>'
                    f'<div style="color:#6b6b6b;font-size:13px;">No results parsed. Raw saved to '
                    f'<code>{raw_path.name if raw_path else "N/A"}</code>.</div>'
                    f'</div>'
                )

            import html as _html
            def _esc(s):
                return _html.escape(s)

            parts = [
                '<div style="font-family:-apple-system,BlinkMacSystemFont,\'Segoe UI\',sans-serif;'
                'max-width:640px;color:#1a1a1a;">',
                '<div style="font-size:15px;font-weight:700;margin-bottom:12px;'
                'padding-bottom:8px;border-bottom:1px solid #e7e7e5;">',
                f'🔍 Bing: <span style="color:#6b21a8;">{_esc(query)}</span>',
                f'<span style="font-size:12px;color:#6b6b6b;font-weight:400;margin-left:8px;">'
                f'{len(top)} results</span>',
                '</div>',
            ]
            for title, url_line, snippet in top:
                parts.append(
                    '<div style="padding:10px 0;border-bottom:1px solid #f0f0ee;">'
                    f'<div style="font-size:14px;font-weight:600;color:#1a0dab;'
                    f'line-height:1.3;margin-bottom:3px;">{_esc(title[:120])}</div>'
                    f'<div style="font-size:12px;color:#006621;'
                    f'font-family:ui-monospace,monospace;margin-bottom:4px;'
                    f'word-break:break-all;">{_esc(url_line[:140])}</div>'
                )
                if snippet:
                    parts.append(
                        f'<div style="font-size:13px;color:#545454;line-height:1.4;">'
                        f'{_esc(snippet[:200])}</div>'
                    )
                parts.append('</div>')

            parts.append(
                f'<div style="font-size:11px;color:#888;margin-top:10px;text-align:right;">'
                f'📄 raw: <code>{raw_path.name if raw_path else "N/A"}</code></div>'
            )
            parts.append('</div>')
            return "".join(parts)

        # ─── TERMINAL / TELEGRAM: text preview ───
        if not top:
            preview = "\n  (no results parsed — raw saved for `build html`)"
        else:
            preview_lines = []
            for title, url_line, snippet in top:
                preview_lines.append(f"\n  ⎙ {title[:80]}")
                preview_lines.append(f"     {url_line[:100]}")
                if snippet:
                    preview_lines.append(f"     {snippet[:120]}")
            preview = "".join(preview_lines)

        tail = f"\n\n  📄 raw: {raw_path.name}" if raw_path else ""
        return f"🎩 Searched Bing: {query}\n  🔗 {url}\n  ⎙ top {len(top)} results:{preview}{tail}"


#+--|════════════════════════════════════════════════════════════════════
