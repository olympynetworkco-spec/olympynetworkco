def _esc(s):
    return (str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))


def _fetch_nhl_games():
    """Return list of game dicts from ESPN's NHL scoreboard."""
    url = "https://site.api.espn.com/apis/site/v2/sports/hockey/nhl/scoreboard"
    ctx = ssl._create_unverified_context()
    req = urllib.request.Request(url, headers={'User-Agent': 'Alfred/1.0'})
    with urllib.request.urlopen(req, timeout=10, context=ctx) as r:
        data = json.loads(r.read().decode('utf-8'))

    games = []
    for ev in data.get("events", []):
        comps = ev.get("competitions", [])
        if not comps:
            continue
        comp = comps[0]
        competitors = comp.get("competitors", [])
        if len(competitors) < 2:
            continue
        t1, t2 = competitors[0], competitors[1]
        status = comp.get("status", {})
        state  = status.get("type", {}).get("state", "")
        period = status.get("period", "")
        detail = status.get("type", {}).get("shortDetail", "")
        games.append({
            "away":  t1.get("team", {}).get("abbreviation") or "?",
            "away_score": t1.get("score", "-"),
            "home":  t2.get("team", {}).get("abbreviation") or "?",
            "home_score": t2.get("score", "-"),
            "state": state,
            "tag": f"P{period}" if period else (detail or "-"),
        })
    return games



import base64

def _build_badge_html(games, changed_keys=None):
    """Load scores-badge.html and inject game rows with Base64 embedded logos."""
    changed_keys = changed_keys or set()
    template = Path(SCORES_BADGE_HTML).read_text(encoding="utf-8")

    # ── Helper to read the PNG and convert it to a Base64 string ──
    def get_base64_logo(abbr):
        if abbr == "NJ": file_abbr = "njd"
        elif abbr == "TB": file_abbr = "tbl"
        elif abbr == "LA": file_abbr = "lak"
        else: file_abbr = abbr.lower()
        
        img_path = Path(f"/Users/olympynetworkco/Desktop/themes/nhl/{file_abbr}.png")
        if img_path.exists():
            try:
                b64_data = base64.b64encode(img_path.read_bytes()).decode('utf-8')
                return f"data:image/png;base64,{b64_data}"
            except Exception:
                pass
        return "" # fallback if file is missing

    if not games:
        rows = '<div style="text-align:center;color:#6b6b6b;padding:12px;">No games right now.</div>'
    else:
        parts = []
        for g in games:
            color = "#ef4444" if g["state"] == "in" else ("#22c55e" if g["state"] == "post" else "#facc15")
            key = f'{g["away"]}@{g["home"]}'
            changed = key in changed_keys
            
            row_style = (
                "display:flex;align-items:center;justify-content:space-between;"
                "padding:8px 8px;border-bottom:1px solid #e7e7e5;"
            )
            if changed:
                row_style += (
                    "background:#dcfce7;border-left:4px solid #16a34a;"
                    "padding-left:10px;border-radius:4px;"
                )
                
            # ── Get the Base64 image strings ──
            away_b64 = get_base64_logo(g["away"].upper())
            home_b64 = get_base64_logo(g["home"].upper())
            
            logo_style = "width:20px;height:20px;object-fit:contain;vertical-align:middle;margin-right:6px;border-radius:3px;"
            
            # Only build the <img> tag if the Base64 data exists
            away_img = f'<img src="{away_b64}" style="{logo_style}">' if away_b64 else ""
            home_img = f'<img src="{home_b64}" style="{logo_style}margin-left:8px;margin-right:6px;">' if home_b64 else ""

            parts.append(
                f'<div style="{row_style}">'
                f'<span style="font-size:13px;color:#1a1a1a;display:flex;align-items:center;">'
                f'{away_img}'
                f'<b style="margin-right:8px;">{_esc(g["away"])}</b> '
                f'<span style="color:#6b6b6b;">{_esc(g["away_score"])}</span>'
                f' <span style="color:#6b6b6b;">—</span> '
                f'<span style="color:#6b6b6b;">{_esc(g["home_score"])}</span>'
                f'{home_img}'
                f'<b>{_esc(g["home"])}</b>'
                f'</span>'
                f'<span style="font-size:11px;font-weight:700;letter-spacing:.5px;'
                f'color:{color};background:{color}1a;padding:2px 7px;border-radius:6px;">'
                f'{_esc(g["tag"])}</span>'
                f'</div>'
            )
        rows = "".join(parts)

    stats_block = re.search(
        r'<!-- Stats strip -->.*?</div>\s*</div>\s*</div>',
        template,
        flags=re.DOTALL,
    )
    if stats_block:
        replacement = (
            '<!-- Stats strip -->\n'
            '  <div class="px-5 pt-3">\n'
            f'    {rows}\n'
            '  </div>\n'
        )
        template = template[:stats_block.start()] + replacement + template[stats_block.end():]

    template = template.replace("MCP Certified", "NHL Scores")
    template = template.replace("Model Context Protocol · Training Module",
                                datetime.now().strftime('%a %b %d · %I:%M %p').replace(' 0', ' '))
    template = template.replace("Badge", "Live")
    template = template.replace("Master Art · OlympyNetworkCo", "OlympyNetworkCo · Watchman")
    template = template.replace("MCP-7F9·A3B1", "NHL · LIVE")
    
    template = template.replace(
        "Verifies completion of the MCP program and unlocks gated resources.",
        "Live NHL scoreboard · refreshed every 2 min by the Watchman."
    )
    
    return template


def _send_document(file_path, caption=""):
    """Send an HTML file to Telegram as a document."""
    cfg = load_telegram_config()
    if not cfg or not cfg.get("token"):
        return False
    try:
        import uuid
        boundary = "----A" + uuid.uuid4().hex
        f = Path(file_path)
        content = f.read_bytes()
        body = f"--{boundary}\r\n".encode()
        body += b'Content-Disposition: form-data; name="chat_id"\r\n\r\n'
        body += f"{cfg['chat_id']}\r\n".encode()
        if caption:
            body += f"--{boundary}\r\n".encode()
            body += b'Content-Disposition: form-data; name="caption"\r\n\r\n'
            body += f"{caption}\r\n".encode()
        body += f"--{boundary}\r\n".encode()
        body += f'Content-Disposition: form-data; name="document"; filename="{f.name}"\r\n'.encode()
        body += b"Content-Type: text/html\r\n\r\n"
        body += content + b"\r\n"
        body += f"--{boundary}--\r\n".encode()
        ctx = ssl._create_unverified_context()
        req = urllib.request.Request(
            f"https://api.telegram.org/bot{cfg['token']}/sendDocument",
            data=body,
            headers={"Content-Type": f"multipart/form-data; boundary={boundary}"}
        )
        urllib.request.urlopen(req, timeout=60, context=ctx)
        print(f"[TG] ✓ HTML sent: {f.name} ({len(content)//1024} KB)")
        return True
    except Exception as e:
        print(f"[TG] Document send failed: {e}")
        return False


def check_live_scores(sport="nhl"):
    """Fetch ESPN scores → build badge HTML (green-highlight changed games) → send as document."""
    global _live_score_last_sig, _live_score_last_games

    try:
        games = _fetch_nhl_games()
    except Exception as e:
        log_error(f"[SCORES] fetch failed: {e}")
        return

    sig = "|".join(f'{g["away"]}{g["away_score"]}{g["home"]}{g["home_score"]}{g["tag"]}' for g in games)
    if sig == _live_score_last_sig.get(sport):
        return
    _live_score_last_sig[sport] = sig

    # Compare current scores to previous snapshot to find changed games
    prev = _live_score_last_games.get(sport, {})
    current = {f'{g["away"]}@{g["home"]}': f'{g["away_score"]}-{g["home_score"]}' for g in games}
    changed = {k for k, v in current.items() if k in prev and prev[k] != v}
    _live_score_last_games[sport] = current

    html = _build_badge_html(games, changed_keys=changed)

    out = Path("/Users/olympynetworkco/Desktop/data/score-card-latest.html")
    out.write_text(html, encoding="utf-8")

    caption = f"🏒 NHL · {datetime.now().strftime('%b %d · %I:%M %p').replace(' 0',' ')}"
    if changed:
        caption += f" · {len(changed)} score change{'s' if len(changed)!=1 else ''}"


    # ── ADD THIS: Append the clickable link to the caption ──
    caption += "\n\n📱 Tap to view live: http://10.0.0.58:8080/data/score-card-latest.html"

    _send_document(out, caption=caption)
    log_info(f"[SCORES] {sport} html sent · {len(changed)} changed")




