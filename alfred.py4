#+--| ALFRED'S BOOK — def load_book():
#+--|════════════════════════════════════════════════════════════════════
BOOK_FILE = BASE / "alfred_book.json"

def load_book():
    if BOOK_FILE.exists():
        try:
            return json.loads(BOOK_FILE.read_text(encoding="utf-8"))
        except Exception:
            pass
    return {"entries": [], "sources_read": {}, "last_thought": None}

def save_book(book):
    BOOK_FILE.write_text(json.dumps(book, indent=2, ensure_ascii=False), encoding="utf-8")

#+--|════════════════════════════════════════════════════════════════════
#+--| ALFRED'S # def add_to_book(source, title, snippet, url=""):
#+--|════════════════════════════════════════════════════════════════════

def add_to_book(source, title, snippet, url=""):
    """Log one thing Alfred read into his book."""
    book = load_book()
    entry = {
        "time": datetime.now().isoformat(),
        "source": source,
        "title": title[:200],
        "snippet": snippet[:400],
        "url": url,
    }
    book["entries"].append(entry)
    book["entries"] = book["entries"][-200:]   # keep last 200
    book["sources_read"][source] = book["sources_read"].get(source, 0) + 1
    book["last_thought"] = entry
    save_book(book)
    return entry


