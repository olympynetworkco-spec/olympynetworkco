#+--| def _think_and_speak(source_name, title, link, snippet):
#+--|════════════════════════════════════════════════════════════════════

def _think_and_speak(source_name, title, link, snippet):
    prompt = (
        f"You just read this from {source_name}. "
        f"Headline: '{title}'. "
        f"Snippet: {snippet}. "
        "In one short sentence (max 22 words), tell Master Art what the story says "
        "and why it matters, or ask him a question about it. "
        "Address him as Sir. No greetings, no repeating the headline."
    )
    try:
        reply = alfred_mind(prompt).strip()
    except Exception:
        reply = "Worth a look, Sir."

    reply = " ".join(reply.split())
    short_title = title if len(title) <= 80 else title[:77] + "…"

    teams = title.replace(" vs ", " ").strip()
    search_url = f"https://www.youtube.com/results?search_query={urllib.parse.quote('Sportsnet ' + teams + ' highlights')}"

    subprocess.run(["open", "-a", "Firefox", search_url])

    msg = f"🏒 {source_name}\n\n  🗞  {short_title}\n  ➤  {reply}\n\n  📺 *Firefox is open. Click the downloader extension.*"
    send_telegram(msg)

    add_memory(f"📖 Feed Read: [{source_name}] {title}")
    log_info(f"[WATCH] opened Firefox for {source_name}: {title[:80]}")


#+--|════════════════════════════════════════════════════════════════════
#+--| def watch_cycle():
#+--|════════════════════════════════════════════════════════════════════

def watch_cycle():
    """One pass: refresh live scores, then check for a new headline."""
    global _last_watch_cycle

    hour = datetime.now().hour
    if WATCH_QUIET_HOURS[0] <= hour < WATCH_QUIET_HOURS[1]:
        return

    # Always refresh live scores first — every watch cycle
    try:
        check_live_scores("nhl")
    except Exception as e:
        log_error(f"[SCORES] watch_cycle check failed: {e}")

    # Then the original headline-vulture pass
    target = random.choice(get_watch_targets())
    log_info(f"[WATCH] reading {target['name']}...")

    try:
        items = _fetch_feed(target["url"])
    except Exception as e:
        log_error(f"[WATCH] {target['name']} fetch failed: {e}")
        return

    if not items:
        log_info(f"[WATCH] {target['name']} returned 0 items")
        return

    for (title, link, snippet) in items:
        if not _check_memory_for_title(title):
            _think_and_speak(target["name"], title, link, snippet)
            return

    log_info(f"[WATCH] {target['name']} all {len(items)} items already seen")


#+--|════════════════════════════════════════════════════════════════════
#+--| def start_watch_loop():
#+--|════════════════════════════════════════════════════════════════════

def start_watch_loop():
    def loop():
        while True:
            try:
                watch_cycle()
                time.sleep(WATCH_INTERVAL)
            except Exception as e:
                log_error(f"[WATCH] loop error: {e}")
                time.sleep(60)
    threading.Thread(target=loop, daemon=True).start()
    log_info("[WATCH] 👁 watch loop started (live scores + headline vulture)")


