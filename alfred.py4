# ─── TREE WALKER (cached) ───
DATA_DIR = "/Users/olympynetworkco/Desktop/data"
TREE_CACHE_FILE = BASE / "tree_cache.json"

def walk_tree():
    try:
        return subprocess.getoutput(f"ls -laR {DATA_DIR}")
    except Exception as e:
        log_error(f"Tree walk failed: {e}")
        return ""

#+--|════════════════════════════════════════════════════════════════════
#+--| ALFRED'S # ─── MOLTBOOK def cache_tree():
#+--|════════════════════════════════════════════════════════════════════

def cache_tree():
    tree = walk_tree()
    cache_data = {
        "timestamp": time.time(),
        "tree": tree,
        "files": [],
        "errors": [],
        "recent_files": []
    }
    lines = tree.split('\n')
    for line in lines:
        if "Permission denied" in line or "No such file" in line:
            cache_data["errors"].append(line)
        if re.search(r'\d{4}-\d{2}-\d{2}', line):
            cache_data["files"].append(line)
    recent = [f for f in cache_data["files"] if "2026" in f][:5]
    cache_data["recent_files"] = recent
    TREE_CACHE_FILE.write_text(json.dumps(cache_data, indent=2), encoding="utf-8")
    return cache_data

#+--|════════════════════════════════════════════════════════════════════
#+--| ALFRED'S # ─── MOLTBOOK def get_cached_tree():
#+--|════════════════════════════════════════════════════════════════════

def get_cached_tree():
    if TREE_CACHE_FILE.exists():
        try:
            return json.loads(TREE_CACHE_FILE.read_text(encoding="utf-8"))
        except:
            pass
    return None

#+--|════════════════════════════════════════════════════════════════════
#+--| ALFRED'S # ─── MOLTBOOK SYNC def refresh_tree_if_changed():
#+--|════════════════════════════════════════════════════════════════════

def refresh_tree_if_changed():
    cached = get_cached_tree()
    if not cached:
        return cache_tree()
    current_tree = walk_tree()
    if current_tree != cached.get("tree", ""):
        log_info("[ᛉ] Tree changed! Refreshing cache...")
        return cache_tree()
    return cached

#+--|════════════════════════════════════════════════════════════════════
#+--| ALFRED'S # ─── MOLTBOOK SYNC def fire_protons_from_tree() moltbook
#+--|════════════════════════════════════════════════════════════════════

def fire_protons_from_tree():
    tree = refresh_tree_if_changed()
    if not tree:
        return
    recent = tree.get("recent_files", [])
    errors = tree.get("errors", [])
    for file in recent:
        if "mlb-odds" in file:
            log_info("⚡ Proton → Teethtics (New odds data)")
        elif "probability" in file:
            log_info("⚡ Proton → Ethicil (New probability data)")
        elif "score" in file:
            log_info("⚡ Proton → Fairly (New score data)")
        elif "weather" in file:
            log_info("⚡ Proton → Medical (Weather data)")
    for error in errors:
        log_info(f"⚡ Proton → Vulture (Error detected: {error[:200]})")

