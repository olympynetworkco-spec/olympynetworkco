def main():
    print(f"\n{CYN}================================================================={R}")
    alfred_log("INFO", "System", f"{BLU}{BOLD}🎩  Alfred watchman initializing...{R}", BG_CYAN)
    alfred_log("SENT", "System", f"{GRN}✓{R} Ready.", BG_GREEN)
    print(f"{CYN}=================================================================\n{R}")

    # ─── Anchor everything to the Desktop ───
    DESKTOP = "/Users/olympynetworkco/Desktop"
    try:
        os.chdir(DESKTOP)
        alfred_log("SENT", "FileSystem", f"CWD set → {os.getcwd()}")
    except OSError as e:
        alfred_log("FAIL", "FileSystem", f"Could not chdir to {DESKTOP}: {e}", BG_RED)

    alfred_log("SENT", "System", "🎩 Alfred initializing")
    alfred_log("SENT", "System", "⎚-⎚ Goggles: Active")
    alfred_log("SENT", "Memory", f"📁 {BASE}")
    alfred_log("SENT", "Voice", f"🎤 {'Telegram' if load_telegram_config() else 'Local only'}")
    alfred_log("SENT", "Hand", "🦞 Native MacBook Pro (AppleScript)")
    alfred_log("SENT", "Brain", "🧠 [✎] Command parser active")
    alfred_log("SENT", "Tower", "🌐 Watchdog active")

    # Web server
    web_thread = threading.Thread(target=start_web_server, daemon=True)
    web_thread.start()
    alfred_log("SENT", "Network", "🌐 Web server booted")

    claw_watchdog()
    send_telegram("🎩 - ✓ online.")

    if load_telegram_config():
        listener_thread = threading.Thread(target=telegram_listener, daemon=True)
        listener_thread.start()
        alfred_log("SENT", "Telegram", "📨 Listener active")

    start_moltbook_sync()
    start_watch_loop()

    time.sleep(1)

    print(f"{CYN}=================================================================\n{R}")

    while True:
        write_dashboard_state()
        fire_protons_from_tree()
        moltbook_sync()

        try:
            sys.stdout.write(f"{BOLD}🎩 {R}")
            sys.stdout.flush()
            user_input = input().strip()
            if not user_input:
                continue

            if _json_builder is not None or _html_builder is not None:
                low = user_input.lower()

                # Single-word terminator on its own line — handle immediately
                if low in ("done", "save", "finish", "cancel", "never mind", "nevermind", "stop"):
                    print(alfred_think(user_input))
                    continue

                # Otherwise read lines until a terminator (or EOF)
                blob = [user_input]
                while True:
                    sys.stdout.write(f"{DIM}   … {R}")
                    sys.stdout.flush()
                    try:
                        nxt = input()
                    except EOFError:
                        break
                    nxt_s = nxt.strip()
                    low_nxt = nxt_s.lower()

                    if low_nxt in ("done", "save", "finish"):
                        print(alfred_think("\n".join(blob)))
                        print(alfred_think(nxt_s))
                        blob = None
                        break
                    if low_nxt in ("cancel", "never mind", "nevermind", "stop"):
                        print(alfred_think(nxt_s))
                        blob = None
                        break

                    blob.append(nxt)

                if blob:
                    print(alfred_think("\n".join(blob)))

                continue

            response = alfred_think(user_input)
            print(response)
        except EOFError:
            break
        except KeyboardInterrupt:
            print(f"\n🎩 Goodbye, sir.")
            break
        except Exception as e:
            handle_error(str(e))
