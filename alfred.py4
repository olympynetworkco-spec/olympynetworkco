def _check_memory_for_title(title):
    """Check if the title is already in alfred_memory.txt."""
    if MEMORY_FILE.exists():
        content = MEMORY_FILE.read_text(encoding="utf-8")
        if title in content:
            return True
    return False

def _article_first_sentences(url, max_paras=8, timeout=15):
    """Fetch the article at `url` and return the first sentence of each paragraph,
    joined with ' '. Ignores empty/short paragraphs. Caps output."""
    try:
        ctx = ssl._create_unverified_context()
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (Alfred)"})
        with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
            html = r.read().decode("utf-8", errors="replace")
    except Exception as e:
        log_error(f"[WATCH] article fetch failed: {e}")
        return ""

    html = re.sub(r"<script[^>]*>.*?</script>", " ", html, flags=re.DOTALL | re.IGNORECASE)
    html = re.sub(r"<style[^>]*>.*?</style>", " ", html, flags=re.DOTALL | re.IGNORECASE)

    paras = re.findall(r"<p[^>]*>(.*?)</p>", html, flags=re.DOTALL | re.IGNORECASE)

    first_sentences = []
    for p in paras:
        text = re.sub(r"<[^>]+>", " ", p)
        text = (text.replace("&amp;", "&")
                    .replace("&quot;", '"')
                    .replace("&#39;", "'")
                    .replace("&nbsp;", " ")
                    .replace("&apos;", "'")
                    .replace("&ldquo;", '"')
                    .replace("&rdquo;", '"')
                    .replace("&mdash;", "—")
                    .replace("&ndash;", "–"))
        text = " ".join(text.split()).strip()

        if len(text) < 30:
            continue

        m = re.split(r'(?<=[\.\?\!])\s', text, maxsplit=1)
        sentence = m[0].strip()
        if sentence and sentence not in first_sentences:
            first_sentences.append(sentence)
        if len(first_sentences) >= max_paras:
            break

    return " ".join(first_sentences)


