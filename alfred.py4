def get_watch_targets():
    """Dynamically builds the scoreboard URLs for yesterday and today."""
    today = datetime.now()
    yesterday = today - timedelta(days=1)
    fmt = "%Y%m%d"

    return [
        {"name": "ESPN-NHL", "url": f"https://www.espn.com/nhl/scoreboard/_/date/{yesterday.strftime(fmt)}"},
        {"name": "ESPN-NHL", "url": f"https://www.espn.com/nhl/scoreboard/_/date/{today.strftime(fmt)}"}
    ]


