def send_telegram_button(message, reply_markup=None):
    """Sends a Telegram message with optional inline buttons."""
    cfg = load_telegram_config()
    if not cfg or not cfg['token']:
        return False
    try:
        context = ssl._create_unverified_context()
        payload = {"chat_id": cfg['chat_id'], "text": message}
        if reply_markup:
            payload["reply_markup"] = reply_markup

        msg = json.dumps(payload).encode()
        req = urllib.request.Request(
            f"https://api.telegram.org/bot{cfg['token']}/sendMessage",
            data=msg,
            headers={"Content-Type": "application/json"}
        )
        urllib.request.urlopen(req, timeout=3, context=context)
        print(f"[TG] Sent Button: {message[:50]}...")
        return True
    except Exception as e:
        print(f"[TG] Send Button failed: {e}")
        return False


