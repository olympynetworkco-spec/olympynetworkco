#+--| def save_memory_turn(chat_id, role, text, intention="unknown", context="general"):
#+--|════════════════════════════════════════════════════════════════════

def save_memory_turn(chat_id, role, text, intention="unknown", context="general"):
    CHATS_DIR = BASE / "chats"
    CHATS_DIR.mkdir(parents=True, exist_ok=True)
    path = CHATS_DIR / f"{chat_id}.json"
    
    data = {"id": chat_id, "title": "", "messages": [], "timestamp": int(time.time() * 1000)}
    if path.exists():
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            pass
            
    if role in ("user", "owner"):
        entry = {"role": "owner", "text": text, "intention": intention}
    else:
        entry = {"role": "chief watchman", "name": "Alfred Pennyworth", "text": text, "intention": intention}
        
    data.setdefault("messages", []).append(entry)
    if not data.get("title") and role in ("user", "owner"):
        data["title"] = text[:40]
        
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")
    return entry

