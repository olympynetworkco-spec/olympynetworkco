#+--|════════════════════════════════════════════════════════════════════

def _json_show():
    if not _last_json_file or not _last_json_file.exists():
        return "🎩 No JSON built yet this session, Sir."
    try:
        content = _last_json_file.read_text(encoding="utf-8")
        if len(content) > 8000:
            content = content[:8000] + "\n... (truncated)"
        return f"🎩 {_last_json_file.name}:\n```json\n{content}\n```"
    except Exception as e:
        return f"🎩 Couldn't read it: {e}"

