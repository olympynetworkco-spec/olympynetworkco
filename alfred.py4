def _fetch_feed(url, timeout=15):
    """Return list of (title, link, snippet) tuples from an ESPN Scoreboard."""
    ctx = ssl._create_unverified_context()
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
        html = r.read().decode("utf-8", errors="replace")

    items = []

    teams = re.findall(r'class="ScoreboardScoreCell__TeamName[^"]*"[^>]*>([^<]+)</div>', html)
    links = re.findall(r'href="([^"]*/game/_/gameId/\d+[^"]*)"', html)

    for i in range(0, len(teams), 2):
        if i + 1 < len(teams) and len(items) < 5:
            away = teams[i].strip()
            home = teams[i+1].strip()

            if not away or not home:
                continue

            title = f"{away} vs {home}"
            link = links[len(items)] if len(items) < len(links) else url
            if link.startswith('/'):
                link = f"https://www.espn.com{link}"

            items.append((title, link, "Scoreboard update"))

    return items


