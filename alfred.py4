#+--|----------------------------------------------------------------------------------->>>>
#+--| # def calculate_formula(formula_id, data): ─── FORMULA BOOK
#+--|----------------------------------------------------------------------------------->>>>
#+--|

def calculate_formula(formula_id, data):
    # 1. Determine the sport's "quantum" (default to MLB)
    sport = data.get("sport", "MLB").upper()
    if sport == "NFL":
        quantum = 4.0      # 4 quarters
        safety_net = 7.5
        std_denom = 4.0
    else:
        quantum = 9.0      # 9 innings
        safety_net = 2.5
        std_denom = 9.0

    values = data.get("values", [])
    
    try:
        if formula_id == "win-loss":
            team_score = data.get("team_score", 0)
            opponent_score = data.get("opponent_score", 0)
            result = team_score - opponent_score
            return {"result": result, "formula": "Team Score − Opponent Score", "description": "Point/Run differential."}

        elif formula_id in ("run-line", "point-spread"):
            win_loss = data.get("win_loss", 0)
            spread = data.get("spread", -1.5 if sport == "MLB" else -3.5)
            result = win_loss >= abs(spread)
            return {"result": "WIN" if result else "LOSE", "win_loss": win_loss, "spread": spread, "formula": f"WIN if win|loss ≥ {abs(spread)}"}

        elif formula_id == "safety-net":
            win_loss = data.get("win_loss", 0)
            # Fixed: Uses the sport's actual safety net, and abs() catches both directions
            result = abs(win_loss) >= safety_net
            return {"result": "WIN" if result else "LOSE", "win_loss": win_loss, "threshold": safety_net, "formula": f"WIN if abs(win|loss) ≥ {safety_net}"}

        elif formula_id == "momentum":
            if not values: return {"error": "No values provided for momentum"}
            # 10-period EMA (intentional, as you confirmed)
            alpha = 2/11 
            ema = values[0]
            for v in values[1:]:
                ema = alpha * v + (1 - alpha) * ema
            window_note = f"(calibrated for 10 games, got {len(values)})" if len(values) != 10 else ""
            return {"result": round(ema, 2), "window_note": window_note, "n": len(values), "formula": "EMA(10)"}

        elif formula_id == "spring":
            # Physics: Mx¨ + fvx˙ + Kx = f(t)
            # We approximate displacement x(t) using win|loss momentum
            if not values: return {"error": "No values for spring"}
            mass = data.get("mass", 1.0)           # Drive weight
            damping = data.get("damping", 0.5)     # Clock runoff
            spring_k = data.get("spring_k", 1.5)   # 4th quarter/9th inning pressure
            
            # Simplified numerical integration of the spring equation
            x = 0.0
            v = 0.0
            for force in values:
                a = (force - damping * v - spring_k * x) / mass
                v += a
                x += v
            return {"result": round(x, 2), "formula": "Mx¨ + fvx˙ + Kx = f(t)", "description": "Spring Pop momentum value"}

        elif formula_id == "prediction":
            if len(values) < 5: return {"error": "Need at least 5 values for prediction"}
            sorted_vals = sorted(values)
            n = len(sorted_vals)
            p85 = sorted_vals[min(n - 1, int(0.85 * n))]
            p50 = sorted_vals[n // 2] # Median (Expected)
            p15 = sorted_vals[int(0.15 * n)] # Downside
            
            # Trend detection (Edging)
            half = max(1, n // 2)
            recent_mean = sum(values[-half:]) / half
            older_mean  = sum(values[:-half]) / max(1, n - half)
            edge_pct    = ((recent_mean - older_mean) / abs(older_mean) * 100) if older_mean else 0.0
            
            return {
                "result": round(p85, 2), 
                "expected": round(p50, 2), 
                "downside": round(p15, 2),
                "edge_pct": round(edge_pct, 2),
                "edging_up": edge_pct >= 3.0,
                "formula": "85th % Percentile", "n": n
            }

        elif formula_id in ("win-percentage", "coverage-rate"):
            total = data.get("total", 0)
            meeting = data.get("meeting", 0)
            if total == 0: return {"error": "Total games cannot be 0"}
            rate = meeting / total
            return {"result": round(rate, 3), "percentage": f"{rate * 100:.1f}%", "meets_target": rate >= 0.85, "formula": "(Games Meeting Criteria / Total Games) × 85"}

        elif formula_id == "safer-bet":
            # Compares Spring to Odd Line
            spring_val = data.get("momentum", data.get("spring", 0)) 
            odd_line = data.get("odd_line", safety_net)
            result = "OVER" if spring_val >= odd_line else "UNDER"
            return {"result": result, "spring": spring_val, "odd_line": odd_line, "formula": f"IF Spring ≥ {odd_line} THEN OVER"}

        elif formula_id == "median":
            if not values: return {"error": "No values provided"}
            sorted_vals = sorted(values)
            n = len(sorted_vals)
            med = sorted_vals[n//2] if n % 2 == 1 else (sorted_vals[n//2 - 1] + sorted_vals[n//2]) / 2
            return {"result": round(med, 2), "formula": f"Median / {quantum}", "description": f"Divided by {quantum} for per-inning/quarter ref"}

        elif formula_id == "std-dev":
            if len(values) < 2: return {"error": "Need at least 2 values for std-dev"}
            mean = sum(values) / len(values)
            variance = sum((x - mean) ** 2 for x in values) / (len(values) - 1)
            result = variance ** 0.5
            return {"result": round(result, 2), "mean": round(mean, 2), "formula": f"σ = √(Σ(win|loss − Spring)² / {std_denom})"}

        elif formula_id == "probability":
            # Z = (Odd Line − Spring) / Quantum
            spring_val = data.get("spring", 0)
            odd_line = data.get("odd_line", safety_net)
            std_dev = data.get("std_dev", 1.0)
            
            # Calculate Z-score
            z = (odd_line - spring_val) / quantum
            
            # Standard Normal CDF (Approximation)
            import math
            cdf = 0.5 * (1.0 + math.erf(z / math.sqrt(2.0)))
            
            prob = cdf * 100
            return {"result": f"{prob:.1f}%", "z_score": round(z, 2), "formula": f"Z = (Odd Line − Spring) / {quantum}"}
            
        else:
            return {"error": f"Formula '{formula_id}' not yet implemented"}
            
    except Exception as e:
        return {"error": str(e)}

#+--|----------------------------------------------------------------------------------->>>>
#+--| # def alfred_calculate(formula_id, data): ─── FORMULA BOOK
#+--|----------------------------------------------------------------------------------->>>>
#+--|

def alfred_calculate(formula_id, data):
    result = calculate_formula(formula_id, data)
    if "error" in result:
        return f"🎩 Calculation error: {result['error']}"
    lines = [f"🎩 Calculating {formula_id}...", "", f"[🎤︎︎ ERROR.DASHBOARD-STATE] Result: {result.get('result', 'N/A')}"]
    if "percentage" in result:
        lines.append(f"[🎤︎︎ ERROR.DASHBOARD-STATE] Percentage: {result['percentage']}")
    if "meets_target" in result:
        lines.append(f"🎯 Meets 85% target: {'✓ YES' if result['meets_target'] else '[🎤︎︎ ERROR] NO'}")
    if "momentum" in result:
        lines.append(f"📈 Momentum: {result['momentum']}")
    if "odd_line" in result:
        lines.append(f"🎯 Odd Line: {result['odd_line']}")
    if "win_loss" in result:
        lines.append(f"🏆 Win/Loss: {result['win_loss']}")
    if "spread" in result:
        lines.append(f"[🎤︎︎ ERROR.DASHBOARD-STATE] Spread: {result['spread']}")
    if "mean" in result:
        lines.append(f"[🎤︎︎ ERROR.DASHBOARD-STATE] Mean: {result['mean']}")
    lines.append("")
    if "formula" in result:
        lines.append(f"📐 Formula: {result['formula']}")
    if "description" in result:
        lines.append(f"⎙ {result['description']}")
    if result.get('example'):
        lines.append(f"💡 Example: {result['example']}")
    lines.append("")
    lines.append("🦇 '↕ shift sir through time expand the graph with song ↔'")
    return "\n".join(lines)


#+--|════════════════════════════════════════════════════════════════════
#+--| — Error handling
#+--|════════════════════════════════════════════════════════════════════
_last_error_time = 0
_error_cooldown = 10

def handle_error(error_text, context=None, severity="warn"):
    """
    severity:
      'info' → logged only, does NOT bump any counter
      'warn' → logged + bumps errors_warn, no Telegram
      'fail' → logged + bumps errors_fail + Telegram alert (cooldown-limited)
    """
    global _last_error_time

    state = load_state()

    if severity == "warn":
        state["errors_warn"] = state.get("errors_warn", 0) + 1
    elif severity == "fail":
        state["errors_fail"] = state.get("errors_fail", 0) + 1

    # keep the old key so anything reading errors_caught still works
    if severity in ("warn", "fail"):
        state["errors_caught"] = state.get("errors_caught", 0) + 1
        save_state(state)

    tag = severity.upper()
    log_error(f"[{tag}] {error_text[:500]}")
    add_memory(f"ERROR[{tag}]: {error_text[:500]}")

    if severity == "fail":
        current_time = time.time()
        if current_time - _last_error_time > _error_cooldown:
            send_telegram(f"[⚠️-Config-json] Alfred caught ({tag}): {error_text[:200]}")
            _last_error_time = current_time

    return {
        "handled": True,
        "severity": severity,
        "error": error_text[:500],
        "context": context,
    }




