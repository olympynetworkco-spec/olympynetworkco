# ─── DASHBOARD STATE WRITER ───
def write_dashboard_state():
    """Write ALFRED's state to /Users/olympynetworkco/Desktop/data for HTML dashboard"""
    DATA_DIR = "/Users/olympynetworkco/Desktop/data"
    try:
        files = []
        if os.path.exists(DATA_DIR):
            for f in os.listdir(DATA_DIR):
                file_path = os.path.join(DATA_DIR, f)
                if os.path.isfile(file_path):
                    files.append({
                        "name": f,
                        "size": os.path.getsize(file_path),
                        "modified": os.path.getmtime(file_path)
                    })

        state = load_state()

        dashboard_state = {
            "alfred": {
                "name": "ALFRED·DNA",
                "version": "2.0",
                "state": "AWAKENED",
                "metrics": {
                    "errors_caught": state.get("errors_caught", 0),
                    "goals_completed": state.get("goals_completed", 0),
                    "commands_parsed": state.get("commands_parsed", 0),
                    "searches_performed": state.get("searches_performed", 0),
                    "tabs_opened": state.get("tabs_opened", 0),
                    "demo_tests_run": state.get("demo_tests_run", 0),
                    "uptime": int(time.time() - _start),
                    "dna_index": 0
                },
                "files_in_data": len(files),
                "file_list": files[:20],
                "current_state": {
                    "status": "LISTENING",
                    "protons": state.get("commands_parsed", 0),
                    "wisdom_level": "AWAKENED"
                }
            }
        }

        with open(os.path.join(DATA_DIR, "alfred-state.json"), "w", encoding="utf-8") as f:
            json.dump(dashboard_state, f, indent=2)
        return True
    except Exception as e:
        log_error(f"  [🎤︎︎ ERROR.DASHBOARD-STATE] Failed to write dashboard state: {e}")
        return False

