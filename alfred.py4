def load_state():
    defaults = {
        "errors_caught": 0,
        "errors_warn":   0,
        "errors_fail":   0,
        "goals_completed": 0,
        "commands_parsed": 0,
        "searches_performed": 0,
        "tabs_opened": 0,
        "demo_tests_run": 0,
        "uptime": 0
    }
    if STATE_FILE.exists():
        try:
            data = json.loads(STATE_FILE.read_text(encoding="utf-8"))
            return {**defaults, **data}
        except:
            return defaults
    return defaults


