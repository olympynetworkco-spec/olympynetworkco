#+--| ALFRED'S # def add_goal(description):
#+--|════════════════════════════════════════════════════════════════════

def add_goal(description):
    goals = []
    if GOALS_FILE.exists():
        try:
            goals = json.loads(GOALS_FILE.read_text(encoding="utf-8"))
        except:
            pass
    goal = {
        "id": f"goal_{int(time.time())}",
        "description": description,
        "status": "active",
        "created_at": datetime.now().isoformat()
    }
    goals.append(goal)
    GOALS_FILE.write_text(json.dumps(goals, indent=2), encoding="utf-8")

    state = load_state()
    state["goals_completed"] = state.get("goals_completed", 0) + 1
    save_state(state)
    return goal

