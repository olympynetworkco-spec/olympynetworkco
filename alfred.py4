# ─── WEB SERVER ───
FAVICON_PATH = "/Users/olympynetworkco/Desktop/themes/alfred/favicon.ico"

class AlfredHTTPHandler(http.server.SimpleHTTPRequestHandler):
    """SimpleHTTPRequestHandler + a guaranteed /favicon.ico from themes/alfred/."""

    def do_GET(self):
        if self.path.split("?")[0] == "/favicon.ico":
            try:
                with open(FAVICON_PATH, "rb") as f:
                    data = f.read()
                self.send_response(200)
                self.send_header("Content-Type", "image/x-icon")
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Cache-Control", "public, max-age=86400")
                self.end_headers()
                self.wfile.write(data)
                return
            except OSError as e:
                log_error(f"🌐 favicon read failed: {e}")
                # fall through → default 404 handling
        return super().do_GET()

    def log_message(self, format, *args):
        """Override to colorize the HTTP server logs."""
        msg = format % args
        clean_msg = msg.replace('"', '')  # Clean up quotes for the grid
        
        # Route the color based on the status code
        if "200" in msg or "304" in msg:
            alfred_log("SENT", "127.0.0.1", clean_msg, BG_GREEN)
        elif "404" in msg:
            alfred_log("FAIL", "127.0.0.1", clean_msg, BG_RED)
        else:
            alfred_log("INFO", "127.0.0.1", clean_msg, BG_CYAN)


def start_web_server(port: int = 8080):
    """Serve the Desktop folder on *port* and open it in the default browser."""
    handler = AlfredHTTPHandler

    try:
        httpd = socketserver.TCPServer(("", port), handler)
        server_thread = threading.Thread(target=httpd.serve_forever, daemon=True)
        server_thread.start()

        url = f"http://localhost:{port}"
        alfred_log("SENT", "Network", f"🌐 Web server running at {url} (root: {os.getcwd()})")
        alfred_log("SENT", "Network", f"🌐 favicon → {FAVICON_PATH}")
        webbrowser.open_new_tab(url)

    except OSError as e:
        alfred_log("FAIL", "Network", f"🌐 Web server error: {e}", BG_RED)

