#+--|----------------------------------------------------------------------------------->>>>
#+--| def parse_intent return ECHO
#+--|----------------------------------------------------------------------------------->>>>
#+--|

def parse_intent(text):
    text_lower = text.lower().strip()

    # ─── Exact commands fire only on exact input ───
    if text_lower in ("read", "read aloud", "read this"):
        return "read"

    if text_lower == "call alfred":
        return "alfredscall"

    for intent, keywords in intents.items():
        if intent in ("alfredscall", "read"):
            continue          # ← handled above, skip keyword scan
        for keyword in keywords:
            if re.search(r'\b' + re.escape(keyword) + r'\b', text_lower):
                return intent
    return "echo"


#+--|----------------------------------------------------------------------------------->>>>
#+--| FOLDER LISTER ─── 1️⃣ Add a list_dir helper (put near json_grip in CHAPTER 5)
#+--|----------------------------------------------------------------------------------->>>>
#+--|
def list_directory(path, show_hidden=False):
    """Pretty-print a folder as a table. Folders first, files newest → oldest."""
    p = Path(os.path.expanduser(path.strip().strip('"').strip("'")))

    if not p.exists():
        return f"⍢ Path not found: {p}"
    if not p.is_dir():
        return f"⍢ Not a folder: {p}\n  (use 'grip' for files)"

    try:
        entries = [e for e in p.iterdir() if show_hidden or not e.name.startswith(".")]
    except PermissionError:
        return f"[SUDO.CER] Permission denied: {p}"

    files, folders, total_bytes = [], [], 0
    for e in entries:
        try:
            mtime = e.stat().st_mtime
        except Exception:
            mtime = 0
        try:
            if e.is_dir():
                try:
                    n = sum(1 for _ in e.iterdir())
                except Exception:
                    n = "?"
                folders.append((e.name, n, mtime))
            else:
                sz = e.stat().st_size
                total_bytes += sz
                files.append((e.name, sz, mtime))
        except Exception:
            continue

    # folders: newest first · files: newest first
    folders.sort(key=lambda x: x[2], reverse=True)
    files.sort(key=lambda x: x[2], reverse=True)

    def human(n):
        for unit in ("B", "KB", "MB", "GB", "TB"):
            if n < 1024:
                return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
            n /= 1024
        return f"{n:.1f}PB"


    def stamp(t):
        try:
            dt = datetime.fromtimestamp(t)
            h = dt.hour % 12 or 12
            ampm = "am" if dt.hour < 12 else "pm"
            return f"{dt.strftime('%Y-%m-%d')}  {h}:{dt.strftime('%M')} {ampm}"
        except Exception:
            return "??????????"

    lines = [f"🎩 Listing: {p}  (newest → oldest)", ""]

    if folders:
        lines.append(f"  ⎙ FOLDERS ({len(folders)})")
        for name, n, t in folders:
            lines.append(f"     {stamp(t)}   {name}/  ({n} items)")
        lines.append("")

    if files:
        lines.append(f"  📄 FILES ({len(files)})")
        for name, sz, t in files:
            lines.append(f"     {stamp(t)}   {name:<50} {human(sz):>10}")
        lines.append("")

    if not files and not folders:
        lines.append("  (empty)")

    lines.append(f"  ─────────────────────────────")
    lines.append(f"  🦞 {len(folders)} folders · {len(files)} files · {human(total_bytes)} total")

    state = load_state()
    state["commands_parsed"] = state.get("commands_parsed", 0) + 1
    save_state(state)
    return "\n".join(lines)

#+--|----------------------------------------------------------------------------------->>>>
#+--| JSONGRIP()─── 1️⃣ Add a list_dir helper (put near json_grip in CHAPTER 5) # ─── JSON 
