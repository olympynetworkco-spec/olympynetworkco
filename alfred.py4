def speak(text, voice=THOMAS_VOICE):
    """Apple default TTS — offline, never 403s."""
    out = "/Users/olympynetworkco/Desktop/data/alfred_call.m4a"
    try:
        subprocess.run(["say", "-v", voice, "-o", out, text],
                       check=False, timeout=30)
        subprocess.run(["afplay", out], check=False)
    except Exception as e:
        print(f"[🎤︎︎ ERROR] say failed: {e}")


