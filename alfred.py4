def _json_start(filename=None):
    global _json_builder
    _json_builder = {
        "stage": "awaiting_games",
        "filename": filename or f"games-{datetime.now().strftime('%Y%m%d-%H%M%S')}",
        "source": "",
        "games": [],
    }
    return "🎩 Drop the games, Sir. (paste the whole blob at once)"

#+--|════════════════════════════════════════════════════════════════════
#+--| def _json_add_game(block):
#+--|════════════════════════════════════════════════════════════════════

def _json_add_game(block):
    """Parse games from blob: teams are 2 lines above a `date / time` anchor."""
    global _json_builder

    lines = [l.strip() for l in block.splitlines() if l.strip()]
    if not lines:
        return "🎩 Empty. Drop the games, Sir."

    MONTHS = {m: i for i, m in enumerate(
        ["jan","feb","mar","apr","may","jun","jul","aug","sep","oct","nov","dec"], 1)}

    def _parse_date(txt):
        txt = txt.strip()
        try:
            return datetime.strptime(txt, "%Y-%m-%d").strftime("%Y-%m-%d")
        except Exception:
            pass
        m = re.search(r'([A-Za-z]{3,9})\s+(\d{1,2})', txt)
        if m:
            mon = m.group(1).lower()[:3]
            day = int(m.group(2))
            if mon in MONTHS:
                year = datetime.now().year
                if MONTHS[mon] < datetime.now().month - 1:
                    year += 1
                try:
                    return datetime(year, MONTHS[mon], day).strftime("%Y-%m-%d")
                except Exception:
                    pass
        return datetime.now().strftime("%Y-%m-%d")

    def _is_date(txt):
        t = txt.strip()
        return bool(re.match(r'^[A-Za-z]{3,9},?\s+[A-Za-z]{3,9}\s+\d{1,2}$', t)
                    or re.match(r'^\d{4}-\d{2}-\d{2}$', t))

    def _is_time(txt):
        return bool(re.search(r'\d{1,2}:\d{2}', txt))

    games_found = 0
    i = 0
    n = len(lines)
    while i + 1 < n:
        # anchor: a date line immediately followed by a time line
        if _is_date(lines[i]) and _is_time(lines[i+1]) and i >= 2:
            game = {
                "date": _parse_date(lines[i]),
                "type": None,
                "away": {"team": lines[i-2], "score": None},
                "home": {"team": lines[i-1], "score": None},
                "status": "pending",
            }
            _json_builder["games"].append(game)
            games_found += 1
            i += 2
            continue
        i += 1

    if games_found == 0:
        return ("🎩 No games found in that blob, Sir.\n"
                "  Expected pattern: away / home / date / time (repeated)")

    return (f"🎩 Added {games_found} game{'s' if games_found != 1 else ''} "
            f"(total {len(_json_builder['games'])}). Say `done` to write it, or paste more.")

#+--|════════════════════════════════════════════════════════════════════
#+--| def _json_cancel():
#+--|════════════════════════════════════════════════════════════════════

def _json_cancel():
    global _json_builder
    _json_builder = None
    return "🎩 Cancelled."

#+--|════════════════════════════════════════════════════════════════════
#+--| ddef _json_finish():
#+--|════════════════════════════════════════════════════════════════════

def _json_finish():
    global _json_builder, _last_json_file

    if not _json_builder or not _json_builder["games"]:
        _json_builder = None
        return "🎩 Nothing to write, Sir."


    # Build games as compact one-liners, blank line between days
    game_lines = []
    prev_date = None
    for g in _json_builder["games"]:
        if prev_date is not None and g["date"] != prev_date:
            game_lines.append("")  # blank line between days
        game_lines.append(
            f'{{ "date": "{g["date"]}", "type": {json.dumps(g["type"])}, '
            f'"away": {{"team": "{g["away"]["team"]}", "score": {json.dumps(g["away"]["score"])}}}, '
            f'"home": {{"team": "{g["home"]["team"]}", "score": {json.dumps(g["home"]["score"])}}}, '
            f'"status": "{g["status"]}" }},'
        )
        prev_date = g["date"]

    body = "\n".join(game_lines)

    text = (
        '{\n'
        f'  "source": {json.dumps(_json_builder["source"] or "")},\n'
        '  "league": "Source_User",\n'
        f'  "season": {datetime.now().year},\n'
        '  "games": [\n'
        f'{body}\n'
        '  ]\n'
        '}\n'
    )

    path = BASE / f"{_json_builder['filename']}.json"
    path.write_text(text, encoding="utf-8")
    _last_json_file = path
    n = len(_json_builder["games"])
    _json_builder = None

    return f"🎩 Saved {n} games → {path.name}"

#+--|════════════════════════════════════════════════════════════════════
