def _html_capture(text):
    global _html_builder
    _html_builder["text"] = text
    _html_builder["stage"] = "awaiting_name"
    return "🎩 Text received. What should I name the file? (e.g. `my-page`)"

def _html_finish(name):
    global _html_builder, _last_json_file
    name = name.strip().replace(" ", "-").lower()
    if not name:
        name = f"page-{datetime.now().strftime('%Y%m%d-%H%M%S')}"
    if not name.endswith(".html"):
        name += ".html"

    path = Path.home() / "Downloads" / name
    path.parent.mkdir(parents=True, exist_ok=True)

#+--|════════════════════════════════════════════════════════════════════
#+--|    raw = _html_builder["text"]
#+--|════════════════════════════════════════════════════════════════════
#+--|
    raw = _html_builder["text"]
    
    # If the text is already HTML, just save it as is.
    if "<html" in raw.lower() or "<!doctype" in raw.lower():
        content = raw
    else:
        content = f"""<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{name[:-5].replace('-', ' ')}</title>
<style>
  :root {{
    --bg: #ffffff; --text: #1a1a1a; --panel-bg: #f8f8f8; --border: #e0e0e0;
    --accent: #6b21a8; --code-bg: #f3f4f6; --panel-width: 260px;
  }}
  
  [data-theme="dark"] {{
    --bg: #0b1424; --text: #dbeafe; --panel-bg: #111c30; --border: #1e293b;
    --accent: #c084fc; --code-bg: #060c16;
  }}

  * {{ box-sizing: border-box; margin: 0; padding: 0; }}

  body {{ 
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; 
    background: var(--bg); color: var(--text); display: flex; height: 100vh; overflow: hidden;
    transition: background 0.3s, color 0.3s;
  }}

  /* ── SIDEBAR PANEL ── */
  #sidebar {{
    width: var(--panel-width); background: var(--panel-bg);
    border-right: 1px solid var(--border); display: flex; flex-direction: column;
    padding: 20px; transition: width 0.3s ease, padding 0.3s ease;
    overflow: hidden; flex-shrink: 0;
  }}
  
  #sidebar.collapsed {{ width: 0; padding: 20px 0; border-right: none; }}

  #sidebar h2 {{ font-size: 14px; text-transform: uppercase; color: var(--accent); margin-bottom: 15px; letter-spacing: 1px; white-space: nowrap; }}

  .category {{
    padding: 10px; margin-bottom: 5px; border-radius: 6px; font-size: 13px;
    cursor: pointer; white-space: nowrap; transition: background 0.2s;
    color: var(--text);
  }}

  .category:hover {{ background: var(--border); }}
  .category.active {{ background: var(--accent); color: #fff; font-weight: 600; }}

  /* ── MAIN CONTENT ── */
  #main {{ flex: 1; display: flex; flex-direction: column; overflow-y: auto; padding: 40px; }}

  header {{ display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--accent); padding-bottom: 10px; margin-bottom: 20px; }}

  h1 {{ font-size: 24px; text-transform: capitalize; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }}

  .controls {{ display: flex; gap: 10px; }}

  .btn {{ background: var(--accent); color: #fff; border: none; padding: 8px 16px; border-radius: 20px; cursor: pointer; font-size: 14px; font-weight: 600; transition: opacity 0.2s; white-space: nowrap; }}
  .btn:hover {{ opacity: 0.8; }}

  /* ── PAGES (The 7 Divs) ── */
  .page {{
    display: none; /* Hidden by default */
    background: var(--code-bg); padding: 20px; border-radius: 8px;
    border: 1px solid var(--border); color: var(--text);
    font-family: "SF Mono", Monaco, monospace; font-size: 14px;
    line-height: 1.6; white-space: pre-wrap; overflow-x: auto;
  }}
  
  .page.active {{ display: block; }} /* Only show the active one */

</style>
</head>
<body>

  <!-- COLLAPSIBLE SIDEBAR -->
  <div id="sidebar">
    <h2>Categories</h2>
    <div class="category active" onclick="showPage(1)">1. Core Philosophy & Learning</div>
    <div class="category" onclick="showPage(2)">2. Deployment & Infrastructure</div>
    <div class="category" onclick="showPage(3)">3. Platform & Interface</div>
    <div class="category" onclick="showPage(4)">4. Model Flexibility</div>
    <div class="category" onclick="showPage(5)">5. Provider Option: Portal Proxy</div>
    <div class="category" onclick="showPage(6)">6. Installation & Platform Support</div>
    <div class="category" onclick="showPage(7)">7. Migration & Compatibility</div>
  </div>

  <!-- MAIN CONTENT -->
  <div id="main">
    <header>
      <h1>{name[:-5].replace('-', ' ')}</h1>
      <div class="controls">
        <button class="btn" onclick="toggleSidebar()">☰ Panel</button>
        <button class="btn" onclick="toggleTheme()">🌓 Theme</button>
      </div>
    </header>
    
    <!-- The Javascript will inject the 7 divs here -->
    <div id="pages-container" style="display: flex; flex-direction: column; gap: 20px;"></div>
  </div>

<script>
  const rawText = {json.dumps(raw)};
  
  function splitTextIntoPages(text, numPages) {{
    const lines = text.split('\\n');
    const chunkSize = Math.ceil(lines.length / numPages);
    const pages = [];
    for (let i = 0; i < numPages; i++) {{
        pages.push(lines.slice(i * chunkSize, (i + 1) * chunkSize).join('\\n'));
    }}
    return pages;
  }}

  const pagesData = splitTextIntoPages(rawText, 7);
  const container = document.getElementById('pages-container');

  pagesData.forEach((chunk, index) => {{
    const div = document.createElement('div');
    div.className = 'page' + (index === 0 ? ' active' : '');
    div.id = 'page-' + (index + 1);
    div.textContent = chunk || '(Empty section)';
    container.appendChild(div);
  }});

  function showPage(pageNum) {{
    // Hide all pages
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    // Show requested page
    document.getElementById('page-' + pageNum).classList.add('active');
    
    // Update active button styling
    document.querySelectorAll('.category').forEach((c, i) => {{
        if (i === (pageNum - 1)) c.classList.add('active');
        else c.classList.remove('active');
    }});
  }}

  // Theme Toggle
  function toggleTheme() {{
    const html = document.documentElement;
    const current = html.getAttribute('data-theme');
    const next = current === 'light' ? 'dark' : 'light';
    html.setAttribute('data-theme', next);
    localStorage.setItem('alfred-theme', next);
  }}

  const savedTheme = localStorage.getItem('alfred-theme');
  if (savedTheme) {{
    document.documentElement.setAttribute('data-theme', savedTheme);
  }}

  // Sidebar Toggle
  function toggleSidebar() {{
    const sidebar = document.getElementById('sidebar');
    sidebar.classList.toggle('collapsed');
    localStorage.setItem('alfred-sidebar', sidebar.classList.contains('collapsed') ? 'closed' : 'open');
  }}

  const savedSidebar = localStorage.getItem('alfred-sidebar');
  if (savedSidebar === 'closed') {{
    document.getElementById('sidebar').classList.add('collapsed');
  }}
</script>
</body>
</html>
"""

    path.write_text(content, encoding="utf-8")
    n_lines = content.count("\n") + 1
    _last_json_file = path
    _html_builder = None

    return f"🎩 Saved {n_lines} lines → ~/Downloads/{name}"


#+--|════════════════════════════════════════════════════════════════════
#+--| chapter 6 :def build python4 scripts
#+--| /python4 — idle | textedit | file edit (replace / delete / add)
#+--|════════════════════════════════════════════════════════════════════

_py4_builder = None

def open_python4_skeleton(choice=None):
    """Entry for /python4. Menu → idle / textedit / file edit."""
    global _py4_builder, _waiting_for_python4_editor

    SKELETON_TXT = Path("/Users/olympynetworkco/Desktop/ollama/python4/skeleton.py4.txt")
    IDLE_APP = "/Users/olympynetworkco/Desktop/ollama/python4/py47tools/IDLE.app"

    if choice is None:
        _py4_builder = {"stage": "menu"}
        _waiting_for_python4_editor = False
        return (
            "🎩 /python4 — what would you like, Sir?\n"
            "  • idle\n"
            "  • textedit\n"
            "  • file edit\n"
            "  (or `cancel`)"
        )

    low = choice.strip().lower()

    if low == "idle":
        if not SKELETON_TXT.exists():
            return f"🎩 Skeleton not found at {SKELETON_TXT}, Sir."
        subprocess.Popen(["open", "-a", IDLE_APP, str(SKELETON_TXT)])
        return "🎩 Opening skeleton.py4.txt in IDLE, Sir."

    if low == "textedit":
        if not SKELETON_TXT.exists():
            return f"🎩 Skeleton not found at {SKELETON_TXT}, Sir."
        subprocess.Popen(["open", "-e", str(SKELETON_TXT)])
        return "🎩 Opening skeleton.py4.txt in TextEdit, Sir."

    if low in ("file edit", "file", "edit", "fileedit"):
        _py4_builder = {"stage": "awaiting_file"}
        return "🎩 Which file, Sir? Drop the .py4 / .py path (or `cancel`)."

    return "🎩 Say `idle`, `textedit`, or `file edit` (or `cancel`)."


def _py4_cancel():
    global _py4_builder
    _py4_builder = None
    return "🎩 Edit cancelled, Sir. No changes made."


def _py4_capture_file(text):
    global _py4_builder
    raw = text.strip().strip('"').strip("'")
    path = Path(os.path.expanduser(raw))

    if not path.exists():
        return f"🎩 File not found, Sir: {path}\n  Drop the path again, or `cancel`."
    if not path.is_file():
        return f"🎩 That's not a file, Sir: {path}\n  Try again, or `cancel`."
    if path.suffix not in (".py", ".py4", ".txt", ".json", ".html", ".sh"):
        _py4_builder = {"stage": "awaiting_file_confirm", "pending": str(path)}
        return (f"🎩 {path.name} isn't .py/.py4/.txt/.json/.html/.sh, Sir.\n"
                f"  Say `yes` to edit it anyway, or drop a different path.")

    # ── Lock + print the script with line numbers ──
    try:
        content = path.read_text(encoding="utf-8")
    except Exception as e:
        return f"🎩 Couldn't read {path.name}, Sir: {e}"

    lines = content.splitlines()
    total = len(lines)

    # Cap the preview so huge files don't flood the terminal
    MAX_PREVIEW = 200
    shown = lines[:MAX_PREVIEW]
    width = len(str(total))

    numbered = "\n".join(f"{i+1:>{width}} │ {ln}" for i, ln in enumerate(shown))
    truncated = ""
    if total > MAX_PREVIEW:
        truncated = (f"\n  … {total - MAX_PREVIEW} more lines "
                     f"(say `show all` to dump the rest, or just paste your find-block)")

    _py4_builder = {"stage": "awaiting_action", "file": str(path)}

    return (f"🎩 File locked: {path.name}  ({total} lines)\n"
            f"{'─' * 60}\n"
            f"{numbered}{truncated}\n"
            f"{'─' * 60}\n\n"
            f"  What would you like?\n"
            f"    • replace lines\n"
            f"    • delete lines\n"
            f"    • add lines\n"
            f"  (or `cancel`)")


def _py4_capture_action(text):
    global _py4_builder
    low = text.strip().lower()

    if low in ("replace", "replace lines"):
        _py4_builder.update({"stage": "awaiting_find", "action": "replace"})
        return ("🎩 Replace — paste the *finding block* first, Sir, "
                "so I can locate it.\n  (paste it exactly as it appears)")

    if low in ("delete", "delete lines"):
        _py4_builder.update({"stage": "awaiting_find", "action": "delete"})
        return ("🎩 Delete — paste the block to remove, Sir.\n"
                "  (paste it exactly as it appears)")

    if low in ("add", "add lines"):
        _py4_builder.update({"stage": "awaiting_new", "action": "add",
                             "find_block": "", "find_line": 0, "anchor": None})
        return ("🎩 Add — paste the new block, Sir.\n"
                "  I'll ask where after.")

    return "🎩 Say `replace`, `delete`, or `add` (or `cancel`)."


def _py4_strip_line_numbers(block):
    """Remove '<n> │ ' / '<n>| ' / '<n> ' prefixes from pasted lines."""
    out = []
    for ln in block.splitlines():
        # match: optional spaces, digits, optional spaces, │ or | or tab, optional space
        m = re.match(r'^\s*\d+\s*[│|]\s?(.*)$', ln)
        if m:
            out.append(m.group(1))
        else:
            out.append(ln)
    return "\n".join(out)


def _py4_capture_find(block):
    global _py4_builder
    f = Path(_py4_builder["file"])
    try:
        content = f.read_text(encoding="utf-8")
    except Exception as e:
        return f"🎩 Couldn't read {f.name}, Sir: {e}"

    # Try exact first, then with line-number prefixes stripped
    idx = content.find(block)
    used = block
    if idx == -1:
        stripped = _py4_strip_line_numbers(block)
        idx = content.find(stripped)
        used = stripped

    if idx == -1:
        return ("🎩 Block not found in the file, Sir.\n"
                "  Paste it exactly (spaces/quotes/line breaks matter), "
                "or `cancel`.")

    line_no = content[:idx].count("\n") + 1
    _py4_builder.update({"find_block": used, "find_line": line_no})

    if _py4_builder["action"] == "replace":
        _py4_builder["stage"] = "awaiting_new"
        return (f"🎩 Found line {line_no}, Sir:\n\n{used}\n\n"
                f"  What would you like to replace it with?\n"
                f"  (paste replacement, or `delete` to remove it)")

    _py4_builder["stage"] = "awaiting_confirm"
    return (f"🎩 Found line {line_no}, Sir:\n\n{used}\n\n"
            f"  Confirm deletion with `done`, or `cancel`.")



def _py4_capture_new(block):
    global _py4_builder
    if _py4_builder["action"] == "add":
        _py4_builder.update({"stage": "awaiting_anchor",
                             "replacement": block})
        return ("🎩 New block captured, Sir. Where?\n"
                "  • `above`  → I'll ask for the anchor block\n"
                "  • `below`  → I'll ask for the anchor block\n"
                "  • `append` → end of file")

    _py4_builder.update({"stage": "awaiting_confirm", "replacement": block})
    return "🎩 Got it, Sir. Say `done` for the process to render (or `cancel`)."


def _py4_capture_anchor_choice(text):
    global _py4_builder
    low = text.strip().lower()

    if low == "append":
        _py4_builder.update({"stage": "awaiting_confirm", "anchor": "append"})
        return "🎩 Appending to end of file. Say `done` to render (or `cancel`)."

    if low in ("above", "below"):
        _py4_builder.update({"stage": "awaiting_anchor_block", "anchor": low})
        return f"🎩 Paste the anchor block, Sir — the one I insert {low}."

    return "🎩 Say `above`, `below`, or `append` (or `cancel`)."


def _py4_capture_anchor_block(block):
    global _py4_builder
    f = Path(_py4_builder["file"])
    try:
        content = f.read_text(encoding="utf-8")
    except Exception as e:
        return f"🎩 Couldn't read {f.name}, Sir: {e}"

    idx = content.find(block)
    used = block
    if idx == -1:
        stripped = _py4_strip_line_numbers(block)
        idx = content.find(stripped)
        used = stripped

    if idx == -1:
        return "🎩 Anchor not found, Sir. Paste it again exactly, or `cancel`."

    line_no = content[:idx].count("\n") + 1
    _py4_builder.update({"stage": "awaiting_confirm",
                         "find_block": used, "find_line": line_no})
    return (f"🎩 Anchor at line {line_no}, Sir. Inserting {_py4_builder['anchor']} it.\n"
            f"  Say `done` to render (or `cancel`).")



def _py4_render():
    global _py4_builder
    b = _py4_builder
    if not b or b.get("stage") != "awaiting_confirm":
        return "🎩 Nothing to render, Sir."

    f = Path(b["file"])
    action = b["action"]

    try:
        original = f.read_text(encoding="utf-8")
    except Exception as e:
        _py4_builder = None
        return f"🎩 Couldn't re-read {f.name}, Sir: {e}"

    find = b.get("find_block", "")
    repl = b.get("replacement", "")

    print("🎩 assisting edit…")

    print("🎩 checking…")
    if action in ("replace", "delete") and find and find not in original:
        _py4_builder = None
        return "🎩 Find-block vanished since I checked, Sir. Aborting. No backup written."

    print("🎩 updating replacement…")
    if action == "replace":
        new_content = original.replace(find, repl, 1)
    elif action == "delete":
        new_content = original.replace(find, "", 1)
    elif action == "add":
        anchor = b.get("anchor")
        if anchor == "append":
            new_content = original.rstrip() + "\n\n" + repl + "\n"
        elif anchor == "above":
            new_content = original.replace(find, repl + "\n" + find, 1)
        elif anchor == "below":
            new_content = original.replace(find, find + "\n" + repl, 1)
        else:
            _py4_builder = None
            return "🎩 Add anchor missing, Sir. Aborting."
    else:
        _py4_builder = None
        return f"🎩 Unknown action '{action}', Sir. Aborting."

    print("🎩 finalizing — backup + new clone…")
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    backup = f.with_name(f"{f.name}.bak-{stamp}")
    try:
        backup.write_text(original, encoding="utf-8")
        f.write_text(new_content, encoding="utf-8")
    except Exception as e:
        _py4_builder = None
        return f"🎩 Write failed, Sir: {e}"

    print("🎩 print done — file updated")
    _py4_builder = None
    return (f"🎩 Done, Sir. File updated in folder it came from.\n"
            f"  ⎙ edited : {f}\n"
            f"  ⎙ backup : {backup.name}\n"
            f"  ⎙ lines  : {len(original.splitlines())} → {len(new_content.splitlines())}")


def _py4_route(user_input):
    """Single router called from alfred_think() while a /python4 flow is active."""
    global _py4_builder
    low = user_input.strip().lower()

    if low in ("cancel", "never mind", "nevermind", "stop", "abort"):
        return _py4_cancel()

    stage = _py4_builder["stage"]

    if stage == "menu":
        return open_python4_skeleton(user_input)
    if stage == "awaiting_file":
        return _py4_capture_file(user_input)
    if stage == "awaiting_file_confirm":
        if low in ("yes", "y", "ok", "sure"):
            f = _py4_builder["pending"]
            _py4_builder = {"stage": "awaiting_action", "file": f}
            return (f"🎩 File locked: {Path(f).name}\n\n"
                    f"  What would you like?\n"
                    f"    • replace lines\n"
                    f"    • delete lines\n"
                    f"    • add lines\n"
                    f"  (or `cancel`)")
        _py4_builder = {"stage": "awaiting_file"}
        return "🎩 Drop a different path, Sir (or `cancel`)."
    if stage == "awaiting_action":
        if low == "show all":
            f = Path(_py4_builder["file"])
            try:
                content = f.read_text(encoding="utf-8")
            except Exception as e:
                return f"🎩 Couldn't read it, Sir: {e}"
            lines = content.splitlines()
            width = len(str(len(lines)))
            numbered = "\n".join(f"{i+1:>{width}} │ {ln}" for i, ln in enumerate(lines))
            return (f"🎩 Full file: {f.name}  ({len(lines)} lines)\n"
                    f"{'─' * 60}\n{numbered}\n{'─' * 60}\n\n"
                    f"  What would you like?\n"
                    f"    • replace lines\n"
                    f"    • delete lines\n"
                    f"    • add lines\n"
                    f"  (or `cancel`)")
        return _py4_capture_action(user_input)
    if stage == "awaiting_find":
        return _py4_capture_find(user_input)
    if stage == "awaiting_new":
        return _py4_capture_new(user_input)
    if stage == "awaiting_anchor":
        return _py4_capture_anchor_choice(user_input)
    if stage == "awaiting_anchor_block":
        return _py4_capture_anchor_block(user_input)
    if stage == "awaiting_confirm":
        if low in ("done", "save", "finish", "render"):
            return _py4_render()
        return "🎩 Say `done` to render, or `cancel` to abort."

    _py4_builder = None
    return "🎩 I lost the edit state, Sir. Say `/python4` to start again."

