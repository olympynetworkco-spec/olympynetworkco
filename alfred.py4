    # ─── REMEMBER ───
    if intent == "remember":
        what = user_input.replace("remember", "").replace("recall", "").strip()
        if what:
            add_memory(what)
            return f"🎩 Remembered: {what}"
        memories = recall_memories()
        if memories:
            return "🎩 Recent memories:\n" + "\n".join(f"  • {m}" for m in memories)
        return "🎩 No memories yet."
