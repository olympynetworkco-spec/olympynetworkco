# Simple logger helpers
log_info = lambda msg: logging.info(msg)
log_error = lambda msg: logging.error(msg)

LOG_FILE = "/Users/olympynetworkco/Desktop/data/alfred.log"
os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)

def log_info(msg):
    with open(LOG_FILE, 'a', encoding='utf-8') as f:
        f.write(f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')} | ALFRED | INFO | {msg}\n")

def log_error(msg):
    with open(LOG_FILE, 'a', encoding='utf-8') as f:
        f.write(f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')} | ALFRED | ERROR | {msg}\n")

def log_warning(msg):
    with open(LOG_FILE, 'a', encoding='utf-8') as f:
        f.write(f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')} | ALFRED | WARNING | {msg}\n")

