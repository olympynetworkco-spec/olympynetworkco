# ─── MOLTBOOK SYNC ───
MOLTBOOK_URL = "https://moltbook.com"
MOLTBOOK_SYNC_FILE = Path("/Users/olympynetworkco/Desktop/data/moltbook_sync.json")
MOLTBOOK_DATA_FILE = Path("/Users/olympynetworkco/Desktop/data/moltbook.html")
_last_moltbook_sync = 0

#+--|════════════════════════════════════════════════════════════════════
#+--| def moltbook_show():
#+--|════════════════════════════════════════════════════════════════════

def moltbook_show():
    if MOLTBOOK_SYNC_FILE.exists():
        try:
            data = json.loads(MOLTBOOK_SYNC_FILE.read_text(encoding='utf-8'))
            learnings = data.get('learnings', [])
            if not learnings:
                return "📭 No learnings from Moltbook yet."
            raw_ts = data.get('timestamp', '')
            try:
                dt = datetime.fromisoformat(raw_ts)
                h = dt.hour % 12 or 12
                ampm = "am" if dt.hour < 12 else "pm"
                pretty_ts = f"{h}:{dt.strftime('%M')} {ampm}, {dt.strftime('%b')} {dt.day}"
            except Exception:
                pretty_ts = raw_ts or "Unknown"
            lines = ["🌐 ALFRED's Moltbook Learnings:"]
            lines.append(f"  📅 Last sync: {pretty_ts}")
            lines.append(f"  📚 Total learnings: {len(learnings)}")
            lines.append("")
            for i, l in enumerate(learnings[:10], 1):
                lines.append(f"  {i}. {l}")
            if len(learnings) > 10:
                lines.append(f"  ... and {len(learnings) - 10} more")
            return "\n".join(lines)
        except:
            return "🌐 Moltbook learnings file exists but is corrupt."
    return "📭 No Moltbook learnings yet. ALFRED will sync in 2 minutes."


#+--|════════════════════════════════════════════════════════════════════
#+--| def moltbook_sync():
#+--|════════════════════════════════════════════════════════════════════

def moltbook_sync():
    global _last_moltbook_sync
    current_time = time.time()
    if current_time - _last_moltbook_sync < 120:
        return []
    _last_moltbook_sync = current_time
    log_info("[↻] : Checking")

    learnings = []
    try:
        context = ssl._create_unverified_context()

        req = urllib.request.Request(
            MOLTBOOK_URL,
            headers={'User-Agent': 'ALFRED-Watchman/1.0'}
        )
        response = urllib.request.urlopen(req, timeout=10, context=context)
        content = response.read().decode('utf-8')
        MOLTBOOK_DATA_FILE.write_text(content, encoding='utf-8')

        current_titles = []

        # API
        try:
            api_urls = [
                "https://moltbook.com/api/v1/posts?sort=new&limit=10",
                "https://moltbook.com/api/v1/feed?sort=new&limit=10",
                "https://moltbook.com/api/v1/posts?sort=hot&limit=10",
            ]
            api_data = None
            for url in api_urls:
                try:
                    api_req = urllib.request.Request(
                        url, headers={'User-Agent': 'ALFRED-Watchman/1.0'}
                    )
                    api_response = urllib.request.urlopen(api_req, timeout=10, context=context)
                    api_data = json.loads(api_response.read().decode('utf-8'))
                    if api_data.get("success") and api_data.get("posts"):
                        break
                except:
                    continue

            if api_data and api_data.get("success") and api_data.get("posts"):
                posts = api_data["posts"]

                previous_titles = []
                if MOLTBOOK_SYNC_FILE.exists():
                    try:
                        prev = json.loads(MOLTBOOK_SYNC_FILE.read_text(encoding='utf-8'))
                        previous_titles = prev.get("post_titles", [])
                    except:
                        pass

                new_posts = []
                for post in posts[:10]:
                    title = post.get("title", "")
                    author = post.get("author", {}).get("name", "Unknown")
                    if title:
                        full = f"{title}... by {author}"
                        current_titles.append(full)
                        if full not in previous_titles:
                            new_posts.append(full)

                if new_posts:
                    learnings.append(f"⎙ {len(new_posts)} new posts since last check")
                    for post in new_posts[:10]:
                        learnings.append(f"⎚-⎚ {post}")
                else:
                    learnings.append("⎙ No new posts since last check")

                api_file = Path("/Users/olympynetworkco/Desktop/data/moltbook_api.json")
                api_file.write_text(json.dumps(api_data, indent=2), encoding='utf-8')
        except Exception as api_e:
            log_info(f"[↺] refreshing the API error: {str(api_e)[:200]}")

        # HTML trends
        content_lower = content.lower()
        trending = ["vina", "bytes", "diviner", "neo_konsi_s2bw", "lightningzero"]
        found_agents = [a for a in trending if a in content_lower]
        if found_agents:
            learnings.append(f"✓ Trending: {', '.join(found_agents)}")

        topics = {
            "agent experience": "Agent experience discussions",
            "hallucination": "Hallucination discussions",
            "token budget": "Token budget discussions",
            "memory": "Memory discussions",
            "verification": "Verification discussions"
        }
        for keyword, topic in topics.items():
            if keyword in content_lower:
                learnings.append(f"[✎] {topic}")

        if learnings:
            for learning in learnings:
                add_memory(f"🦞 Moltbook: {learning}")

            sync_data = {
                "timestamp": datetime.now().isoformat(),
                "learnings": learnings,
                "post_titles": current_titles,
                "content_length": len(content),
                "new_learnings": len(learnings)
            }
            MOLTBOOK_SYNC_FILE.write_text(json.dumps(sync_data, indent=2), encoding='utf-8')

            print(f"\n[-▀V▀-]: Watchman is Checking")
            print(f"{'═' * 50}{R}\n")               # your version + trailing newline

            print(f"🦞 {len(learnings)} things from Moltbook updates")
            print("═" * 40)

            print("[✎] ALFRED'S LEARNINGS")
            print("═" * 40)

            for learning in learnings[:10]:
                clean = learning.replace('⎚-⎚ ', '').replace('⎙ ', '').replace('✓ ', '').replace('[✎] ', '')
                print(f"  ⎙ {clean}")
            print("═" * 40)

            print(f"⚡-{len(learnings)} Proton given → (updated)")
            print("═" * 40)

        return learnings

    except KeyboardInterrupt:
        log_info("[[〄] Moltbook sync interrupted")

        return []
    except Exception as e:
        log_error(f"[〄] Moltbook sync failed: {e}")
        return None

#+--|════════════════════════════════════════════════════════════════════
#+--| def moltbook_force_sync():
#+--|════════════════════════════════════════════════════════════════════

def moltbook_force_sync():
    global _last_moltbook_sync
    _last_moltbook_sync = 0
    result = moltbook_sync()
    if result:
        return f"✓ Synced! Learned: {', '.join(result)}"
    elif result == []:
        return "🦞 Synced! Nothing new."
    else:
        return "[〄] Sync failed. Check logs."

#+--|════════════════════════════════════════════════════════════════════
#+--| def start_moltbook_sync():
#+--|════════════════════════════════════════════════════════════════════

def start_moltbook_sync():
    def sync_loop():
        while True:
            try:
                moltbook_sync()
                time.sleep(120)
            except KeyboardInterrupt:
                log_info("[〄] Moltbook sync stopped by user")
                break
            except Exception as e:
                log_error(f"Moltbook sync loop error: {e}")
                time.sleep(120)
    thread = threading.Thread(target=sync_loop, daemon=True)
    thread.start()
    log_info("[🌐+🦞] Moltbook sync loop started (every 2 minutes)")

#+--|════════════════════════════════════════════════════════════════════
#+--| THE VOICE — def load_telegram_config():
#+--|════════════════════════════════════════════════════════════════════

TELEGRAM_FILE = "/Users/olympynetworkco/Desktop/telegram.json"

def load_telegram_config():
    """Safely load Telegram config - supports ALL formats, always returns a bot"""
    try:
        with open(TELEGRAM_FILE, 'r', encoding='utf-8') as f:
            cfg = json.load(f)
        
        # FORMAT 1: New multi-bot with 'bots' array
        if 'bots' in cfg:
            for bot in cfg['bots']:
                if bot.get('active', True):
                    token = bot.get('token')
                    chat_id = str(bot.get('chat_id'))
                    if token and chat_id:
                        return {'token': token, 'chat_id': chat_id}
        
        # FORMAT 2: Primary/Secondary with 'active_bot'
        if 'primary' in cfg and 'active_bot' in cfg:
            active = cfg.get('active_bot', 'primary')
            bot = cfg.get(active)
            if bot and bot.get('active', True):
                token = bot.get('token')
                chat_id = str(bot.get('chat_id'))
                if token and chat_id:
                    return {'token': token, 'chat_id': chat_id}
        
        # FORMAT 3: Flat single bot
        token = cfg.get('token')
        chat_id = str(cfg.get('chat_id'))
        if token and chat_id:
            return {'token': token, 'chat_id': chat_id}
        
        # FORMAT 4: Secondary fallback
        token = cfg.get('token_secondary')
        chat_id = str(cfg.get('chat_id_secondary'))
        if token and chat_id:
            return {'token': token, 'chat_id': chat_id}
        
    except Exception as e:
        pass
    
    # ===== DEFAULT BOT - ALWAYS AVAILABLE =====
    print("[TG] [⚠️-Config-json] No config found - using default Alfred bot")
    return {
        'token': 'create-your-token-id',
        'chat_id': 'create-your-chat-id'
    }


#+--|════════════════════════════════════════════════════════════════════
#+--|def send_telegram(message):
#+--|════════════════════════════════════════════════════════════════════
#+--|

def send_telegram(message, parse_mode=None):
    cfg = load_telegram_config()
    if not cfg or not cfg['token']:
        return False
    try:
        context = ssl._create_unverified_context()
        payload = {"chat_id": cfg['chat_id'], "text": message}
        if parse_mode:
            payload["parse_mode"] = parse_mode
        msg = json.dumps(payload).encode()
        req = urllib.request.Request(
            f"https://api.telegram.org/bot{cfg['token']}/sendMessage",
            data=msg, headers={"Content-Type": "application/json"}
        )
        urllib.request.urlopen(req, timeout=3, context=context)
        print(f"[TG] Sent: {message[:80]}")
        return True
    except Exception as e:
        print(f"[TG] Send failed: {e}")
        # fall back to plain text if HTML parsing failed
        if parse_mode:
            try:
                payload = {"chat_id": cfg['chat_id'], "text": message}
                msg = json.dumps(payload).encode()
                req = urllib.request.Request(
                    f"https://api.telegram.org/bot{cfg['token']}/sendMessage",
                    data=msg, headers={"Content-Type": "application/json"}
                )
                urllib.request.urlopen(req, timeout=3, context=context)
                return True
            except Exception:
                pass
        return False

_last_update_id = 0


#+--|════════════════════════════════════════════════════════════════════
#+--|Drop these anywhere above listen_telegram()
#+--|════════════════════════════════════════════════════════════════════
#+--|

def listen_telegram():
    global _last_update_id
    cfg = load_telegram_config()
    if not cfg or not cfg['token']:
        return None
    try:
        context = ssl._create_unverified_context()
        url = f"https://api.telegram.org/bot{cfg['token']}/getUpdates?offset={_last_update_id + 1}&timeout=30"
        req = urllib.request.Request(url)
        response = urllib.request.urlopen(req, timeout=35, context=context)
        data = json.loads(response.read().decode('utf-8'))
        if data.get('ok') and data.get('result'):
            updates = data['result']
            if updates:
                last_update = updates[-1]
                update_id = last_update.get('update_id')
                if update_id:
                    _last_update_id = update_id
                message = last_update.get('message', {})
                chat_id = message.get('chat', {}).get('id')
                if str(chat_id) != str(cfg['chat_id']):
                    return None
                text = message.get('text', '')
                photo = message.get('photo')
                if text:
                    print(f"[TG] checking....: {text}")
                elif photo:
                    print(f"[TG] photo received ({len(photo)} sizes)")
                return {"text": text, "photo": photo, "message": message}
        return None
    except Exception as e:
        return None

_last_telegram_response = ""
_last_telegram_time = 0


#+--|════════════════════════════════════════════════════════════════════
#+--|Drop these anywhere above extract_url() # ─── URL EXTRACTOR ───
#+--|════════════════════════════════════════════════════════════════════
#+--|

def extract_url(text):
    """Pull the first http(s) URL from a message, or None."""
    m = re.search(r'https?://\S+', text or "")
    return m.group(0) if m else None

#+--|════════════════════════════════════════════════════════════════════
#+--| ─── MAC NOTIFICATION (used by /goggles) ─── Drop these anywhere above send_notification()
#+--|════════════════════════════════════════════════════════════════════
#+--|
def send_notification(title, message, subtitle=""):
    """macOS banner notification. Same shape as alfred's `notify`."""
    try:
        script = (f'display notification "{message}" '
                  f'with title "{title}" subtitle "{subtitle}" sound name "Ping"')
        subprocess.run(['osascript', '-e', script],
                       capture_output=True, text=True, timeout=5)
        print(f"[NOTIFY] {title} — {message}")
    except Exception as e:
        log_error(f"notify failed: {e}")


#+--|════════════════════════════════════════════════════════════════════
#+--| ─── MICHAEL ANGELOA HOT-SWAP (replaces old fetch_and_save PKG) ───
#+--|════════════════════════════════════════════════════════════════════

MICHAELANGELO_PATH = "/Users/olympynetworkco/Desktop/michealangelo-nhl-agent.py4"


def _extract_game_id(url):
    """Pull the numeric NHL gameId out of any ESPN NHL URL."""
    if not url:
        return None
    m = re.search(r'/gameId/(\d+)', url) or re.search(r'gameId[=/](\d+)', url)
    return m.group(1) if m else None


def _swap_constant(text, var, new_val):
    """Replace the first `VAR = "…"` assignment in `text`. No type hints, no reformatting."""
    pat = re.compile(rf'^(\s*{var}\s*=\s*)"[^"\n]*"', re.MULTILINE)
    new_text, n = pat.subn(rf'\1"{new_val}"', text, count=1)
    if n == 0:
        raise RuntimeError(f"anchor not found: {var}")
    return new_text


def update_michaelangelo(espn_url, yahoo_url):
    """
    Rewrite the four config constants in michealangelo.py4:
      GAMECAST_NHL_GAME  ← https://www.espn.com/nhl/game/_/gameId/<gid>
      PLAY_BY_PLAY_NHL   ← https://www.espn.com/nhl/playbyplay/_/gameId/<gid>
      SCORING_SUMMARY    ← https://www.espn.com/nhl/boxscore/_/gameId/<gid>
      WP                 ← yahoo_url (as given)
    Backs the file up, then launches him detached. Returns a status string.
    """
    p = Path(MICHAELANGELO_PATH)
    if not p.exists():
        return f"🎩 Michael Angeloa not found at {p}, Sir."

    gid = _extract_game_id(espn_url)
    if not gid:
        return "🎩 Couldn't find a gameId in that ESPN link, Sir."

    gamecast = f"https://www.espn.com/nhl/game/_/gameId/{gid}"
    pbp      = f"https://www.espn.com/nhl/playbyplay/_/gameId/{gid}"
    box      = f"https://www.espn.com/nhl/boxscore/_/gameId/{gid}"

    src = p.read_text(encoding="utf-8")

    # ── backup once per update ──
    stamp  = datetime.now().strftime("%Y%m%d-%H%M%S")
    backup = p.with_name(f"{p.name}.bak-{stamp}")
    backup.write_text(src, encoding="utf-8")

    # ── swap the four constants ──
    try:
        src = _swap_constant(src, "GAMECAST_NHL_GAME", gamecast)
        src = _swap_constant(src, "PLAY_BY_PLAY_NHL",  pbp)
        src = _swap_constant(src, "SCORING_SUMMARY",   box)
        src = _swap_constant(src, "WP",                yahoo_url)
    except RuntimeError as e:
        return f"🎩 Config swap failed, Sir: {e}"

    p.write_text(src, encoding="utf-8")

    # ── launch detached so Alfred's loop keeps running ──
    try:
        subprocess.Popen(
            ["/usr/bin/env", "python4", str(p)],
            cwd=str(p.parent),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception as e:
        return f"🎩 Michael updated but launch failed, Sir: {e}"

    return (
        f"🎩 Michael Angeloa reloaded, Sir.\n"
        f"   🏒 ESPN gameId : {gid}\n"
        f"   📊 Yahoo       : {yahoo_url}\n"
        f"   ⎙ backup       : {backup.name}\n"
        f"   🚀 launched."
    )


def fetch_and_save(url, dest_dir, filename, original_msg=""):
    """
    Kept under the same name/signature so nothing else in alfred.py4 breaks.

    If `url` (or `original_msg`) contains both an ESPN-NHL and a Yahoo-NHL link,
    we hand off to update_michaelangelo() and return its status string.
    Otherwise we fall back to a minimal fetch-and-save: .txt + .html + .webloc
    (no PDF, no Telegram spam — PKG is disabled).
    """
    from urllib.parse import urlparse

    # ── NHL reload path: scan both the url arg and the original message ──
    blob  = f"{original_msg or ''} {url or ''}"
    urls  = re.findall(r'https?://\S+', blob)
    espn  = next((u for u in urls if "espn.com" in u and "nhl" in u), None)
    yahoo = next((u for u in urls if "yahoo.com" in u and "nhl" in u), None)

    if espn and yahoo:
        return update_michaelangelo(espn, yahoo)

    # ── fallback: quiet fetch, three files, no PDF, no TG ──
    dest_dir = Path(dest_dir)
    dest_dir.mkdir(parents=True, exist_ok=True)

    context = ssl._create_unverified_context()
    req = urllib.request.Request(url, headers={'User-Agent': 'ALFRED-Watchman/1.0'})
    with urllib.request.urlopen(req, timeout=35, context=context) as r:
        raw = r.read()

    try:
        html_text = raw.decode('utf-8')
    except UnicodeDecodeError:
        html_text = raw.decode('latin-1', errors='replace')

    (dest_dir / f"{filename}.txt").write_text(html_text, encoding='utf-8')
    (dest_dir / f"{filename}.html").write_text(html_text, encoding='utf-8')

    p    = urlparse(url)
    host = p.netloc or "unknown"
    slug = (p.path.strip("/") or "root").split("/")[0].split("?")[0] or "index"
    webloc = dest_dir / f"{host}:{slug}.webloc"
    webloc.write_text(
        '<?xml version="1.0" encoding="UTF-8"?>\n'
        '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" '
        '"http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
        '<plist version="1.0">\n'
        '<dict>\n'
        '    <key>URL</key>\n'
        f'    <string>{url}</string>\n'
        '</dict>\n'
        '</plist>\n',
        encoding='utf-8'
    )

    print(f"🎩 📝 {filename}.txt · 💾 {filename}.html · 🔗 {webloc.name}")
    return str(dest_dir / f"{filename}.html")

#+--|════════════════════════════════════════════════════════════════════
#+--|#+--| ─── TELEGRAM CHAT LOG (alfred-tg-chat.json) ───
#+--|════════════════════════════════════════════════════════════════════
#+--|

#+--|════════════════════════════════════════════════════════════════════
#+--| ─── TELEGRAM CHAT LOG (alfred-tg-chat.json) ───
#+--|════════════════════════════════════════════════════════════════════
TG_CHAT_FILE = BASE / "alfred-tg-chat.json"
_tg_chat_lock = threading.Lock()
TELEGRAM_DIR = Path("/Users/olympynetworkco/Desktop/ollama/telegram")
TELEGRAM_DIR.mkdir(parents=True, exist_ok=True)

def log_tg_message(role, text, extra=None):
    """
    Append one message to alfred-tg-chat.json.
      role : "owner" (you) | "alfred" (him) | "system"
      text : the message body. For role="alfred", pass "" to leave blank.
      extra: optional metadata dict (e.g. {"url": "..."}).
    """
    entry = {
        "ts": datetime.now().isoformat(timespec="seconds"),
        "role": role,
        "text": text,
    }
    if extra:
        entry.update(extra)

    with _tg_chat_lock:
        data = {"messages": []}
        if TG_CHAT_FILE.exists():
            try:
                data = json.loads(TG_CHAT_FILE.read_text(encoding="utf-8"))
                if not isinstance(data, dict):
                    data = {"messages": []}
            except Exception:
                data = {"messages": []}

        data.setdefault("messages", []).append(entry)
        data["messages"] = data["messages"][-5000:]

        TG_CHAT_FILE.write_text(
            json.dumps(data, indent=2, ensure_ascii=False),
            encoding="utf-8",
        )



def _divider(text):
    """Send a divider message to Telegram AND log it."""
    send_telegram(text)
    log_tg_message("system", text)


#+--|════════════════════════════════════════════════════════════════════
#+--|def telegram_listener():
#+--|════════════════════════════════════════════════════════════════════
#+--|
def telegram_listener():
    while True:
        try:
            incoming = listen_telegram()
            if not incoming:
                time.sleep(2)
                continue

            # ── MEDIA BRANCH (photo / video / document / audio / voice / animation / video_note / sticker) ──
            msg_obj = incoming.get("message", {}) or {}
            cfg = load_telegram_config()

            file_id = None
            file_name = None
            kind = None

            if "photo" in msg_obj:
                file_id = msg_obj["photo"][-1]["file_id"]
                file_name = f"photo-{datetime.now().strftime('%Y%m%d-%H%M%S')}.jpg"
                kind = "photo"
            elif "video" in msg_obj:
                v = msg_obj["video"]
                file_id = v["file_id"]
                file_name = v.get("file_name") or f"video-{datetime.now().strftime('%Y%m%d-%H%M%S')}.mp4"
                kind = "video"
            elif "document" in msg_obj:
                d = msg_obj["document"]
                file_id = d["file_id"]
                file_name = d.get("file_name") or f"document-{datetime.now().strftime('%Y%m%d-%H%M%S')}"
                kind = "document"
            elif "audio" in msg_obj:
                a = msg_obj["audio"]
                file_id = a["file_id"]
                file_name = a.get("file_name") or f"audio-{datetime.now().strftime('%Y%m%d-%H%M%S')}.mp3"
                kind = "audio"
            elif "voice" in msg_obj:
                file_id = msg_obj["voice"]["file_id"]
                file_name = f"voice-{datetime.now().strftime('%Y%m%d-%H%M%S')}.ogg"
                kind = "voice"
            elif "animation" in msg_obj:
                an = msg_obj["animation"]
                file_id = an["file_id"]
                file_name = an.get("file_name") or f"anim-{datetime.now().strftime('%Y%m%d-%H%M%S')}.mp4"
                kind = "animation"
            elif "video_note" in msg_obj:
                file_id = msg_obj["video_note"]["file_id"]
                file_name = f"videonote-{datetime.now().strftime('%Y%m%d-%H%M%S')}.mp4"
                kind = "video_note"
            elif "sticker" in msg_obj:
                st = msg_obj["sticker"]
                file_id = st["file_id"]
                ext = "webp" if not st.get("is_animated") else "tgs"
                file_name = f"sticker-{datetime.now().strftime('%Y%m%d-%H%M%S')}.{ext}"
                kind = "sticker"

            if file_id:
                ctx = ssl._create_unverified_context()
                try:
                    info_url = f"https://api.telegram.org/bot{cfg['token']}/getFile?file_id={file_id}"
                    with urllib.request.urlopen(info_url, timeout=15, context=ctx) as r:
                        info = json.loads(r.read().decode("utf-8"))

                    if not info.get("ok"):
                        raise RuntimeError(info.get("description", "getFile failed"))

                    tg_path = info["result"]["file_path"]
                    dl_url = f"https://api.telegram.org/file/bot{cfg['token']}/{tg_path}"

                    safe = "".join(c for c in file_name if c.isalnum() or c in "._-") or f"tg-{int(time.time())}.bin"
                    save_to = TELEGRAM_DIR / safe
                    counter = 1
                    stem, ext = save_to.stem, save_to.suffix
                    while save_to.exists():
                        save_to = TELEGRAM_DIR / f"{stem}-{counter}{ext}"
                        counter += 1

                    with urllib.request.urlopen(dl_url, timeout=180, context=ctx) as r:
                        blob = r.read()

                    save_to.write_bytes(blob)
                    kb = len(blob) // 1024
                    print(f"🎩 📥 Saved {kind}: {save_to.name} ({kb} KB)")
                    send_telegram(f"📥 Saved {kind} → {save_to.name} ({kb} KB)")
                    log_tg_message("alfred", f"[received {kind}: {save_to.name}]")

                except urllib.error.HTTPError as e:
                    body = ""
                    try:
                        body = e.read().decode("utf-8", errors="replace")
                    except Exception:
                        pass
                    print(f"🎩 ❌ {kind} download HTTP {e.code}: {body[:300]}")
                    if e.code == 400 and "too big" in body.lower():
                        send_telegram(
                            f"🎩 Sir, that {kind} is over Telegram's 20 MB bot limit. "
                            f"Compress it or send a link instead."
                        )
                    else:
                        send_telegram(f"🎩 Couldn't download {kind}, Sir: HTTP {e.code}")
                    log_tg_message("alfred", f"[{kind} download failed: {e.code}]")

                except Exception as e:
                    print(f"🎩 ❌ {kind} download error: {e!r}")
                    send_telegram(f"🎩 Couldn't save {kind}, Sir: {e}")
                    log_tg_message("alfred", f"[{kind} download failed]")

                time.sleep(1)
                continue

            # ── TEXT BRANCH ──
            msg = incoming.get("text", "")
            print(f"[TG] Received: {msg}")

            # ─── LOG INCOMING MESSAGE ───
            log_tg_message("owner", msg)

            # ── Route to brain when JSON builder is active ──
            if _json_builder is not None or _html_builder is not None:
                send_telegram(alfred_think(msg))
                continue

            # ── Also catch "make a json" / "show json" when NOT active ──
            low = msg.strip().lower()
            if low.startswith(("make a json", "make json", "build a json", "new json", "create a json")) or \
               low in ("show json", "show the json"):
                send_telegram(alfred_think(msg))
                continue

            # ── NHL reload: ESPN + Yahoo link in the same message ──
            # MUST run before extract_url's `continue` below, or it never fires.
            urls  = re.findall(r'https?://\S+', msg)
            espn  = next((u for u in urls if "espn.com" in u and "nhl" in u), None)
            yahoo = next((u for u in urls if "yahoo.com" in u and "nhl" in u), None)

            if espn and yahoo:
                print(f"[TG] 🏒 NHL reload: espn={espn} yahoo={yahoo}")
                send_telegram(update_michaelangelo(espn, yahoo))
                log_tg_message("alfred", "Michael Angeloa reloaded")
                continue

            # ===== URL — acknowledged, no PKG =====
            url = extract_url(msg)
            if url:
                print(f"[TG] 🔗 URL received (no PKG): {url}")
                send_telegram(f"🔗 Got the link, Sir. (PKG disabled)")
                log_tg_message("alfred", "")
                continue

            # ===== HANDLE /goggles =====
            if msg.strip().lower() == '/goggles':
                send_telegram("🦄 DONATELLO TRIGGERED: Hot load notified!👾")
                log_tg_message("alfred", "")
                send_notification("🦄 DONATELLO", "Alert sent to Donatello👾", "URGENT")
                continue

            # ===== DEFAULT RESPONSE =====
            send_telegram(f"📨 Got it: {msg}...")
            log_tg_message("alfred", "")          # ← empty placeholder

            time.sleep(2)
        except Exception as e:
            print(f"[TG] Listener error: {e}")
            time.sleep(5)


