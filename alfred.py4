    # ─── CALCULATE FIRST ───
    # ─── CALCULATE FIRST ───
    if intent == "calculate":
        # Added spring and probability to the regex
        formula_match = re.search(
            r'(win-loss|run-line|safety-net|momentum|prediction|coverage-rate|win-percentage|safer-bet|median|std-dev|spring|probability)',
            user_input.lower()
        )
        
        if not formula_match:
            # If it's not a sports formula, try to just do the math!
            math_str = user_input.lower().replace("calculate", "").replace("what is", "").replace("=", "").strip()
            math_str = math_str.replace("minus", "-").replace("plus", "+").replace("times", "*").replace("divided by", "/")
            try:
                result = eval(math_str)
                return f"🎩 The answer is {result}, Sir."
            except Exception:
                pass 

            return """🎩 Which formula, sir?
  Available: win-loss, run-line, safety-net, momentum, prediction, coverage-rate, safer-bet, median, std-dev, spring, probability

  Examples:
    calculate win-loss 8 5
    calculate run-line 2.0
    calculate momentum 2 1 -1 3 0 4 2 -2 3 5
    calculate spring 3 1 -2 4 5
    calculate prediction 3 1 5 0 2 -1 4 2 6 1
    calculate probability 7.5
    calculate safer-bet 1.82 2.5"""

        formula_id = formula_match.group(1)

        numbers = re.findall(r'-?\d+\.?\d*', user_input)

        # Check for sport override in the text (e.g., "calculate spring NFL 3 1 2")
        user_lower = user_input.lower()
        sport_override = "NFL" if "nfl" in user_lower else "MLB"

        if formula_id == "win-loss" and len(numbers) >= 2:
            data = {"team_score": float(numbers[0]), "opponent_score": float(numbers[1]), "sport": sport_override}
        elif formula_id in ("run-line", "point-spread") and len(numbers) >= 1:
            data = {"win_loss": float(numbers[0]), "spread": float(numbers[1]) if len(numbers) >= 2 else (-3.5 if sport_override == "NFL" else -1.5), "sport": sport_override}
        elif formula_id == "safety-net" and len(numbers) >= 1:
            data = {"win_loss": float(numbers[0]), "sport": sport_override}
        elif formula_id in ("momentum", "prediction", "median", "std-dev", "spring") and len(numbers) >= 3:
            data = {"values": [float(n) for n in numbers], "sport": sport_override}
        elif formula_id in ("coverage-rate", "win-percentage") and len(numbers) >= 2:
            data = {"total": float(numbers[0]), "meeting": float(numbers[1]), "sport": sport_override}
        elif formula_id == "safer-bet" and len(numbers) >= 1:
            data = {"momentum": float(numbers[0]), "odd_line": float(numbers[1]) if len(numbers) >= 2 else (7.5 if sport_override == "NFL" else 2.5), "sport": sport_override}
        elif formula_id == "probability" and len(numbers) >= 1:
            # For probability, we need the odd line and optionally the spring value
            data = {"odd_line": float(numbers[0]), "spring": float(numbers[1]) if len(numbers) >= 2 else 0, "sport": sport_override}
        else:
            return f"🎩 Not enough numbers for {formula_id}. Please provide the required values."

        return alfred_calculate(formula_id, data)


