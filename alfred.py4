R = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
BLU = "\033[94m"
WHT = "\033[97m"
YLW = "\033[93m"
GRN = "\033[92m"
RED = "\033[91m"
CYN = "\033[96m"
MAG = "\033[95m"

# ─── BADGE FORMATTING ───
BG_GREEN = "\033[42m\033[30m"
BG_CYAN  = "\033[46m\033[30m"
BG_RED   = "\033[41m\033[30m"
GRAY     = "\033[90m"

def alfred_log(badge, module, message, badge_color=BG_GREEN):
    """Prints a formatted log line matching the Ollama grid style."""
    now = datetime.now().strftime("%Y/%m/%d - %H:%M:%S")
    
    # We pad with spaces inside the color box so they look like uniform blocks
    padded_badge = f" {badge.ljust(4)} "
    
    # Print: [Timestamp] | [Badge] | [Module] | [Message]
    print(f"[{now}] | {badge_color}{padded_badge}{R} | {GRAY}{module}{R} | {message}")

_start = time.time()
_tick = 0

#+--|════════════════════════════════════════════════════════════════════
#+--| def get_cpu() / get_ram() — cached (5s TTL)
#+--|════════════════════════════════════════════════════════════════════
_cpu_cache = "0%"
_cpu_ts    = 0
_ram_cache = "unknown"
_ram_ts    = 0
_CACHE_TTL = 5.0

def get_cpu():
    global _cpu_cache, _cpu_ts
    now = time.time()
    if now - _cpu_ts > _CACHE_TTL:
        try:
            result = subprocess.getoutput("ps -A -o %cpu | awk '{s+=$1} END {print s}'")
            _cpu_cache = f"{float(result):.1f}%" if result else "0%"
        except:
            _cpu_cache = "0%"
        _cpu_ts = now
    return _cpu_cache

def get_ram():
    global _ram_cache, _ram_ts
    now = time.time()
    if now - _ram_ts > _CACHE_TTL:
        try:
            mem = subprocess.getoutput("vm_stat | grep 'Pages free' | awk '{print $3}'")
            _ram_cache = f"{float(mem) * 4096 / (1024**3):.1f}GB" if mem and mem.isdigit() else "unknown"
        except:
            _ram_cache = "unknown"
        _ram_ts = now
    return _ram_cache
    return "unknown"
#+--|════════════════════════════════════════════════════════════════════
#+--| def get_uptime():
#+--|════════════════════════════════════════════════════════════════════

def get_uptime():
    up = int(time.time() - _start)
    h, r = divmod(up, 3600)
    m, s = divmod(r, 60)
    return f"{h:02d}:{m:02d}:{s:02d}"
