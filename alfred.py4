_watchdog_last_alert = 0
_watchdog_cooldown = 300

def claw_watchdog():
    global _watchdog_last_alert
    state = load_state()
    errors = state.get("errors_caught", 0)
    current_time = time.time()
    if errors > 10 and current_time - _watchdog_last_alert > _watchdog_cooldown:
        send_telegram(f"[⚠️-Config-json] Watchdog: {errors} errors total.")
        _watchdog_last_alert = current_time
    return BASE.exists()


