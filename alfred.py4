            return f"🎩 Error logged: {err}"
#+--|════════════════════════════════════════════════════════════════════
#+--| if tab remember return post tab open old an current browser command + t
#+--|════════════════════════════════════════════════════════════════════
    # ─── TAB ───
    if intent == "tab":
        if "new tab" in user_input.lower():
            subprocess.run(["osascript", "-e", 'tell app "System Events" to keystroke "t" using command down'])
            state["tabs_opened"] = state.get("tabs_opened", 0) + 1
            save_state(state)
            return "🎩 New tab opened"
        if "close tab" in user_input.lower():
            subprocess.run(["osascript", "-e", 'tell app "System Events" to keystroke "w" using command down'])
            return "🎩 Tab closed"
        if "next tab" in user_input.lower():
            subprocess.run(["osascript", "-e", 'tell app "System Events" to keystroke "}" using command down'])
            return "🎩 Next tab"
        if user_input.lower().strip() == "tab":
            claw_tab()
            return "🎩 Tab pressed"
#+--|════════════════════════════════════════════════════════════════════
#+--| if intent enter return post click enter an current tab
#+--|════════════════════════════════════════════════════════════════════
    # ─── ENTER ───
    if user_input.lower().strip() == "enter":
        claw_enter()
        return "🎩 Enter pressed"
#+--|════════════════════════════════════════════════════════════════════
#+--| if intent love return current curving up an lubdub love
#+--|════════════════════════════════════════════════════════════════════
    # ─── LOVE ───
    if "love you" in user_input.lower():
        return "♘ Love you too Master Art now Rev it!"

#+--|════════════════════════════════════════════════════════════════════
#+--| if intent == "appreciation":
#+--|════════════════════════════════════════════════════════════════════
    # ─── APPRECIATION ───
    if "thank you" in user_input.lower():
        return "🎩 You're most welcome, Master Art, Sir. The watchman is always with you."

#+--|════════════════════════════════════════════════════════════════════
#+--| if intent grip return json html txt current search files list from folders
#+--|════════════════════════════════════════════════════════════════════
    # ─── GRIP (JSON + HTML + TXT) ───
    if intent == "grip":
        match = re.search(r'([\w\-\.]+\.(json|html|txt))', user_input)
        if match:
            filename = match.group(1)
            possible_paths = [
                f"/Users/olympynetworkco/Desktop/data{filename}",
                f"/Users/olympynetworkco/Desktop/themes{filename}",
                f"/Users/olympynetworkco/Desktop/media{filename}",
                f"/Users/olympynetworkco/Desktop/html{filename}",


                f"/Applications/python4/{filename}",
                f"/Applications/python4/alfred/{filename}",
            ]
            filepath = None
            for path in possible_paths:
                if os.path.exists(path):
                    filepath = path
                    break

            if filepath:
                if filename.endswith('.html') or filename.endswith('.txt'):
                    try:
                        with open(filepath, 'r', encoding='utf-8') as f:
                            content = f.read()
                        if len(content) > 3000:
                            content = content[:3000] + "\n... (truncated)"
                        return f"🎩 Gripping {filename}:\n```html\n{content}\n```"
                    except Exception as e:
                        return f"🎩 Error reading file: {e}"
                else:
                    if "stats" in user_input.lower():
                        stats = json_stats(filepath)
                        if "error" in stats:
                            return f"🎩 Error: {stats['error']}"
                        return f"""🎩 JSON Stats for {filename}:
  ⎙ Type: {stats['type']}
  🔑 Keys: {', '.join(stats['keys'][:10])}{'...' if len(stats['keys']) > 10 else ''}
  [🎤︎︎ ERROR.DASHBOARD-STATE] Size: {stats['size']} characters"""
                    content = json_grip(filepath)
                    if content.startswith("🎩 Error"):
                        return content
                    if len(content) > 3000:
                        content = content[:3000] + "\n... (truncated)"
                    return f"🎩 Gripping {filename}:\n```json\n{content}\n```"
            return f"🎩 File not found: {filename}"
        return "🎩 Which file shall I grip, sir? e.g., 'grip alfred-state.json' or 'grip www.bing.com_webhp.html'"

#+--|════════════════════════════════════════════════════════════════════
#+--| if intent == "TIME/DATE/DAY":
#+--|════════════════════════════════════════════════════════════════════
    # ─── TIME / DATE ───
    if intent == "time":
        now = datetime.now().astimezone()
        
        # Format: Saturday, October 24, 2026 at 07:15 PM
        date_str = now.strftime('%A, %B %d, %Y')
        time_str = now.strftime('%I:%M %p')
        
        return f"🎩 It is currently {time_str} on {date_str}, Sir."
#+--|════════════════════════════════════════════════════════════════════
#+--| if intent == "WEATHER":
#+--|═══════════════════════════════════════════════════════════════════
    # ─── WEATHER ───
    global _waiting_for_weather
    
    if _waiting_for_weather:
        _waiting_for_weather = False
        # The user just replied with a city
        city = user_input.strip()
        return get_weather(city)
        
    if intent == "weather":
        # Use regex to find the city name, stripping out all the filler words
        # Matches things like "whats the weather in Seattle" -> "Seattle"
        match = re.search(r'(?:weather|temperature|forecast)(?:\s+in|\s+for|\s+at)?\s+([a-zA-Z\s]+)', user_input.lower())
        
        if match:
            city = match.group(1).strip()
            if city:
                return get_weather(city)
                
        # If no city was found in the sentence, ask for it
        _waiting_for_weather = True
        return "🎩 Which city would you like the weather for, Sir?"

#+--|════════════════════════════════════════════════════════════════════
#+--| if intent == "calculate":
#+--|═══════════════════════════════════════════════════════════════════

    # ─── MATH CALCULATOR ───
    if "math" in user_input.lower() or "minus" in user_input.lower():
        # Strip out the words so only the numbers and symbols remain
        math_str = user_input.lower().replace("calculate", "").replace("what is", "").replace("=", "").strip()
        
        # Translate words to symbols
        math_str = math_str.replace("minus", "-").replace("plus", "+").replace("times", "*").replace("divided by", "/")
        
        try:
            # eval() does the actual math instantly
            result = eval(math_str)
            return f"🎩 The answer is {result}, Sir."
        except Exception:
            pass # If it fails, let it fall through to the AI brain

#+--|════════════════════════════════════════════════════════════════════
#+--| if intent == "schedule":
#+--|═══════════════════════════════════════════════════════════════════

    # ─── NEW: schedule trigger ───
    if intent == "schedule":
        return _schedule_start()


#+--|════════════════════════════════════════════════════════════════════
#+--| CHAPTER 3b # ─── ECHO ─── everything goes above echo
#+--|═══════════════════════════════════════════════════════════════════

    # ─── ECHO ───
    global _waiting_for_sport
    if _waiting_for_sport:
        # User just picked a sport — route to search
        _waiting_for_sport = False
        sport = user_input.strip().lower()
        valid = ["mlb", "nba", "nfl", "nhl", "soccer", "baseball", "basketball", "hockey", "football"]
        if any(v in sport for v in valid):
            return search_web(f"{sport} scores today")
        return f"🎩 I don't recognize '{sport}', Sir. Try MLB, NBA, NFL, or NHL."

    # Check if the user is asking for game results without specifying a sport
    lower = user_input.lower()
    if any(word in lower for word in ["game results", "todays game", "today's game", "score", "who won"]):
        if not any(sport in lower for sport in ["mlb", "nba", "nfl", "nhl", "soccer"]):
            _waiting_for_sport = True
            return "🎩 Which sport, Sir? MLB, NBA, NFL, or NHL?"

    # ─── No keyword matched — ask Ollama ───
    try:
        upload_dir = Path("/Users/olympynetworkco/Desktop/ollama/uploads")
        latest_image = None
        if upload_dir.exists():
            images = sorted(upload_dir.glob("*.png"), key=os.path.getmtime, reverse=True)
            if images:
                latest_image = str(images[0])
        
        # If a graph was uploaded, use the drawing tool
        if latest_image and user_input.strip().lower().startswith("analyze graph"):
            # Let Alfred get the color first
            color = analyze_graph_colors(latest_image)
            
            # We can hardcode the grid coordinates for now, or let the model decide
            result = draw_graph_analysis(
                image_path=latest_image, 
                dominant_color=color, 
                horizontal_line_y=50, # Middle
                vertical_line_x=50    # Middle
            )
            
            # Then let the brain talk about it
            brain_reply = alfred_mind(user_input, image_path=latest_image)
            return f"{result}\n\n{brain_reply}"
            
        # ─── Sanitize history: never let status-card residue pattern-complete ───
        clean_history = [
            h for h in CHAT_HISTORY
            if not any(marker in h for marker in (
                "ALFRED STATUS",
                "CPU:",
                "RAM:",
                "Uptime:",
                "Errors:",
                "Goals:",
                "Searches:",
                "Tabs:",
            ))
        ]
        return alfred_mind(user_input, history=clean_history, image_path=latest_image)

    except Exception as e:
        log_error(f"tinydolphin:latest brain failed: {e}")
        return f"🎩 Brain error, Sir: {e}"


#+--|════════════════════════════════════════════════════════════════════
#+--| READ BUILDER — module-level functions (must live OUTSIDE alfred_think)
#+--|════════════════════════════════════════════════════════════════════
def _read_start():
    global _read_builder
    _read_builder = {"stage": "awaiting_text", "text": ""}
    return "🎩 Drop the text, Sir. Say `done` on its own line to speak it, or `cancel`."

def _read_cancel():
    global _read_builder
    _read_builder = None
    return "🎩 Read cancelled, Sir."

def _read_finish():
    global _read_builder
    if not _read_builder or not _read_builder.get("text", "").strip():
        _read_builder = None
        return "🎩 Nothing to read, Sir."

    text = _read_builder["text"].strip()
    _read_builder = None

    if len(text) > 6000:
        text = text[:6000] + " ... truncated, Sir."

    out_path = Path("/Users/olympynetworkco/Desktop/data/alfred_read.mp3")
    out_path.parent.mkdir(parents=True, exist_ok=True)

    voices = ["en-GB-ThomasNeural", "en-GB-RyanNeural"]
    last_err = ""

    # ─── Reading banner + preview of what he'll say ───
    word_count = len(text.split())
    char_count = len(text)
    print(f"\n{'═' * 50}")
    print(f"🎤︎︎ ALFRED IS READING — {word_count} words · {char_count} chars")
    print(f"{'═' * 50}")

    preview = text.replace("\n", " ").strip()
    wrap_width = 60
    preview_lines = []
    while preview and len(preview_lines) < 6:
        cut = preview.rfind(" ", 0, wrap_width)
        if cut == -1:
            cut = wrap_width
        preview_lines.append(preview[:cut].strip())
        preview = preview[cut:].strip()
    if preview:
        preview_lines[-1] = preview_lines[-1].rstrip() + " …"

    for line in preview_lines:
        print(f"🎤︎︎ ❟ {line}")
    print(f"{'═' * 50}\n")
    # ──────────────────────────────────────────────────

    for voice in voices:
        try:
            proc = subprocess.run(
                ["edge-tts", "--voice", voice, "--text", text,
                 "--write-media", str(out_path)],
                capture_output=True, text=True, timeout=60
            )
            if proc.returncode == 0 and out_path.exists() and out_path.stat().st_size > 500:
                kb = out_path.stat().st_size // 1024
                print(f"🎤︎︎ Playing via afplay…  ({kb} KB · {voice})")
                print(f"🎤︎︎ ▶  speak, sir.\n-\n")
                subprocess.run(
                    ["afplay", str(out_path)],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
                print(f"\n🎤︎︎ ✓ Playback complete, Sir.")
                print(f"{'═' * 50}\n")
                return f"🎩 Spoken, Sir. ({kb} KB · voice: {voice})\n  📎 {out_path}"
            last_err = (proc.stderr or proc.stdout or "empty audio").strip()[:200]
        except FileNotFoundError:
            return ("🎩 `edge-tts` is not installed, Sir.\n"
                    "  Run:  pip install edge-tts")
        except subprocess.TimeoutExpired:
            last_err = "edge-tts timed out after 60s"
        except Exception as e:
            last_err = str(e)[:200]

    return f"🎩 Edge TTS failed, Sir: {last_err}"


#+--|════════════════════════════════════════════════════════════════════
#+--| CHAPTER 3: Darwin def laws def start_gui_bridge():
#+--|════════════════════════════════════════════════════════════════════
# ─── GUI BRIDGE (Lets the web GUI talk to Alfred) ───
def start_gui_bridge():
    from http.server import BaseHTTPRequestHandler, HTTPServer
    
    class AlfredHandler(BaseHTTPRequestHandler):
#+--|════════════════════════════════════════════════════════════════════

        def do_POST(self):
            if self.path == '/api/generate':
                response_text = None
                try:
                    length = int(self.headers['Content-Length'])
                    post_data = json.loads(self.rfile.read(length).decode('utf-8'))
                    user_prompt = post_data.get('prompt', '')
                    chat_id = post_data.get('chat_id', f"chat-{int(time.time())}")
                    history = post_data.get('history', [])

                    log_info(f"[GUI] prompt={user_prompt!r} chat_id={chat_id}")

                    save_memory_turn(chat_id, "owner", user_prompt,
                                     intention="message", context="gui")

                    global _via_gui, _read_builder, _json_builder, _html_builder
                    _via_gui = True

                    # ─── File-drop guard: disarm stale builders BEFORE the brain runs ───
                    stripped = user_prompt.lstrip()
                    is_file_drop = (
                        len(user_prompt) > 2000
                        or stripped.startswith(("{", "<", "[", "file:", "/", "~"))
                    )
                    if is_file_drop:
                        _read_builder = None
                        _json_builder = None
                        _html_builder = None
                        log_info(f"[GUI] file-drop guard triggered — builders disarmed")

                    try:
                        response_text = alfred_think(user_prompt)
                        log_info(f"[GUI] alfred_think returned: type={type(response_text).__name__} value={response_text!r:.200}")
                    except Exception as e:
                        import traceback
                        tb = traceback.format_exc()
                        log_error(f"GUI brain error: {e}\n{tb}")
                        response_text = f"🎩 Brain error, Sir: {e}"
                    finally:
                        _via_gui = False

                    # ─── HARD GUARD: never emit null ───
                    if response_text is None or response_text == "":
                        log_error(f"GUI brain returned empty for: {user_prompt!r}")
                        response_text = (
                            f"🎩 I processed '{user_prompt[:80]}' but produced no output, Sir. "
                            f"Check alfred.log for details."
                        )

                    save_memory_turn(chat_id, "watchman", str(response_text),
                                     intention="response", context="gui")

                    response_json = json.dumps({"response": str(response_text)}).encode('utf-8')
                    self.send_response(200)
                    self.send_header('Content-Type', 'application/json')
                    self.send_header('Content-Length', str(len(response_json)))
                    self.end_headers()
                    self.wfile.write(response_json)

                except Exception as e:
                    import traceback
                    tb = traceback.format_exc()
                    log_error(f"GUI bridge crash: {e}\n{tb}")
                    err_body = json.dumps({
                        "response": f"🎩 Bridge error, Sir: {e}"
                    }).encode('utf-8')
                    try:
                        self.send_response(500)
                        self.send_header('Content-Type', 'application/json')
                        self.send_header('Content-Length', str(len(err_body)))
                        self.end_headers()
                        self.wfile.write(err_body)
                    except Exception:
                        pass

#+--|════════════════════════════════════════════════════════════════════


        def log_message(self, format, *args):
            pass  # Keep the terminal quiet


#+--|════════════════════════════════════════════════════════════════════


    try:
        server = HTTPServer(('localhost', 11435), AlfredHandler)
        server.serve_forever()
    except Exception as e:
        log_error(f"GUI Bridge failed: {e}")


#+--|════════════════════════════════════════════════════════════════════

# ─── START THE BRIDGE ───

threading.Thread(target=start_gui_bridge, daemon=True).start()


