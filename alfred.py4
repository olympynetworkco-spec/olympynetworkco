def draw_graph_analysis(image_path, dominant_color, horizontal_line_y, vertical_line_x):
    """Creates an HTML file that draws the grid and dots over the graph."""
    import shutil
    import uuid
    
    # 1. Copy the image to the data folder so the HTML can see it
    img_name = f"graph_{uuid.uuid4().hex[:6]}.png"
    dest_img = BASE / img_name
    shutil.copy(image_path, dest_img)
    
    # 2. Build the HTML with SVG overlays
    html_content = f"""
    <!DOCTYPE html>
    <html>
    <head>
        <title>Alfred's Graph Analysis</title>
        <style>
            body {{ background: #0b1424; color: #dbeafe; font-family: sans-serif; text-align: center; }}
            .container {{ position: relative; display: inline-block; margin-top: 50px; }}
            img {{ max-width: 800px; border-radius: 12px; border: 2px solid #60a5fa; }}
            .overlay {{ position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }}
            .h-line {{ position: absolute; top: {horizontal_line_y}%; left: 0; width: 100%; border-top: 2px dashed #ff0033; }}
            .v-line {{ position: absolute; top: 0; left: {vertical_line_x}%; height: 100%; border-left: 2px dashed #00ffcc; }}
            .dot {{ position: absolute; width: 12px; height: 12px; background: #ffcc00; border-radius: 50%; transform: translate(-50%, -50%); box-shadow: 0 0 10px #ffcc00; }}
        </style>
    </head>
    <body>
        <h1>🎩 Alfred's Graph Analysis</h1>
        <p>Dominant Color Detected: <strong>{dominant_color}</strong></p>
        
        <div class="container">
            <img src="{img_name}">
            <div class="overlay">
                <!-- Horizontal Line -->
                <div class="h-line"></div>
                <!-- Vertical Line -->
                <div class="v-line"></div>
                <!-- Dots (Highs and Lows) -->
                <div class="dot" style="top: {horizontal_line_y - 10}%; left: {vertical_line_x + 10}%;"></div>
                <div class="dot" style="top: {horizontal_line_y + 15}%; left: {vertical_line_x - 20}%;"></div>
            </div>
        </div>
        <p>Analysis complete, Sir.</p>
    </body>
    </html>
    """
    
    # 3. Save and open it
    html_path = BASE / f"graph_analysis_{uuid.uuid4().hex[:6]}.html"
    html_path.write_text(html_content, encoding="utf-8")
    
    subprocess.run(["open", str(html_path)])
    return f"🎩 Created and opened the analysis file: {html_path.name}"

#+--|════════════════════════════════════════════════════════════════════
#+--|  THE EYE — Graph Color Analyzer
#+--|════════════════════════════════════════════════════════════════════
def analyze_graph_colors(image_path):
    """Use macOS sips to grab the dominant color of the graph."""
    try:
        # sips can resize an image to 1x1, which averages all pixels
        avg_path = "/tmp/alfred_avg_color.png"
        subprocess.run(
            ["sips", "-z", "1", "1", image_path, "--out", avg_path],
            check=False, capture_output=True, timeout=10
        )
        # Get the pixel color
        result = subprocess.run(
            ["sips", "-g", "pixelColor", avg_path],
            check=False, capture_output=True, text=True, timeout=5
        )
        # sips returns something like "  pixelColor: 255 0 0"
        for line in result.stdout.splitlines():
            if "pixelColor" in line:
                return line.split(":", 1)[1].strip()
    except Exception as e:
        log_error(f"analyze_graph_colors failed: {e}")
    return "unknown"

